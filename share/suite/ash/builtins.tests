#
# BusyBox ash's own answers among the builtins every shell has.
#
# The one a portable script meets first is `echo`: dash processes the escape
# sequences with no option at all, and ash does not — it wants `-e`, the way
# bash does. Two shells that sit on the same side of the ext/ boundary and
# give opposite answers about the most-used builtin there is.

# echo leaves the escapes alone.
echo 'plain: a\tb'
echo 'plain: a\nb'

# -e turns them on, -E turns them back off, and -n drops the newline.
echo -e 'with -e: a\tb'
echo -E 'with -E: a\tb'
echo -n 'with -n, no newline follows'
echo ''
echo -e -n 'both: a\tb'
echo ''

# printf is the portable spelling and behaves the same way it does
# everywhere, including %b for the processing echo will not do unasked.
printf '%b\n' 'via %%b: a\tb'
printf '%s|%d|%c\n' str 42 xyz
printf '%5.2f\n' 3.14159

# `local` is here, as it is in dash and not in ksh93. A valueless name is
# unset rather than empty, which is the half the panel disagrees about.
outer=kept
f() {
  local outer=inner
  local u
  outer=changed
  printf 'inside: %s\n' "$outer"
  printf 'valueless: [%s]\n' "${u-unset}"
}
f
printf 'outside: %s\n' "$outer"

# Several names in one local, and they are names rather than declarations.
g() {
  local a=1 b
  b=2
  printf '%s%s\n' "$a" "$b"
}
g
printf 'nothing escaped: [%s][%s]\n' "${a-unset}" "${b-unset}"

# type and command -V, in BusyBox's wording.
type echo
type f
type nosuchcommandanywhere
printf 'type on nothing: %s\n' "$?"
command -V echo
command -v f
command -v nosuchcommandanywhere
printf 'command -v on nothing: %s\n' "$?"

# The expansion operators ash has and dash has not, on the builtins' own
# ground: a substring and a substitution used to build a word.
p=/one/two/three.txt
printf '%s\n' "${p##*/}"
printf '%s\n' "${p%/*}"
printf '%s\n' "${p/.txt/.md}"
printf '%s\n' "${p:5}"
printf '%s\n' "${#p}"

# read takes a line, and -r is what keeps a backslash.
printf 'a\\tb\n' | { read -r line; printf '%s\n' "$line"; }
printf 'a\\tb\n' | { read line; printf '%s\n' "$line"; }

# `exec -a name` is BusyBox's, and the other two letters are not: `-l` and
# `-c` are refused at the same door any unknown letter is, and `exec` is
# special here, so the subshell ends there. This column had `-a` refused as a
# command until #3056, which is the dash answer given to a shell that is not
# dash.
( exec -a NAME /bin/sh -c 'printf "[%s]\n" "$0"' )
( exec -l /bin/sh -c 'printf "reached\n"' ) 2> /dev/null; printf 'option -l -> %s\n' "$?"
( exec -c /bin/sh -c 'printf "reached\n"' ) 2> /dev/null; printf 'option -c -> %s\n' "$?"
# `.` reads a leading dash-word as an option here and has none to read, so
# `. -p dir f` is an illegal option rather than a file called `-p`, and `.`
# being special, the subshell ends there. Only bash 5.3 has the `-p`.
( . -p /tmp f.sh; printf 'reached\n' ) 2> /dev/null
printf 'a dash-word -> %s\n' "$?"

# `kill` has no option complaint at all here: everything after the dash is a
# signal, whatever it looks like. So a number out of range, a letter, a word
# and a number with junk behind it are one sentence with the *whole* word in
# it, at 1 — where dash reads the same words as option letters and names only
# the first, at 2. #3139 was this column answering dash's way: `kill -99` was
# `illegal option -9` at 2, which named a letter nobody typed and a status
# this shell has no route to.
#
# The prefix is cut off every line, and that is not tidying: BusyBox prints
# these applet-style — `ash: bad signal name '99'`, no file and no line —
# where its own `not found` carries `<file>: line N:`. Nothing here can say
# the word `ash`, because the same sentence from this shell names the binary
# it was started as. What is left after the cut is the whole of the sentence.
said() { sed "s/^.*: //"; }
( kill -99 $$ ) 2>&1 | said
( kill -99 $$ ) 2>/dev/null; printf 'a number out of range -> %s\n' "$?"
( kill -Q $$ ) 2>&1 | said
( kill -Q $$ ) 2>/dev/null; printf 'a letter -> %s\n' "$?"
( kill -NOPE $$ ) 2>&1 | said
( kill -NOPE $$ ) 2>/dev/null; printf 'a word -> %s\n' "$?"
( kill -9x $$ ) 2>&1 | said
( kill -9x $$ ) 2>/dev/null; printf 'a number with junk behind it -> %s\n' "$?"
# And the option that takes a signal reaches the same sentence and the same
# status, which the bare form alone cannot show: the two routes were 1 and 2
# here before, so a row on one of them would have passed.
( kill -s 99 $$ ) 2>&1 | said
( kill -s 99 $$ ) 2>/dev/null; printf 'the same number after -s -> %s\n' "$?"
# The control, so the probe is known to discriminate: `-9` is a signal here
# and the same route says nothing at all about it. A row of refusals with no
# acceptance beside it would read the same in a shell that refused every
# signal there is.
sleep 30 &
p=$!
( kill -9 $p ) 2>&1 | said
wait $p 2> /dev/null
printf 'a signal this shell has -> nothing said above\n'

# --- getopts: OPTARG when the scan runs out of options ---
#
# This shell unsets OPTARG on the call that reports "no more options", which
# is where it parts from dash for the third time in one builtin: dash leaves
# the last option's argument standing, and bash and ksh93 unset it as this
# shell does. The two are otherwise the closest pair on the panel (#3146).

( OPTIND=1; set -- -a val x
  getopts 'a:' o; getopts 'a:' o
  printf 'after the scan: st=%s o=[%s] OPTARG=[%s]\n' "$?" "$o" "${OPTARG-unset}" )

# And the clearing is an ordinary write, so a frozen OPTARG refuses it: the
# value stands, the builtin stops at 2 with the name unwritten, and OPTIND has
# not moved past the `--`.
( OPTIND=1; OPTARG=PRESET; set -- -- operand; o=kept; readonly OPTARG
  getopts 'a:' o 2>/dev/null
  printf 'frozen, at the end: st=%s o=[%s] OPTIND=%s OPTARG=[%s]\n' "$?" "$o" "$OPTIND" "${OPTARG-unset}" ) 2>/dev/null
