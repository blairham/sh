#
# The arithmetic the ksh family and zsh share and dash has not got. Every
# construct here is refused outright by dash — as a parse error inside
# `$(( ))`, or as a command dash has never had — which is what puts it in
# ext/ rather than in core/arith.tests beside the POSIX operators.
#
# Read it beside core/arith.tests: that file is what a `sh` script may write,
# and this is what the other four-fifths of the panel adds to it.

# --- explicit bases ----------------------------------------------------------
#
# `base#number`, for any base from 2 to 36. Base ten spelled out is the way to
# read a digit string with a leading zero as decimal, which is what a script
# that parses a date or a zero-padded index actually needs.

printf '%s\n' "binary=$(( 2#101 )) hex=$(( 16#ff )) octal=$(( 8#17 ))"
printf '%s\n' "base ten spelled out=$(( 10#09 + 1 ))"
printf '%s\n' "the widest base=$(( 36#z )) and a digit inside it=$(( 36#10 ))"
printf '%s\n' "the narrowest=$(( 2#1 )) zero in any base=$(( 16#0 ))"

# The `0x` prefix is core and is asked there; it is here once, next to its
# spelled-out twin, because the pair is the claim a reader wants.
printf '%s\n' "two spellings of the same number: $(( 0x1f )) $(( 16#1f ))"

# --- the empty expression ----------------------------------------------------
#
# Nothing at all between the parentheses is zero rather than an error. dash
# refuses it as a missing primary.

printf '[%s] [%s]\n' "$(( ))" "$((    ))"

# --- increment and decrement -------------------------------------------------
#
# Both operators in both positions, and the pair asked together: what the
# expression was worth, and what the variable holds afterwards. Either half
# alone passes on the wrong one.

i=5
printf '%s\n' "post-increment=$(( i++ )) then i=$i"
printf '%s\n' "post-decrement=$(( i-- )) then i=$i"
printf '%s\n' "pre-increment=$(( ++i )) then i=$i"
printf '%s\n' "pre-decrement=$(( --i )) then i=$i"
j=0
printf '%s\n' "twice in one expression=$(( j++ + j++ )) then j=$j"

# --- a value that is itself an expression ------------------------------------
#
# A name is read as a number, and when what it holds is not a number it is
# read again as an expression. dash stops at the first reading and calls the
# value an illegal number.

expr='2 + 3'
printf '%s\n' "a variable holding an expression=$(( expr ))"
indirect=expr
printf '%s\n' "and one holding the name of that one=$(( indirect ))"
one=1
plus='one + one'
printf '%s\n' "a name inside the held expression=$(( plus ))"

# --- the comma ---------------------------------------------------------------
#
# Every operand is evaluated, left to right, and the value is the last one.

printf '%s\n' "comma=$(( 1,2,3 ))"
g=0
printf '%s\n' "the left operand still ran=$(( g = 5, g + 1 )) g=$g"

# --- `(( ))` as a command ----------------------------------------------------
#
# The one place in the shell where zero is false: the status is the truth of
# the value rather than the value itself, so a successful assignment of zero
# is a failed command.

if (( 1 + 1 == 2 )); then printf 'a true expression succeeds\n'; fi
(( 0 ))
printf 'zero is a failure: %s\n' "$?"
(( 1 ))
printf 'one is a success: %s\n' "$?"
(( -1 ))
printf 'a negative number is a success too: %s\n' "$?"
a=1
(( a = 0 ))
printf 'an assignment of zero: status %s, a=%s\n' "$?" "$a"
(( a = 4 ))
printf 'an assignment of four: status %s, a=%s\n' "$?" "$a"

# --- `let` -------------------------------------------------------------------
#
# The same evaluation as a builtin taking words, and the same inversion of
# zero. With more than one word it is the *last* one that decides the status,
# and every one of them still runs.

let 'b = 3 + 4'
printf 'let assigned: status %s, b=%s\n' "$?" "$b"
let 'b - 7'
printf 'let of a zero result: %s\n' "$?"
let 'b'
printf 'let of a nonzero value: %s\n' "$?"
let 'c = 1' 'd = 0'
printf 'the last word decides: status %s, c=%s d=%s\n' "$?" "$c" "$d"
let 'e = 0' 'f = 1'
printf 'and it decides the other way too: status %s, e=%s f=%s\n' "$?" "$e" "$f"

# --- `((` is ambiguous, and what keeps the arithmetic reading ----------------
#
# core/grammar.tests has the other half of this: `((cmd); cmd)` is two
# groupings in every shell here, dash and ash included, because the
# arithmetic reading is given up where the expression's own nesting is not
# closed by two *adjacent* `)`. These are the rows the reading holds for, and
# they are ext/ because only the four shells with `(( ))` have them at all.
#
# The discriminator throughout is where the assignment lands. An arithmetic
# command runs in the shell that wrote it and a subshell does not, so a
# reading demoted to two groupings shows up as a value that did not change —
# which no status and no diagnostic would report (#3052).

n=0; (( n = 5 )); printf 'the ordinary form: %s\n' "$n"
n=0; ((n=5)); printf 'with no blanks at all: %s\n' "$n"
n=0; (( (n=5) )); printf 'an expression that opens with a paren: %s\n' "$n"
n=0; (((n=5))); printf 'and with no blanks around it: %s\n' "$n"
n=0; ((((n=5)))); printf 'one deeper again: %s\n' "$n"

# The two closers have to be adjacent. Both of these are two groupings, so
# the assignment stays in the subshell and 0 is what the shell keeps.
n=0; (((n=5)) ); printf 'a blank before the last closer: %s\n' "$n"
n=0; ((n=5) ); printf 'and with one paren fewer: %s\n' "$n"
n=0; ( ((n=5)) ); printf 'a subshell written with blanks: %s\n' "$n"

# An expression that is nothing but parentheses still evaluates.
(( (1+2)*3 == 9 )); printf 'a parenthesised expression: %s\n' "$?"
(( ((2)) )); printf 'parentheses and nothing else: %s\n' "$?"

# `set -u` reaches arithmetic, and it reaches every route into an arithmetic
# read of a name rather than the expansion alone. Measured 2026-09-18 against
# bash 5.3.20, ksh93u+ 2012-08-01 and zsh 5.9.2, which write these bytes
# identically; dash and BusyBox ash read a name in an expression as text that
# might be a number whether or not the option is on, which is why this is here
# and not in core/ (#3574).
#
# Each row is a subshell with its stderr discarded, because the refusal is
# fatal in all three of these shells and the wording is each shell's own — the
# status and the line that did not run are what they agree on.

( set -u; printf 'expansion: %s\n' "$(( b ))"; printf 'ran on\n' ) 2>/dev/null
printf 'expansion status: %s\n' "$?"
( set -u; a=1; printf 'operand: %s\n' "$(( a + b ))"; printf 'ran on\n' ) 2>/dev/null
printf 'operand status: %s\n' "$?"
( set -u; a=(x y z); printf 'subscript: %s\n' "${a[b]}"; printf 'ran on\n' ) 2>/dev/null
printf 'subscript status: %s\n' "$?"
( set -u; for (( i = 0; i < b; i++ )); do :; done; printf 'ran on\n' ) 2>/dev/null
printf 'for header status: %s\n' "$?"

# The two controls, and they are what say this is a lookup rule turned on by
# the option rather than a change to what arithmetic reads. A name holding the
# empty string is zero, and with the option off an unset one is zero too.
( set -u; b=; printf 'an empty name: %s\n' "$(( b + 7 ))" ) 2>/dev/null
printf 'an empty name status: %s\n' "$?"
( printf 'the option off: %s\n' "$(( b + 7 ))" ) 2>/dev/null
printf 'the option off status: %s\n' "$?"
