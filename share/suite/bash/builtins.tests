#
# The builtins bash has that the rest of the panel has not, and the spellings
# bash gives the ones it shares.
#
# `shopt`, `mapfile`/`readarray`, `type -t`, `history` and `declare -p`'s
# exact output are bash's own: zsh has `setopt`, `fc` and a different
# `typeset -p`, ksh93 has neither shopt nor mapfile and spells the history
# builtin `hist`, and dash has none of it.

# readarray reads lines into an array; -t strips the newline and -n bounds
# how many are read.
readarray -t lines < <(printf 'a\nb\nc\n')
printf 'count: %s\n' "${#lines[@]}"
printf '[%s]\n' "${lines[@]}"
mapfile -t -n 2 two < <(printf '1\n2\n3\n')
printf '-n 2 gave: %s\n' "${#two[@]}"
printf '[%s]\n' "${two[@]}"

# declare -p writes a declaration that would rebuild the name, attributes and
# all, in bash's exact spelling.
declare -p lines
v=plain
declare -p v
declare -r frozen=x
declare -p frozen
declare -i counter=1
counter+=2
printf 'integer += is arithmetic: %s\n' "$counter"
declare -p counter

# declare -A and -a are the two array kinds, and -p tells them apart.
declare -a indexed=(one two)
declare -A assoc=([k]=v)
declare -p indexed
declare -p assoc

# local takes the same attribute letters inside a function, and the
# attribute is local with the name.
f() {
  local -i i=2
  local -r fixed=y
  printf '%s\n' "$((i*3))"
  printf '%s\n' "$fixed"
}
f
printf 'nothing escaped: [%s][%s]\n' "${i-unset}" "${fixed-unset}"

# type -t is the kind of thing a word is, as one word.
printf '%s\n' "$(type -t f)"
printf '%s\n' "$(type -t printf)"
printf '%s\n' "$(type -t if)"
type -t nosuchthing
printf 'type -t on nothing: %s\n' "$?"

# FUNCNAME is a stack, and it exists only inside a function.
g() { printf '%s\n' "${FUNCNAME[0]}"; }
g
printf 'outside: [%s]\n' "${FUNCNAME[0]-unset}"

# shopt is bash's second option table, separate from set -o, and -p writes
# the command that would restore what it found.
shopt -s extglob
printf '%s\n' "$(shopt -p extglob)"
shopt -q extglob
printf 'shopt -q on: %s\n' "$?"
shopt -u nocasematch
shopt -q nocasematch
printf 'shopt -q off: %s\n' "$?"

# An option name set through `shopt -o` is a set -o option, which is how the
# two tables meet.
shopt -o -s noglob
printf '%s\n' "$(shopt -o -p noglob)"
shopt -o -u noglob

# history is a builtin a non-interactive shell still has, and it starts
# empty: nothing is read from a history file unless the shell is interactive,
# so what this measures is the list bash keeps in memory rather than what is
# on the machine. It was one of the eleven builtins no case anywhere in this
# tree mentioned (#2293).
history
printf 'empty -> %s\n' "$?"

# -s pushes a line on without running it, which is the only way a script can
# put anything there.
history -s 'first entry'
history -s 'second entry'
history
printf 'two entries -> %s\n' "$?"

# A count is how many of the most recent to write.
history 1

# -p runs a word through history expansion and prints the result rather than
# executing it. Nothing here is an expansion, so the word comes back whole.
history -p 'plain words'

# -d removes one by its number and the rest are renumbered from 1.
history -d 1
history

# -c empties the list, and an empty list prints nothing and succeeds.
history -c
history
printf 'after clear -> %s\n' "$?"

# -w and -r are the file halves, and they name the file rather than taking
# HISTFILE from the environment. A read appends to what is already there,
# which is why the line is listed twice below rather than once.
history -s kept
history -w hfile
printf 'written:\n'
cat hfile
history -r hfile
history

# help is this shell's only self-documenting builtin, and the synopsis is the
# half of a topic that is behavior: the option letters a builtin takes and the
# shape of a keyword. `help -s` is that half and nothing else, which is why it
# is what this file grades — the description a bare `help` follows it with is
# documentation prose and is deliberately not carried here.
help -s true
help -s while
help -s cd pwd

# An exact topic name wins over the prefix match, which is what keeps
# `help -s time` from also answering for `times`.
help -s time

# An operand that is only a prefix matches every topic beginning with it, and
# writes no header.
help -s sh

# An operand with a metacharacter is a pattern anchored at both ends, and
# writes one. `getopts` contains `pt` and is not matched, which is what says
# the pattern is not the prefix rule with a star on the end.
help -s '*pt'

# A topic nobody has is a complaint at 1.
help -s nosuchtopicanywhere
printf 'status: %s\n' "$?"

# `shopt -s extdebug` and the DEBUG trap: with extended debugging on, the
# action's own *status* decides what runs next. Three rules, and a probe whose
# action refuses every command cannot tell any of them apart — with everything
# skipped nothing is printed whichever rule is in force — so each block below
# refuses exactly one firing, counted.
shopt -s extdebug
n=0
d() { n=$((n+1)); [ $n = "$stop" ] && return "$code"; return 0; }
trap d DEBUG

# Any non-zero status skips the command it fired for, and the next command
# sees 0 rather than the action's status. 1, 2 and 5 all do it.
stop=2 code=1; n=0; echo one; echo two; echo three
stop=2 code=2; n=0; echo one; echo two; echo three
stop=2 code=5; n=0; echo one; echo two; echo three
stop=2 code=0; n=0; echo one; echo two; echo three

# A status of exactly 2 *inside a call* also returns from it, at 2. The
# firings for a call are the call itself, the frame being entered, then the
# body's own commands — so 4 is the middle command of a three-command body.
g() { echo g1; echo g2; echo g3; }
stop=4 code=2; n=0; g; printf 'two returned: %s\n' "$?"
stop=4 code=1; n=0; g; printf 'one skipped: %s\n' "$?"
stop=4 code=5; n=0; g; printf 'five skipped: %s\n' "$?"

# At the entry firing — the second one a call makes — any non-zero returns
# from the call carrying the action's own status, which is the rule that
# differs from the one above rather than restating it.
h() { echo in; }
stop=2 code=1; n=0; h; printf 'entry one: %s\n' "$?"
stop=2 code=5; n=0; h; printf 'entry five: %s\n' "$?"
stop=1 code=5; n=0; h; printf 'the call firing is only a skip: %s\n' "$?"

# How far a refusal reaches is the firing site's answer. A loop's per-pass
# head costs that pass and the loop carries on; three passes rather than two,
# because refusing the last pass looks the same either way.
stop=3 code=1; n=0; for i in 1 2 3; do echo b$i; done

# The arithmetic loop splits three ways over its own three parts: a refused
# initializer or step is not evaluated and the loop runs on, where a refused
# condition ends it.
stop=1 code=1; n=0; for ((i=0;i<3;i++)); do echo a$i; done
stop=2 code=1; n=0; for ((i=0;i<3;i++)); do echo c$i; done
stop=4 code=1; n=0; for ((i=0;i<3;i++)); do echo s$i; done

# And the rule belongs to the option, so turning it off puts the status back
# to being discarded.
shopt -u extdebug
stop=2 code=5; n=0; echo one; echo two; echo three
trap - DEBUG

# `ulimit`'s two keyword operands. `hard` names the ceiling this process is
# already allowed and `soft` the floor in force, so `ulimit -n hard` is how a
# script asks for every descriptor it may have without knowing the number.
# bash has both; zsh has only the first, and ksh93, dash and BusyBox ash have
# neither — see the same section in the other three directories.
#
# The limits are read back and compared rather than printed, so these rows
# are a fact about the words and not about this machine's ceiling. `-c` is
# the resource, because nothing else in this suite depends on it.
ulimit -c hard; printf 'ulimit -c hard -> %s\n' "$?"
[ "$(ulimit -Sc)" = "$(ulimit -Hc)" ] && printf 'the floor is now the ceiling\n'
ulimit -Hc soft; printf 'ulimit -Hc soft -> %s\n' "$?"
[ "$(ulimit -Hc)" = "$(ulimit -Sc)" ] && printf 'the ceiling is now the floor\n'

# A limit is a plain number here, and a sign is not part of one: `+1` is a
# number to C's strtol and to Go's strconv, and to no shell but ksh93, where
# the operand is an expression instead. It was accepted in silence, at status
# 0, until #3060.
ulimit -c +1 2> /dev/null; printf 'signed -> %s\n' "$?"
ulimit -c 1+1 2> /dev/null; printf 'expression -> %s\n' "$?"
ulimit -c 0x10 2> /dev/null; printf 'hex -> %s\n' "$?"
ulimit -c 1x 2> /dev/null; printf 'trailing -> %s\n' "$?"

# `kill -l` past the one subtraction every shell makes. bash takes the 128
# off once and refuses what is left when it names nothing, so `kill -l 257`
# — which is 129 after one go — is not HUP here, and `kill -l 160` is not the
# 32 that ksh93 and BusyBox ash answer. Zero is the trap table's own
# pseudo-signal.
kill -l 0
kill -l 160 2> /dev/null; printf '160 -> %s\n' "$?"
kill -l 257 2> /dev/null; printf '257 -> %s\n' "$?"
kill -l 128 2> /dev/null; printf '128 -> %s\n' "$?"
kill -l 32 2> /dev/null; printf '32 -> %s\n' "$?"
# `exec`'s own option letters. `-l` puts the leading `-` on argv[0] that says
# "login shell" to whatever is being started, and `-c` hands the replacement
# no environment at all — the `env -i` a launcher would otherwise write on
# the front of the line. bash and zsh have both; ksh93 has `-c` and not `-l`,
# and dash has neither. Each `exec` is in a subshell so the file survives it.
#
# The `-` goes on the word as written, path and all.
( exec -l /bin/sh -c 'printf "[%s]\n" "$0"' )
( exec -a NAME /bin/sh -c 'printf "[%s]\n" "$0"' )
# And with both letters bash puts the dash on the name `-a` chose, which is
# the one place the two shells that have `-l` disagree: zsh answers `NAME`.
( exec -l -a NAME /bin/sh -c 'printf "[%s]\n" "$0"' )
( exec -a NAME -l /bin/sh -c 'printf "[%s]\n" "$0"' )

# `-c` clears everything, an export on the way in included.
( export KEEP=1; exec -c /bin/sh -c 'printf "with -c: [%s]\n" "${KEEP-unset}"' )
( export KEEP=1; exec /bin/sh -c 'printf "without: [%s]\n" "${KEEP-unset}"' )
# `umask`'s symbolic operand past the letters every shell reads. POSIX gives
# an action a third alternative — a `u`, `g` or `o` meaning *whatever that
# group is allowed now* — and `X` beside the permission characters. bash 5.3
# has both; **bash 3.2 has neither**, calling each an invalid symbolic mode
# character, so this is a 5.x row and not a bash one.
#
# The mask is set and printed back from a known start each time, so these are
# facts about the operand and not about the process this began in.
( umask 022; umask -S g=u )
( umask 022; umask -S o=u )
( umask 022; umask -S u=g )
( umask 022; umask -S g+u )
( umask 022; umask -S g-u )
( umask 022; umask -S g=u,o=u )
# A copy written *after* permission letters replaces what they accumulated,
# which is bash's reading of a spelling POSIX does not define: from 222 the
# `w` is spent and only the copied `r-x` lands. dash OR-s the two and
# BusyBox ash refuses the mixture, so this row is bash's alone — #3074.
( umask 222; umask -S g=wu )

# `X` is not a plain `x`: it is chmod's conditional execute, and the
# condition survives here even though a mask has no file to be a directory.
# It is worth execute only where the mask already allows execute to somebody.
( umask 022; umask -S u=X )
( umask 022; umask -S a+X )
( umask 122; umask -S u+X )
( umask 133; umask -S a+X )
( umask 776; umask -S u+X )
( umask 111; umask -S u=rwX )
# And the test is against the mask the operand started from, not the one an
# earlier clause left: the owner gaining `x` does not give the group `X`.
( umask 133; umask -S u+x,g+X )

# `read` into a readonly name stops the builtin at that name and parts "I
# stopped early" from "a write failed" in the status: 2 where a name was left
# to fill and 1 where the frozen name was the last one. ksh93 fills the rest
# and reports 1 throughout, dash and BusyBox ash report 2 wherever the frozen
# name stood, and zsh ends the shell — so all four numbers below are this
# column's alone (#3208).
#
# Stderr is discarded: the sentence is this shell's and the file is already
# its tier, where the numbers are the claim.
( a=A; b=B; c=C; readonly a
  printf 'x y z\n' | { read a b c; printf 'first  st=%s [%s][%s][%s]\n' "$?" "$a" "$b" "$c"; }
) 2> /dev/null
( a=A; b=B; c=C; readonly b
  printf 'x y z\n' | { read a b c; printf 'middle st=%s [%s][%s][%s]\n' "$?" "$a" "$b" "$c"; }
) 2> /dev/null
( a=A; b=B; c=C; readonly c
  printf 'x y z\n' | { read a b c; printf 'last   st=%s [%s][%s][%s]\n' "$?" "$a" "$b" "$c"; }
) 2> /dev/null
# A `read` with no operands has no last name for that to be about: the name it
# fills is the shell's own, and this column answers 2 for it.
( REPLY=R; readonly REPLY
  printf 'x\n' | { read; printf 'bare   st=%s [%s]\n' "$?" "$REPLY"; }
) 2> /dev/null

# `logout` is the exit a **login** shell has and an ordinary one refuses, and
# the refusal names the word a script should have written instead. A suite
# file is never a login shell, so the refusal is the whole of what can be
# asked here — and it is not a gap, because that refusal is the behavior a
# script written for a login shell meets when it is sourced somewhere else.
#
# In a subshell, because it exits the one it succeeds in.
#
# It was one of the eight surface elements #3990 found that no case anywhere
# in the tree mentioned. It had been read as unreachable without the word
# being run: it is reachable, it agrees, and it takes nothing but a subshell.
( logout ) 2>&1 > /dev/null
printf 'logout outside a login shell -> %s\n' "$?"
( logout 3 ) 2>&1 > /dev/null
printf 'and with a status operand -> %s\n' "$?"
printf 'the file kept going\n'
