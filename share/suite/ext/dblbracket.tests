#
# The [[ ]] conditional command. dash is the holdout, so this is ext/.
#
# What makes [[ ]] a construct rather than a spelling of `test` is that it is
# parsed by the shell: the words inside are not expanded and split the way an
# ordinary command's are, so an empty variable is still one operand and a
# pattern on the right of == is a pattern rather than a string.

say() {
  if "$@"; then printf 'true   %s\n' "$*"; else printf 'false  %s\n' "$*"; fi
}

# Equality, and the same test spelled with one = rather than two.
[[ abc == abc ]] && printf 'equal\n'
[[ abc = abc ]] && printf 'equal, one sign\n'
[[ abc != abd ]] && printf 'unequal\n'

# The right-hand side is a pattern unless it is quoted, which is the
# difference from `test`.
[[ abc == a* ]] && printf 'pattern matched\n'
[[ abc == "a*" ]] || printf 'quoted pattern did not match a literal\n'
[[ 'a*' == "a*" ]] && printf 'quoted pattern matched the literal star\n'
[[ abc != b* ]] && printf 'pattern did not match, negated\n'
[[ abc == ?b? ]] && printf 'single-character class\n'
[[ abc == [ab]bc ]] && printf 'bracket expression\n'

# An unquoted empty expansion is still one operand here. In `test` it
# disappears and leaves a one-argument command.
empty=
[[ -z $empty ]] && printf 'empty is empty, unquoted and still one word\n'
[[ -n "$empty" ]] || printf 'and is not non-empty\n'
spaced="two words"
[[ $spaced == "two words" ]] && printf 'unquoted operand did not split\n'

# String ordering, which is the collation of LC_ALL=C the harness sets.
[[ a < b ]] && printf 'a sorts before b\n'
[[ B < a ]] && printf 'uppercase sorts first in C\n'
[[ b > a ]] && printf 'and the other way round\n'

# The arithmetic comparisons, which take the same names as test's.
[[ 3 -lt 10 ]] && printf 'numeric less-than is numeric\n'
[[ 3 > 10 ]] && printf 'string greater-than is textual\n'

# && and || inside the brackets are the conditional's own operators, not the
# shell's list operators, and ! negates.
[[ -n x && -z "" ]] && printf 'both\n'
[[ -z x || -n y ]] && printf 'either\n'
[[ ! -z x ]] && printf 'negated\n'
[[ ( -n x || -n y ) && ! -n "" ]] && printf 'grouped\n'

# A file test on something the run made itself, so the answer does not depend
# on what the machine has.
printf 'contents\n' > afile
[[ -e afile ]] && printf 'exists\n'
[[ -f afile ]] && printf 'is a regular file\n'
[[ -d afile ]] || printf 'is not a directory\n'
[[ -s afile ]] && printf 'is not empty\n'
[[ -r afile ]] && printf 'is readable\n'
[[ -e nosuchfile ]] || printf 'and a name nobody made does not exist\n'
rm -f afile

# The exit status of the command itself, which is what makes it usable in a
# list rather than only in an if.
[[ x == x ]]
printf 'status when true: %s\n' "$?"
[[ x == y ]]
printf 'status when false: %s\n' "$?"

# In a while, and in a function's return value.
n=0
while [[ $n -lt 3 ]]; do
  n=$((n + 1))
done
printf 'counted to %s\n' "$n"

isname() { [[ $1 == [a-z]* ]]; }
say isname alpha
say isname 9lives

# -L and -h are the same operator under two names, and they are the only file
# tests that do not follow the link: a symbolic link is what they answer
# about, so one pointing at nothing is -L and is not -e.
#
# core/test.tests asks `test -L`, which is a different question and does not
# reach this one. There the word is an argument to a utility; here it is an
# operator the shell parses, and the two were the last condition operators no
# case anywhere in the tree mentioned (#2293).
printf 'target\n' > pointee
ln -s pointee alive
ln -s nobody-made-this dead
[[ -L alive ]] && printf 'a link is -L\n'
[[ -h alive ]] && printf 'and -h says the same\n'
[[ -L pointee ]] || printf 'the file it points at is not\n'
[[ -h pointee ]] || printf 'under either name\n'
[[ -e alive ]] && printf 'a live link exists, because -e follows it\n'
[[ -f alive ]] && printf 'and is a regular file, for the same reason\n'
[[ -L dead ]] && printf 'a dangling link is still -L\n'
[[ -e dead ]] || printf 'and does not exist\n'
[[ -L nosuchname ]] || printf 'a name nobody made is not a link either\n'
[[ -L alive ]]
printf 'status when a link: %s\n' "$?"
[[ -L pointee ]]
printf 'status when not: %s\n' "$?"
rm -f alive dead pointee
