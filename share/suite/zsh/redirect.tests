#
# The `&>` family, which is where the last three redirection operators no
# case anywhere in the tree mentioned were living (#2293).

# `&>>|` is the first thing this file runs on purpose. It is a syntax error
# in bash, ksh93 and dash, so what those three write for this file is a parse
# diagnostic rather than an answer, and the file is zsh's alone from its
# first line.
setopt noclobber
printf 'kept\n' > f
{ printf 'out\n'; printf 'err\n' >&2; } &>>| f
printf 'append both, clobbering:\n'
cat f

# `&>|` is the same override without the append: one stream file, truncated,
# in a shell that has been told not to truncate.
printf 'gone\n' > g
{ printf 'out\n'; printf 'err\n' >&2; } &>| g
printf 'truncate both, clobbering:\n'
cat g

# `!` is the other spelling of the same override, and zsh takes it in both
# positions.
printf 'gone\n' > h
{ printf 'out\n'; printf 'err\n' >&2; } &>! h
printf 'bang, truncating:\n'
cat h
printf 'kept\n' > i
{ printf 'out\n'; printf 'err\n' >&2; } &>>! i
printf 'bang, appending:\n'
cat i

# Without an override, noclobber refuses the truncating form and lets the
# appending one through.
printf 'kept\n' > j
( { printf 'out\n'; } &> j ) 2> /dev/null
printf 'refused -> %s\n' "$?"
cat j
{ printf 'out\n'; printf 'err\n' >&2; } &>> j
printf 'appended:\n'
cat j
unsetopt noclobber

# `&>` and `&>>` themselves are shared with bash and with nothing else on
# this panel, which is the measurement that keeps them out of ext/: ksh93 and
# dash read `&>` as "run it in the background, then redirect", so the group
# runs detached and the file is left alone.
printf 'first\n' > k
{ printf 'out\n'; printf 'err\n' >&2; } &> k
printf 'both, truncating:\n'
cat k
{ printf 'more\n'; printf 'still\n' >&2; } &>> k
printf 'both, appending:\n'
cat k

# The order the two streams arrive in is the order the commands ran, because
# one descriptor is carrying both.
{ printf '1\n'; printf '2\n' >&2; printf '3\n'; printf '4\n' >&2; } &> m
printf 'interleaved:\n'
cat m

# And the descriptor really is shared rather than duplicated twice: a write
# through 2 lands after a write through 1 that came first.
{ printf 'a' ; printf 'b' >&2; printf 'c'; } &> n
printf 'shared: [%s]\n' "$(cat n)"

# MULTIOS is the option underneath all of it, and it is zsh's alone: a second
# redirection of one descriptor adds a target rather than replacing it, so a
# word written once is written twice.
printf 'teed\n' > p > q
printf 'multios p=[%s] q=[%s]\n' "$(cat p)" "$(cat q)"
( unsetopt multios; printf 'once\n' > p > q )
printf 'without multios p=[%s] q=[%s]\n' "$(cat p)" "$(cat q)"

# --- MULTIOS on the input side ----------------------------------------------
#
# The option above tees a write. It does the same thing to a read, from the
# other direction: two sources for one descriptor are concatenated rather than
# the second replacing the first. bash, ksh93 and dash all feed the command
# only the last source named.
#
# Two here-documents on one command line is the shape that meets a script:
# there is no sensible reason to write it, and a shell that fed both is doing
# something nobody expected.
cat <<A <<B
first
A
second
B

# And the same with a file beside a here-document, in both orders — because a
# shell that replaced rather than concatenated would answer one of them the
# way zsh does by accident.
printf 'from the file\n' > src
cat < src <<C
from the here-document
C
cat <<D < src
from the here-document
D

# Two files, which is the plain form of the same rule.
printf 'second file\n' > src2
cat < src < src2

# And the option really is what does it.
unsetopt multios
cat < src < src2
cat <<E <<F
first
E
second
F
setopt multios

# --- a write to a closed descriptor -----------------------------------------
#
# bash, ksh93 and dash all fail. zsh does not: the write goes nowhere and the
# status is 0, which is the half of the closing pair core/redirect.tests had
# to leave out. Reading a closed descriptor fails here as it does everywhere,
# and that half is in core/.
( printf 'into the void\n' >&- )
printf 'writing to a closed descriptor: %s\n' "$?"
( cat <&- ) 2>/dev/null
printf 'reading one:                    %s\n' "$?"

# --- a brace fan copies the names, not the work ------------------------------
#
# A target whose braces make several names is one word expanded once, and the
# names share what it produced. It is here rather than beside the option above
# because it is the same switch: with MULTIOS off the braces are not expanded
# at all and the target is the one literal name it was written as.
#
# The counts are taken through a **file** rather than off the stream, because
# the two readings produce the same names and differ only in how many times the
# word's own expansions ran — so what has to be counted is the runs, and
# nothing about the wording of anything is being asked here.
rm -f ticks bxz byz
: > {bx,by}$(printf 'tick\n' >> ticks; printf 'z\n')
printf 'target names: %s\n' "$(echo b?z)"
printf 'target runs:  %s\n' "$(wc -l < ticks | tr -d ' ')"

# The same word as an ordinary argument, which is the control that says this
# belongs to the braces and not to the redirection: one run there too.
rm -f ticks
set -- {ax,ay}$(printf 'tick\n' >> ticks; printf 'z\n')
printf 'argument names: %s %s\n' "$1" "$2"
printf 'argument runs:  %s\n' "$(wc -l < ticks | tr -d ' ')"

# And the side effect, which is the half a count cannot be argued with: the
# variable an arithmetic substitution moves is moved once for the word, so
# every name carries the value the first one got.
i=0
set -- {ax,ay,aw}$((i++))
printf 'the values:   %s %s %s\n' "$1" "$2" "$3"
printf 'i afterwards: %s\n' "$i"

# A failure in the word ends the fan, so a word that cannot be computed is one
# diagnostic and not one per name. Counted from a file for the same reason.
( : > {x,y}$(( 1/0 )) ) 2> zz
printf 'a failed fan: %s line\n' "$(wc -l < zz | tr -d ' ')"

# With MULTIOS off the braces are not expanded here at all, so there is one
# name and the word runs once because of that rather than because of sharing.
rm -f ticks
( unsetopt multios; : > {cx,cy}$(printf 'tick\n' >> ticks; printf 'z\n') )
if [ -f '{cx,cy}z' ]; then
	printf 'without multios: one literal name, runs=%s\n' "$(wc -l < ticks | tr -d ' ')"
else
	printf 'without multios: the braces were expanded after all\n'
fi

# --- a subshell's failed redirection target ---------------------------------
#
# `( … )` is a process of its own, so a redirection target that will not
# expand costs the parentheses and not the script: the rest of the *same line*
# runs, `||` catches it, and 1 is left behind. A group with the same target
# ends this shell, which is the control — the difference is the parentheses
# and not a general fatality.
#
# Every row puts its marker after a `;` on the redirection's own line, because
# a marker on the *next* line is printed by a give-up that costs the line as
# well as by one that costs only the command, and cannot tell them apart. The
# rows that end the shell are wrapped in parentheses of their own so the file
# carries on; that wrapper is itself the fact under test one level out, which
# is why the two readings still part (#4695).

sub_zz() { printf -- '--- %s\n' "$1"; }

sub_zz 'a subshell: the rest of its own line runs'
( ( echo RAN ) > $(( 1/0 )) ; echo SAME ) 2>/dev/null
printf 'after st=%s\n' "$?"

sub_zz 'a group: the shell it is in ends'
( { echo RAN; } > $(( 1/0 )) ; echo SAME ) 2>/dev/null
printf 'after st=%s\n' "$?"

sub_zz 'a subshell: || catches it'
( ( echo RAN ) > $(( 1/0 )) || echo CAUGHT ) 2>/dev/null

sub_zz 'a group: || never sees it'
( { echo RAN; } > $(( 1/0 )) || echo CAUGHT ) 2>/dev/null

sub_zz 'a subshell inside a function: the body carries on'
g_zz() { ( echo RAN ) > $(( 1/0 )); printf 'in the function\n'; }
( g_zz ) 2>/dev/null
printf 'after st=%s\n' "$?"

sub_zz 'the write the target made is confined'
unset u_zz
( ( : ) > "${u_zz:=made}" ) 2>/dev/null
printf 'u=[%s]\n' "${u_zz-unset}"

sub_zz 'and a command of its own confines it too'
unset u_zz
( cat /dev/null > "${u_zz:=made}" ) 2>/dev/null
printf 'u=[%s]\n' "${u_zz-unset}"

sub_zz 'while a group keeps it'
unset u_zz
{ : ; } > "${u_zz:=made}"
printf 'u=[%s]\n' "${u_zz-unset}"
