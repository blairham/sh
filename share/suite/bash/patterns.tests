#
# Matching, the answer only bash gives.
#
# bash's regular-expression operator fills BASH_REMATCH, and the pattern
# options it has are `shopt` names rather than `setopt` names or nothing at
# all. The sub-patterns themselves are ext/ — every shell in the ksh family
# has them — but reaching them through `shopt -s extglob` is bash's alone.
#
# This is the one file in the suite that `parsed` scores against, and the
# reason is in internal/suite/score.go rather than in this shell: an option
# set at run time decides what a later line means, so `shopt -s extglob`
# followed by `@(a|b)` cannot be read by any static pass. bash's own `bash -n`
# refuses this file too. The column reports 23/24 parsed and 24/24 strict, and
# that gap is the measurement working rather than a defect to chase.
#
# Every fixture here is made by the file and named in lower case on purpose:
# a glob's matches are sorted, bash sorts them by the locale's collation and
# this shell sorts them by byte (#1675), so a case-mixed directory would
# measure that open divergence rather than what these lines are about.

# =~ matches an extended regular expression and leaves the whole match in
# BASH_REMATCH[0] with the groups after it.
if [[ abc123 =~ ^([a-z]+)([0-9]+)$ ]]; then
  printf 'whole: %s\n' "${BASH_REMATCH[0]}"
  printf 'one:   %s\n' "${BASH_REMATCH[1]}"
  printf 'two:   %s\n' "${BASH_REMATCH[2]}"
  printf 'groups: %s\n' "${#BASH_REMATCH[@]}"
fi

# A failed match leaves a status and no capture.
[[ abc =~ ^[0-9]+$ ]]
printf 'no match: %s\n' "$?"

# A quoted right-hand side is a literal string rather than a pattern, which
# is the rule that makes a regexp in a variable work and a quoted one not.
re='^a.c$'
[[ abc =~ $re ]] && printf 'unquoted variable is a pattern\n'
[[ abc =~ "$re" ]] || printf 'quoted variable is a literal\n'

# nocasematch takes the case out of a pattern match, and only while it is
# set. It reaches the regexp operator as well as the pattern one, and reaches
# the whole regexp rather than its literal letters: a bracket expression and
# a character class fold with them, and the fold happens before a negated
# class is complemented, so `[^a]` stops matching `A` too.
shopt -s nocasematch
[[ ABC == abc ]] && printf 'nocasematch: == ignores case\n'
[[ ABC =~ ^abc$ ]] && printf 'nocasematch: =~ ignores case\n'
[[ ABC =~ ^[[:lower:]]+$ ]] && printf 'nocasematch: =~ folds a character class\n'
[[ A =~ ^[^a]$ ]] || printf 'nocasematch: =~ folds before it negates\n'
shopt -u nocasematch
[[ ABC == abc ]] || printf 'and it is off again\n'
[[ ABC =~ ^abc$ ]] || printf 'and so is the regexp half\n'

# extglob is what turns the five sub-patterns on. They stay on for the rest
# of the file: turning the option off while a later line still spells one
# would be a parse error rather than a non-match.
shopt -s extglob
case abc in
  @(abc|xyz)) printf 'extglob: @()\n' ;;
esac
[[ abcabc == +(abc) ]] && printf 'extglob: +()\n'
[[ ac == a?(b)c ]] && printf 'extglob: ?()\n'
[[ axd == a!(b)d ]] && printf 'extglob: !()\n'
[[ ac == a*(b)c ]] && printf 'extglob: *()\n'

# The glob options, measured on fixtures this file makes.
mkdir -p g/one/two
: > g/one/a.txt
: > g/one/two/b.txt

# globstar makes ** cross directories, and without it ** is one *.
shopt -s globstar
printf '%s\n' g/**/*.txt
shopt -u globstar
printf '%s\n' g/**/*.txt

# nullglob removes a pattern that matched nothing; without it the pattern is
# the word.
shopt -s nullglob
printf 'nullglob: [%s]\n' g/nosuch*
shopt -u nullglob
printf 'without it: [%s]\n' g/nosuch*

# failglob is the third answer about a miss, and neither of the other two:
# the word is not kept and it is not deleted, the statement it was in does
# not run, and the shell goes on to the next line. The refusal wins over
# nullglob where both are set, which is the opposite of the order zsh keeps
# between the same two behaviors.
#
# The lines are separate on purpose. What the refusal gives up here is the
# statement, so a `printf` written after a semicolon on the same line would be
# dropped with it — measured, and the reason the next line is what proves the
# shell carried on.
shopt -s failglob
printf 'failglob: [%s]\n' g/nosuch*
printf 'the next line still runs\n'
shopt -s nullglob
printf 'and with nullglob too: [%s]\n' g/nosuch*
shopt -u nullglob failglob

# dotglob brings the leading-dot names into an ordinary pattern.
: > g/.hidden
printf 'plain: [%s]\n' g/*
shopt -s dotglob
printf 'dotglob: [%s]\n' g/*
shopt -u dotglob

# nocaseglob matches a name whose case does not agree.
shopt -s nocaseglob
printf 'nocaseglob: %s\n' g/ONE
shopt -u nocaseglob

# GLOBIGNORE is not an option but a parameter, and its patterns take names
# back out of what a pathname expansion produced. The assignment does two
# things at once: the pattern removes a name and the non-null value brings
# the hidden ones in, which is why `g/.hidden` arrives on the line that takes
# `g/one` away.
#
# The fixture above is what makes each line discriminate. `g/.hidden` is
# there so the reveal is visible; `g/one` is a directory so a pattern with no
# separator in it has something with one to fail to reach; and the last line
# leaves the parameter unset rather than null, because those are different
# states — an assignment of nothing leaves the hidden names on.
GLOBIGNORE='g/one'
printf 'ignore: [%s]\n' g/*
GLOBIGNORE='g/one:g/.hidden'
printf 'list: [%s]\n' g/*
GLOBIGNORE='g/one:'
printf 'empty element: [%s]\n' g/*
GLOBIGNORE='*one'
printf 'separator: [%s]\n' g/*
GLOBIGNORE='g/*'
printf 'all ignored: [%s]\n' g/*
unset GLOBIGNORE
printf 'unset: [%s]\n' g/*

rm -rf g
