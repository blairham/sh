#
# The here-string in dash, which has none — the ext/ area dash is the
# holdout on, asked of dash.
#
# `<<<` is refused while the line is read, with the redirection sentence,
# wherever it is written — including inside an `if` that is never taken.
#
# Every refusal is asked through `eval` in a subshell, so a script that
# reaches one goes on to the next row and the file's own parse is not what is
# being graded. The rows that print `ran` or `after` ask whether the refusal
# is made while reading or while running.
#
# Measured 2026-09-16: Apple's dash-16 on macOS and Ubuntu 24.04's dash answer
# every row alike, and bash, zsh and ksh93 each answer the file differently.

try() {
	( eval "$1" ) 2>&1
	printf '  -> %s\n' "$?"
}

printf -- '--- refused wherever it is written ---\n'
try 'cat <<< word'
try 'cat <<<word'
try 'read -r x <<< one; printf "%s\n" "$x"'
try '{ cat; } <<< word'
try 'printf "ran\n"; cat <<< word'
try 'if false; then cat <<< word; fi; printf "after\n"'
try 'cat << <'
printf -- '--- the here-document it falls back to ---\n'
read -r x <<END
one two
END
printf '[%s]\n' "$x"
