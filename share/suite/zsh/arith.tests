#
# Arithmetic, the answer only zsh gives.
#
# This is not a file of constructs the others lack. Every line below is an
# expression all four shells parse and evaluate, and zsh returns a different
# number for it — which makes it the more dangerous kind of divergence, since
# a script written against bash or ksh93 runs here and gets an answer rather
# than a diagnostic.
#
# core/arith.tests holds the operators the panel agrees about, and says on
# each omission why it is not there. This is where those omissions went.

# --- the shifts bind tighter than the arithmetic ------------------------------
#
# In C, and in bash, ksh93 and dash, `<<` and `>>` are below `+` and `*`.
# In zsh they are above both, so the shift happens first.
printf '%s\n' "shift against a sum on the right: $(( 1 << 2 + 1 ))"
printf '%s\n' "shift against a sum on the left:  $(( 1 + 2 << 1 ))"
printf '%s\n' "shift against a product:          $(( 1 << 2 * 2 ))"
printf '%s\n' "the other direction:              $(( 16 >> 1 + 1 ))"
printf '%s\n' "and against a product:            $(( 8 >> 1 * 2 ))"

# The control, so the lines above are read as precedence rather than as a
# shift that is simply wrong: parenthesised, every shell agrees.
printf '%s\n' "parenthesised the C way: $(( 1 << (2 + 1) )) $(( (1 + 2) << 1 ))"

# --- and the bitwise operators bind tighter than the comparisons -------------
#
# The same reordering one level down: `&` is above `<` here and below it
# everywhere else, so `1 < 2 & 1` is `1 < (2 & 1)` and comes out false.
printf '%s\n' "and against a comparison: $(( 1 < 2 & 1 ))"
printf '%s\n' "parenthesised:            $(( (1 < 2) & 1 ))"

# --- and the option that puts C's order back ---------------------------------
#
# `c_precedences` is zsh's own name for the rest of the panel's answer, which
# is the strongest evidence that the order above is a decision and not an
# accident. Every number here is the one bash, ksh93 and dash print.
setopt c_precedences
printf '%s\n' "with c_precedences: $(( 1 << 2 + 1 )) $(( 1 + 2 << 1 )) $(( 1 << 2 * 2 ))"
printf '%s\n' "and the comparison: $(( 1 < 2 & 1 ))"
unsetopt c_precedences
printf '%s\n' "and back again: $(( 1 << 2 + 1 )) $(( 1 < 2 & 1 ))"

# --- a leading zero is not octal ---------------------------------------------
#
# `010` is eight in bash, ksh93 and dash and ten here. `0x` is hexadecimal in
# every column including this one, so the divergence is about the bare zero
# rather than about prefixes in general.
printf '%s\n' "leading zero: $(( 010 )) $(( 0100 )) $(( 08 + 1 ))"
printf '%s\n' "hexadecimal is still hexadecimal: $(( 0x10 ))"

# And the option for that one too, which is the same shape of evidence.
setopt octal_zeroes
printf '%s\n' "with octal_zeroes: $(( 010 )) $(( 0100 ))"
unsetopt octal_zeroes
printf '%s\n' "and back again: $(( 010 ))"

# --- a numeral past the machine word ------------------------------------------
#
# All four shells answer one and all four answer differently: bash lets the
# unsigned word go round, dash clamps at the largest signed value, ksh93 has
# no word to overflow and gives the double, and zsh reads part of the numeral
# and says how much it read. So the numbers below are this column's alone
# (#3202).
#
# The rule is not "the digits that fit". The accumulator is unsigned and it
# wraps: reading stops only when a digit fails to make the running value
# larger, and where the digits run out with the value merely past the signed
# word the last one comes off by dividing what it has. Three of the rows below
# separate those two readings and the first two do not, which is why they are
# here together.
printf '%s\n' "one past the word:        $(( 10000000000000000000 ))"
printf '%s\n' "at the unsigned maximum:  $(( 18446744073709551615 ))"
printf '%s\n' "one past that:            $(( 18446744073709551616 ))"
printf '%s\n' "several words past:       $(( 99999999999999999999999 ))"
printf '%s\n' "divided rather than cut:  $(( 50000000000000000000 ))"
printf '%s\n' "read whole and silently:  $(( 22222222222222222222 ))"
printf '%s\n' "hexadecimal:              $(( 0xffffffffffffffffff ))"
printf '%s\n' "out of a variable:        $( n=10000000000000000000; printf '%s' $(( n )) 2>/dev/null )"

# And what it says while doing it, which no other column says at all. Stdout
# is dropped so that what is compared is the diagnostic: the count of digits
# it got through, and the expression from the numeral to the end of it —
# the blank before the `))` included.
( : $(( 9999999999999999999 )) ) 2>&1 > /dev/null
( : $((9999999999999999999 + 1)) ) 2>&1 > /dev/null
( : $(( 0xfffffffffffffffff )) ) 2>&1 > /dev/null

# The control: a numeral the word holds is answered with nothing said, so the
# lines above are read as the size of the numeral rather than as this shell
# complaining about arithmetic in general.
( printf '%s\n' "the largest that fits: $(( 9223372036854775807 ))" ) 2>&1

# `set -u` reaching an expression is refused here as it is in bash and ksh93,
# but the refusal is the *expression's* failure rather than the shell's — so
# the construct holding it answers. Measured 2026-09-18 against zsh 5.9.2 with
# `b` unset: the arithmetic command leaves 2 and the line runs on, an `||`
# catches it, `let` leaves 1 and runs on, and the same refusal inside a word
# expansion stops the shell as any failed expression there does (#3574).
( set -u; (( b )); printf 'an arithmetic command: %s\n' "$?" ) 2>/dev/null
( set -u; (( b )) || printf 'and an || catches it\n' ) 2>/dev/null
( set -u; let "x = b"; printf 'a let operand: %s\n' "$?" ) 2>/dev/null
( set -u; x=$(( b )); printf 'ran on\n' ) 2>/dev/null
printf 'a word expansion: %s\n' "$?"
