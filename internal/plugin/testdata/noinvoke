#!/bin/sh
# Declares a command and then answers method-not-found to it. An advertised
# capability is not a working method: the host must degrade on the answer.
while IFS= read -r line; do
	id=$(printf '%s' "$line" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')
	case $line in
	*'"method":"initialize"'*)
		printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"protocolVersion\":1,\"name\":\"noinvoke\",\"commands\":[\"ghost\"]}}"
		;;
	*'"method":"command/invoke"'*)
		printf '%s\n' "{\"jsonrpc\":\"2.0\",\"id\":$id,\"error\":{\"code\":-32601,\"message\":\"no such method\"}}"
		;;
	esac
done
