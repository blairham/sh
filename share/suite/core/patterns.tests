#
# Pattern matching notation, POSIX XCU 2.13, asked where it is a pure
# function of the pattern and the string: `case` and the prefix/suffix
# expansions. Filename generation is asked separately, because it also
# depends on what is on the disk.
#
# The helper is called `emit` and not `r`: ksh93 predefines `r` as an alias
# for its history editor, an alias beats a function of the same name, and the
# whole file ran as history commands. Measured, and the reason a case file
# avoids the words ksh aliases — r, type, hash, integer, float, source.
#
# Every pattern here is written literally in the `case` rather than passed in
# through a variable. Measured: an unquoted expansion in a pattern position is
# a pattern in bash, ksh93 and dash, and is *literal* in zsh, which quotes the
# result of a parameter expansion unless asked not to. That is a real
# divergence and it belongs in the dialect files; writing the helper the
# convenient way would have hidden it behind one of its own.

emit() { printf '%s\n' "$1"; }

case abc in *) emit 'star abc: yes' ;; *) emit 'star abc: no' ;; esac
case '' in *) emit 'star empty: yes' ;; *) emit 'star empty: no' ;; esac
case abc in a*) emit 'a-star abc: yes' ;; *) emit 'a-star abc: no' ;; esac
case abc in *c) emit 'star-c abc: yes' ;; *) emit 'star-c abc: no' ;; esac
case abc in a*c) emit 'a-star-c abc: yes' ;; *) emit 'a-star-c abc: no' ;; esac
case ac in a*c) emit 'a-star-c ac: yes' ;; *) emit 'a-star-c ac: no' ;; esac
case a in ?) emit 'question a: yes' ;; *) emit 'question a: no' ;; esac
case ab in ?) emit 'question ab: yes' ;; *) emit 'question ab: no' ;; esac
case abc in ???) emit 'three abc: yes' ;; *) emit 'three abc: no' ;; esac
case abc in a?c) emit 'a-q-c abc: yes' ;; *) emit 'a-q-c abc: no' ;; esac
case b in [abc]) emit 'set b: yes' ;; *) emit 'set b: no' ;; esac
case d in [abc]) emit 'set d: yes' ;; *) emit 'set d: no' ;; esac
case b in [a-c]) emit 'range b: yes' ;; *) emit 'range b: no' ;; esac
case d in [a-c]) emit 'range d: yes' ;; *) emit 'range d: no' ;; esac
case d in [!abc]) emit 'negated d: yes' ;; *) emit 'negated d: no' ;; esac
case a in [!abc]) emit 'negated a: yes' ;; *) emit 'negated a: no' ;; esac
case a5z in a[0-9]z) emit 'digit a5z: yes' ;; *) emit 'digit a5z: no' ;; esac
case aXz in a[0-9]z) emit 'digit aXz: yes' ;; *) emit 'digit aXz: no' ;; esac
case ']' in []]) emit 'bracket-first: yes' ;; *) emit 'bracket-first: no' ;; esac
case - in [-a]) emit 'dash-first: yes' ;; *) emit 'dash-first: no' ;; esac
case 'a*c' in a\*c) emit 'escaped star: yes' ;; *) emit 'escaped star: no' ;; esac
case abc in a\*c) emit 'escaped star abc: yes' ;; *) emit 'escaped star abc: no' ;; esac
case notes.txt in *.txt) emit 'suffix: yes' ;; *) emit 'suffix: no' ;; esac
case notes.txtx in *.txt) emit 'suffix extra: yes' ;; *) emit 'suffix extra: no' ;; esac
case .hidden in .*) emit 'leading dot: yes' ;; *) emit 'leading dot: no' ;; esac
case .hidden in *) emit 'star sees dot: yes' ;; *) emit 'star sees dot: no' ;; esac

# A slash is not special to these operators; only filename generation treats
# it as a separator.
case a/b in */*) emit 'slash: yes' ;; *) emit 'slash: no' ;; esac
case a/c in a?c) emit 'question over slash: yes' ;; *) emit 'question over slash: no' ;; esac

# A quoted expansion in a pattern position is literal in every shell.
p='a*'
case abc in
"$p") emit 'quoted pattern: matched' ;;
*) emit 'quoted pattern: literal' ;;
esac

# Alternation, and the case a shell reaches when none of them matched.
case beta in alpha | beta | gamma) emit 'alternation: yes' ;; *) emit 'alternation: no' ;; esac
case delta in alpha | beta | gamma) emit 'alternation other: yes' ;; *) emit 'alternation other: no' ;; esac

# The same notation in prefix and suffix removal.
s=aXbXc
printf '%s\n' "shortest#=${s#*X} longest##=${s##*X}"
printf '%s\n' "shortest%=${s%X*} longest%%=${s%%X*}"
printf '%s\n' "class=${s#a[WX]}"
printf '%s\n' "question=${s#?}"
printf '%s\n' "star-empty=[${s#*}] [${s##*}]"
printf '%s\n' "anchored=${s#X} unanchored=${s#*X}"

# [^...] is deliberately absent. Measured, bash, ksh93 and zsh read it as a
# negation and dash does not, so it is a dialect answer rather than a core one.
