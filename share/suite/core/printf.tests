#
# printf — the conversions, the escapes and the format reuse POSIX XCU gives
# it, asked of printf itself rather than leaned on.
#
# Every other file in this suite emits with printf and none of them measures
# it. That is the same shape as a shell matrix listing a construct as common
# because it is used everywhere: a mention is not a measurement, and the most
# exercised builtin here was until now the least graded one.
#
# What is asked is the agreed ground only. printf is where the shells part
# more than almost anywhere else — an unknown escape, a leading zero in a
# numeric operand, `%q`, `\xHH` and the rounding of a half all split the
# panel — and each of those is asked in the file of the shell that answers it
# alone.

# A format with no conversion is written out as it stands.
printf 'plain\n'
printf 'no newline'; printf '\n'

# %s writes the operand. An absent operand is the empty string, not an error.
printf '%s\n' one
printf '%s %s\n' one two
printf 'a%sb\n' ''
printf '%s\n'
printf 'missing:[%s][%s]\n' only

# The integer conversions, in the bases POSIX names for them.
printf '%d\n' 0
printf '%d\n' 1
printf '%d\n' -1
printf '%d\n' 42
printf '%i\n' 7
printf '%o %o\n' 8 64
printf '%x %X\n' 255 255
printf '%u\n' 7
printf '%d\n' +5

# A numeric operand may come from a variable or a substitution; it is the
# same operand either way.
v=9
printf '%d\n' "$v"
printf '%d\n' "$(printf '11')"

# A leading single quote makes the operand the value of the character after
# it, which is the one place printf reads a letter as a number.
printf "%d\n" "'A"
printf "%d\n" "'0"

# %c writes the first character of the operand and nothing else of it. An
# operand with no character in it — empty, or absent — is one NUL byte, and
# the two spellings of "no character" are the same answer. A NUL shows as
# nothing on a terminal, so those lines are read as bytes; the field is read
# in hex as well, because `tr -s` would squeeze away the padding that is half
# of what the last line asks.
printf '%c\n' abc
printf '[%c]' '' | od -An -tx1 | tr -s ' '
printf '[%c]' | od -An -tx1 | tr -s ' '
printf '[%c]' a '' b | od -An -tx1 | tr -s ' '
printf '[%3c][%-3c]' '' '' | od -An -tx1 | tr -s ' '

# %% is a literal percent and consumes no operand.
printf '%% %s\n' after

# Field width, left adjustment, precision, zero padding and the sign flags —
# the same flags the C function has, on both the string and the integer
# conversions.
printf '[%5s]\n' hi
printf '[%-5s]\n' hi
printf '[%.2s]\n' hello
printf '[%5.3s]\n' abcdefg
printf '[%5d]\n' 42
printf '[%-5d]\n' 42
printf '[%05d]\n' 42
printf '[%.3d]\n' 5
printf '[%+d]\n' 42
printf '[% d]\n' 42
printf '[%3c]\n' x

# A star takes the width or the precision from the operand list, ahead of the
# value being converted, and a negative width taken that way is a left
# adjustment rather than an error — which is how a star differs from writing
# the digits out.
printf '[%*d]\n' 5 42
printf '[%-*d]\n' 5 42
printf '[%.*s]\n' 3 abcdef
printf '[%*.*f]\n' 8 2 3.14159
printf '[%*d]\n' -5 42
printf '[%*s|%*s]\n' 4 a 6 b

# The floating conversions round and format as C does, except at a half —
# which is asked of ksh93 alone, because ksh93 alone rounds it upward.
printf '[%5.2f]\n' 3.14159
printf '[%e]\n' 1500
printf '[%g]\n' 0.0001

# %g defaults to six significant digits, which is C's number and not the
# shortest representation that round-trips. 999999.5 needs both halves of the
# conversion at once: six digits round it to 1000000 and the trailing zeros
# are then stripped to 1e+06. The three after it agree whatever the default
# is, and are here so that rounding to six decimal places fails them.
printf '[%g]\n' 1234567
printf '[%g]\n' 999999.5
printf '[%g]\n' 0.1
printf '[%g]\n' 100000
printf '[%g]\n' 1000000
printf '[%G]\n' 123456789
printf '[%.10g]\n' 123456789

# Escapes in the format string. The control characters are written out so the
# bytes are visible rather than the terminal's reading of them.
printf 'tab:\tafter\n'
printf 'backslash:\\\n'
printf 'octal:\101\102\n'
printf 'controls:\a\b\f\v\n' | od -An -c | tr -s ' '

# %b processes the escapes of its operand, which plain %s does not.
printf '[%b]\n' 'x\ty'
printf '[%b]\n' 'a\nb'
printf '[%s]\n' 'a\nb'
printf '[%b]\n' '\0101\0102'
printf '[%b%b]\n' a b

# \c in a %b operand ends the output of that printf, including the rest of
# the format; a later printf is unaffected.
printf '[%b' 'x\c'
printf 'and this is a separate command]\n'

# The format is reused until the operands run out, and a final pass with
# fewer operands than conversions fills the rest in as empty.
#
# A *numeric* conversion left without an operand fills in as a zero. The four
# references here write it silently and BusyBox writes it with a complaint, so
# the diagnostics go to /dev/null and the rows ask the value and the reuse.
printf '%d-%d\n' 1 2 3 2> /dev/null
printf '[%s][%d]\n' a 2> /dev/null
printf '%s=%s\n' a 1 b 2
printf '%s|%s|%s|\n' a b c d e f
printf '%s-%s;' a b c d e; printf '\n'

# A format with no conversion at all is written once however many operands
# follow it, because reuse is driven by operands being consumed.
printf 'once\n' a b c

# `--` ends the options, so a leading dash in the format or in an operand is
# an operand rather than a flag.
printf -- '%s\n' dashdash
printf '%s\n' -n

# Command substitution strips the trailing newlines of what printf wrote, so
# a value carried through one is the text without them.
printf '[%s]\n' "$(printf 'z\n\n\n')"

# An operand is passed whole. Field splitting happened before printf saw it,
# and a quoted operand keeps its spaces, its newline and its asterisk.
printf '[%s]\n' '  spaced  '
printf '[%s]\n' '*'
printf '[%s]\n' 'a
b'

# The flags on the numeric conversions, and the combinations of them that a
# script reaches for when it is laying out a column.
printf '[%#o][%#x][%#X]\n' 8 255 255
printf '[%08.3f][%-8.3f|]\n' 3.14159 3.14159
printf '[%5.2s|][%-5.2s|]\n' abcdef abcdef
printf '[%c%c]\n' ab cd
printf '[%d]\n' 9223372036854775807

# A numeric operand in C's hexadecimal spelling is read as one. The leading
# *zero* is not common ground and is a note rather than a case: `printf '%d'
# 010` is 8 in bash and dash, which read it as octal, and 10 in zsh and
# ksh93, which do not.
printf '[%d][%d]\n' 0x10 0xff

# An unsigned conversion writes the operand's bit pattern, and the width is
# the shell's own integer and not C's: `printf '%x' -1` in C is `ffffffff`
# and in all four of these shells it is sixty-four bits of it (#2902).
printf '[%x][%X][%o][%u]\n' -1 -1 -1 -1
printf '[%x][%o][%u]\n' -255 -8 -5

# The flags go through the bit pattern the same way a positive operand's
# digits do — except the two that name a sign, which an unsigned conversion
# has none of and every reference ignores.
#
# The extremes are notes rather than cases, because what parts the columns
# there is the *reading* of the operand and not the conversion. `printf '%x'
# -9223372036854775808` is `8000000000000000` in bash, ksh93 and dash, and in
# zsh the operand does not survive being read: `number truncated after 18
# digits`. An operand that overflows splits three ways again — bash and dash
# saturate unsigned, ksh93 signed, zsh keeps nineteen digits of it.
printf '[%#x][%#o][%.20x]\n' -1 -8 -1
printf '[%20x][%-20x]\n' -1 -1
printf '[%+x][% x][%+u]\n' -1 -1 -1
printf '[%+x][% x][%+u]\n' 255 255 5

# The signed conversions keep the sign, which is the whole of what parts
# them from the four above.
printf '[%d][%i]\n' -1 -255

# What a failure does. The statuses split — dash says 2 where the other three
# say 1 — so what is printed is whether it failed, and the output written
# before the failure, which every shell writes. A format ending in a bare `%`
# is not here: ksh93 writes the percent out and succeeds where the other
# three stop, and it is asked in ksh/.
( printf 'an undefined conversion [%y]' ) 2> /dev/null
printf ' -> %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"
( printf ) 2> /dev/null
printf 'no format at all -> %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"

# A numeric conversion given something that is not a number writes the zero
# it could not make and carries on. Whether it also complains is not common
# ground — bash and dash do, zsh and ksh93 do not — so the complaint is taken
# off the stream and only the value is read.
printf '[%d]\n' abc 2> /dev/null
printf '[%f]\n' abc 2> /dev/null
printf '[%d]\n' ' 7' 2> /dev/null

# `--` ends printf's own options. `%q` is not asked here at all: bash and zsh
# quote `a b` as `a\ b`, ksh93 as `'a b'` with `$'…'` where a quote is inside
# it, and dash has no `%q`, so the conversion has three answers among four
# shells. `\xHH` in the format is the same shape one step smaller — bash, zsh
# and ksh93 write the byte, dash writes the backslash out — and both are
# asked in the files of the shells that are alone.
#
# `%b`'s escapes are not common ground either, and split differently again:
# `\x41` is a byte in bash and zsh and eight characters in ksh93 and dash,
# while `\101` is the byte in bash and dash and the characters in zsh and
# ksh93. `\0101` is the one spelling all four agree on, which is why it is
# the one asked above.
printf -- '%s\n' 'after the dashdash'

# A sign flag survives a precision of nought. C says a precision of 0 with a
# value of 0 produces no digits, and says separately that `+` and the space
# flag write a sign for a signed conversion; both hold at once, so what comes
# out is one character rather than none. Every shell here agrees, which is
# what puts it in this file rather than in one of the dialects'.
printf 'a plus [%+.0d]\n' 0
printf 'a space [% .0d]\n' 0
printf 'a bare point [%+.d]\n' 0

# No flag, so there is nothing left to write. This is the control that makes
# the three lines above about the *sign* rather than about the erasure.
printf 'no flag [%.0d]\n' 0

# The sign goes through the field like any other one-character text, and the
# `-` flag moves it to the left. `%+05.0d` is deliberately not here: the `0`
# flag is ignored where an integer conversion states a precision in every
# shell but ksh93, which pads with zeros whatever the precision said, so the
# spelling belongs in a dialect's file and not in this one.
printf 'padded [%+5.0d]\n' 0
printf 'to the left [%-+5.0d]\n' 0
printf 'a space padded [% 5.0d]\n' 0

# The controls that the erasure does not reach: a nonzero value, a precision
# that leaves digits, and a float conversion, whose precision is places after
# the point rather than a minimum count of digits.
printf 'a nonzero value [%+.0d]\n' 7
printf 'digits left [%+.3d]\n' 0
printf 'a float [%+.0f]\n' 0

# Where a `0` fill meets an alternate form and every shell still agrees. C
# counts the `0x` against the width and ksh93 does not, which is a dialect's
# row — but four spellings around it are unanimous, and they are what keeps
# that reading from being taken more widely than it goes.
#
# An octal's alternate form is a leading `0` that is itself a fill character,
# so nothing can tell the two readings apart there.
printf 'an octal [%#06o] [%#05o]\n' 255 8

# A *space* fill goes in front of the whole field everywhere, so the reading
# is the `0` flag's and not the width's; and `-` voids a zero fill outright,
# which C says and every shell here does.
printf 'a space fill [%#8x] and left-justified [%#-08x]\n' 7 7

# A sign is counted in the width by every shell, ksh93 included, which is
# what makes the divergence the prefix's rather than the fill's.
printf 'a sign [%05d] [%+05d] [% 05d]\n' -42 42 42

# And a width the digits already reach leaves no fill to place at all.
printf 'nothing to fill [%#03x] and no alternate form [%08x]\n' 4095 255
