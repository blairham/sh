#
# Redirection, the answer only bash gives: a descriptor number wider than one
# digit.
#
# `10> file` is a redirection here and is two tokens everywhere else — the
# word `10` followed by `>` — so zsh, ksh93 and dash run a command called `10`
# and redirect its output. That is the dangerous shape: the line parses in all
# four shells and means something completely different in three of them.
#
# The neighbouring construct is `exec {name}> file`, which bash, zsh and ksh93
# all have and which exists precisely because a hand-written number is a
# shared namespace with no registry. It is share/suite/ext/redirect.tests. The
# two together are the whole answer to "how do I get a descriptor above 9":
# one shell lets you write the number, three make you ask for one.

exec 10> wide
printf 'through descriptor ten\n' >&10
exec 10>&-
printf 'ten: [%s]\n' "$(cat wide)"

exec 11< wide
IFS= read -r line <&11
exec 11<&-
printf 'eleven, reading: [%s]\n' "$line"

# Three digits is no different from two: the width is not the question, only
# whether the shell reads the digits as a number at all.
exec 200> wider
printf 'through descriptor two hundred\n' >&200
exec 200>&-
printf 'two hundred: [%s]\n' "$(cat wider)"

# And on a simple command rather than on `exec`, which is where a script
# actually writes one.
{ printf 'scoped\n' >&12; } 12> scoped
printf 'on a command: [%s]\n' "$(cat scoped)"
{ cat <&13; } 13< scoped

# Duplication and closing take the wide number too.
exec 14> dup14
exec 15>&14
printf 'through the duplicate\n' >&15
exec 15>&-
exec 14>&-
printf 'duplicated: [%s]\n' "$(cat dup14)"

# The append and read-write forms, for the same reason the core file asks
# every operator once: a shell that read only `>` wide would pass a file that
# asked only that.
exec 16>> dup14
printf 'appended\n' >&16
exec 16>&-
printf 'appended: [%s]\n' "$(cat dup14 | tr '\n' '-')"

# --- a target whose expansion failed is one diagnostic ----------------------
#
# `ambiguous redirect` is this shell's alone, and it is a complaint about *how
# many words* the target came to. A word that could not be computed never got
# a count, so what a script is told is the failure's own sentence and nothing
# after it. Every row is a subshell with stdout dropped, because two of the
# failure kinds end the shell they happen in (#4688).
#
# The rows that *do* say it are here beside the rows that do not, since a file
# asking only the quiet half would pass for a shell that had gone silent.

say() { printf -- '--- %s\n' "$1"; }

say 'a target whose arithmetic failed'
( : > $(( 1/0 )) ) 2>&1 > /dev/null

say 'a target whose parameter had a word of its own'
( : > ${qq_zz?bad} ) 2>&1 > /dev/null

say 'a target that is an unset name under -u'
( set -u; : > $NOPE_ZZ ) 2>&1 > /dev/null

say 'a target that came to no words, with nothing failing'
( e=; : > $e ) 2>&1 > /dev/null

say 'a target that came to several words, with nothing failing'
( e="a b"; : > $e ) 2>&1 > /dev/null

say 'several words and a failure on the way to them'
( e="a b"; : > $e$(( 1/0 )) ) 2>&1 > /dev/null

say 'braces making several words, with nothing failing'
( : > {x_zz,y_zz} ) 2>&1 > /dev/null

# And the reach beside the wording, on the redirection's own line: the command
# does not run, the rest of the line goes with the failure, and the next line
# reads 1.
say 'the reach'
( echo RAN > $(( 1/0 )); echo SAME ); echo "after st=$?"

# --- a subshell's failed redirection target ---------------------------------
#
# This column reads "already right" on the coarse question — the script is
# alive on the next line either way — and it was not. `( … )` is a process of
# its own here, so a target that will not expand costs the parentheses: the
# rest of the *same line* runs and `||` catches it, where a group with the
# same target gives up the line and `||` never sees it.
#
# So `||` is a column of its own rather than a restatement of the reach, and
# the marker goes after a `;` on the redirection's own line: one on the next
# line is printed by both readings (#4695).

sub_zz() { printf -- '--- %s\n' "$1"; }

sub_zz 'a subshell: the rest of its own line runs'
( ( echo RAN ) > $(( 1/0 )) ; echo SAME ) 2>/dev/null
printf 'after st=%s\n' "$?"

sub_zz 'a group: the rest of its line is given up'
( { echo RAN; } > $(( 1/0 )) ; echo SAME ) 2>/dev/null
printf 'after st=%s\n' "$?"

sub_zz 'a subshell: || catches it'
( ( echo RAN ) > $(( 1/0 )) || echo CAUGHT ) 2>/dev/null

sub_zz 'a group: || never sees it'
( { echo RAN; } > $(( 1/0 )) || echo CAUGHT ) 2>/dev/null

sub_zz 'a subshell inside a function: the body carries on'
g_zz() { ( echo RAN ) > $(( 1/0 )); printf 'in the function\n'; }
( g_zz ) 2>/dev/null
printf 'after st=%s\n' "$?"

sub_zz 'the write the target made is confined'
unset u_zz
( ( : ) > "${u_zz:=made}" ) 2>/dev/null
printf 'u=[%s]\n' "${u_zz-unset}"

sub_zz 'while a group keeps it'
unset u_zz
{ : ; } > "${u_zz:=made}"
printf 'u=[%s]\n' "${u_zz-unset}"
