#
# Two answers about `set` that are zsh's alone, and both are silent.
#
# A letter no shell has is a usage error in bash, ksh93 and dash. zsh takes
# it: `set -Q` is status 0 and no diagnostic, because zsh reads a single
# letter it does not know as a no-op rather than as a mistake. So the
# portability trap is the quiet one — a script written for zsh with a typo in
# a `set` line runs there and fails everywhere else.
#
# And `$-` does not gain `f` when globbing is turned off, because in zsh the
# letter for noglob is `-F` and `-f` is something else entirely
# (zsh/options.tests asks that pair). `set -o noglob` works here as it does
# in every shell; it is the letter the option reports itself under that
# differs.

has() { case $- in *"$1"*) printf '%s: yes\n' "$2";; *) printf '%s: no\n' "$2";; esac; }
( set -o noglob; has f 'f after set -o noglob' )
( set -o noglob; printf '[%s]' /dev/nul*; printf '\n' )
( set -C; has C 'C after set -C' )

( set -Q ) 2> /dev/null
printf 'an unknown letter -> %s\n' "$?"
( set -Q; printf 'and the shell carried on\n' ) 2> /dev/null
( set -o nosuchoption_zz ) 2> /dev/null
printf 'an unknown long name -> %s\n' "$?"

# ---- and a `--word` at the builtin is swallowed whole ----
#
# The command line takes every option name as a `--name` word here (see
# zsh/invocation.tests), and the builtin does not take it at all — it is
# neither applied, nor refused, nor left to become a positional parameter.
# ksh93, the other shell with the spelling, reads it as the name and applies
# it, and the other four read it as option letters and refuse the dash.
#
# The positional parameters are what tell "swallowed" from "ignored": a word
# an option loop merely declined would end the options and stand as `$1`.

( set --xtrace q; has x 'x after set --xtrace'; printf 'and [%s]\n' "$*" )
( set --zzznosuch q; printf 'an unknown one -> %s [%s]\n' "$?" "$*" ) 2>&1
( set --noglob q; printf '[%s]' /dev/nul*; printf ' and [%s]\n' "$*" )
( set -- --xtrace q; printf 'behind the terminator [%s]\n' "$*" )

# ---- `set -x` and the assignment written in front of a command ----
#
# zsh's shape: the assignments go **on the command's own line**, as dash and
# BusyBox ash write them — and then this shell writes **the trace prefix a
# second time** between the assignments and the command's words, which no
# other column does. `+ A=3 + xf zz` is one line and two prefixes.
#
# The repeat is a question about the command and not about the line. It
# appears in front of a command this shell runs itself — a function, a
# builtin, a `builtin`-forced one — and not in front of one it hands to a
# process: `D=6 E=7 /bin/echo ext` is a single prefix. `command` counts as
# handing it over even when what it names is a builtin, and this shell drops
# the `command` word from the trace as well, which is why no row here uses it.
#
# `PS4='+ '` is deliberate and is the only reason these rows can exist. The
# default prefix here is `+%N:%i> ` — the script's name and the line — so a
# block written without it would compare where the harness put the file rather
# than what the shell traced, and would pass or fail by directory.
#
# **Held out and named:** a prefix whose value is a command substitution
# writes a *partial* assignment before it expands — `V=$(printf vv) :` traces
# `+ V=+ printf vv` and then the finished line — which is an artifact of the
# order this shell writes and expands in, and is recorded here rather than
# reproduced. bash/ and ksh/ carry that row, where it is an ordinary one.

xf() { :; }
PS4='+ '
exec 3>&2 2> xt.err
set -x
A=3 xf zz
B=4 true
C=5 :
D=6 E=7 /bin/echo ext
Q='a b' :
v=14
v+=5 :
set +x
exec 2>&3
cat xt.err
printf 'and the append did not outlive the command [%s]\n' "$v"

# ---- CHASE_LINKS and CHASE_DOTS ----
#
# Two names for not keeping the path a directory was reached by, and no other
# shell in the panel has either. `chaselinks` resolves every `cd`; `chasedots`
# resolves one whose destination holds a `..`, and then it resolves the whole
# destination rather than only the `..` — which the third row is what says, a
# link sitting *after* the `..` where a narrower reading would have left it
# alone.
#
# The fixture is made here rather than assumed, and the names are printed
# relative to it, so what a row compares is the shape and never a path. `cd
# -P .` first, because a temporary directory is commonly reached through a
# link and every row below would otherwise be measuring the machine.

rm -rf chase.tmp
mkdir -p chase.tmp/real/deep chase.tmp/sub/sub
ln -s ../real chase.tmp/sub/fake
ln -s ../../real chase.tmp/sub/sub/fake
cd chase.tmp
cd -P .
base=$PWD
where() { print -r -- "${PWD#$base}"; }

( unsetopt chaselinks chasedots; cd sub/fake;              printf 'neither    '; where )
( setopt chasedots;              cd sub/fake;              printf 'dots       '; where )
( setopt chaselinks;             cd sub/fake;              printf 'links      '; where )
( setopt chaselinks chasedots;   cd sub/fake;              printf 'both       '; where )

( unsetopt chaselinks chasedots; cd sub/fake/..;           printf 'dotdot  n  '; where )
( setopt chasedots;              cd sub/fake/..;           printf 'dotdot  d  '; where )
( setopt chaselinks;             cd sub/fake/..;           printf 'dotdot  l  '; where )

( unsetopt chaselinks chasedots; cd sub/fake/../sub/fake;  printf 'tail    n  '; where )
( setopt chasedots;              cd sub/fake/../sub/fake;  printf 'tail    d  '; where )

# A `.` is not a `..`, which holds the option on and takes the `..` away.
( setopt chasedots;              cd sub/./fake;            printf 'dotonly d  '; where )
# And a `..` with no link on the way is the row that must not move.
( setopt chasedots;              cd real/deep/..;          printf 'nolink  d  '; where )

# `-L` puts `chaselinks` down and leaves `chasedots` standing. Same
# destination in all three; only the option moves.
( setopt chaselinks;           cd -L sub/fake/../sub/fake; printf '-L links   '; where )
( setopt chasedots;            cd -L sub/fake/../sub/fake; printf '-L dots    '; where )
( setopt chaselinks chasedots; cd -L sub/fake/../sub/fake; printf '-L both    '; where )
( setopt chaselinks;           cd -P sub/fake;             printf '-P links   '; where )

# `cd` reads the wider one when it moves and `pwd` reads it when it *prints*,
# which the second block is what says: $PWD still holds the logical name and a
# bare `pwd` writes the resolved one all the same.
three() { p=$(pwd); l=$(pwd -L); c=$(pwd -P)
  printf '%s PWD%s pwd%s -L%s -P%s\n' "$1" "${PWD#$base}" "${p#$base}" "${l#$base}" "${c#$base}" }
( setopt chaselinks; cd sub/fake; unsetopt chaselinks; three 'on-then-off' )
( unsetopt chaselinks; cd sub/fake; setopt chaselinks; three 'off-then-on' )
( setopt chasedots;  cd sub/fake;                      three 'dots-only  ' )
( unsetopt chaselinks chasedots; cd sub/fake;          three 'neither    ' )

# Both report themselves, apart, and a subshell keeps its change to itself.
setopt chaselinks
[[ -o chaselinks ]] && print 'chaselinks: on'
[[ -o chasedots ]]  || print 'chasedots: off'
print -r -- "options: ${options[chaselinks]} ${options[chasedots]}"
unsetopt chaselinks
( setopt chasedots; [[ -o chasedots ]] && print 'inner: on' )
[[ -o chasedots ]] || print 'outer: still off'
cd "$base/.."
