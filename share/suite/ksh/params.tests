#
# Parameter expansion, the answer only ksh93 gives.
#
# The operators POSIX defines are core/ and the ksh-family ones the substrate
# adopted are ext/. What is left, and what this file is, is the handful of
# places where ksh93's answer is its own: `${!name}` names a variable where
# bash dereferences it, `${ … ; }` runs a command substitution in the current
# shell, and the case attributes apply to every later assignment rather than
# only to the one that declared them.

# `${!name}` is the *name*, which is how ksh93 spells what bash spells
# `${!ref}` as an indirection. zsh and dash refuse the form outright, so all
# four references part company here.
v=abc
printf '%s\n' "${!v}"

# On an array the same operator gives the subscripts rather than the values.
arr=(one two three)
printf '%s\n' "${!arr[@]}"

# `${ command; }` is a command substitution that does not fork: assignments
# inside it survive, which is the whole point of the form and the one thing
# `$( … )` can never do. Both are run here because the pair is the claim.
x=3
printf '%s\n' "${ echo shared $x; x=9; }"
printf '%s\n' "x is now $x"
y=5
printf '%s\n' "$( y=7; echo sub $y )"
printf '%s\n' "y is still $y"

# The case attributes are attributes, not a one-off conversion: a later
# assignment to the same name is converted too.
typeset -u U=abc
printf '%s\n' "$U"
U=mixed
printf '%s\n' "$U"
typeset -l L=ABC
printf '%s\n' "$L"
L=MiXeD
printf '%s\n' "$L"

# An offset may be a bare arithmetic expression, and a name in it is read as
# a variable rather than as anything else.
s=hello
printf '%s\n' "${s: -2}"
printf '%s\n' "${s:1:3}"
n=2
printf '%s\n' "${s:n}"
printf '%s\n' "${s:n:1}"

# A negative offset needs the space, and a negative length counts back from
# the end.
printf '%s\n' "${s: -4:2}"

# `${#name}` counts characters, and on an array it is the element count.
printf '%s\n' "${#s}"
printf '%s\n' "${#arr[@]}"

# A range's pattern characters are protected before it is read, so every one
# of them is an arithmetic syntax error here where bash and zsh evaluate the
# expression. `${s:(-2)}` is the spelling the issue was filed about and the
# parentheses are not what it is about: a bitwise or is refused in the same
# position and a comparison is not. Each one is in a subshell because the
# refusal ends the shell it happens in, and the rest of this file has to run.
( printf '%s\n' "${s:(-2)}" )
printf 'st=%s\n' "$?"
( printf '%s\n' "${s:1|2}" )
printf 'st=%s\n' "$?"
( printf '%s\n' "${s:1:(2)}" )
printf 'st=%s\n' "$?"
printf '%s\n' "${s:1<2}"
printf '%s\n' "${s:1%2}"

# `${!prefix@}` and `${!prefix*}` list the names *extending* the prefix. The
# name that matches it exactly is set and readable and is still left out,
# which is where this parts from bash's plain prefix match.
zqp=0
zqp_a=1
zqp_b=2
printf '[%s]' "${!zqp@}"
printf '\n'
printf '[%s]' "${!zqp*}"
printf '\n'
printf '[%s]\n' "${!zqnosuch@}"

# Assignment forms set the variable as well as expanding, and the unset test
# and the null test differ by the colon.
unset u
printf '%s\n' "${u=assigned}"
printf '%s\n' "u is $u"
e=
printf '[%s]\n' "${e-kept}"
printf '[%s]\n' "${e:-substituted}"

# A `.` is a name character here, which is how this shell spells its own
# namespace and how a compound variable's member is addressed. No other shell
# on the panel reads one: all five call `${.sh.version}` a bad substitution
# (#2620).

# `${.sh.version}` is the shell's own identity, and the shape is asserted
# rather than the text — every build writes a different sentence.
case "${.sh.version}" in
  Version\ *) printf '%s\n' '.sh.version: a version sentence' ;;
  *)          printf '%s\n' '.sh.version: unexpected' ;;
esac

# The dot is a rule about *names* and not about the namespace: a dotted name
# nobody set is the empty string at status 0, exactly as a plain one is.
printf '[%s]\n' "${.nosuchname}"
printf '[%s]\n' "${.}"

# And it reads in the positions that are not an expansion — an assignment, a
# declaration, a loop variable, and the builtins that take a name.
.dotted=one
printf '%s\n' "${.dotted}"
typeset .declared=two
printf '%s\n' "${.declared}"
for .each in a b; do printf '%s\n' "${.each}"; done
printf '%s\n' "${#.dotted}"
unset .dotted
printf '[%s]\n' "${.dotted}"

# A `$` in front of a bare dotted name is not an expansion, which is what says
# the rule belongs to names rather than to what may follow a dollar.
.again=three
printf '%s\n' '$.again'

# An array literal standing where one element's value goes makes that element
# an array of its own here, and the array around it keeps its length. bash
# refuses the line and ends the script, zsh splices the words in and the array
# grows; this is the third answer (#2620).
c=(x y)
c[1]=(p q)
printf '[%s]' "${c[@]}"
printf ' n=%s\n' "${#c[@]}"
typeset -p c

# An empty literal is still an element rather than a removal, and it reads back
# as a value rather than as the empty string.
d=(x y z)
d[1]=()
printf 'n=%s\n' "${#d[@]}"
typeset -p d

# `+=` replaces an element holding a string and appends to one already holding
# an array — the two halves do not follow from each other.
e=(x y)
e[1]+=(p)
typeset -p e
e[1]+=(r)
typeset -p e

# A plain assignment through the subscript reaches the nested array's own first
# element instead of flattening it away.
f=(x y)
f[1]=(p q)
f[1]=z
typeset -p f

# A name holding a string is promoted rather than refused: the string becomes
# element zero and the literal nests beside it.
g=abc
g[1]=(p q)
typeset -p g

# A comma in a subscript is the arithmetic operator here and not the separator
# of a range, so the literal lands at the right operand and nowhere else.
h=(1 2 3)
h[2,3]=(x y)
printf '[%s]' "${h[@]}"
printf ' n=%s\n' "${#h[@]}"

# And a keyed table takes the same value under a key.
typeset -A t
t[k]=v
t[a,b]=(x y)
printf 'n=%s\n' "${#t[@]}"
typeset -p t

# A parenthesized literal whose first word is an assignment is a *compound
# variable* and not an array: the members are names of their own, spelled with
# a dot, and `${c.a}` reads one. No other shell on the panel has the construct
# — all four read `c=(a=1 b=2)` as an array of two strings — which is why the
# whole block is here rather than in ext/ (#2620).
c2=(a=1 b=2)
printf '%s\n' "${c2.a}" "${c2.b}"
typeset -p c2
typeset -p c2.a

# The members list in sorted order whatever order they were written in, and a
# `;` between two of them is the same literal as a blank.
c3=(b=2; a=1)
typeset -p c3

# A member may be a compound of its own, and the listing nests.
c4=(a=1 b=(y=2))
printf '%s\n' "${c4.b.y}"
typeset -p c4

# The body holds declarations and not only assignments, so a member carries
# its own attributes — which is the half that makes it a program rather than a
# word list.
c5=(typeset -i n=5+5)
printf '%s\n' "${c5.n}"
typeset -p c5
typeset -p c5.n

# An array-valued member keeps its own letters in the listing.
c6=(a=1 q=(p r))
printf '%s\n' "${c6.q[1]}"
typeset -p c6

# A bare `$c` is the whole tree laid out over lines, and it is text: `d=$c`
# leaves `d` a scalar holding those lines rather than a compound of its own.
c7=(a=1 b=2)
c8=$c7
typeset -p c8
printf '[%s]\n' "${c8.a}"

# Every name under the compound enumerates, branches included: `c9.b` is
# listed beside the leaf stored under it.
c9=(a=1 b=(y=2))
printf '[%s]' "${!c9.@}"
printf '\n'

# `unset` of a member takes that name away and leaves the rest, and `unset` of
# the parent takes the members with it.
ca=(a=1 b=2)
unset ca.a
printf '[%s]\n' "${ca.a}"
typeset -p ca
unset ca
printf '[%s]\n' "${ca.b}"

# `+=` adds to a compound where a plain assignment replaces it whole.
cb=(a=1)
cb+=(b=2)
typeset -p cb
cb=(d=3)
typeset -p cb

# A value of another kind retypes the name, and the members go with it.
cc=(a=1)
cc=(x y)
typeset -p cc
printf '[%s]\n' "${cc.a}"

# The letter declares the kind without a literal, and `compound` is the same
# declaration spelled as a word.
typeset -C cd
cd.a=1
typeset -p cd
compound ce=(a=1)
typeset -p ce

# `[[ -v ]]` sees a member as the name it is.
cf=(a=1)
[[ -v cf.a ]] && printf '%s\n' 'cf.a: set'
[[ -v cf.zz ]] || printf '%s\n' 'cf.zz: unset'

# A dotted name whose head is *not* a compound is two ordinary scalars, which
# is what says the dot is a name character rather than a tree operator.
cg=1
cg.b=2
typeset -p cg
printf '%s\n' "${cg.b}"

# Copying a compound is a bare *name* on the right of an assignment, and the
# spelling that reads it that way is a `-C` declaration or an assignment whose
# target is already one. The right-hand name decides the kind, so a scalar
# source leaves a scalar.
ch=(a=1 b=2)
typeset -C ci=ch
typeset -p ci
ci.a=9
printf '[%s][%s]\n' "${ch.a}" "${ci.a}"
cj=(a=9)
cj=ch
typeset -p cj
ck=5
typeset -C cl=ck
typeset -p cl

# A source nobody set takes the target with it; text that is not a name at all
# leaves the empty compound the letter declared.
cm=hello
typeset -C cm=nosuchnameanywhere
printf '[%s]\n' "$cm"
typeset -C cn="not a name"
typeset -p cn

# The target is emptied before the source is read, and `+=` merges instead of
# replacing — with the source's members standing over the target's own.
co=(a=1 z=3)
typeset -C cp=(z=2)
typeset -C cp=co
typeset -p cp
typeset -C cq=(z=2)
cq+=co
typeset -p cq

# A member's attributes travel with the copy, because they are part of the
# compound's value rather than of the name holding it.
cr=(typeset -i n=5)
typeset -C cs=cr
typeset -p cs.n

# The bare spelling reads only a compound out of the name: every other kind is
# the text it was written as, and so is a target that was not a compound.
ct=5
cu=(a=9)
cu=ct
typeset -p cu
cv=(a=1 b=2)
cw=cv
typeset -p cw

# A write through a subscript takes the compound *reading* away and leaves the
# members, where a whole-name write takes them with it. The compound's text is
# never what the write builds on — nothing lands at subscript 0 — and the base
# is still occupied, which is why a `+=` list starts at 1.
cx=(a=1)
cx[0]=z
typeset -p cx
printf '[%s][%s]\n' "${cx.a}" "${!cx.@}"
cy=(a=1)
cy[1]=z
typeset -p cy
printf '[%s]\n' "${cy.a}"
cz=(a=1)
cz+=(x y)
typeset -p cz
printf '[%s]\n' "${cz.a}"

# A scalar append is a whole-name write, so the members go — and the tree's
# rendering is not what it joins.
da=(a=1)
da+=z
typeset -p da
printf '[%s]\n' "${da.a}"

# The subtree still goes with the parent once the parent is an array.
db=(a=1)
db[0]=z
unset db
printf '[%s]\n' "${db.a}"

# An empty literal is a compound too, which moves the spelling every script
# uses to start an array: `${#c[@]}` answers 1, `${c[0]}` is the tree, and a
# later `+=` list starts at subscript 1. A prior declaration of the other kind
# does not change it.
dc=()
typeset -p dc
printf '%s\n' "$dc"
printf '%s %s\n' "${#dc[@]}" "${!dc[@]}"
dd=()
dd.a=1
typeset -p dd
de=()
de+=(x y)
typeset -p de
typeset -a df
df=()
typeset -p df

# The declaration's own letters settle it ahead of the word, and they reach
# the parse rather than the store — an empty pair of parentheses has no word in
# it to decide with.
typeset -C dg=()
typeset -p dg
typeset -A dh=()
printf 'n=%s\n' "${#dh[@]}"
typeset -a di=(a=1 b=2)
printf 'n=%s\n' "${#di[@]}"
printf '%s\n' "${di[0]}"

# `+=` with an empty body adds nothing to a name that is already a container,
# and declares the kind over anything else.
dj=(x y)
dj+=()
typeset -p dj
dk=1
dk+=()
typeset -p dk

# ---- `$_`, which this shell has and which moves under a rule of its own ----
#
# The first block is the function call, where all three shells that have the
# parameter agree about the last line of each pair — the caller reads the
# **call's** own last argument, not whatever the body last ran (#3134) — and
# part company on the first, which is what the caller had here and in bash and
# the call's own argument in zsh.
#
# The second block is this shell's alone, and it is why the record had this
# column down as having no `$_` at all. It has one. It moves only for a
# **simple command standing alone on a line at the top level of the input** —
# not across a `;`, an `&&`, a pipe, a `!`, an `&`, not for a bare assignment,
# and not for anything inside a loop, a branch, a group, a subshell or an
# `eval`. The probe that column was measured with is a `;`-list, which is the
# one shape where a shell with the parameter and a shell without it both
# answer empty.
#
# The consequence worth naming is that the idiom does not work here:
# `mkdir -p "$d" && cd "$_"` reaches an empty `$_`, because the `&&` is what
# stops it moving. The same two written as two lines work.

suiteinner() { :; }
suitepeek() { printf 'body [%s]\n' "$_"; suiteinner zz; printf 'body-after [%s]\n' "$_"; }
: outer
suitepeek one two
printf 'after-call [%s]\n' "$_"
suitepeek
printf 'after-argless [%s]\n' "$_"
A=2 suitepeek three
printf 'after-prefixed [%s]\n' "$_"
suitewrap() { suitepeek aa bb; }
: before
suitewrap xx yy
printf 'after-nested [%s]\n' "$_"
suiteset() { _=SET_IN_BODY; }
suiteset qq
printf 'after-explicit [%s]\n' "$_"

# The second block: which commands move it, and which leave it where it stood.
: alpha
echo one two > /dev/null
printf 'a lone command [%s]\n' "$_"
echo three four > /dev/null; printf 'behind a semicolon [%s]\n' "$_"
echo five six > /dev/null && printf 'behind an and [%s]\n' "$_"
echo seven eight > /dev/null
printf 'and the and left it [%s]\n' "$_"
echo nine ten | cat > /dev/null
printf 'after a pipeline [%s]\n' "$_"
# A `!`-negated command belongs in this list and is held out of it: it leaves
# `$_` where it stood, exactly as the pipeline above does, and a row for it
# cannot be written here until `sh -n` will read one — a top-level `! cmd`
# exits 1 with nothing said, in every dialect, so the file's static column
# would report a syntax error nobody wrote (#3179).
zz=13
printf 'after a bare assignment [%s]\n' "$_"
for suitei in fourteen
do
	: fifteen
	printf 'inside a loop [%s]\n' "$_"
done
printf 'after the loop [%s]\n' "$_"
if : sixteen
then
	printf 'inside a branch [%s]\n' "$_"
fi
{ : seventeen
	printf 'inside a group [%s]\n' "$_"
}
( : eighteen
	printf 'inside a subshell [%s]\n' "$_" )
eval ': nineteen
printf "inside an eval [%s]\n" "$_"'
printf 'after the eval [%s]\n' "$_"
