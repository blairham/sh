#
# Arithmetic, the answer only ksh93 gives.
#
# ext/ already proves what the ksh family shares. This file is the rest: the
# arithmetic ksh93 has and the others either lack or answer differently.
# Every line here was measured against AT&T ksh93 93u+ 2012-08-01 on this
# machine, and each is one the other references part company with — bash has
# no floating point in `$(( ))` at all and refuses `2**-1`, dash refuses a
# based literal, and zsh has floats and prints them to a different width.

# A float operand makes the whole expression float, and an all-integer
# expression stays integer. That pair is the rule; neither half is
# interesting without the other.
printf '%s\n' "$(( 3/2 ))"
printf '%s\n' "$(( 3.0/2 ))"
printf '%s\n' "$(( 1.0/2 ))"

# How a float prints is a dialect answer rather than a shared one. ksh93
# writes fifteen significant digits and no trailing point; zsh writes
# seventeen and keeps the point on a whole number. Both are defensible and
# they are not the same bytes, which is what puts this line here.
printf '%s\n' "$(( 1.0/3 ))"
printf '%s\n' "$(( 10.0/4 ))"
printf '%s\n' "$(( 1e3 ))"
printf '%s\n' "$(( 2.5 + 2.5 ))"

# `**` takes a negative exponent because the result is a float. bash refuses
# this outright.
printf '%s\n' "$(( 2**10 ))"
printf '%s\n' "$(( 2**-1 ))"

# Integer division truncates toward zero, and the remainder takes the sign of
# the left operand.
printf '%s\n' "$(( -7/2 ))"
printf '%s\n' "$(( -7%2 ))"

# base#number, including base ten spelled out — which is the way to read a
# digit string with a leading zero as decimal rather than octal.
printf '%s\n' "$(( 10#09 + 1 ))"
printf '%s\n' "$(( 2#1011 ))"
printf '%s\n' "$(( 8#17 ))"
printf '%s\n' "$(( 16#ff ))"

# `integer` is ksh's own spelling of typeset -i, and an integer variable
# evaluates its assignment as arithmetic rather than storing the text.
integer n=7
printf '%s\n' "$(( n/2 ))"
n=n+1
printf '%s\n' "$n"
integer m=3*4
printf '%s\n' "$m"

# typeset -i<base> is an output base: the value is stored as a number and
# written back in that base, with the base still on it. ksh93 writes the hex
# digits in lower case where zsh writes them in upper.
typeset -i8 oct=64
printf '%s\n' "$oct"
typeset -i16 hex=255
printf '%s\n' "$hex"
typeset -i2 bin=5
printf '%s\n' "$bin"

# The base survives further arithmetic on the variable.
oct=oct+1
printf '%s\n' "$oct"

# (( )) is a command whose status is the truth of the value, so a zero value
# is a false command — the one place in the shell where zero is false.
if (( 1 + 1 == 2 )); then printf '%s\n' 'true arithmetic succeeds'; fi
if (( 0 )); then printf '%s\n' 'unreachable'; else printf '%s\n' 'zero is a failure'; fi

# let takes its arguments as arithmetic and reports the last one the same way.
let 'a = 3 + 4'
printf '%s\n' "$a"
let "a == 7" && printf '%s\n' 'let reports the truth of its last expression'

# --- a negative divisor is not asked, and that is the measurement ------------
#
# ksh93 93u+ on this machine refuses *every* integer division whose divisor is
# negative and calls it a division by zero: `7 / -2`, `6 / -2`, `7 / -1`,
# `-7 / -2` and `7 / (0 - 2)` all end the script, and so does a divisor read
# out of a variable. The remainder operator with the same operands answers 1,
# and `7 / -2.0` answers -3.5, so it is integer division with a negative
# divisor specifically. bash, zsh and dash all answer -3.
#
# It is written here rather than run because a case of ours is a thing our
# ksh has to reproduce, and this is a defect in a shell from 2012 rather than
# a dialect's answer. core/arith.tests says the same thing from the other
# side: `-7 / 2` is core and `7 / -2` is nowhere.

# --- every value is a C double ------------------------------------------------
#
# The other three columns do their arithmetic in the machine word. This one
# does not do it in a word at all: every value is a C `long double`, 64 bits
# wide on this machine, and both halves of that show.
#
# The half at the top of the range was here before, read as a saturation —
# `big + 1` holds at the maximum where bash and zsh wrap to the minimum. That
# row is the maximum under either reading, which is what made it the wrong
# probe to have recorded the rule from: a shell that clamps says so, and a
# shell that adds in a double reaches 2^63, casts it back saturating, and
# lands on the same number. `big * 2` is the row that parts them.
big=9223372036854775807
printf 'the largest value: %s\n' "$(( big ))"
printf 'one past it:       %s\n' "$(( big + 1 ))"
printf 'twice it:          %s\n' "$(( big * 2 ))"
printf 'below the smallest: %s\n' "$(( -9223372036854775807 - 2 ))"
printf 'two to the sixty-third: %s\n' "$(( 2**63 ))"
printf 'two to the sixty-fourth: %s\n' "$(( 2**64 ))"

# The other half is nowhere near the edge of the word: a value past what a
# double holds exactly loses its low bits, whether it was written down or
# arrived at. A saturation reading has nothing to say about any of these.
printf 'one past what a double holds: %s\n' "$(( 9007199254740993 ))"
printf 'and reached by adding:        %s\n' "$(( 9007199254740992 + 1 ))"
printf 'a product that fits and rounds: %s\n' "$(( 3037000499*3037000499 ))"
printf 'a quotient that rounds:         %s\n' "$(( 1152921504606846976/3 ))"
printf 'a bit the double cannot keep:   %s\n' "$(( (1<<62) | 1 ))"

# Whether the answer is written as an integer or in floating notation is not a
# magnitude but a round trip: the value is an integer when a saturating cast of
# it converts back to the same double. The product two lines above is nineteen
# digits and an integer; two to the sixty-fourth is not.
#
# And the *kind* stays integer even where the representation cannot, so an
# integer operator still does integer work on the saturated cast rather than
# refusing a value it thinks is a float.
printf 'a wide value divided:     %s\n' "$(( 2**64 / 3 ))"
printf 'a wide value remaindered: %s\n' "$(( 2**64 % 3 ))"

# A numeral the word cannot hold is the same rule, and here the four columns
# give four answers: bash wraps it modulo 2^64, zsh stops after the digits it
# can hold and says so, dash saturates. See #3202 — this is ksh93's answer and
# the others are not yet read at all.
printf 'a numeral past the word:      %s\n' "$(( 10000000000000000000 ))"
printf 'a hexadecimal one:            %s\n' "$(( 0xffffffffffffffffff ))"

# --- two rows that are not asked, and that is the measurement -----------------
#
# `integer n=9223372036854775807; n=n+1` is **0** in ksh93 93u+ on this
# machine, where the same addition inside `$(( ))` is the largest value. A
# double of 2^63 stored into an integer variable comes back as zero, which is
# neither the arithmetic above nor a clamp, and is a defect in a shell from
# 2012 rather than a rule this dialect has: the same variable holding
# 9007199254740993 reads back as -1 there, and 2^64 as -4, which is no reading
# at all. It is written here rather than run, for the reason the negative
# divisor above is. The whole panel is on #3211.

# --- a value that is not a number --------------------------------------------
#
# bash and zsh read an unparseable operand as zero and carry on. dash fails
# with status 2 and ksh93 with status 1, so what is ksh93's alone is the pair:
# it refuses, and it refuses with a 1.
( printf 'value [%s]\n' "$(( 0x ))" ) 2>/dev/null
printf 'a hexadecimal prefix with no digits: %s\n' "$?"
notanumber=abc
( printf 'value [%s]\n' "$(( notanumber ))" ) 2>/dev/null
printf 'a name holding letters: %s\n' "$?"

# --- C's hexadecimal spelling of a float --------------------------------------
#
# A hexadecimal literal carrying a point or a `p` exponent is a float here, and
# nowhere else on the panel: bash 5.3, bash 3.2, bash-as-sh, zsh 5.9.2, dash
# and BusyBox ash refuse every shape of it, each in its own words. The exponent
# is a power of *two*, which is what the letter changes.
printf 'a binary exponent:    %s\n' "$(( 0x1p4 ))"
printf 'either case of it:    %s\n' "$(( 0x1P4 ))"
printf 'and a signed one:     %s\n' "$(( 0x1p-1 ))"
printf 'a plus sign as well:  %s\n' "$(( 0x1p+2 ))"
printf 'an exponent of zero:  %s\n' "$(( 0xffp0 ))"
printf 'a point as well:      %s\n' "$(( 0x1.8p1 ))"
printf 'or a point alone:     %s\n' "$(( 0x1.8 ))"
printf 'with no digits after: %s\n' "$(( 0x1.p1 ))"

# `e` is a hexadecimal *digit*, so the decimal spelling's exponent letter makes
# no float of a hexadecimal literal. This is the row that says the reader knows
# which letter it is looking at.
printf 'an e is a digit here: %s\n' "$(( 0x1e5 ))"

# The exponent's digits may be missing where the letter is there — the letter
# is consumed and the exponent read as zero — which is the opposite of the
# decimal rule, where `1e` ends the numeral at the `1`. Both spellings are
# asked so that a reader written to one rule answers the other wrong.
printf 'an exponent with no digits: %s\n' "$(( 0x1p ))"
printf 'and with only a sign:       %s\n' "$(( 0x1p+ ))"

# A mantissa with no digit of its own is refused, and that is about the digit
# rather than the exponent: `0x.8p1` and `0xp4` both end the script.
( printf 'value [%s]\n' "$(( 0x.8p1 ))" ) 2>/dev/null
printf 'a point with no digit before it: %s\n' "$?"
( printf 'value [%s]\n' "$(( 16#1p4 ))" ) 2>/dev/null
printf 'and the base# spelling has none of this: %s\n' "$?"

# --- the one operand an integer-only operator takes rather than refuses --------
#
# A float where only an integer will do is refused here and truncated in zsh,
# which is an axis. What is this column's alone is the *extent* of the refusal:
# `%` refuses a float divisor and takes a float dividend, truncating it — so
# `1.5 % 1` is 0 and not the 0.5 the float operation gives. Every other
# integer-only operator refuses a float on either side.
printf 'a float dividend is truncated: %s\n' "$(( 1.5 % 1 ))"
printf 'a whole one written as a float: %s\n' "$(( 7.0 % 2 ))"
printf 'and a negative one:             %s\n' "$(( -1.5 % 2 ))"
( printf 'value [%s]\n' "$(( 7 % 2.5 ))" ) 2>/dev/null
printf 'a float divisor is refused: %s\n' "$?"
( printf 'value [%s]\n' "$(( 7 % 2.0 ))" ) 2>/dev/null
printf 'even a whole one: %s\n' "$?"
( printf 'value [%s]\n' "$(( 1.5 & 1 ))" ) 2>/dev/null
printf 'and a bitwise operator refuses either side: %s\n' "$?"

# --- a numeral with a radix, and the unsigned word it is read in --------------
#
# Every value in this shell's arithmetic is a C double, which is what makes
# `$(( 18446744073709551615 ))` 1.84467440737096e+19 where bash and BusyBox
# ash wrap it, zsh truncates the digits and dash stops at the signed maximum.
# But a numeral with an **explicit radix** does not go straight to the double:
# it is read in the unsigned word first and wraps in it, and becomes the
# double only when that word overflows.
#
# So the same magnitude answers two ways depending on how it was spelt, and
# the octal pair below is what makes that a rule rather than a width. 2^64-1
# in octal is held exactly and reads as -1; 2^64 in octal overflows, and the
# reader it falls back to has never heard of octal — so the answer is the
# decimal reading of the same digits with the leading zero along for the ride.
printf 'the unsigned maximum in octal: %s\n' "$(( 01777777777777777777777 ))"
printf 'and one past it:               %s\n' "$(( 02000000000000000000000 ))"
printf 'a longer octal run:            %s\n' "$(( 017777777777777777777770 ))"
printf 'the same magnitude in decimal: %s\n' "$(( 18446744073709551615 ))"

# The hexadecimal fallback is the hexadecimal float the same reader takes, so
# one past the unsigned word is 2^64 rather than 2·10^16.
printf 'one past the unsigned word: %s\n' "$(( 0x10000000000000000 ))"
printf 'and well past it:           %s\n' "$(( 0x1ffffffffffffffff ))"

# The wrapped value is an integer, so the integer operators do integer work on
# it — a reader that handed back a float would answer -0.333333333333333 here.
printf 'a wrapped value divided: %s\n' "$(( 0xffffffffffffffff / 3 ))"

# And it is carried in the double like every other integer, which the unsigned
# word is wider than: 2^63+1 is held exactly by the word and not by the double
# it is then stored in, so the answer is one below the exact reading.
printf 'a value the double cannot keep: %s\n' "$(( 0x8000000000000001 ))"

# --- and when a double is written as an integer -------------------------------
#
# A value is written as an integer whenever a saturating `(intmax_t)` cast of
# it converts back to the same double, and in floating notation when it does
# not. It is not a magnitude and not a question of where the value came from:
# `1e19/3` is an integer and `1e19` is not, from a float literal either way.
printf 'a float literal divided: %s\n' "$(( 1e19/3 ))"
printf 'the literal itself:      %s\n' "$(( 1e19 ))"
printf 'the numeral at 2^63:     %s\n' "$(( 9223372036854775808 ))"
printf 'and 2^64 divided:        %s\n' "$(( 18446744073709551616 / 3 ))"

# --- and the 1 a zero result leaves is not a failure --------------------------
#
# `(( expr ))` answers 1 for a zero value in every shell that has the
# construct, and this one alone does not count that 1 as a failure `set -e` or
# the ERR trap sees (#3348). Each run is a subshell of its own so that the
# ones which do stop take nothing else with them, and the status is printed
# rather than the shell's survival inferred.
run() { ( eval "$1" ) 2> /dev/null; printf '%s -> %s\n' "$2" "$?"; }
run 'set -e; (( 0 )); printf "after\n"' 'a zero result under errexit'
run 'set -e; x=1; (( x == 2 )); printf "after\n"' 'a comparison that did not hold'
run 'set -e; true && (( 0 )); printf "after\n"' 'the last operand of a chain'
run 'trap "echo ERRFIRED" ERR; (( 0 )); printf "after\n"' 'a zero result under an ERR trap'
run 'set -e; let 0; printf "after\n"' 'the same value through let'
run 'set -e; f() { (( 0 )); }; f; printf "after\n"' 'a call whose body ended in one'
run 'set -e; ( (( 0 )) ); printf "after\n"' 'a subshell of one'

# `set -u` reaching an expression is refused here, and the refusal is the
# expression's failure rather than the shell's — which is what parts this
# shell's two arithmetic constructs, since a failed `(( ))` ends the input here
# and a failed `let` does not. Measured 2026-09-18 against ksh93u+
# 2012-08-01 with `b` unset (#3574).
( set -u; (( b )); printf 'ran on\n' ) 2>/dev/null
printf 'an arithmetic command: %s\n' "$?"
( set -u; let "x = b"; printf 'a let operand: %s\n' "$?" ) 2>/dev/null

# The wider refusal is the option's: with it off, a name at the top of an
# expression is still zero here, where one inside a subscript is not.
( printf 'the option off: %s\n' "$(( b ))" ) 2>/dev/null
