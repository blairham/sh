#
# The arithmetic `for` in BusyBox ash, which does not have it — an ext/ area this column
# does not run.
#
# BusyBox takes a good part of the ext/ list (`$'…'`, `[[`, substrings, the
# replacement, `function`), so which constructs it lacks is a question per
# construct rather than a foregone one. This one it lacks, and it answers
# every row with the same shape dash does: the same refusal at the same
# place, in BusyBox's own wording (`syntax error: unexpected "("`, a
# `line N` after `eval:`).
#
# Every refusal is asked through `eval` in a subshell, so a script that
# reaches one goes on to the next row and the file's own parse is not what
# is being graded.
#
# Measured 2026-09-16 in the pinned alpine image, BusyBox v1.37.0.

try() {
	( eval "$1" ) 2>&1
	printf '  -> %s\n' "$?"
}

printf -- '--- the arithmetic for does not parse ---\n'
try 'for ((i = 0; i < 2; i++)); do printf "%s\n" "$i"; done'
try 'for ((;;)); do break; done'
try 'printf "ran\n"; for ((i = 0; i < 1; i++)); do :; done'
printf -- '--- and the arithmetic command neither ---\n'
try '((1 + 1)); printf "%s\n" "$?"'
try '(( x = 3 ))'
printf -- '--- the loop a script writes instead ---\n'
i=0
while [ "$i" -lt 3 ]; do printf '%s ' "$i"; i=$((i + 1)); done
printf '\n'
