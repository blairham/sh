#
# dash's own answers about variables — #2316's dialect half.
#
# core/variables.tests asks what every shell here agrees a variable does. This
# file asks the one thing dash does differently from all three of the others
# at once, and it is not a feature: it is how this shell *writes a variable
# back out*. `export -p`, `readonly -p` and a bare `set` are the three ways a
# script reads its own state, and dash single-quotes every value in all three
# where no other shell on the panel quotes an ordinary word at all.
#
# Measured 2026-09-16 against /bin/dash (Apple dash-16) with the panel beside
# it — bash 5.3, zsh 5.9.2, ksh93 93u+ 2012:
#
#	export -p, for v=plain
#	  dash    export v='plain'
#	  bash    declare -x v="plain"
#	  zsh     export v=plain
#	  ksh93   export v=plain
#
# Four shells, four answers, and dash's is the only one that is both `export`
# and quoted. That matters to a script rather than to a reader: the output of
# `export -p` is specified to be re-readable input, and a value with a space,
# a dollar or a backtick in it is only re-readable if something quoted it.
#
# The second half is the specials dash has not. `$RANDOM`, `$SECONDS` and `$_`
# are in the other three and in no POSIX text, so a script that reads one of
# them is writing for three shells out of four — and here it reads the empty
# string in silence rather than failing, which is the harder half to notice.
#
# ---- held out, and where each went instead ----
#
# `$-` in a script is empty here and carries letters in all three others, but
# it is asked in dash/builtins.tests beside `set -o stdin`, which is the
# option that puts a letter in it. Asking it twice would grade one fact in two
# places and make the second one look like a second finding.
#
# Assigning to a readonly is zsh's split rather than dash's — zsh ends the
# script and the other three carry on — and core/variables.tests says so.
# `unset` on a readonly is dash *and* ksh93 saying `is read only`, which is
# two shells and so belongs in neither tier: see #2291 on the splits a tier
# cannot express.
#
# `$_` is the third absence and it is held out because it is **ours**, not
# this shell's. dash has no `$_` at all — `${_+x}` is empty and, under
# `set -u`, reading it is `_: parameter not set` at status 2 — and cmd/dash
# answers `[]` at 0 because the producer is registered for every dialect.
# #3380, filed rather than fixed here, because the repair is a question about
# which shells have the parameter at all and BusyBox cannot be asked on this
# machine. A case will come back to this file when that is decided.

# A plain value, quoted. This is the row the whole file turns on: nothing
# about `plain` needs quoting and dash quotes it anyway.
v=plain; export v
export -p | sed -n '/ v=/p'

# A value with a single quote in it. The closing quote, an escaped quote and a
# reopening quote — `'"'"'` — which is the spelling that works in a shell with
# no other way to put a quote inside quotes. bash writes `"a'b"`, zsh writes
# `'a'\''b'` and ksh93 writes `$'a\'b'`; all four are re-readable and only
# this one uses no construct outside POSIX.
q="a'b"; export q
export -p | sed -n '/ q=/p'

# A value with a space and a tab. The tab is written as itself inside the
# quotes, where bash, zsh and ksh93 all reach for `$'…'` — which dash has not
# got, so it could not write that form even if it wanted to.
s='a b	c'; export s
export -p | sed -n '/ s=/p' | od -An -c | sed -n '1,2p'

# The empty value, and a value made of the characters that would expand if
# they were not quoted.
e=; export e
export -p | sed -n '/ e=/p'
d='$x`y'; export d
export -p | sed -n '/ d=/p'

# A name exported with no value at all is written back as the bare name. It is
# not `bare=''`: the name is marked for export and has no value, and those are
# different states to a shell that has to write them back.
export bare
export -p | sed -n '/bare/p'
printf 'bare is set? [%s]\n' "${bare+yes}"

# `readonly -p` is the same rule under the other builtin's own name, and the
# name it prints is `readonly` rather than a declaration word.
readonly r=ro
readonly -p | sed -n '/ r=/p'

# `set` with no operands writes the variables, and it writes them with the
# same quoting. Filtered to the names this file set, because the rest of the
# listing is the environment the run was given.
set | sed -n '/^[qrsv]=/p'

# The specials dash has not. Each is present in all three other shells on the
# panel and in no POSIX text, and each reads as the empty string here rather
# than failing.
#
# Presence only, never the value: both carry a clock or a generator in the
# other shells, and a case that printed one would not repeat even under the
# shell that answered it.
case "${RANDOM+x}" in x) printf 'RANDOM     [present]\n' ;; *) printf 'RANDOM     [absent]\n' ;; esac
case "${SECONDS+x}" in x) printf 'SECONDS    [present]\n' ;; *) printf 'SECONDS    [absent]\n' ;; esac

# And one it has, so that the three above are a measurement rather than a
# probe that cannot tell an absent variable from an absent shell.
case "${LINENO+x}" in x) printf 'LINENO     [present]\n' ;; *) printf 'LINENO     [absent]\n' ;; esac

# The name diagnostic. dash calls it a bad variable name; bash says it is not
# a valid identifier, ksh93 that it is not an identifier, and zsh prints the
# name alone. The status is the same in all four, so the wording is the whole
# of the difference and this is the file that owns it.
( export 1bad=1 ) 2>&1 | sed 's/.*: //'
printf 'export of a bad name -> %s\n' "$( ( export 1bad=1 ) 2>/dev/null; printf '%s' "$?" )"
