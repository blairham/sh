#
# Diagnostic wording in zsh — #2324.
#
# core/diagnostics.tests asks the half a script can depend on: every
# diagnostic is on stderr, nothing leaks to stdout, and each arrives between
# the output before it and the output after it. This file asks the half a
# *person* depends on, and zsh's is the most structured of the four.
#
# The prefix is `<file>:N: ` with no space after the file and no word `line`
# — and where the diagnostic came from a builtin, the builtin's name is
# inserted between them: `<file>:cd:11: `. No other shell on the panel puts
# the utility in the prefix, and zsh does not do it for every diagnostic
# either, which is what makes the two shapes worth having side by side.
#
# The sentence itself is usually reversed from everybody else's. bash writes
# `nosuchcommand_zz: command not found`; zsh writes `command not found:
# nosuchcommand_zz`, the complaint first and the thing complained about
# after the colon. Nothing here is normalized, because a row graded on its
# status reads as a match when the text is wrong.

# Every case is a subshell with stdout dropped and stderr kept, so what is
# compared is the diagnostic and nothing else. The subshell is not decoration:
# several of these are fatal in at least one shell on the panel, and a file
# that stopped at the first of them would measure one line.

say() { printf -- '--- %s\n' "$1"; }

say 'a command that is not there'
( nosuchcommand_zz ) 2>&1 > /dev/null

say 'a file that cannot be executed'
: > ne; chmod 644 ne
( ./ne ) 2>&1 > /dev/null

say 'a directory where a command was expected'
mkdir -p adir
( ./adir ) 2>&1 > /dev/null

say 'cd to a directory that is not there'
( cd /nosuchdir_zz ) 2>&1 > /dev/null

say 'an unset name under -u'
( set -u; printf '%s' "$UNSET_ZZ" ) 2>&1 > /dev/null

say 'a redirection from a file that is not there'
( read x < /nosuchfile_zz ) 2>&1 > /dev/null

say 'a redirection into a directory that is not there'
( printf x > /nosuchdir_zz/f ) 2>&1 > /dev/null

say 'a signal name nobody has'
( kill -s NOSUCHSIG_ZZ 1 ) 2>&1 > /dev/null

say 'the same name given to trap'
( trap : NOSUCHSIG_ZZ ) 2>&1 > /dev/null

say 'an option the builtin does not have'
( unset -Z x ) 2>&1 > /dev/null

say 'an option name set does not have'
( set -o nosuchoption_zz ) 2>&1 > /dev/null

say 'shift past the end'
( set -- a; shift 5 ) 2>&1 > /dev/null

say 'arithmetic that will not parse'
( : $((1 +)) ) 2>&1 > /dev/null

say 'division by zero'
( : $((1 / 0)) ) 2>&1 > /dev/null

say 'assigning to a readonly'
( readonly rv=1; rv=2 ) 2>&1 > /dev/null

say 'unsetting a readonly'
( readonly rr=1; unset rr ) 2>&1 > /dev/null

say 'a dot file that is not there'
( . ./nosuchfile_zz ) 2>&1 > /dev/null

say 'exec of a program that is not there'
( exec ./nosuchprog_zz ) 2>&1 > /dev/null

say 'a name that is not an identifier'
( read 1bad < /dev/null ) 2>&1 > /dev/null
( export 1bad=1 ) 2>&1 > /dev/null

say 'printf given a number that is not one'
( printf '%d\n' abc ) 2>&1 > /dev/null

say 'test given an operand too many'
( test a = b = c ) 2>&1 > /dev/null

say 'waiting for a pid that is not a child'
( wait 999999 ) 2>&1 > /dev/null

say 'signaling a pid nobody has'
( kill -0 999999 ) 2>&1 > /dev/null

say 'text that will not parse, through eval'
( eval 'for' ) 2>&1 > /dev/null

# A signal *number* out of range never reaches the signal table here: this
# shell hands it to `kill(2)` and prints the errno the kernel answered with,
# which is a different sentence from the one a pid that is really absent gets
# and is why both are below. A *name* out of range is a different route
# altogether — refused before anything is sent, in this shell's own words and
# with the hint after it. #3139 was the number taking the name's route and,
# worse, being read as an unknown option first.
# The process id is taken out of what is compared, because this shell writes
# it into the sentence and it differs on every run.
#
# **Masked by its role and not by its digits**, which is #3988. This file
# said `sed "s/$$/<pid>/g"` and that mask is unanchored: this shell's
# diagnostic prefix is `file:kill:LINENO:`, so every one of these rows writes
# the line it lands on, and a run whose pid *equalled* that line number had
# the mask eat the line number too — the file answered two different ways and
# the whole zsh column came back non-deterministic. Pids start at 1 inside a container,
# so a three-digit collision with a three-digit line number is ordinary
# rather than remote, and it happened on the first scoped run of the pass
# that found it.
#
# Bounding the digits by non-digits — which is what #3456 gave the bash and
# dash copies of this file — does not close it: `:121:` is a digit run
# bounded by non-digits on both sides. Only the *role* distinguishes them, so
# the mask matches the two sentences that carry a pid, zsh's `kill <pid>
# failed: …` and ksh93's `kill: <pid>: no such process`, and nothing else.
# ksh93's `kill: 99: unknown signal name` is why the second is a phrase and
# not a `kill: N:` shape: that row wears the same shape and holds a signal
# number.
#
# One shape in all three copies. internal/suite/pidmask_test.go is the guard
# that it does not over-match, and the reason the helper is written here as a
# function rather than inline.
nopid() { sed -e "s/kill $$ failed/kill <pid> failed/g" -e "s/kill: $$: no such process/kill: <pid>: no such process/g"; }

say 'a signal number out of range'
( kill -99 $$ ) 2>&1 > /dev/null | nopid
( kill -99 $$ ) > /dev/null 2>&1; printf 'status %s\n' "$?"

say 'the same number written to the option that takes one'
( kill -n 99 $$ ) 2>&1 > /dev/null | nopid
( kill -n 99 $$ ) > /dev/null 2>&1; printf 'status %s\n' "$?"

say 'and to the option that takes a name, which does not send'
( kill -s 99 $$ ) 2>&1 > /dev/null
( kill -s 99 $$ ) > /dev/null 2>&1; printf 'status %s\n' "$?"

say 'a pid that is really absent, for the errno to be compared against'
( kill -0 4194303 ) 2>&1 > /dev/null
( kill -0 4194303 ) > /dev/null 2>&1; printf 'status %s\n' "$?"

printf -- '--- and the ordering, with the sentences replaced\n'
mark() { sed -e 's/.*nosuchcommand_zz.*/<a diagnostic>/' -e 's/.*nosuchdir_zz.*/<a diagnostic>/'; }
( printf 'before\n'; nosuchcommand_zz; printf 'after\n' ) 2>&1 | mark
( printf 'one\n'; nosuchcommand_zz; printf 'two\n'; cd /nosuchdir_zz; printf 'three\n' ) 2>&1 | mark
