#
# Pattern matching, the answer only ksh93 gives.
#
# The five ksh sub-patterns are always on in ksh93: no option turns them on
# and none turns them off. bash hides the same five behind `shopt -s
# extglob`, zsh behind `setopt KSH_GLOB`, and dash has nothing of the kind,
# so a file that uses them unadorned is a file only ksh93 answers.
#
# `~(…)` — ksh93's pattern-modifier prefix, which is how it spells an ERE and
# a case-insensitive match — is at the foot of this file. It was left out when
# the file was written because this shell refused it at parse time (#2621).

# The five, in a case where no option was set to reach them.
for w in abc xyz abcabc ac ad abbbc nomatch; do
  case $w in
    @(abc|xyz)) printf '%s: @(…|…) is one of\n' "$w" ;;
    +(abc))     printf '%s: +(…) is one or more\n' "$w" ;;
    a?(b)c)     printf '%s: ?(…) is none or one\n' "$w" ;;
    a!(b)d)     printf '%s: !(…) is anything but\n' "$w" ;;
    a*(b)c)     printf '%s: *(…) is none or more\n' "$w" ;;
    *)          printf '%s: none of them\n' "$w" ;;
  esac
done

# The same five on the right of [[ == ]], which is where a script most often
# wants them.
[[ abc == @(abc|xyz) ]] && printf '%s\n' 'condition: @()'
[[ abcabcabc == +(abc) ]] && printf '%s\n' 'condition: +()'
[[ ac == a?(b)c ]] && printf '%s\n' 'condition: ?()'
[[ axd == a!(b)d ]] && printf '%s\n' 'condition: !()'
[[ ac == a*(b)c ]] && printf '%s\n' 'condition: *()'

# And in the expansion operators, where the sub-pattern decides how much of
# the word is eaten.
p=aXbXcX
printf '%s\n' "${p%%X}"
printf '%s\n' "${p##*(a)}"
printf '%s\n' "${p//@(X)/-}"
printf '%s\n' "${p/+(a|X)/=}"

# Alternation nests, and a sub-pattern takes an ordinary pattern inside it.
[[ foo.tar.gz == *.@(tar.gz|tgz) ]] && printf '%s\n' 'nested: *.@(tar.gz|tgz)'
[[ report2026 == @(report|memo)+([0-9]) ]] && printf '%s\n' 'nested: @()+([0-9])'
[[ abc == !(@(x|y)) ]] && printf '%s\n' 'nested: !(@(x|y))'

# A bracket expression keeps its POSIX meaning inside a sub-pattern, and a
# character class works there too.
[[ a1 == @([a-z])@([0-9]) ]] && printf '%s\n' 'bracket inside @()'
[[ Q == @([[:upper:]]) ]] && printf '%s\n' 'class inside @()'

# The ksh family strips the longest match with ## and %% and the shortest
# with # and %, and a sub-pattern makes the difference visible.
path=/one/two/three
printf '%s\n' "${path#*/}"
printf '%s\n' "${path##*/}"
printf '%s\n' "${path%/*}"
printf '%s\n' "${path%%/*}"

# `~(…)`, the pattern-modifier prefix, and this shell's only spelling for a
# regular expression: bash and zsh have `=~` and ksh93 has this. The letters
# below are the ones measured to change an answer — see #2621 for the whole
# sweep and for the ones deliberately left out.

# `E` is an extended regular expression, and it matches a *substring* where
# every glob in this file matches the whole word.
[[ foo123 == ~(E)^foo[0-9]+$ ]] && printf '%s\n' 'E: an anchored ERE'
[[ xabcx == ~(E)a.c ]] && printf '%s\n' 'E: matches inside the subject'
[[ xabcx == a?c ]] || printf '%s\n' 'a glob does not'

# `l` and `r` anchor that search to the ends of the subject.
[[ abcx == ~(El)a.c ]] && printf '%s\n' 'El: anchored left'
[[ xabc == ~(Er)a.c ]] && printf '%s\n' 'Er: anchored right'
[[ xabcx == ~(Elr)a.c ]] || printf '%s\n' 'Elr: both, so neither end may spare a character'

# `i` folds case, and it reaches a bracket and a character class as well as a
# literal.
[[ FOO == ~(i)foo ]] && printf '%s\n' 'i: a literal folds'
[[ ABC == ~(i)[abc][abc][abc] ]] && printf '%s\n' 'i: a bracket folds'
[[ ABC == ~(i)[[:lower:]][[:lower:]][[:lower:]] ]] && printf '%s\n' 'i: a class folds'
[[ ABC == ~(-i)abc ]] || printf '%s\n' '-i: and the toggle turns it back off'

# `F` and `L` are the literal flavors: nothing in the pattern is a
# metacharacter.
[[ 'a.c' == ~(F)a.c ]] && printf '%s\n' 'F: the three characters'
[[ abc == ~(F)a.c ]] || printf '%s\n' 'F: and not a pattern'

# `K` is the ksh glob, which is what a pattern with no prefix already is, and
# an empty group says nothing at all.
[[ abc == ~(K)a?c ]] && printf '%s\n' 'K: the glob, said explicitly'
[[ abc == ~()abc ]] && printf '%s\n' '(): a group that says nothing'

# The group reaches every surface a pattern does.
case abc in ~(E)^a.c$) printf '%s\n' 'case: an ERE arm' ;; esac
s=aXbXc
printf '%s\n' "${s//~(E)X/-}"
printf '%s\n' "${s//~(i)x/-}"

# And a word that is not being matched keeps the characters: the prefix
# belongs to the word, and only a pattern reads it.
printf '%s\n' ~(E)a.c
