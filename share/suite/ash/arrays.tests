#
# Arrays in BusyBox ash, which does not have it — an ext/ area this column
# does not run.
#
# BusyBox takes a good part of the ext/ list (`$'…'`, `[[`, substrings, the
# replacement, `function`), so which constructs it lacks is a question per
# construct rather than a foregone one. This one it lacks, and it answers
# every row with the same shape dash does: the same refusal at the same
# place, in BusyBox's own wording (`syntax error: unexpected "("`, a
# `line N` after `eval:`).
#
# Every refusal is asked through `eval` in a subshell, so a script that
# reaches one goes on to the next row and the file's own parse is not what
# is being graded.
#
# Measured 2026-09-16 in the pinned alpine image, BusyBox v1.37.0.

try() {
	( eval "$1" ) 2>&1
	printf '  -> %s\n' "$?"
}

printf -- '--- an array assignment does not parse ---\n'
try 'a=(1 2 3); printf "%s\n" "$a"'
try 'a=(); printf "empty\n"'
try 'printf "ran\n"; a=(x)'
printf -- '--- a subscripted name is a command word ---\n'
try 'a[1]=x; printf "[%s]\n" "$a"'
try 'a[1]=x'
printf -- '--- and a subscript in an expansion is a bad substitution ---\n'
try 'a=x; printf "%s\n" "${a[0]}"'
try 'set -- p q; printf "%s\n" "${#@}"'
try 'printf "%s\n" "${a[@]}"'
printf -- '--- positional parameters are the one list ---\n'
set -- one "two three" four
printf '%s:' "$#"; printf '<%s>' "$@"; printf '\n'
