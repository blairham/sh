#
# `return` where there is no function and no dot script to return from: bash
# refuses it and carries on, and it is alone in both halves of that.
#
# zsh, ksh93 and dash all take a top-level `return` as an `exit` — the script
# ends there with the status given. bash writes a diagnostic, leaves the
# status at 2 and runs the next line, so a script whose last line is a bare
# `return 0` ends at 2 under bash and at 0 everywhere else.
#
# The subshell asks the same question one level down, because a subshell is
# not a function: the other three end the subshell with the operand, bash
# refuses it there too.

( return 4 ) 2> /dev/null
printf 'return in a subshell -> %s\n' "$?"

( return ) 2> /dev/null
printf 'with no operand -> %s\n' "$?"

# Inside a function it is the ordinary thing, and it is the ordinary thing in
# bash as well — this line is here so the file is not only the difference.
f() { return 6; }
f
printf 'return from a function -> %s\n' "$?"

# And at the top level of the file, which is the line the other three stop
# at. It is last for that reason.
printf 'about to return at the top level\n'
return 5 2> /dev/null
printf 'bash carried on, status %s\n' "$?"
