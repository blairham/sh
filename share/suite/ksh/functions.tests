#
# Function definition, scope and return in ksh93 — #2302.
#
# The whole of this file is the facility no other shell on the panel has: a
# *discipline* function. A `function name.get` is not a function called
# `name.get` — it is a hook the shell runs when the variable `name` is read,
# and `.set`, `.append` and `.unset` are the same for the other three events.
# bash and zsh read every line here as an ordinary function whose name has a
# dot in it, so the hook never fires and the variable answers plainly; dash
# will not parse the `function` keyword at all.
#
# The reserved names around them are the same story. `${.sh.fun}` is the
# function running now, `${.sh.level}` its depth, `${.sh.name}` and
# `${.sh.subscript}` the variable and element a discipline was entered for,
# and `${.sh.value}` the value the event carries. Every one of them is a
# name in ksh93's own `.sh` namespace, which the other three shells cannot
# even expand — they report a bad substitution.
#
# Two of the answers below are worth naming before they are read, because
# they look like mistakes and are not.
#
# `.get` is entered with `${.sh.value}` **empty** in 93u+, not with the
# variable's current value, so a discipline written to decorate what is
# already there decorates nothing. That is what this build does, it does it
# every time, and a later ksh93 that fills it in would change this file —
# which is the reason to have the file rather than a reason to leave the
# case out.
#
# Each section runs in a subshell, which is this directory's usual shape and
# is load-bearing here: refusing a discipline definition is *fatal* in ksh93
# and in any shell that copies the refusal, so a section written at the top
# level would take every later section down with it and the file would
# measure one line. Inside a subshell a gap costs its own section and the
# rest of the file is still evidence.
#
# A `function` whose name contains a dot is not a namespace here. ksh93 reads
# it as a discipline for the variable named by the part before the dot, so
# `function ns.thing` with no `ns` in scope is refused as an *invalid
# discipline function* rather than defined. It is the one spelling in this
# file the other shells accept and run.

printf -- '--- .get is entered with an empty value ---\n'
(
  g=raw
  function g.get { .sh.value="[${.sh.value}]"; }
  printf 'read once: %s\n' "$g"
  printf 'read twice: %s\n' "$g"
  printf 'expanded in a word: <%s>\n' "${g}"
)

printf -- '--- .set sees the value on its way in ---\n'
(
  function s.set { .sh.value="<${.sh.value}>"; }
  s=first
  printf 's after the assignment: %s\n' "$s"
  s=second
  printf 's after a second: %s\n' "$s"

  # The discipline decorates once per assignment rather than once per read, so
  # the wrapping does not accumulate. That is the half that tells .set from
  # .get, and it is why both are here.
)

printf -- '--- the name and the subscript a discipline was entered for ---\n'
(
  function n.set { printf 'set name=[%s] value=[%s] subscript=[%s]\n' "${.sh.name}" "${.sh.value}" "${.sh.subscript}"; }
  n=plain
  n[3]=indexed
)

printf -- '--- .append is given only what was appended ---\n'
(
  function p.append { printf 'append was given [%s]\n' "${.sh.value}"; }
  p=base
  p+=more
  printf 'p=[%s]\n' "$p"
)

printf -- '--- .unset runs before the name goes ---\n'
(
  u=here
  function u.unset { printf 'the unset discipline ran, and u is still [%s]\n' "$u"; }
  unset u
  printf 'after the unset: [%s]\n' "${u-gone}"
)

printf -- '--- the function running now, and how deep ---\n'
(
  function outer { printf 'fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"; inner; }
  function inner { printf 'fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"; }
  outer
  posixform() { printf 'the POSIX form answers too: fun=[%s]\n' "${.sh.fun}"; }
  posixform
  printf 'at the top: fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"
)

# The depth after a call has returned, which is `0` and *set* — and is the
# half of the starting-value question a file like this one can ask.
(
  function called { :; }
  called
  printf 'after a call has returned: [%s] [%s] [%s]\n' \
    "${.sh.level}" "${.sh.level-UNSET}" "${.sh.level+SET}"
)

# **The other half cannot be asked here, and that is worth writing down.**
# Before the *first* call the parameter is not there at all — `${.sh.level}`
# is empty, `${.sh.level-UNSET}` takes its default, `${.sh.level+SET}` is
# empty and `set -u` stops on the read — which is a third state beside `0` and
# empty, and is what makes the `0` above a starting value rather than an
# off-by-one. It needs a shell that has called nothing, and by this line this
# one has called plenty: a subshell inherits the state, and a **discipline
# function is a call**, so the `.get` in the first section of this file
# already settled it. dialect/ksh's own Go tests ask it in a script of their
# own. Measured 2026-09-18 (#3310).

# **A sourced file is deliberately left out of this section**, and the absence
# is the measurement. In ksh93u+ 2012-08-01 a dot script makes the depth read
# `1` at the top of a script where nothing has been called and `0` after a
# function has been called and returned — the *same source line*, in the same
# script, with no enclosing construct either time — so the parameter there
# carries a leftover from the last frame that wrote it rather than a depth.
# Reordered and repeated, the answer follows what ran before it. This shell
# counts function frames and nothing else, which agrees wherever the parameter
# is a depth at all and answers `0` where that shell answers a leftover.
# Copying the rows that look rule-shaped without the one that does not would
# be a third behavior that is neither shell's. See #3117, and
# docs/spec/semantics.md for the whole grid.

printf -- '--- a dotted name is a discipline, not a namespace ---\n'
(
  ( eval 'function ns.thing { printf "ran\n"; }' ) 2>&1 | sed 's/^.*: ns\./ns./'
)

printf -- '--- typeset -f writes the definition back out ---\n'
(
  function shown { printf 'in shown\n'; }
  plain() { printf 'in plain\n'; }
  typeset -f shown
  typeset -f plain
  printf 'names alone: [%s]\n' "$(typeset +f | sort | tr '\n' ' ')"
)

printf -- '--- autoload finds a definition on FPATH ---\n'
(
  mkdir -p fns
  printf 'function auto { printf "autoloaded\\n"; }\n' > fns/auto
  FPATH=$PWD/fns
  autoload auto
  auto
  printf 'the autoloaded call -> %s\n' "$?"
)

printf -- '--- return takes the low byte ---\n'
(
  function big { return 300; }
  big
  printf 'return 300 -> %s\n' "$?"
)

printf -- '--- a .get is entered for one element, with its subscript ---\n'
(
  a=(p q r)
  function a.get { printf 'get sub=[%s] name=[%s]\n' "${.sh.subscript}" "${.sh.name}"; }
  printf 'one element: %s\n' "${a[1]}"
  printf 'a subscript nothing was assigned at: [%s]\n' "${a[9]}"

  # A count and a list of names are not reads of a value, and neither enters
  # the hook. The length of *one* element is a read and does.
  printf 'how many: %s\n' "${#a[@]}"
  printf 'which subscripts: %s\n' "${!a[@]}"
  printf 'the length of one: %s\n' "${#a[1]}"
)

printf -- '--- every element of a whole-array read is its own event ---\n'
(
  a=(p q r)
  function a.get { .sh.value="<${.sh.subscript}>"; }
  printf '[%s]' "${a[@]}"
  printf '\n'
  # A bare read of an array is a read of its first element, and the hook is
  # told which one: the subscript here is 0 and not the empty string a scalar
  # read carries.
  printf 'bare: [%s]\n' "$a"
  # Counting back from the end arrives counted forwards.
  printf 'last: [%s]\n' "${a[-1]}"
)

printf -- '--- a keyed table hands the discipline its key ---\n'
(
  typeset -A m=([x]=1 [y]=2)
  function m.get { .sh.value="<${.sh.subscript}>"; }
  printf 'one key: [%s]\n' "${m[x]}"
  printf 'a key the table has not got: [%s]\n' "${m[zz]}"
  printf '[%s]' "${m[@]}"
  printf '\n'
)

printf -- '--- what a .set returns is the assignment status ---\n'
(
  function s.set { return 5; }
  s=1
  # Both halves, because the status alone cannot tell a hook that decided it
  # from an assignment that failed: the store happens either way.
  printf 'status=%s value=[%s]\n' "$?" "$s"

  # A substitution on the right-hand side does not outrank it.
  s=$(false)
  printf 'over a failed substitution: %s\n' "$?"

  # The declaration, the read and the loop fire the very same hook and report
  # none of it.
  typeset s=2
  printf 'typeset: %s\n' "$?"
  printf 'x\n' | read s
  printf 'read: %s\n' "$?"
  for s in one; do :; done
  printf 'for: %s\n' "$?"

  # And the status belongs to the assignment that ran the hook. A plain
  # assignment to a name with no discipline of its own, straight after one
  # that failed, is 0 — which is what says the answer is read from this
  # command rather than left lying about from the last one.
  plain=ok
  printf 'a name with no hook: %s\n' "$?"
)

printf -- '--- an exported name reaches a child through its .get ---\n'
(
  g=raw
  function g.get { .sh.value=A; }
  export g
  env | grep '^g='
)

printf -- '--- writing the level selects a frame ---\n'
(
  function inner {
    printf 'where it is: fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"
    .sh.level=1
    printf 'one frame out: fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"
    # A level outside the stack is heard and moves nothing — it neither
    # clamps to the innermost frame nor puts the selection back.
    .sh.level=9
    printf 'out of range: fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"
    .sh.level=0
    printf 'the top: fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"
  }
  function outer { inner; printf 'back in the caller: fun=[%s] level=[%s]\n' "${.sh.fun}" "${.sh.level}"; }
  outer

  # The name is separately assignable, and the selection lasts no longer than
  # the frame that made it: the next call answers for itself.
  function named { .sh.fun=zzz; printf 'named: fun=[%s]\n' "${.sh.fun}"; }
  named
  function after { printf 'the next call: fun=[%s]\n' "${.sh.fun}"; }
  after
)

printf -- '--- a prefix fires the hook only where it stores ---\n'
(
  function s.set { printf 'SET[%s]\n' "${.sh.value}"; }
  function s.append { printf 'APP[%s]\n' "${.sh.value}"; }

  # A regular builtin's prefix is the environment it is handed rather than a
  # store in the shell, so nothing fires and nothing is left behind.
  s=5 true
  printf 'after a regular builtin: [%s]\n' "$s"
  s=5 command true
  printf 'after command: [%s]\n' "$s"

  # A special builtin's persists, and a store is what the hook is about.
  s=5 :
  printf 'after a special builtin: [%s]\n' "$s"
)

printf -- '--- and a prefix to a function is a store too ---\n'
(
  # Its own section rather than another command in the one above, because
  # `unset` between them would take the discipline with it — the hook goes on
  # being a function `typeset -f` lists and stops being this variable's.
  function s.set { printf 'SET[%s]\n' "${.sh.value}"; }
  pf() { printf 'the function sees: %s\n' "$s"; }
  s=5 pf
  printf 'after a function: [%s]\n' "$s"
)

printf -- '--- an append prefix names the append event ---\n'
(
  # `+=` enters `.append` with the part being appended, and not `.set` with
  # the whole join.
  function s.set { printf 'SET[%s]\n' "${.sh.value}"; }
  function s.append { printf 'APP[%s]\n' "${.sh.value}"; }
  s=base
  s+=5 :
  printf 'after an append prefix: [%s]\n' "$s"
  s+=9 true
  printf 'after one to a regular builtin: [%s]\n' "$s"
)

printf -- '--- an append prefix rewrites only the appended part ---\n'
(
  # A name of its own: ksh93 does not undo a function definition made in a
  # subshell, so an `s.set` from a section above would still be watching `s`
  # here and this section would be measuring that instead.
  t=base
  function t.append { .sh.value="<${.sh.value}>"; }
  t+=5 :
  printf 'joined: %s\n' "$t"
)

printf -- '--- an inherited name reaches a child as it came in ---\n'
(
  # PATH is inherited by this shell and nothing here assigns it, so the child
  # is handed the text that came in — which is what a shell with any hook in
  # it stopped doing when the environment asked a discipline with the name in
  # place of the value. Counted rather than printed: the path itself is the
  # harness's and not an answer.
  function q.set { :; }
  printf 'entries naming themselves: %s\n' "$(env | grep -c '^PATH=PATH$')"
)
