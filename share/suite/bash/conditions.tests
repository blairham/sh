#
# Two answers about `[[ ]]` that are bash's alone, and both of them are the
# kind a script gets wrong silently.
#
# A **quoted** right-hand side of `=~` is literal text in bash and is still a
# regular expression in zsh and ksh93. So `[[ $x =~ "a.c" ]]` asks whether
# the value is the three characters `a.c` here and whether it contains any
# `a`-something-`c` there — true and false on the same input, with no
# diagnostic either way.
#
# And a numeric comparison inside `[[ ]]` reads its operands as arithmetic,
# which in bash means a leading zero is octal. `[[ 010 -eq 10 ]]` is false
# here and true in zsh and ksh93, so a zero-padded number from `date` or from
# a file name compares as a different number.
#
# BASH_REMATCH is the third: the captures of the last `=~` are bash's and
# nobody else's, zsh putting them in MATCH and match and ksh93 in .sh.match.

[[ abc =~ "a.c" ]] || printf 'a quoted regex is literal text\n'
[[ a.c =~ "a.c" ]] && printf 'and matches the characters it is\n'
re='^a.c$'
[[ abc =~ "$re" ]] || printf 'a quoted expansion is literal too\n'
[[ abc =~ $re ]] && printf 'and unquoted it is the regex\n'

[[ 010 -eq 10 ]] || printf 'a leading zero is octal in a numeric comparison\n'
[[ 010 -eq 8 ]] && printf 'and 010 is eight\n'
[[ 10 -eq 10 ]] && printf 'without one it is decimal\n'

[[ abcd =~ (b)(c) ]]
printf 'BASH_REMATCH [%s][%s][%s]\n' "${BASH_REMATCH[0]}" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
printf 'and how many of them: %s\n' "${#BASH_REMATCH[@]}"
[[ abcd =~ z ]]
printf 'after a miss [%s] %s\n' "${BASH_REMATCH[0]}" "${#BASH_REMATCH[@]}"

# And `[[ -v a[k] ]]` reads the subscript the script *wrote*, not the one
# left standing once the operand has been expanded and unquoted. A bracket
# inside quotes, one behind a backslash, and one that arrives out of an
# expansion are all content, so each of the four spellings below finds the
# element whose key really is the two characters `x]`. zsh 5.9.2 and ksh93u+
# answer unset to every one of them.
#
# The last two are the controls, and they are what makes this a rule about
# written brackets rather than "the subscript ends at the last bracket":
# written out, `a[x]]` closes its subscript and then has a bracket nobody
# opened, and `a[q[r]` opens one nobody closes. bash refuses both.
#
# `test -v` is the row where bash's own two spellings of the operator part,
# and it is not an oversight on either side: the builtin is handed one word
# that has already been expanded, so there is no written bracket left in it.
declare -A brk
brk['x]']=closer
brk['q[r']=opener
bk=']'
bo='q[r'
[[ -v brk["x]"] ]] && printf 'a double-quoted bracket is part of the key\n'
[[ -v brk['x]'] ]] && printf 'and so is a single-quoted one\n'
[[ -v brk[x\]] ]] && printf 'and one behind a backslash\n'
[[ -v brk[x$bk] ]] && printf 'and one out of an expansion\n'
[[ -v brk[$bo] ]] && printf 'at the opening end too\n'
[[ -v brk[x]] ]] || printf 'a written bracket closes the subscript\n'
[[ -v brk[q[r] ]] || printf 'and a written one left open is no subscript\n'
[[ -v brk[nope] ]] || printf 'an ordinary absent key is still absent\n'
test -v "brk[x$bk]" || printf 'the test builtin has no written bracket to read\n'

# The word-spelled comparisons read the subscript the script wrote too, which
# is this shell alone in the panel and not the same measurement as the `-v`
# rows above: ksh93u+ reads a quotation inside a subscript in `(( ))` and
# still refuses it here, because a condition's operand reaches its arithmetic
# already expanded. zsh 5.9.2 refuses it as well (#3302).
declare -A cmp
cmp[']']=5
cmp['x]']=9
cmp[q]=8
ck='x]'
[[ cmp[']'] -eq 5 ]] && printf 'a single-quoted bracket is part of the key\n'
[[ cmp["]"] -eq 5 ]] && printf 'and so is a double-quoted one\n'
[[ cmp[x$ck] -eq 0 ]] && printf 'a bracket out of an expansion is content\n'
[[ cmp[$ck] -eq 9 ]] && printf 'and the whole key can come out of one\n'
[[ cmp['q'] -eq 8 ]] && printf 'a quotation with no bracket in it still reaches the key\n'
[[ cmp[nope] -eq 0 ]] && printf 'an absent key is zero to a comparison\n'
