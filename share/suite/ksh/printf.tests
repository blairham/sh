#
# ksh93's printf, where it is alone among the four.
#
# `%q` is the largest of them. bash and zsh both write `a\ b` — a backslash
# per character that needs one — and ksh93 quotes the word instead, reaching
# for `$'…'` when a quote is inside it. dash has no `%q` at all. Three
# answers among four shells, so the conversion is in no shared tier and is
# asked here and in dash/.
#
# Held out, each with its issue, and each a place ours answers as the other
# three do rather than as ksh93 does:
#
#   #2903  a half rounds away from zero here and to even everywhere else:
#          `printf '%.0f %.0f' 2.5 4.5` is `3 5` in ksh93 and `2 4` in ours
#   #2904  an escape the format does not define loses its backslash:
#          `printf '[\q]\n'` is `[q]` in ksh93 and `[\q]` in ours

printf '[%q]\n' 'a b'
printf '[%q]\n' "it's"
printf '[%q]\n' ''
printf '[%q]\n' plain
printf '[%q]\n' 'two
lines'
printf '[%q]\n' '$HOME'
printf '[%q]\n' 'a*b?c'

# A star with no operand to take the width from. The other three quietly use
# zero; ksh93 refuses the format outright, and the refusal is a diagnostic
# rather than a silent zero. It is run in a subshell so the file survives
# whatever the status is.
( printf 'star with no operand [%*d]\n' ) 2> /dev/null
printf 'that was %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"

# A format ending in a bare percent. bash, zsh and dash all stop there and
# report a failure; ksh93 writes the percent out and succeeds.
( printf 'a bare percent [%' ) 2> /dev/null
printf '\nand that was %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"

# An integer operand is carried through this shell's floating type, so one
# past what a double holds exactly comes back rounded: bash, zsh, dash and
# BusyBox ash all write the digits unchanged. The int64 maximum is the operand
# that hides it -- it rounds to 2^63 and saturates back to itself, so it is
# exact here too -- and one short of the negative end is where the same
# rounding shows with nothing to hide it.
printf '[%d]\n' 123456789012345678
printf '[%d]\n' 1000000000000000001
printf '[%d]\n' 9007199254740993
printf '[%d]\n' 9223372036854775807
printf '[%d]\n' -9223372036854775807
printf 'and an ordinary one [%d]\n' 42
