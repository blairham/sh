#
# `set -u` and the positional parameters: ksh93 does not count an absent one
# as an unset name, and it is alone in that.
#
# `set -u; set --; printf '%s' "$1"` ends bash, zsh and dash and prints an
# empty line here. It is the shape a script meets in an argument check —
# `set -u` at the top and `$1` read before `$#` is looked at — and it means
# the check fires in three shells and passes silently in the fourth.
#
# And the `set -o` roster, which is this shell's alone twice over: it is
# thirty-two rows where the other three write about twenty, and five of them
# — `clobber`, `exec`, `glob`, `log` and `unset` — are the *positive*
# spelling of a name the rest list negative. Same state, opposite row.
#
# `set +o` is the other half and is asked here too, because the two are not
# the same question in this shell: that line names the states it **stores**,
# so a negated row appears under the `no…` spelling and only when it is off,
# and a row the shell will not take is left out of it altogether.

( set -u; set --; printf 'the first positional [%s]\n' "$1" ) 2> /dev/null
printf 'an absent positional -> %s\n' "$?"
( set -u; set --; printf 'the whole list [%s]\n' "$*" ) 2> /dev/null
printf 'the list itself -> %s\n' "$?"
( set -u; set -- a; printf 'one that is there [%s]\n' "$1" ) 2> /dev/null
printf 'a positional that is set -> %s\n' "$?"
( set -u; printf '[%s]' "$NOSUCH_ZZ" ) 2> /dev/null
printf 'and an ordinary name is still unset -> %s\n' "$?"

# The whole roster, and the states a script starts in.
set -o

# The same thing as a command that could be read back in. Twice more with one
# option moved each way, which is what says the line follows the state rather
# than being a constant — and the second of them moves a *negated* row, where
# the spelling on the line is not the spelling in the listing above.
set +o
( set -o errexit; set +o )
( set +o clobber; set +o )

# A row this shell lists and will not take, in both directions. The complaint
# is the one a name it has never heard of gets, and it ends the shell — so
# each is asked in a subshell of its own.
( set -o interactive ) 2> /dev/null; printf 'set -o interactive -> %s\n' "$?"
( set +o rc ) 2> /dev/null; printf 'set +o rc -> %s\n' "$?"

# ---- `set -k`, the keyword option ----
#
# POSIX's keyword option: with it on, **every** `name=value` word of a simple
# command is a prefix assignment and not only the ones in front of the command
# name. ksh93 and bash have it, zsh spells `interactivecomments` with the same
# letter, and dash and BusyBox ash end the file over it — so it cannot be a
# core or an ext case, and this half of it is graded against ksh93.
#
# Two things are this shell's own. A promoted assignment **outlives the call**,
# exactly as one written in front of a function does here and does not in bash;
# and the option leaves a declaration utility's own operand where it stands,
# where bash takes that too and leaves the utility with nothing to act on.
# bash/shell-options.tests holds the same rows with the other answer.
#
# `set -k` stands on a line of its own throughout, because this shell decides
# the option while **parsing**: `set -k; f A=1 x` on one line reaches nothing
# here even though it works in bash, and a case written that way would be
# asking the two columns different questions.
#
# The argument words are `zz` and `yy` rather than anything shorter: `r` is a
# preset alias for `hist -s` in this shell, and an argument standing behind an
# assignment is alias-expanded — so a probe using it reports two arguments and
# an argument nobody wrote.

f() { printf 'f: 1=[%s] KV=[%s] n=%s\n' "${1-.}" "${KV-unset}" "$#"; }
set -k
f KV=2 zz
printf 'and the promoted name outlives the call [%s]\n' "${KV-unset}"
unset KV

# Several on one command, and the last of a repeated name wins.
g() { printf 'g: 1=[%s] A=[%s] B=[%s] n=%s\n' "${1-.}" "${A-unset}" "${B-unset}" "$#"; }
g A=1 xx B=2
unset A B
g A=4 A=5 yy
unset A

# A `--` does not stop it: it is not an end-of-options marker for this.
g -- C=3
printf 'C after the double dash [%s]\n' "${C-unset}"
unset C

# The **written** word decides and not the expanded one.
w='A=9'
g $w yy
g 'A=10' yy
g 1A=11 yy

# The value may hold what a written assignment's may, and is neither split nor
# matched against the filesystem.
h() { printf 'h: 1=[%s] Q=[%s] n=%s\n' "${1-.}" "${Q-unset}" "$#"; }
V=vv
h Q=$V yy
h Q="$V" yy
h Q=x$V yy
h Q=$(printf cs) yy
h Q=$((1+1)) yy
h Q= yy
h Q=a=b yy
unset Q

# It reaches a builtin and an external alike, and an external is handed the
# name in its environment — which is what the option is for.
printf 'echo drops it -> [%s]\n' "$(echo A=12 kept)"
unset A
env A=13 > k.env
printf 'an external is told -> %s\n' "$(grep -c '^A=13$' k.env)"
unset A

# The letter shows in `$-`, and the long name is the same state.
case "$-" in *k*) printf 'the letter is in $-\n' ;; *) printf 'the letter is not in $-\n' ;; esac
set +k
case "$-" in *k*) printf 'and set +k left it\n' ;; *) printf 'and set +k took it out\n' ;; esac
g A=14 yy
set -o keyword
printf 'set -o keyword -> %s\n' "$?"
g A=15 yy
unset A
set +o keyword
printf 'set +o keyword -> %s\n' "$?"
g A=16 yy

# The row bash does not share: a declaration utility keeps its own operand.
set -k
export E1=e1 > /dev/null
printf 'export under -k [%s]\n' "${E1-unset}"
readonly R1=r1 > /dev/null
printf 'readonly under -k [%s]\n' "${R1-unset}"
typeset -i N1=3*3 > /dev/null
printf 'typeset under -k [%s]\n' "${N1-unset}"
set +k

# ---- every name the roster carries is a name a script can move ----
#
# The listing is a capture surface, so a row it writes that `set` will not take
# is a promise the shell then declines — and `eval "$(set +o)"` is the idiom
# that collects the bill. #2925 gave this file's listing all thirty-two of
# ksh93's rows; these are the rows moving, which is the other half (#3128).
#
# Each name is asked in a subshell of its own for two reasons: a refusal ends
# the shell here, `set` being a special builtin, and `restricted` would take
# the rest of the file with it if it landed in this one.
#
# The state is read back as well as the status, because a status alone cannot
# tell "taken and remembered" from "taken and dropped on the floor" — and one
# name in the roster really is the second of those.

for o in bgnice globstar gmacs ignoreeof letoctal markdirs notify restricted showme
do
	( set -o $o ) 2> /dev/null
	printf 'set -o %s -> %s\n' "$o" "$?"
	( set +o $o ) 2> /dev/null
	printf 'set +o %s -> %s\n' "$o" "$?"
done

# The three whose listed state is on, so the plus direction is the request and
# the minus one is the state they are already in.
for o in multiline viraw log
do
	( set +o $o ) 2> /dev/null
	printf 'set +o %s -> %s\n' "$o" "$?"
	( set -o $o ) 2> /dev/null
	printf 'set -o %s -> %s\n' "$o" "$?"
done

# And the state each one is left in, which is the half a status cannot report.
( set -o globstar; set -o ) | grep '^globstar'
( set -o markdirs; set -o ) | grep '^markdirs'
( set -o notify; set -o ) | grep '^notify'
( set -o bgnice; set -o ) | grep '^bgnice'
( set +o multiline; set -o ) | grep '^multiline'
( set +o log; set -o ) | grep '^log'

# `privileged` is the name that is taken and does not move. It is 0 in both
# directions with nothing on standard error, and the row still reads off
# afterwards — the shell does not hand out privilege because a script asked.
( set -o privileged ) 2> /dev/null; printf 'set -o privileged -> %s\n' "$?"
( set +o privileged ) 2> /dev/null; printf 'set +o privileged -> %s\n' "$?"
( set -o privileged; set -o ) | grep '^privileged'

# The `set +o` line follows a moved row, which is what makes the save half of
# the idiom worth having.
( set -o globstar; set +o )
( set -o notify; set -o bgnice; set +o )

# And the same names through the `--name` spelling, which reads this very
# namespace — so a name the roster carries and `-o` moves must move here too.
( set --globstar; set -o ) | grep '^globstar'
( set --noglobstar; set -o ) | grep '^globstar'
( set --markdirs; set --nomarkdirs; set -o ) | grep '^markdirs'

# ---- `set -x` and the assignment written in front of a command ----
#
# ksh93's shape, and the one the panel has no majority for: **a line of its
# own for each assignment, behind the command's** — `+ /bin/echo ext` and
# then `+ D=6`. bash writes the same lines ahead of the command and dash,
# BusyBox ash and zsh write them on the command's line, so each column's file
# carries its own rows. See interp/xtraceprefix.go and #3133, where this shell
# wrote nothing for the position at all.
#
# The half that is not "behind", and the reason the rows below are four
# commands and not one: a **special builtin** and a **function** keep the
# assignment in front, where a regular builtin and an external put it behind.
# Those are exactly the two positions where a prefix in this shell is an
# ordinary assignment that stays assigned, so the shell is writing it where a
# bare assignment would be written. `xf` is the function, `:` the special
# builtin, `true` the regular one and `/bin/echo` the external, and a reading
# that used only one of them would record a quarter of the answer.
#
# `PS4='+ '` is this shell's own default and is written so that the same rows
# in bash/ and zsh/ are the same rows.

xf() { :; }
PS4='+ '
exec 3>&2 2> xt.err
set -x
A=3 xf zz
B=4 true
C=5 :
D=6 E=7 /bin/echo ext
V=$(printf vv) :
Q='a b' :
v=14
v+=5 :
set +x
exec 2>&3
cat xt.err
printf 'and the append did not outlive the command [%s]\n' "$v"

# ---- `set -o globstar`, and the walk behind it ----
#
# The row moved from #3128 and `**` went on reading as `*`, which is the same
# promise the refusal was, one level quieter: `set -o globstar` at 0 with the
# listing saying `globstar on` and a script still getting `d/e` for `d/**`
# (#3152).
#
# Four questions hang on the one name here, and three of them are bash's
# answers too — `**` crosses levels, `**/` names a symlinked directory
# without entering it, and a run of `**` is one component rather than a cross
# product. The other two are this shell's alone, and neither is the symmetric
# guess:
#
#   - A zero-level `**` is **not** the directory the walk stood in. What it
#     reports is what the component ahead of it *listed*, so `p/**` names no
#     `p/` at all, `*/**` names the plain file `topf` that no walk could have
#     stood in, and `*/q/**` and `**/q/**` differ while spelling the same `q`.
#   - A pattern holding a `**` reads no directory through a symbolic link —
#     the one the walk starts in included — while the same shell with the
#     option still on reads straight through that link for a pattern with no
#     `**` in it.
#
# Every pattern is printed one word per `[…]`. A table built with `echo` looks
# identical across every column in the panel, because `echo` joins with
# spaces and the whole question here is where the words divide.

mkdir -p gs/p/q/w gs/r
: > gs/topf; : > gs/p/pf; : > gs/p/q/qf; : > gs/p/q/w/leaf; : > gs/r/x
ln -s r gs/s

# Off first, so the rows below are a difference and not a claim.
( cd gs; printf 'off p/**  [%s]' p/**; printf '\n' )

( cd gs
  set -o globstar
  printf 'set -o globstar -> %s\n' "$?"
  [[ -o globstar ]] && printf 'and the condition agrees\n'

  # Crossing, with a component behind it and with none.
  printf 'p/**       [%s]' p/**; printf '\n'
  printf '**/qf      [%s]' **/qf; printf '\n'
  printf 'p/q/**     [%s]' p/q/**; printf '\n'

  # The zero-level question, four ways. The prefix decides it, and `*/**`
  # naming a plain file is what says the match is a listing and not a place
  # the walk stood.
  printf '*/**       [%s]' */**; printf '\n'
  printf 'p/*/**     [%s]' p/*/**; printf '\n'
  printf '*/q/**     [%s]' */q/**; printf '\n'
  printf '**/q/**    [%s]' **/q/**; printf '\n'
  printf '**/q/w/**  [%s]' **/q/w/**; printf '\n'

  # A trailing slash asks for directories and writes one slash, not two.
  printf 'p/**/      [%s]' p/**/; printf '\n'
  printf '*/**/      [%s]' */**/; printf '\n'

  # A run of `**` is one component. Without that the run is a cross product
  # and every name comes back once per way of splitting it.
  printf '**/**/     [%s]' **/**/; printf '\n'
  printf 'p/**/**    [%s]' p/**/**; printf '\n'

  # Links: named by `**/`, never entered, and not read from at all by a
  # pattern that holds a `**`.
  printf '**/        [%s]' **/; printf '\n'
  printf '**/x       [%s]' **/x; printf '\n'
  printf 's/**       [%s]' s/**; printf '\n'
  printf 's/**/x     [%s]' s/**/x; printf '\n'
  # A literal component is joined and stat'd rather than listed, so it
  # reaches through the same link in the same pattern.
  printf '*/x        [%s]' */x; printf '\n'
  # And with no `**` in the word the link is read like any other directory,
  # with the option still on.
  printf 's/*        [%s]' s/*; printf '\n'
  printf '*/*        [%s]' */*; printf '\n'
)

# The letter is the same option: `set -G` moves the row and shows in `$-`.
( cd gs
  set -G
  printf 'set -G -> %s\n' "$?"
  set -o | grep '^globstar'
  case "$-" in *G*) printf 'the letter is in $-\n' ;; *) printf 'the letter is not in $-\n' ;; esac
  printf 'set -G p/** [%s]' p/**; printf '\n'
  set +G
  set -o | grep '^globstar'
  case "$-" in *G*) printf 'and set +G left it\n' ;; *) printf 'and set +G took it out\n' ;; esac
)

# A subshell that turns it off does not reach the shell that started it.
( cd gs
  set -o globstar
  ( set +o globstar; printf 'inner [%s]' p/**; printf '\n' )
  printf 'outer [%s]' p/**; printf '\n'
)
