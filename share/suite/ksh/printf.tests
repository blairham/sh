#
# ksh93's printf, where it is alone among the four.
#
# `%q` is the largest of them. bash and zsh both write `a\ b` — a backslash
# per character that needs one — and ksh93 quotes the word instead, reaching
# for `$'…'` when a quote is inside it. dash has no `%q` at all. Three
# answers among four shells, so the conversion is in no shared tier and is
# asked here and in dash/.
#
# Held out, each with its issue, and each a place ours answers as the other
# three do rather than as ksh93 does:
#
#   #2903  a half rounds away from zero here and to even everywhere else:
#          `printf '%.0f %.0f' 2.5 4.5` is `3 5` in ksh93 and `2 4` in ours
#   #2904  an escape the format does not define loses its backslash:
#          `printf '[\q]\n'` is `[q]` in ksh93 and `[\q]` in ours

printf '[%q]\n' 'a b'
printf '[%q]\n' "it's"
printf '[%q]\n' ''
printf '[%q]\n' plain
printf '[%q]\n' 'two
lines'
printf '[%q]\n' '$HOME'
printf '[%q]\n' 'a*b?c'

# A star with no operand to take the width from. The other three quietly use
# zero; ksh93 refuses the format outright, and the refusal is a diagnostic
# rather than a silent zero. It is run in a subshell so the file survives
# whatever the status is.
( printf 'star with no operand [%*d]\n' ) 2> /dev/null
printf 'that was %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"

# A format ending in a bare percent. bash, zsh and dash all stop there and
# report a failure; ksh93 writes the percent out and succeeds.
( printf 'a bare percent [%' ) 2> /dev/null
printf '\nand that was %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"

# An integer operand is carried through this shell's floating type, so one
# past what a double holds exactly comes back rounded: bash, zsh, dash and
# BusyBox ash all write the digits unchanged. The int64 maximum is the operand
# that hides it -- it rounds to 2^63 and saturates back to itself, so it is
# exact here too -- and one short of the negative end is where the same
# rounding shows with nothing to hide it.
printf '[%d]\n' 123456789012345678
printf '[%d]\n' 1000000000000000001
printf '[%d]\n' 9007199254740993
printf '[%d]\n' 9223372036854775807
printf '[%d]\n' -9223372036854775807
printf 'and an ordinary one [%d]\n' 42

# A flag written past a field. The other three refuse every one of these, so
# the file redirects nothing and asks the values: a flag after the width is a
# flag and the width already read stands, a run after it replaces the width,
# and a `-` after a *precision* throws the precision away without becoming a
# flag -- which is why the third line is right-justified.
printf '[%5-d][%5+d][%5 d]\n' 42 42 42
printf '[%5-3d][%5-+d][%5-3-4d]\n' 42 42 42
printf '[%.5-d][%.3-5d][%5.3-d]\n' 42 42 42
printf '[%.5+d][%.3+5d][%.3--5d]\n' 42 42 42
printf 'a star the restart replaced [%*-5d]\n' 4 42

# What an operand is left holding after its arithmetic evaluated and failed.
# This shell goes on evaluating past a division by zero -- 0 for a division,
# the dividend for a remainder -- and reports once the whole expression has
# been read, so the value is the expression's and not a piece of the operand.
# zsh stops at the failure with a zero and the other two never evaluate an
# operand at all. The diagnostics differ across the panel and are dropped.
printf '[%d][%d][%d]\n' 1/0 1%0 -7%0 2> /dev/null
printf '[%d][%d][%d]\n' 1/0+9 1%0+9 '8%0*2' 2> /dev/null
printf '[%d][%d]\n' 3+1/0 3+1%0 2> /dev/null

# The alternate form at a value of nought, where ksh93 is alone. C reads `#`
# off the *value* — the `0x` goes on a nonzero one and an octal's precision
# is raised until there is a leading zero, which is a zero to write where the
# precision left none — and ksh93 reads the prefix off the digits instead:
# written wherever there are digits, and absent where there are none. So the
# first two lines are `0x0` and `0X0` here and a bare `0` in the other four,
# and the octal is empty here and a `0` there.
printf 'a hexadecimal nought [%#x] [%#X]\n' 0 0
printf 'through a precision [%#.2x] and a width [%#5x]\n' 0 0
printf 'and a zero fill [%#05x]\n' 0
printf 'an octal with nothing left [%#.0o] [%#5.0o]\n' 0 0

# The controls, which are the same in every shell: the two readings agree
# where there is neither a nonzero value nor a digit, an octal nought already
# leads with its own zero, and a nonzero value takes the ordinary prefix.
printf 'no value and no digits [%#.0x]\n' 0
printf 'an octal nought [%#o]\n' 0
printf 'nonzero [%#x] [%#o]\n' 255 255

# Held out with the two at the top of this file, and for the same reason:
#
#   #3067  the `0` flag beside a precision. C ignores it where an integer
#          conversion states one and the other four shells do; ksh93 pads
#          with zeros whatever the precision said, so `printf '[%+05.0d]' 0`
#          is `[+0000]` here and `[    +]` in ours.

# The `0` fill against the `0x` its own `#` wrote, where ksh93 is alone
# again and is alone the same way: the width is the digits' and the prefix is
# written past it, so `%#05x` of 7 is `0x00007` and is seven characters where
# the other four write `0x007` and five. Go's `fmt` reads it this way too,
# which is why this column needed no change when the other four were fixed.
printf 'a hexadecimal [%#05x] [%#05X]\n' 7 255
printf 'a wider field [%#010x]\n' 255
printf 'the flags the other way round [%0#5x]\n' 7

# The width the prefix eats into. Here the fill is the width less the digits
# alone, so it is still two characters where C's has already gone empty.
printf 'the prefix overflows [%#05x] [%#06x] and then does not [%#07x]\n' 65535 65535 65535

# And the nought, which this shell keeps a prefix on and then does not count:
# the two readings move together in every column, which is what makes them
# two axes that never both bite rather than one.
printf 'a nought [%#05x]\n' 0
