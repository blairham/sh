# SPDX-License-Identifier: Apache-2.0
#
# `read` in BusyBox ash takes a delimiter, a descriptor and silence.
#
# dash's `read` is the POSIX pair and nothing else, and this dialect had
# dash's list plus `-p`, `-t` and `-n`: `read -d ';' x` was `illegal option
# -d` at 2 here until 2026-09-16. BusyBox also takes `-d`, `-s` and `-u`, and
# reads them the way bash does. It refuses `-a`, `-e`, `-i` and `-N`, which
# bash has, so the letter set is its own even where each letter's meaning is
# not.
#
# The complaints — a missing argument, a descriptor that is not a number —
# are held out: BusyBox words them `no arg for -d option` and `invalid file
# descriptor` at 2, and ours does not yet (see the issue this file's pull
# request names).

printf 'a b;c\n' > semi
read -r -d ';' first second < semi
printf -- '-d splits at the delimiter: %s [%s][%s]\n' "$?" "$first" "$second"

# The delimiter ends the read; the newline does not.
printf 'one\ntwo;three\n' > lines
read -r -d ';' both < lines
printf -- '-d reads past a newline: %s [%s]\n' "$?" "$both"

# Without -r a backslash still quotes, and it quotes the delimiter too.
printf 'a\;b;c\n' > escaped
read -d ';' quoted < escaped
printf -- '-d without -r: %s [%s]\n' "$?" "$quoted"
read -r -d ';' raw < escaped
printf -- '-d with -r:    %s [%s]\n' "$?" "$raw"

# An empty delimiter is the NUL byte, so an ordinary file is read to its end
# — at 1, because the end came before the delimiter.
read -r -d '' whole < semi
printf -- '-d empty: %s [%s]\n' "$?" "$whole"

# No delimiter before the end: the text is kept, the status says so.
printf 'abc' > unterminated
read -r -d ';' partial < unterminated
printf -- '-d at end of file: %s [%s]\n' "$?" "$partial"

# REPLY when no name is given, as with every other letter.
read -d ';' < semi
printf -- '-d into REPLY: %s [%s]\n' "$?" "$REPLY"

# -u reads another descriptor, and leaves standard input where it was.
exec 3< lines
read -r -u 3 fromthree
printf -- '-u 3: %s [%s]\n' "$?" "$fromthree"
read -r -u 3 again
printf -- '-u 3 again: %s [%s]\n' "$?" "$again"
exec 3<&-

# A descriptor that is open to nothing is a failed read, not a usage error.
read -r -u 7 closed 2>/dev/null
printf -- '-u of a closed descriptor: %s\n' "$?"

# -s turns off echo on a terminal. There is none here, so the letter is only
# accepted — which is the half this row can ask.
read -r -s silent < semi
printf -- '-s: %s [%s]\n' "$?" "$silent"

# The refusals, by status only.
for letter in a e N; do
  read -$letter x < semi 2>/dev/null
  printf -- '-%s is refused: %s\n' "$letter" "$?"
done
