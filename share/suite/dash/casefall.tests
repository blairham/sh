#
# `;&` and `;;&` in dash, which has neither.
#
# Both are refused while reading, with two different sentences: `;&` at the
# `&`, and `;;&` at the word that follows it.
#
# Every refusal is asked through `eval` in a subshell, so a script that
# reaches one goes on to the next row and the file's own parse is not what is
# being graded. The rows that print `ran` or `after` ask whether the refusal
# is made while reading or while running.
#
# Measured 2026-09-16: Apple's dash-16 on macOS and Ubuntu 24.04's dash answer
# every row alike, and bash, zsh and ksh93 each answer the file differently.

try() {
	( eval "$1" ) 2>&1
	printf '  -> %s\n' "$?"
}

printf -- '--- a fall-through terminator does not parse ---\n'
try 'case a in a) printf "1\n" ;& b) printf "2\n" ;; esac'
try 'case a in a) printf "1\n" ;;& *) printf "2\n" ;; esac'
try 'printf "ran\n"; case a in a) :;& esac'
printf -- '--- and a bare ;; is the only one ---\n'
case a in a) printf 'one\n' ;; b) printf 'two\n' ;; esac
case b in (a) printf 'one\n' ;; (b) printf 'parenthesized\n' ;; esac
case c in a) ;; esac
printf 'no match -> %s\n' "$?"
