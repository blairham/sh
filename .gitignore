### This repository ###
# Regenerate the block above with:
#   curl -sfL "https://www.toptal.com/developers/gitignore/api/go,macos,linux,windows,visualstudiocode,vim,emacs" \
#     | sed -e 's/[[:space:]]*$//'
# and keep everything below, which is ours and not in any template. The sed is
# not optional: the API answers with trailing whitespace on some lines and the
# trailing-whitespace hook rejects the commit.

/dist/

# Graded binaries: `make conformance` and friends build here rather than to a
# shared TMPDIR name, so two worktrees can be graded at once.
/build/

# Hand-built shells. `make` puts its own binaries in /build/ above, so nothing
# in bin/ is a build product of the repo — it is where a `go build -o bin/…`
# typed by hand lands, and each one is another 8.7M for the large-files hook to
# stop. Ignored as a directory rather than by name, because the names are
# whatever the person building them chose.
/bin/

# Scratch targets from redirection probes. The oracle runs cases in its own
# temp directory, but hand-run exploration in the repo root leaves these
# behind, and `git add -A` once swept two of them into a commit.
/b
/f

# Bare `go build ./cmd/shfmt` and `./internal/cmd/fmtwild` drop a binary named
# after the package in the working directory. The large-files hook catches
# them, which is one commit's delay each time; these two never belong in a
# commit, so name them here instead.
/shfmt
/fmtwild
