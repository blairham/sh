#
# A name reference aimed at its **own name** — #3048, out of #2299's
# `127 / 0` row.
#
# `local -n r=r` is the ordinary spelling of "give me a handle on the outer
# variable of the same name", and bash has two answers for it decided by
# whether there is a function scope to refer out of. At the top level it is
# refused; inside a function it is a *warning* and the reference resolves
# outward, so a write through it reaches the outer variable and outlives the
# call. Only bash on this panel says both — ksh93 refuses in both scopes and
# ends the script, and zsh, dash and ash have no `-n` letter at all — which
# is why this file is in the bash tier rather than in ext/.
#
# The diagnostics are the point as much as the values are, so every case
# keeps stderr and drops nothing: the declaration says the same sentence
# twice, a read through says it again, and a write says `maximum nameref
# depth` instead. A file that compared only the values would call a silent
# shell a matching one.
#
# Each case is a subshell. Two of them end in a failed assignment, which
# gives up the command list it stood in, and a file that ran them inline
# would stop at the first.

say() { printf -- '--- %s\n' "$1"; }

say 'the top level refuses, and carries on'
( r=OUTER; typeset -n r=r; printf 'top=[%s]\n' "$r"; r=SET; printf 'after=[%s]\n' "$r" ) 2>&1

say 'inside a function it warns and reads the outer value'
( r=OUTER; f() { local -n r=r; printf 'in=[%s]\n' "$r"; }; f; printf 'after=[%s]\n' "$r" ) 2>&1

say 'and the write reaches the outer variable'
( r=OUTER; f() { local -n r=r; r=SET; }; f; printf 'after=[%s]\n' "$r" ) 2>&1

say 'the cell it reaches is the global one, past a caller local'
( r=L0
  h() { local r=L1; g; printf 'h=[%s]\n' "$r"; }
  g() { local r=L2; f; printf 'g=[%s]\n' "$r"; }
  f() { local -n r=r; printf 'f=[%s]\n' "$r"; r=SET; }
  h; printf 'top=[%s]\n' "$r" ) 2>&1

say 'an outer cell nobody set reads unset and is still written'
( g() { local r=L2; f; printf 'g=[%s]\n' "$r"; }
  f() { local -n r=r; printf 'f=[%s]\n' "${r-UNSET}"; r=SET; }
  g; printf 'top=[%s]\n' "${r-UNSET}" ) 2>&1

say 'declare and typeset say it in their own words'
( r=OUTER; f() { declare -n r=r; printf 'in=[%s]\n' "$r"; }; f ) 2>&1
( r=OUTER; f() { typeset -n r=r; printf 'in=[%s]\n' "$r"; }; f ) 2>&1

say 'the declaration reports success'
( r=OUTER; f() { local -n r=r; printf 'st=%s\n' "$?"; }; f ) 2>&1

say 'an assignment can aim a reference at its own name'
( r=OUTER; f() { local -n r; r=r; declare -p r; printf 'in=[%s]\n' "$r"; r=SET; }
  f; printf 'after=[%s]\n' "$r" ) 2>&1

say 'a plain unset warns twice and leaves the outer cell alone'
( r=OUTER; f() { local -n r=r; unset r; }; f; printf 'after=[%s]\n' "${r-GONE}" ) 2>&1

say 'a reference that is itself the global cell is a closed loop'
( r=OUTER; f() { declare -gn r=r; printf 'in=[%s]\n' "$r"; }; f ) 2>&1

say 'and a write through that one lands nowhere and gives up the list'
( f() { declare -gn r=r; r=SET; printf 'NOPE\n'; }; f; printf 'st=%s\n' "$?" ) 2>&1
printf 'and the file carries on\n'

# The cell a reference lands on — #3084, and the second half of what `-n`
# means. The letter says the name is a reference, and a reference has no value
# under it, so whatever the name was holding is discarded when the reference is
# made. Nothing can see that while the reference stands, because a read of the
# name goes through it; `unset -n` is the door onto the cell, and what it finds
# is an unset name.
#
# Not a fact about scope, which is why the top-level and `-g` cases are here
# beside the local one: the discard happens with no function in sight and
# through the letter that takes no scope at all.

say 'unset -n opens an empty cell'
( r=OUTER; v=VEE; f() { local -n r=v; unset -n r; printf 'in=[%s]\n' "${r-GONE}"; }
  f; printf 'after=[%s]\n' "${r-GONE}" ) 2>&1

say 'the top level discards it too'
( r=OUTER; v=VEE; declare -n r=v; unset -n r; printf '[%s]\n' "${r-GONE}" ) 2>&1

say 'and so does a global declaration made inside a function'
( r=OUTER; v=VEE; f() { declare -gn r=v; unset -n r; printf 'in=[%s]\n' "${r-GONE}"; }
  f; printf 'after=[%s]\n' "${r-GONE}" ) 2>&1

say 'a reference with nothing to point at empties it as well'
( r=OUTER; f() { local -n r; unset -n r; printf 'in=[%s]\n' "${r-GONE}"; }
  f; printf 'after=[%s]\n' "${r-GONE}" ) 2>&1

say 'and the listing says the same from the other side'
( r=OUTER; f() { local -n r; declare -p r; }; f ) 2>&1
( v=1; declare -n r=v; declare -p r ) 2>&1

say 'the cell opened is this binding, not a caller of it'
( r=L0; v=VEE
  h() { local r=L1; g; printf 'h=[%s]\n' "$r"; }
  g() { local r=L2; f; printf 'g=[%s]\n' "$r"; }
  f() { local -n r=v; unset -n r; printf 'f=[%s]\n' "${r-GONE}"; }
  h; printf 'top=[%s]\n' "$r" ) 2>&1

say 'and what it opens onto is an ordinary empty local'
( r=OUTER; v=VEE
  f() { local -n r=v; unset -n r; r=NEW; printf 'in=[%s] v=[%s]\n' "$r" "$v"; }
  f; printf 'after=[%s] v=[%s]\n' "$r" "$v" ) 2>&1

say 'an inherited value goes with it'
( export E=ENV; v=VEE; declare -n E=v; unset -n E; printf '[%s]\n' "${E-GONE}" ) 2>&1

say 'a refused declaration keeps the value it found'
( r=OUTER; declare -n r=1bad; printf 'st=%s\n' "$?"; unset -n r
  printf '[%s]\n' "${r-GONE}" ) 2>&1
( r=OUTER; declare -n r=r; printf 'st=%s\n' "$?"; unset -n r
  printf '[%s]\n' "${r-GONE}" ) 2>&1

say 'and the reference is what hides all of it until then'
( r=OUTER; v=VEE; declare -n r=v; printf '[%s]\n' "${r-GONE}"; unset -n r
  printf '[%s]\n' "${r-GONE}" ) 2>&1

# A reference over a name holding an **array** — #3103, and the third thing
# the `n` letter means. Both shells with the letter refuse it, in the same
# words; what they disagree about is when the check runs and what counts as an
# array, and this file is the bash half of that. Here the array is looked at
# *after* the two refusals about the name, so a bad target or a self reference
# speaks for a line where both are true — ksh93 writes the array sentence for
# both — and the *attribute* alone is enough, so a bare `declare -a r` holding
# nothing is refused where ksh93 takes it.
#
# The refusal must leave the name exactly as it found it, which is why every
# case reads the array back afterwards rather than only the status: a shell
# that emptied the cell on a refusal would print the same diagnostic and then
# answer GONE with `${#r[@]}` still at 3.

say 'an indexed array is refused and left standing'
( r=(a b c); v=VEE; declare -n r=v; printf 'st=%s\n' "$?"
  printf 'after=[%s] n=%s\n' "${r-GONE}" "${#r[@]}" ) 2>&1

say 'and so is the associative kind'
( declare -A r=([k]=KV); v=VEE; declare -n r=v; printf 'st=%s\n' "$?"
  printf '[%s]\n' "${r[k]}" ) 2>&1

say 'a bare attribute holding nothing is enough'
( declare -a r; v=VEE; declare -n r=v; printf 'st=%s\n' "$?"
  printf '[%s]\n' "${r-GONE}" ) 2>&1
( declare -A r; v=VEE; declare -n r=v; printf 'st=%s\n' "$?" ) 2>&1

say 'the valueless form is refused on the attribute too'
( r=(a b); declare -n r; printf 'st=%s n=%s\n' "$?" "${#r[@]}" ) 2>&1

say 'a bad target and a self reference are both reported ahead of it'
( r=(a b); declare -n r=1bad; printf 'st=%s\n' "$?" ) 2>&1
( r=(a b); declare -n r=r; printf 'st=%s\n' "$?" ) 2>&1

say 'and inside a function the refusal splits the warning in two'
( f() { local r=(a b); local -n r=r; printf 'st=%s in=[%s]\n' "$?" "${r-GONE}"; }; f ) 2>&1

say 'a fresh local binding is not the global array'
( r=(a b c); v=VEE; f() { local -n r=v; printf 'in=[%s]\n' "$r"; }; f
  printf 'after=[%s]\n' "${r-GONE}" ) 2>&1

say 'but a global declaration reaches it'
( r=(a b c); v=VEE; f() { declare -gn r=v; printf 'st=%s\n' "$?"; }; f
  printf 'after=[%s]\n' "${r-GONE}" ) 2>&1

say 'three deep the refusal disturbs nothing outside it'
( r=(G0 G1); v=VEE
  h() { local r=L1; g; printf 'h=[%s] n=%s\n' "${r-GONE}" "${#r[@]}"; }
  g() { local r=(L2a L2b); f; printf 'g=[%s] n=%s\n' "${r-GONE}" "${#r[@]}"; }
  f() { local r=(F0 F1); local -n r=v; printf 'f=[%s] n=%s\n' "${r-GONE}" "${#r[@]}"; }
  h; printf 'top=[%s] n=%s\n' "${r-GONE}" "${#r[@]}" ) 2>&1

say 'the refused name still lists as an array'
( r=(a b); v=VEE; declare -n r=v; declare -p r ) 2>&1

say 'and the refusal does not end the script'
( r=(a b); declare -n r=v; printf 'after\n' ) 2>&1

say 'a reference aimed at an array is the feature, not the question'
( v=(a b c); declare -n r=v; printf 'st=%s [%s] n=%s\n' "$?" "${r[1]}" "${#r[@]}" ) 2>&1

# The warning is **per read** — #3104, and the third thing this file pins
# about the same declaration. A read through a reference bash has warned about
# says the sentence once, so a function that declares one and reads it writes
# three: the builtin's copy, the shell's, and the read's. `${r-word}` wrote a
# fourth, because the shell resolved the reference once to ask whether the
# name was set and again to take its value, and the word forms were the only
# ones that asked twice.
#
# Every line here is counted rather than eyeballed. Four warnings and three
# read the same at a glance, which is why the count is printed beside the
# value and not left in the diff.

count() { printf -- '--- %s: %s warnings, %s\n' "$1" "$2" "$3"; }

say 'one warning per read, whatever the expansion carries'
( r=OUTER
  for read in 'plain' 'alternate' 'length' 'default' 'colon-default'; do
    case $read in
    plain)         out=$( { f() { local -n r=r; printf 'v=[%s]\n' "$r"; }; f; } 2>&1 ) ;;
    alternate)     out=$( { f() { local -n r=r; printf 'v=[%s]\n' "${r+S}"; }; f; } 2>&1 ) ;;
    length)        out=$( { f() { local -n r=r; printf 'v=[%s]\n' "${#r}"; }; f; } 2>&1 ) ;;
    default)       out=$( { f() { local -n r=r; printf 'v=[%s]\n' "${r-GONE}"; }; f; } 2>&1 ) ;;
    colon-default) out=$( { f() { local -n r=r; printf 'v=[%s]\n' "${r:-D}"; }; f; } 2>&1 ) ;;
    esac
    n=$( printf '%s\n' "$out" | grep -c 'circular name reference' )
    count "$read" "$n" "$( printf '%s\n' "$out" | grep '^v=' )"
  done ) 2>&1

# A subscript is **arithmetic**, so a second read of the same expansion is a
# different element. `a[i++]` is the counter that makes the reads visible, and
# it is the same bug wearing a value rather than a diagnostic: the word forms
# read four times, so by the fourth the counter was past the end of the array
# and the *word* came back.

say 'a subscript is evaluated once, whatever the operator'
( for op in '${a[i++]}' '${a[i++]-D}' '${a[i++]:-D}' '${a[i++]+S}' '${a[i++]:+S}' \
            '${a[i++]=D}' '${a[i++]?}' '${#a[i++]}' '${a[i++]#x}' '${a[i++]/x/y}' \
            '${a[i++]:0:1}' '${a[@]:i++:1}'; do
    a=(x y z); i=0
    eval "v=\"$op\""
    printf -- '--- %-14s [%s] i=%s\n' "$op" "$v" "$i"
  done ) 2>&1

say 'and a loop walks the array one element per pass'
( a=(x y z); i=0
  for n in 1 2 3; do printf '%s ' "${a[i++]-D}"; done
  printf 'i=%s\n' "$i" ) 2>&1
( c=(1 2); m=0; printf '[%s][%s] m=%s\n' "${c[m++]-D}" "${c[m++]-D}" "$m" ) 2>&1

# An **attribute letter** over an existing reference — #3136. A declaration
# that does not write `-n` again operates on what the reference points at, so
# the letter goes to the target and the reference keeps only `-n`. This shell
# put the letter on the reference, which left the target without it and the
# reference carrying a letter no reference can carry.
#
# `readonly` is the row that costs a script something: a helper handed the
# name of a caller's variable and told to freeze it froze nothing, and the
# caller's variable stayed writable for the rest of the run at status 0.

say 'a letter over a reference lands on the target'
( u=1; declare -n s=u; declare -i s; declare -p s u ) 2>&1
( u=1; declare -n s=u; declare -r s; declare -p s u ) 2>&1
( u=1; declare -n s=u; declare -x s; declare -p s u ) 2>&1
( u=AB; declare -n s=u; declare -l s; declare -p s u ) 2>&1
( u=1; declare -n s=u; declare -a s; declare -p s u ) 2>&1
( u=1; declare -n s=u; declare -ix s=7; declare -p s u ) 2>&1

say 'and the letter works where it landed'
( u=1; declare -n s=u; declare -i s; s=3+4; printf 'u=[%s]\n' "$u" ) 2>&1
( u=1; declare -i u; declare -n s=u; declare +i s; s=3+4; printf 'u=[%s]\n' "$u" ) 2>&1

say 'the attribute words follow it too'
( u=1; declare -n s=u; readonly s; declare -p u; u=9; printf 'NOPE\n' ) 2>&1
printf 'st=%s\n' "$?"
( u=1; declare -n s=u; readonly s; s=9; printf 'NOPE\n' ) 2>&1
( u=1; declare -n s=u; export s; declare -p u; env | grep '^u=' ) 2>&1

say 'the chain is walked to the end, and an element lands on its array'
( u=1; declare -n s=u; declare -n s2=s; declare -i s2; declare -p s s2 u ) 2>&1
( declare -a a=(x y); declare -n s=a[1]; declare -i s; declare -p s a ) 2>&1

say 'a target nobody set is brought into being with it'
( declare -n s=nope; declare -i s; declare -p s nope ) 2>&1

say 'n on the same line keeps the letters on the reference'
( u=1; declare -rn s=u; declare -p s u ) 2>&1
( v=1; declare -rn r=v; declare -i r; printf 'st=%s\n' "$?"; declare -p r v ) 2>&1

say 'a fresh binding is a declaration of that binding'
( u=1; declare -n s=u; f() { local -i s; declare -p s u; }; f; declare -p s u ) 2>&1
( u=1; declare -n s=u; f() { declare -i s; declare -p s u; }; f; declare -p s u ) 2>&1
( f() { local u=1; local -n s=u; local -i s; declare -p s u; }; f ) 2>&1
( u=1; declare -n s=u; f() { declare -g -r s; }; f; declare -p s u ) 2>&1

say 'and a re-aim is about the reference rather than about its target'
( u=1; w=2; declare -n s=u; declare -n s=w; declare -p s u w ) 2>&1
( u=1; w=2; declare -n s=u; declare -rn s=w; declare -p s u w ) 2>&1
( u=1; declare -n s=u; declare -n s; declare -p s u ) 2>&1
