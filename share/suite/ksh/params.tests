#
# Parameter expansion, the answer only ksh93 gives.
#
# The operators POSIX defines are core/ and the ksh-family ones the substrate
# adopted are ext/. What is left, and what this file is, is the handful of
# places where ksh93's answer is its own: `${!name}` names a variable where
# bash dereferences it, `${ … ; }` runs a command substitution in the current
# shell, and the case attributes apply to every later assignment rather than
# only to the one that declared them.

# `${!name}` is the *name*, which is how ksh93 spells what bash spells
# `${!ref}` as an indirection. zsh and dash refuse the form outright, so all
# four references part company here.
v=abc
printf '%s\n' "${!v}"

# On an array the same operator gives the subscripts rather than the values.
arr=(one two three)
printf '%s\n' "${!arr[@]}"

# `${ command; }` is a command substitution that does not fork: assignments
# inside it survive, which is the whole point of the form and the one thing
# `$( … )` can never do. Both are run here because the pair is the claim.
x=3
printf '%s\n' "${ echo shared $x; x=9; }"
printf '%s\n' "x is now $x"
y=5
printf '%s\n' "$( y=7; echo sub $y )"
printf '%s\n' "y is still $y"

# The case attributes are attributes, not a one-off conversion: a later
# assignment to the same name is converted too.
typeset -u U=abc
printf '%s\n' "$U"
U=mixed
printf '%s\n' "$U"
typeset -l L=ABC
printf '%s\n' "$L"
L=MiXeD
printf '%s\n' "$L"

# An offset may be a bare arithmetic expression, and a name in it is read as
# a variable rather than as anything else.
s=hello
printf '%s\n' "${s: -2}"
printf '%s\n' "${s:1:3}"
n=2
printf '%s\n' "${s:n}"
printf '%s\n' "${s:n:1}"

# A negative offset needs the space, and a negative length counts back from
# the end.
printf '%s\n' "${s: -4:2}"

# `${#name}` counts characters, and on an array it is the element count.
printf '%s\n' "${#s}"
printf '%s\n' "${#arr[@]}"

# A range's pattern characters are protected before it is read, so every one
# of them is an arithmetic syntax error here where bash and zsh evaluate the
# expression. `${s:(-2)}` is the spelling the issue was filed about and the
# parentheses are not what it is about: a bitwise or is refused in the same
# position and a comparison is not. Each one is in a subshell because the
# refusal ends the shell it happens in, and the rest of this file has to run.
( printf '%s\n' "${s:(-2)}" )
printf 'st=%s\n' "$?"
( printf '%s\n' "${s:1|2}" )
printf 'st=%s\n' "$?"
( printf '%s\n' "${s:1:(2)}" )
printf 'st=%s\n' "$?"
printf '%s\n' "${s:1<2}"
printf '%s\n' "${s:1%2}"

# `${!prefix@}` and `${!prefix*}` list the names *extending* the prefix. The
# name that matches it exactly is set and readable and is still left out,
# which is where this parts from bash's plain prefix match.
zqp=0
zqp_a=1
zqp_b=2
printf '[%s]' "${!zqp@}"
printf '\n'
printf '[%s]' "${!zqp*}"
printf '\n'
printf '[%s]\n' "${!zqnosuch@}"

# Assignment forms set the variable as well as expanding, and the unset test
# and the null test differ by the colon.
unset u
printf '%s\n' "${u=assigned}"
printf '%s\n' "u is $u"
e=
printf '[%s]\n' "${e-kept}"
printf '[%s]\n' "${e:-substituted}"
