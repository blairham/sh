#
# Command lookup in ksh93 — #2320.
#
# Two answers here are ksh93's alone, and both are about the table of
# remembered locations rather than about the search.
#
# The first is that ksh93 keeps looking. bash, zsh and dash all use the
# location they remembered until PATH is assigned to; ksh93 finds a program
# that has appeared *earlier* on PATH since, with no assignment in between.
# A tracked alias is what the table is called here, which is why `hash` is a
# preset alias for `alias -t --` rather than a builtin — and why its
# diagnostics name `alias`.
#
# The second is `command -v` on a word with a slash in it. The word is a
# pathname and is not searched for, so there is nothing to report but the
# word; bash, zsh and dash report exactly that, and ksh93 resolves it against
# the working directory instead — joining rather than cleaning, so a `./` in
# the operand survives in the middle of the answer.

mkdir -p bin1 bin2
printf '#!/bin/sh\nprintf "bin2 tool2\\n"\n' > bin2/tool2; chmod 755 bin2/tool2
PATH="$PWD/bin1:$PWD/bin2:/usr/bin:/bin"

# Found in the second directory, because the first does not have it yet.
tool2

# And found in the first the moment it is there, without PATH being touched.
printf '#!/bin/sh\nprintf "bin1 tool2\\n"\n' > bin1/tool2; chmod 755 bin1/tool2
tool2

# Assigning PATH its own value changes nothing here, because nothing was
# being held on to.
PATH="$PWD/bin1:$PWD/bin2:/usr/bin:/bin"
tool2

# With the file gone the search finds the copy in bin2.
rm -f bin1/tool2
tool2 2>/dev/null; printf 'after the file went -> %s\n' "$?"

# `hash` is the preset alias. Its flags are `alias`'s, so a flag `alias` does
# not have is an error from `alias` — and a fatal one, which is why the two
# calls below are inside subshells.
alias hash
( hash -t tool2 ) > /dev/null 2>&1; printf 'hash -t -> %s\n' "$?"
( hash -p /bin/ls lsalias ) > /dev/null 2>&1; printf 'hash -p -> %s\n' "$?"

# The same two with the diagnostic kept, because the status alone cannot see
# which command was refused. `hash` is not a command in this dialect, so a
# refusal naming it sends the reader to options that do not exist here — and
# the sentence is `bad option(s)` with no usage block under it, which is not
# what `alias` writes for a letter it has not got.
( hash -t tool2 ) 2>&1 > /dev/null
( hash -p /bin/ls lsalias ) 2>&1 > /dev/null

# That other sentence, for the contrast: a letter written *beside* the
# tracked one is `alias`'s ordinary refusal, usage block and all, at 2 rather
# than 1. Two spellings of `alias` in one dialect, which is why the rows above
# cannot be graded on the word `alias` alone.
( alias -tq ) 2>&1 > /dev/null; printf 'a letter beside it -> %s\n' "$?"

# And it is fatal, which no status can show. The line after it inside the
# subshell never runs; the file does.
( hash -t tool2 2>/dev/null; printf 'reached after the refusal\n' )
printf 'the file runs on -> %s\n' "$?"

# `-p` and `-x` are `alias`'s letters, not the cache's, and beside the tracked
# one with no operand they are two shapes of the same listing: `-pt` writes
# the word that would define the entry back in front of it, and `-xt` writes
# nothing, because a tracked alias is never an exported one. The bare `-t` is
# the control — a row that lost the prefix and a row that lost the listing
# cannot both pass. PATH is set inside the subshell so the rows below still
# see the one this file built.
( PATH=/bin; ls > /dev/null 2>&1; alias -t; alias -pt; alias -xt ) 2>&1
printf 'the three listings -> %s\n' "$?"

# A word with a slash, reported by `command -v`.
printf '#!/bin/sh\nprintf "tool\\n"\n' > bin1/tool; chmod 755 bin1/tool
command -v ./bin1/tool; printf 'dot slash -> %s\n' "$?"
command -v bin1/tool; printf 'relative -> %s\n' "$?"
command -v /bin/ls; printf 'absolute -> %s\n' "$?"

# And the join is not a cleaning: the dot-dot survives in the middle of the
# answer exactly as the `./` does. core/ asks the half every reference agrees
# on — that the operand comes back whole — and this is the spelling where a
# shell that joined and *then* cleaned would look like this one.
command -v ./bin1/../bin1/tool; printf 'dot-dot -> %s\n' "$?"

# The same answer through the builtin whose whole job is this question, so a
# fix applied to `command -v` alone is visible here rather than nowhere.
whence -p ./bin1/tool; printf 'whence -p -> %s\n' "$?"

# The sentence as well as the path, which was held out until #2953 landed:
# this shell keeps `is a tracked alias for` for a name it resolved through
# PATH and writes the plain sentence for a pathname operand, which was never
# searched for. The control is one line down — a bare name, which keeps the
# tracked-alias wording — so the row is about the slash and not about the
# builtin.
command -V ./bin1/tool
type ./bin1/tool
whence -v ./bin1/tool

# `-a` says how many rows there are and `-p` says what a row is, and the two
# compose: with both, the PATH walk is `-a`'s and the wording is decided by
# whichever of `a`, `p` and `v` was written last. The fixtures are two copies
# of one name in two directories (#3198).
mkdir -p dupd1 dupd2
printf '#!/bin/sh\nexit 0\n' > dupd1/dupcmd
printf '#!/bin/sh\nexit 0\n' > dupd2/dupcmd
chmod 755 dupd1/dupcmd dupd2/dupcmd
dupsave=$PATH
PATH=$PWD/dupd1:$PWD/dupd2:$PATH
whence -a dupcmd | sed -e "s|$PWD|.|g"
printf 'whence -a -> %s\n' "$?"
whence -ap dupcmd | sed -e "s|$PWD|.|g"
printf 'whence -ap -> %s\n' "$?"
whence -pa dupcmd | sed -e "s|$PWD|.|g"
printf 'whence -pa -> %s\n' "$?"
whence -p dupcmd | sed -e "s|$PWD|.|g"
printf 'whence -p -> %s\n' "$?"
PATH=$dupsave

# And a `command` reached through an expansion reports rather than runs here,
# where a written one runs. The second line is the control (#3369).
expc=command
$expc echo expanded; printf 'expanded -> %s\n' "$?"
command echo written; printf 'written -> %s\n' "$?"
$expc -v echo; printf 'with a written -v -> %s\n' "$?"

# A function may not be *named* after a special builtin here either, and the
# stage is this shell's own: the definition parses and the complaint comes
# where it **runs**, so the line in front of it does run. It still ends the
# file, which is why it is the last thing in it — dash/ has the same refusal
# made while reading, and bash/ the accepting side.
printf 'before\n'
export() { printf 'fn\n'; }
printf 'not reached -> %s\n' "$?"
