#
# Command lookup in dash — #2320, and the area where dash's answers are
# smaller rather than different.
#
# dash reports a name that is nothing as 127 from `command -v` and from
# `type`, where bash, zsh and ksh93 all answer 1. 127 is the status a *shell*
# uses for a command it could not find, and dash reuses it for "the utility
# you asked about is not there" — so a script testing `command -v foo` sees
# the same number whether the query failed or the query itself was not
# found.
#
# And there is no `builtin`: the way bash, zsh and ksh93 name a builtin past
# a function of the same name does not exist here, leaving `command` as the
# only precommand modifier dash has.

mkdir -p bin1
printf '#!/bin/sh\nprintf "external prog\\n"\n' > bin1/prog; chmod 755 bin1/prog
PATH="$PWD/bin1:/usr/bin:/bin"

# The query that fails, twice, for a name nothing has ever defined.
command -v nosuchthing_zz > /dev/null 2>&1; printf 'command -v missing -> %s\n' "$?"
( type nosuchthing_zz ) > /dev/null 2>&1; printf 'type missing -> %s\n' "$?"

# The controls: the same two queries on names that *are* something answer 0
# everywhere, so what is being measured is the failure and not the utility.
command -v prog > /dev/null 2>&1; printf 'command -v a program -> %s\n' "$?"
command -v true > /dev/null 2>&1; printf 'command -v a builtin -> %s\n' "$?"
( type true ) > /dev/null 2>&1; printf 'type a builtin -> %s\n' "$?"

# No `builtin`.
( eval 'builtin true' ) 2>/dev/null; printf 'builtin -> %s\n' "$?"

# And `hash` has no flags at all: every letter the other three take is an
# error here, and the bare form and `-r` are the whole of it.
( hash ) > /dev/null 2>&1; printf 'hash -> %s\n' "$?"
( hash -r ) > /dev/null 2>&1; printf 'hash -r -> %s\n' "$?"
( hash -t prog ) > /dev/null 2>&1; printf 'hash -t -> %s\n' "$?"
( hash -l ) > /dev/null 2>&1; printf 'hash -l -> %s\n' "$?"

# And the listing itself is dash's alone: bare absolute paths, one per line,
# where bash prints a `hits command` table and ksh93 and zsh print
# `name=/path`.
#
# It is asked **through `sort`**, which is the whole of the case. dash lists
# in the order of its own hash table and this shell lists in the order the
# names were first run, so the two share no prefix once there are three names
# — `sed ls cat` run in that order is `cat`, `sed`, `ls` there and `sed`,
# `ls`, `cat` here. That order is a permutation of whatever a script happened
# to run, decided by a hash function and a table size that no manual states
# and nothing a script can depend on; reproducing it would mean fitting an
# implementation's internals, which is out of reach here by rule. Sorting
# grades the set and the format and leaves the bucket walk alone, which is
# the part of the row that is a fact about dash rather than about its table
# (#2897).
hash -r
for n in sed ls cat; do $n < /dev/null > /dev/null 2>&1; done
hash | sort
printf 'the sorted listing -> %s\n' "$?"

# `command -v` answers for the grammar *this* shell has. `select`, `function`,
# `[[` and `]]` are constructs dash does not have, so they are ordinary names
# it cannot find; `time` is a keyword in the other three and is the program of
# that name here, which is what a script writing `command -v time` is looking
# for. Ours answered all five as words of the grammar until #2918.
command -v select > /dev/null 2>&1; printf 'command -v select -> %s\n' "$?"
command -v function > /dev/null 2>&1; printf 'command -v function -> %s\n' "$?"
command -v ']]' > /dev/null 2>&1; printf "command -v ']]' -> %s\n" "$?"
printf 'command -v time -> [%s]\n' "$(command -v time 2>/dev/null)"
( type time ) 2>&1

# The control: a word dash *does* reserve is still one, so the lines above are
# about the constructs dash has not got rather than about this shell having
# stopped answering for the grammar at all.
printf 'command -v if -> [%s]\n' "$(command -v if)"
printf 'command -v for -> [%s]\n' "$(command -v for)"
( type until ) 2>&1

# A function may not be *named* after a special builtin. The refusal is a
# syntax error made while the input is **read**, so nothing at all in this
# file runs past it — which is why it is the last thing in the file. The top
# of core/lookup.tests says why the question cannot be asked there; bash/
# carries the accepting side and ksh/ the other refusing one, at a different
# stage.
export() { printf 'fn\n'; }
printf 'not reached -> %s\n' "$?"
