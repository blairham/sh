#
# dash's own answers among the builtins every shell has.
#
# dash adds almost nothing to POSIX, so its dialect answers are not extra
# features — they are the places where the same builtin behaves differently
# here than in the other three. `echo` processing escapes with no option is
# the one a portable script trips over most.
#
# ---- two rows here are not this shell's to answer ----
#
# Measured 2026-09-16, and both are named so that nobody closes them by
# making cmd/dash wrong somewhere else.
#
# The `set -o` listing is **patched by Debian and Ubuntu**. Upstream dash
# 0.5.12 lists seventeen names and Apple's dash-16 lists the same seventeen;
# Debian's dash 0.5.12-12 lists nineteen, adding `privileged` after `nounset`
# and `pipefail` after `nolog`. Two builds of one upstream version disagree,
# so it is the distribution's patch and not a version this file is behind on.
# Matching it would put two names in cmd/dash's listing that upstream dash
# does not have.
#
# The `kill -l` rows are **the operating system's signal table**, not the
# shell's. `kill -l 32` is `32` at 0 under every dash on Linux — Debian's and
# Alpine's alike — and `invalid signal number or exit status` at 2 under
# Apple's dash-16, because macOS has 31 signals and Linux has 64. The
# reference on the machine is the expectation, so each platform's answer is
# the right one there; what is missing is that cmd/dash knows only the
# signals both platforms name, so on Linux it refuses a number the reference
# accepts. That is ours and is filed, platform-scoped.
#
# Neither can be read off the column header, and that is the sharper half:
# dash answers no version probe in any spelling, so the report prints
# `could not determine` and has nothing to raise the WRONG BUILD banner from
# that the bash, zsh and ksh93 columns carry for exactly this. See #2291.

# echo interprets the escape sequences with no -e and no option set. bash
# does not, which is the whole reason `printf` is the portable spelling.
echo 'tab: a\tb'
echo 'newline: a\nb'
echo 'backslash: a\\b'
echo 'octal: \0101'

# \c stops the output there, newline included.
echo 'stops here \c and this is gone'
echo ''

# -n suppresses the newline, and it is the option rather than an argument.
echo -n 'no newline'
echo ''

# printf %b asks for the same processing on an argument, and that spelling
# is portable where echo's is not.
printf '%b\n' 'b flag: a\tb'

# `local` is dash's — POSIX has no such builtin and ksh93 has not got it. A
# local name shadows the outer one and the assignment inside the function
# does not escape.
outer=kept
f() {
  local outer=inner
  outer=changed
  printf 'inside: %s\n' "$outer"
}
f
printf 'outside: %s\n' "$outer"

# `local` with no value leaves the name set to nothing rather than unset,
# which is the half of it shells disagree about.
g() {
  local u
  printf 'valueless: [%s]\n' "${u-unset}"
}
g

# local takes several names at once, and the list is names rather than a
# declaration.
h() {
  local a b
  a=1
  b=2
  printf '%s %s\n' "$a" "$b"
}
h

# type says what a word is, in dash's wording.
type echo
type f
type nosuchcommandanywhere
printf 'type on nothing: %s\n' "$?"

# command -v answers with the word for a function and a builtin alike.
command -v f
command -v echo
command -v nosuchcommandanywhere
printf 'command -v on nothing: %s\n' "$?"

# The special builtins keep their POSIX status rule: a redirection error on
# one is fatal to a non-interactive shell, so this is run where the death is
# contained.
( : > /nonexistent/path/that/cannot/be/made; printf 'not reached\n' ) 2>&1
printf 'after the redirection failure: %s\n' "$?"

# set -o with nothing after it writes this shell's whole option table, and
# the table has an order: it is the shell's own rather than a sort, so the
# names are not the names the other shells list and they are not in
# alphabetical order either. Three of them — interactive, stdin and debug —
# no other shell in the panel has, and two of those say how this shell was
# started, which is the reason a script reads the listing at all.
set -o

# set +o writes the same table as commands that can be read back in, in the
# same order.
set +o

# The three are settable in both directions, and stdin carries the $- letter
# that names the same fact. This file is a script, so it starts off.
printf 'started with: [%s]\n' "$-"
set -o stdin
printf 'after -o stdin: [%s]\n' "$-"
set +o stdin
printf 'and off again: [%s]\n' "$-"

# `set -o interactive` is deliberately not exercised here. It is settable and
# it does carry the `i` — measured under -c, where both shells answer `[i]` —
# but in a *script* the real shell starts drawing prompts at the next command
# and writes them to standard error, which this shell does not. That is a
# divergence about entering the line editor mid-file rather than about the
# option, and a case that measured it would be measuring the prompt.

# debug is listed and remembered and earns no letter.
set -o debug
printf 'after -o debug: [%s]\n' "$-"
set -o
set +o debug

# `ulimit` takes a plain number and nothing else here: neither of the two
# keyword operands bash has, and none of the spellings ksh93's arithmetic
# reading accepts. `+1` was taken in silence at status 0 until #3060, which
# set a limit from a word no shell on the panel but ksh93 reads.
ulimit -c hard 2> /dev/null; printf 'ulimit -c hard -> %s\n' "$?"
ulimit -c soft 2> /dev/null; printf 'ulimit -c soft -> %s\n' "$?"
ulimit -c +1 2> /dev/null; printf 'signed -> %s\n' "$?"
ulimit -c 1+1 2> /dev/null; printf 'expression -> %s\n' "$?"
ulimit -c 0x10 2> /dev/null; printf 'hex -> %s\n' "$?"

# `kill -l` takes the 128 off once and refuses everything it cannot name —
# 0 included, which is the one column with no `EXIT` and no number printed
# back. The refusal calls the operand an exit status rather than a signal
# name, which no other shell here does and which is the listing form's whole
# subject.
kill -l 0 2> /dev/null; printf '0 -> %s\n' "$?"
kill -l 32 2> /dev/null; printf '32 -> %s\n' "$?"
kill -l 128 2> /dev/null; printf '128 -> %s\n' "$?"
kill -l 160 2> /dev/null; printf '160 -> %s\n' "$?"
kill -l 257 2> /dev/null; printf '257 -> %s\n' "$?"
kill -l 32 2>&1 > /dev/null | sed 's/.*kill: //'
# `exec` takes no options here, which is not three missing letters but one
# answer: a leading dash-word is the *command*, so each of them is looked up
# on PATH and reported as not found at 127. bash, zsh and ksh93 all read at
# least one of the three.
( exec -a NAME /bin/sh -c 'printf "reached\n"' ) 2> /dev/null; printf 'option -a -> %s\n' "$?"
( exec -l /bin/sh -c 'printf "reached\n"' ) 2> /dev/null; printf 'option -l -> %s\n' "$?"
( exec -c /bin/sh -c 'printf "reached\n"' ) 2> /dev/null; printf 'option -c -> %s\n' "$?"
# `umask` here reads both of POSIX's extras — a permission copy after the
# operator, and chmod's conditional-execute `X` — and, being this shell,
# says nothing at all while doing it. The mask is printed afterwards because
# that is the only evidence there is.
( umask 022; umask -S g=u; umask -S )
( umask 022; umask -S o=u; umask -S )
( umask 022; umask -S u=X; umask -S )
( umask 122; umask -S u+X; umask -S )
( umask 133; umask -S a+X; umask -S )
( umask 133; umask -S u+x,g+X; umask -S )
