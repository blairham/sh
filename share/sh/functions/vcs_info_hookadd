#
# vcs_info_hookadd hook function ... — registers functions to a vcs_info hook
# whatever the context, as +vi-<function>; they run before the ones the hooks
# style names. Running vcs_info autoloads it.
#
# Written from zshcontrib(1) and from what the installed shell answers, never
# from its function files; docs/spec/functions.md has the measurements.

emulate -L zsh
if (( $# < 2 )); then
	print -r -- "vcs_info_hookadd: give a hook and one or more functions"
	return 1
fi
local hook=$1
shift
local -a funcs
zstyle -a ":vcs_info-static_hooks:$hook" hooks funcs
zstyle ":vcs_info-static_hooks:$hook" hooks $funcs "$@"
