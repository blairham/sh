#
# `-f` on the command line — #2315's zsh/ half, and the letter a portable
# script is most likely to reach for without checking.
#
# In bash, ksh93 and dash, `-f` is noglob: `sh -f -c 'printf "[%s]\n" *'`
# prints the pattern. In zsh the letter is `NO_RCS` — "read no startup files"
# — and globbing is untouched, so the same command line prints the file names.
# zsh spells noglob `-F`.
#
# zsh/options.tests records the same split for `set -f` *inside* a running
# shell. This file is the other route, and the route is the point: `zsh -f` is
# how a script asks for a shell with no startup files, and it is written into
# shebangs and into `#!/usr/bin/env` lines where the writer usually means one
# of the two things and gets the other.
#
# `-o noglob`, which every column shares, is what core/invocation.tests uses
# and is asked here too — beside the letter, so the file says the option
# exists and the *letter* is what moved.
#
# `$SUITE_SHELL` is the shell of this run; see suite.OurShellVar.

: > aaa.txt
: > bbb.txt

# The letter, three ways of writing it, and the option's long name beside it.
"$SUITE_SHELL" -f -c 'printf "dash f: [%s]\n" *.txt'
"$SUITE_SHELL" -fc 'printf "bundled: [%s]\n" *.txt'
"$SUITE_SHELL" -o noglob -c 'printf "the option name: [%s]\n" *.txt'

# And with no option at all, so the three lines above are read against
# something rather than against an assumption.
"$SUITE_SHELL" -c 'printf "no option: [%s]\n" *.txt'

# `$0` read inside a function of a `-c` command string is the *function's*
# name here and the shell's `$0` in the other three — the same rule
# zsh/functions.tests records for a function called from a script, seen on the
# route where a script is one string on the command line.
"$SUITE_SHELL" -c 'f() { printf "in a function [%s]\n" "$0"; }
f' givenname
"$SUITE_SHELL" -c 'printf "outside a function [%s]\n" "$0"' givenname

# ---- every `setopt` name is a command-line word of its own ----
#
# The second of the two shells that have this facility, and it is not ksh93's.
# The namespace is zsh's own: it holds the `no` forms as names in their own
# right, it folds case and underscores wherever an option name is written, and
# the `--name` spelling folds hyphens on top of that — `--e-x-t-endedglob` is
# `extendedglob` here. A refused word is `no such option: …` at **1** with no
# usage block, where ksh93 writes a usage line and exits 2.
#
# The `-o` rows are what say the hyphen fold belongs to the `--name` spelling
# rather than to the option table: `--no-glob` is `noglob` and `-o no-glob` is
# a refusal, in the same shell in the same run.
#
# `--nonomatch` and `--nonoglob` are the pair that pins what "the `no` forms
# are names" means. `nomatch` is a canonical name, so `nonomatch` is its
# negation and is taken; the canonical name behind `noglob` is `glob`, so
# `noglob` is *already* the negation and `nonoglob` is a second one the
# namespace does not have.

# A refusal here names the shell by the **whole word** it was invoked by,
# where everything zsh says about a line it is running names `zsh` — so the
# harness's own `<shell>` rewrite is what appears in the rows below, and a
# shell that shortened its name to `zsh` would fail them. That is the
# difference from ksh93, which shortens its name for exactly this diagnostic
# and spells it in full everywhere else.

# A number in parentheses is a process group and is taken out: bash, asked for
# `-o monitor` with no terminal, says `cannot set terminal process group (N)`,
# and N is the group the run was started in — a new one every run, which made
# the whole file an answer the tier check could not repeat. No zsh row writes
# a parenthesized number.
zrow() {
	label=$1
	shift
	printf -- '--- %s\n' "$label"
	out=$( "$SUITE_SHELL" "$@" 2>&1 )
	st=$?
	printf '%s\n' "$out" | sed 's/([0-9-][0-9]*)/(<group>)/g'
	printf 'status %s\n' "$st"
}

zrow 'xtrace'              --xtrace -c 'echo traced'
zrow 'the no form of it'   --noxtrace -c 'echo untraced'
zrow 'errexit'             --errexit -c 'false; echo unreachable'
zrow 'noexec'              --noexec -c 'echo unreachable'
zrow 'shwordsplit'         --shwordsplit -c 'v="a b"; set -- $v; echo $#'
zrow 'and without it'      -c 'v="a b"; set -- $v; echo $#'
zrow 'extendedglob'        --extendedglob -c 'setopt'
zrow 'underscores'         --no_glob -c 'setopt'
zrow 'case as well'        --NO_GLOB -c 'setopt'
zrow 'hyphens too'         --no-glob -c 'setopt'
zrow 'and all of it'       --e-x-t-endedglob -c 'setopt'
zrow 'the same name to -o' -o no-glob -c 'echo unreachable'
zrow 'a no form as a name' --nonomatch -c 'setopt'
zrow 'a second negation'   --nonoglob -c 'echo unreachable'
zrow 'and with a gap in it' --no_no_glob -c 'echo unreachable'
zrow 'a word that is none' --zzznosuch -c 'echo unreachable'
zrow 'a bare no'           --no -c 'echo unreachable'
zrow 'no value is read'    --xtrace=1 -c 'echo unreachable'
zrow 'the refusal stops it' --zzz --xtrace -c 'echo unreachable'

# ---- the four names a running script cannot move, granted here ----
#
# zsh refuses exactly five names to a script — `interactive`, `monitor`,
# `shinstdin`, `singlecommand` and `zle`, with `can't change option: NAME` at
# 1 — and **takes four of the five on the command line that started it**.
# `singlecommand` was the one that already worked here and is the worked
# example the other four follow (#3154).
#
# The route is the whole of it, which is why these rows are in this file and
# not in options.tests: the refusals a script gets are right and were never in
# question, and the grant lives where the front end hands a `-o name` or a
# `--name` word to the option table. A Go test that called the resolver would
# pass with the routing gone, which is what #3129 recorded when
# `LongOptionNamesASetOption` was dropped and every one of them stayed green.
#
# Two of the four move observable state and two do not, and that is measured
# rather than symmetric:
#
#   - `interactive` turns the shell interactive, so `$-` gains `i` — and `Z`
#     with it, because `zle` is read over the same state and an interactive
#     shell has an editor.
#   - `shinstdin` gains `s`, which is the state behind the `s` this shell
#     already wrote on the route where the program really does arrive on
#     standard input.
#   - `monitor` and `zle` are **granted and inert**: status 0, nothing on
#     standard error, and `[[ -o NAME ]]` still false afterwards. Neither the
#     refusal a script gets nor a move.
#
# `+o zle` is the row that says the last of those is about the route and not
# about the name: with `interactive` on ahead of it the option really is on,
# and turning it off there takes the `Z` back out.

zrow 'interactive'          -o interactive -c 'echo "[$-]"'
zrow 'the long spelling'    --interactive -c 'echo "[$-]"'
zrow 'and it reads back'    -o interactive -c '[[ -o interactive ]] && echo yes; [[ -o zle ]] && echo and the editor'
zrow 'shinstdin'            -o shinstdin -c 'echo "[$-]"'
zrow 'reading back too'     --shinstdin -c '[[ -o shinstdin ]] && echo yes'
zrow 'monitor'              -o monitor -c 'echo "[$-]"'
zrow 'granted and inert'    --monitor -c '[[ -o monitor ]] && echo on; echo asked'
zrow 'zle'                  -o zle -c 'echo "[$-]"'
zrow 'and inert as well'    --zle -c '[[ -o zle ]] && echo on; echo asked'
zrow 'singlecommand'        -o singlecommand -c 'echo "[$-]"'
zrow 'two of them at once'  -o singlecommand -o interactive -c 'echo "[$-]"'
zrow 'the editor turned off' -o interactive +o zle -c 'echo "[$-]"'
zrow 'and asked for again'  -o interactive -c 'unsetopt zle; setopt zle; echo "[$-]"'
zrow 'the plus direction'   +o interactive -c 'echo "[$-]"'
zrow 'and the no spelling'  --nomonitor -c 'echo "[$-]"'

# And a script still may not move any of them, which is the half that was
# already right and is what the four rows above are a difference against.
zrow 'a script may not'     -c 'setopt interactive'
zrow 'nor this one'         -c 'setopt shinstdin'
zrow 'nor the editor'       -c 'setopt zle'
zrow 'nor one command'      -c 'setopt singlecommand'

# `ARGV0`: the variable that names the command instead of reaching it.
#
# zsh alone reads an **exported** `ARGV0` as the `argv[0]` the next command is
# started under, and spends it there — the child is named and never shown the
# variable. Everywhere else it is a variable like any other.
#
# The noun is "exported" and not "prefix", which is what the last two rows
# below are for: they hold "there is a variable named ARGV0" fixed and vary
# only whether it is exported, and the answer moves. Every row above them
# agrees with a rule written around the assignment prefix, and that rule is
# wrong about what decides any of them.
#
# No row prints `$0` itself unless it was renamed — an unrenamed `$0` is this
# run's own path, which is not the same string in the two columns being
# compared. The unrenamed rows ask a yes-or-no question instead.

printf 'a prefix: [%s]\n' "$(ARGV0=chosen "$SUITE_SHELL" -c 'printf %s "$0"')"
printf 'exported, no prefix: [%s]\n' "$(export ARGV0=chosen; "$SUITE_SHELL" -c 'printf %s "$0"')"
printf 'exported after the fact: [%s]\n' "$(ARGV0=chosen; export ARGV0; "$SUITE_SHELL" -c 'printf %s "$0"')"

# And it is spent rather than copied: the child is named and the name is gone
# from its environment.
ARGV0=chosen "$SUITE_SHELL" -c 'printf "spent: [%s]\n" "${ARGV0-unset}"'

# This shell's own copy survives the command it named, so only the child's
# environment was touched.
(export ARGV0=kept; "$SUITE_SHELL" -c ':'; printf 'ours survives: [%s]\n' "$ARGV0")

# The first half of the discriminating pair: a variable of that name, and
# nothing exports it.
(ARGV0=chosen
 "$SUITE_SHELL" -c 'case $0 in chosen) echo "not exported: renamed";; *) echo "not exported: left alone";; esac')

# The second half: exported and then not, which takes the attribute away and
# leaves the variable in place.
(export ARGV0=chosen; typeset +x ARGV0
 "$SUITE_SHELL" -c 'case $0 in chosen) echo "unexported: renamed";; *) echo "unexported: left alone";; esac')

# And every other assignment prefix goes on doing exactly what it did: it
# reaches the child as a variable and renames nothing.
(V=1 "$SUITE_SHELL" -c 'printf "ordinary prefix: [%s] " "$V"
 case $0 in V|1) echo renamed;; *) echo "and it renamed nothing";; esac')
