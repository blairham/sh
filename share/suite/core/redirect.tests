# SPDX-FileCopyrightText: 2026 Blair Hamilton
# SPDX-License-Identifier: Apache-2.0
#
# Redirection, POSIX XCU 2.7. Every case that involves the error stream sends
# it to a file and then prints the file, rather than letting the two streams
# interleave on one descriptor: the order two streams arrive in is a property
# of when a libc flushed, not of the shell, and a case whose answer moves with
# buffering is a case that says nothing.

printf 'first\n' > out
printf 'second\n' >> out
printf 'read back:\n'
cat out
printf 'redirected in: '
cat < out | wc -l | tr -d ' '

printf 'clobbered\n' > out
printf 'truncating > left: '
cat out

# The redirection is set up before the command runs, so a file read and
# written in the same command sees the truncation.
printf 'a\nb\n' > two
printf 'lines=%s\n' "$(wc -l < two | tr -d ' ')"

# Order matters: 2>&1 duplicates whatever descriptor 1 is at that moment.
{ printf 'to stdout\n'; printf 'to stderr\n' >&2; } > both 2>&1
printf 'both, in order:\n'
cat both
{ printf 'out only\n'; printf 'err only\n' >&2; } > justout 2> justerr
printf 'stdout file: '; cat justout
printf 'stderr file: '; cat justerr

# `2>&1 > file` and a write to a closed descriptor are deliberately absent.
# Measured: zsh sends the error stream to *both* targets, because a second
# redirection of one descriptor tees rather than replaces, and a write to a
# closed descriptor is a diagnostic and status 1 in bash while zsh and ksh93
# say nothing. Both are dialect answers.

# /dev/null swallows, and reading it is immediately end of file.
printf 'swallowed\n' > /dev/null
printf 'devnull status=%s\n' "$?"
printf 'devnull read=[%s]\n' "$(cat < /dev/null)"

# Here-documents. Unquoted, the body is expanded; quoted, it is not.
v=expanded
cat <<HERE
plain $v
arith $((2 * 3))
sub $(printf inner)
HERE
cat <<'HERE'
literal $v
literal $((2 * 3))
HERE
# <<- strips leading tabs from the body and the delimiter.
cat <<-HERE
	indented $v
	HERE

# A here-document is the command's standard input, so a reader consumes it.
while IFS= read -r line; do printf 'from heredoc: %s\n' "$line"; done <<'HERE'
one
two
HERE

# Two here-documents on one command line: the last wins in bash, ksh93 and
# dash, and zsh feeds both, so that one is asked in the dialect files.

# Redirections on a compound command apply to everything inside it.
{
	printf 'group line 1\n'
	printf 'group line 2\n'
} > grouped
printf 'grouped:\n'
cat grouped
for w in x y; do printf '%s\n' "$w"; done > looped
printf 'looped: '
tr '\n' ' ' < looped
printf '\n'

# exec moves the shell's own descriptors, and a numbered descriptor can be
# opened, written and closed.
exec 3> three
printf 'via three\n' >&3
exec 3>&-
printf 'fd 3:\n'
cat three
exec 4< three
IFS= read -r line <&4
exec 4<&-
printf 'read via fd 4: %s\n' "$line"

# Reading from a missing file fails without running the command. The
# diagnostic is each shell's own wording, so it goes to /dev/null — and the
# order matters, because a redirection that fails reports on whatever the
# error stream was when it failed. The status is kept in `rc` and not in
# `status`, which zsh makes read-only — measured, and a case file that used it
# would fail zsh for a reason that is about the case rather than the shell.
cat 2> /dev/null < nosuchfile
rc=$?
printf 'missing input status is nonzero: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi
printf 'missing input ran the command: '
if [ -e nosuchfile ]; then printf 'yes\n'; else printf 'no\n'; fi

# A redirection on a null command still happens.
: > made
printf 'null command made the file: '
if [ -f made ]; then printf 'yes\n'; else printf 'no\n'; fi

# --- every operator, once ----------------------------------------------------
#
# The table the rest of the file leans on. `>` `>>` `<` `<>` `>&` `<&` `>&-`
# `<&-` `>|` and `<<`, each on its own line, so a shell missing one is missing
# a named line rather than a subtle difference in a compound case.

printf 'to a file\n' > op1
printf 'write:       [%s]\n' "$(cat op1)"
printf 'appended\n' >> op1
printf 'append:      [%s]\n' "$(cat op1 | tr '\n' '-')"
printf 'read:        [%s]\n' "$(cat < op1)"
( printf 'read-write\n' 1<> op2 )
printf 'read-write:  [%s]\n' "$(cat op2)"
{ printf 'dup\n' >&5; } 5> op3
printf 'duplicated:  [%s]\n' "$(cat op3)"
{ cat <&6; } 6< op3
( printf 'clobbered\n' >| op1 )
printf 'clobbering:  [%s]\n' "$(cat op1)"

# The numbered descriptor is the command's, so it is gone again afterwards.
( printf 'gone\n' >&5 ) 2>/dev/null
rc=$?
printf 'the descriptor did not outlive its command: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi

# --- closing -----------------------------------------------------------------
#
# `>&-` and `<&-` close. Reading from a closed descriptor fails in every
# column; *writing* to one does not — zsh leaves status 0 where the other
# three fail — so only the reading half is here and the other is
# share/suite/zsh/redirect.tests.

( cat <&- ) 2>/dev/null
rc=$?
printf 'reading a closed descriptor failed: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi

# --- noclobber ---------------------------------------------------------------
#
# With `set -C` a plain `>` will not truncate a file that exists. What it does
# instead is refuse, and the *number* it refuses with is dash's own — 2 there
# and 1 in the other three — so what is claimed here is the refusal and its
# effect on the file, and share/suite/dash/redirect.tests holds the number.

set -C
printf 'kept\n' > nc
( printf 'overwritten\n' > nc ) 2>/dev/null
rc=$?
printf 'noclobber refused: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi
printf 'the file is untouched: [%s]\n' "$(cat nc)"
( printf 'appended\n' >> nc ) 2>/dev/null
printf 'append is allowed: [%s]\n' "$(cat nc | tr '\n' '-')"
( printf 'forced\n' >| nc ) 2>/dev/null
printf 'the override truncates: [%s]\n' "$(cat nc)"
( printf 'fresh\n' > nc2 ) 2>/dev/null
printf 'a file that did not exist: [%s]\n' "$(cat nc2)"
( : > nc3 ) 2>/dev/null
printf 'a new file from the null command: [%s]\n' "$(cat nc3)"
( printf 'discarded\n' > /dev/null ) 2>/dev/null
rc=$?
printf 'the null device is exempt: %s\n' "$rc"
set +C
printf 'after set +C\n' > nc
printf 'and the option really was what refused: [%s]\n' "$(cat nc)"

# --- order -------------------------------------------------------------------
#
# Redirections are applied left to right, so `>file 2>&1` sends both streams
# to the file and `2>&1 >file` sends the error stream wherever the output was
# *before* the file was opened. The pair is the case; either line alone is
# indistinguishable from a shell that applied them in the other order.

{ printf 'out\n'; printf 'err\n' >&2; } > ord1 2>&1
printf 'file first:  [%s]\n' "$(cat ord1 | tr '\n' '-')"
{ printf 'out\n'; printf 'err\n' >&2; } 2>&1 > ord2
printf 'dup first:   [%s]\n' "$(cat ord2 | tr '\n' '-')"
{ printf 'o\n'; printf 'e\n' >&2; } > ord3 2> ord4
printf 'two targets: [%s] [%s]\n' "$(cat ord3)" "$(cat ord4)"

# Both streams to the same file by name rather than by duplication: the second
# open truncates what the first wrote, which is the reason `2>&1` exists.
{ printf 'first\n'; printf 'second\n' >&2; } > same 2> same
printf 'the same name twice: [%s]\n' "$(cat same | tr '\n' '-')"

# --- a redirection that fails -----------------------------------------------
#
# The redirection is set up before the command runs, so a failure means the
# command did not run at all — and a *later* redirection in the same command
# was never reached either.

( cat < nosuchfile ) 2>/dev/null
rc=$?
printf 'a missing input failed: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi
( cat < nosuchfile > wouldbe ) 2>/dev/null
printf 'the later target was not created: '
if [ -e wouldbe ]; then printf 'it was\n'; else printf 'it was not\n'; fi

# --- here-documents ----------------------------------------------------------
#
# Four ways to write the delimiter, and only the bare one expands the body.

v=expanded
cat <<BARE
bare: $v and $((2 * 3)) and $(printf 'sub')
BARE
cat <<'SINGLE'
single: $v and $((2 * 3))
SINGLE
cat <<"DOUBLE"
double: $v
DOUBLE
cat <<\ESCAPED
escaped: $v
ESCAPED

# A backslash in an unquoted body escapes, and in a quoted one it is data.
cat <<BS
unquoted backslash: \$v and \\ and a continued \
line
BS
cat <<'BS'
quoted backslash: \$v and \\ and a continued \
line
BS

# The body may be empty, may end in text, and may hold a tab.
printf 'empty body: ['
cat <<EMPTY
EMPTY
printf ']\n'
cat <<TAB
tab	inside
TAB

# A blank between the operator and the delimiter word is allowed.
cat << SPACED
a blank before the delimiter word
SPACED

# The body is the command's standard input wherever the command is: in a
# group, in a function, in a pipeline, and with another redirection beside it.
{ cat; } <<GROUP
inside a group
GROUP
emit() {
	cat <<FUNC
inside a function, where $v still expands
FUNC
}
emit
cat <<PIPE | tr '\n' '-'
piped
away
PIPE
printf '\n'
cat <<FILE > hdfile
into a file
FILE
printf 'and back: [%s]\n' "$(cat hdfile)"

# An expansion in an unquoted body is an expansion like any other, so one that
# fails takes the command with it — and the body is not written.
unset missing
( cat <<FAIL
before ${missing?is unset}
after
FAIL
) 2>/dev/null
rc=$?
printf 'a failing expansion in the body failed the command: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi
( cat <<'SAFE'
before ${missing?is unset}
SAFE
) 2>/dev/null
printf 'and quoted, the same text is data\n'

# `<<-` strips leading tabs from the body *and* from the delimiter line, and
# strips only tabs — a leading blank is data.
cat <<-STRIP
	tabs are stripped
		even from a deeper line
	    and the blanks past the tabs are data
	STRIP

# Two here-documents on one command line are deliberately absent: bash, ksh93
# and dash feed the command only the last, and zsh's MULTIOS feeds it both, so
# it is share/suite/zsh/redirect.tests.

# A `( … )`'s here-document body: the rows every shell in the panel agrees
# about. Where the body's *write* lands is not one of them — it splits four to
# one and lives in each dialect's own file — but everything around it is
# common, and each of these is a reading the split row would otherwise be
# confused with. Measured 2026-09-26 across bash 5.3.20, zsh 5.9.2, ksh93u+
# 2012-08-01, dash 0.5.12 and BusyBox v1.37.0 (#4700).

hd_zz() { printf -- '--- %s\n' "$1"; }

hd_zz 'a group keeps what its here-document body wrote'
n_zz=0
{ cat; } <<END
$(( n_zz += 5 ))
END
printf 'n=[%s]\n' "$n_zz"

hd_zz 'a function keeps it too'
f_zz() { cat; }
n_zz=0
f_zz <<END
$(( n_zz += 5 ))
END
printf 'n=[%s]\n' "$n_zz"

hd_zz 'a quoted delimiter on a subshell is literal, so there is no write'
n_zz=0
( cat ) <<'END'
$(( n_zz += 5 ))
END
printf 'n=[%s]\n' "$n_zz"

# Counted as whole lines, because the body's own text reaches the command too
# — and counted at all because "confined" and "never expanded" produce the
# same `n` and are not the same fact.
hd_zz 'a subshell body is expanded once even where nothing reads it'
( ( : ) <<END
$(printf 'TICK\n' >&2; printf 'z\n')
END
) 2>&1 | grep -c '^TICK$'

hd_zz 'a redirection the shell never reaches expands nothing'
( false && ( cat ) <<END
$(printf 'TICK\n' >&2; printf 'z\n')
END
) 2>&1 | grep -c '^TICK$'

# The marker is after a `;` on the redirection's own line: one on the next
# line is printed by every reading there is.
hd_zz 'a failing subshell body costs the parentheses: the rest of the line runs'
( ( echo RAN ) <<END ; echo SAME
$(( 1/0 ))
END
) 2>/dev/null
printf 'after st=%s\n' "$?"

hd_zz 'and || catches it'
( ( echo RAN ) <<END || echo CAUGHT
$(( 1/0 ))
END
) 2>/dev/null
