#
# Arithmetic, the answer only bash gives — #3202.
#
# One claim: a well-formed integer numeral larger than the machine word is
# read in an unsigned word that goes round, and the result is then read as
# signed. That is C's `strtoull` with the range error thrown away, and it is
# bash's alone on this panel — zsh reads part of the numeral and says so, dash
# clamps at the largest signed value, and ksh93 has no word to overflow and
# answers the double its arithmetic is carried in.
#
# Measured identically in 5.3.20, in 3.2.57 and under the `sh` name, so this
# is the shell's reading rather than a version's.

# The pair that says it is modular rather than a stop at the top of the
# unsigned word: a reader that saturated there would answer -1 twice.
printf 'at the unsigned maximum: %s\n' "$(( 18446744073709551615 ))"
printf 'one past it:             %s\n' "$(( 18446744073709551616 ))"

printf 'one past the word:       %s\n' "$(( 10000000000000000000 ))"
printf 'several words past:      %s\n' "$(( 99999999999999999999999 ))"
printf 'hexadecimal:             %s\n' "$(( 0xffffffffffffffffff ))"
printf 'octal:                   %s\n' "$(( 01777777777777777777777 ))"
printf 'negated:                 %s\n' "$(( -10000000000000000000 ))"
printf 'and still arithmetic:    %s\n' "$(( 10000000000000000000 - 1 ))"

# The same digits out of a variable, which is the row dash answers differently
# from its own written numeral and every other column answers the same way
# twice.
big=10000000000000000000
printf 'the same digits stored:  %s\n' "$(( big ))"

# The control: a numeral the word holds is untouched by any of this.
printf 'the largest that fits:   %s\n' "$(( 9223372036854775807 ))"

# An associative subscript written inside an arithmetic expression is a
# quoting context here, exactly as `${m['k']}` is — so `(( a['q'] ))` is the
# element under the one character `q`, and the store takes the same key the
# read does. ksh93u+ agrees; zsh 5.9.2 does not, and looks up the three
# characters the quotation is, which is the same split
# `${a['q']}` already falls on.
declare -A quo
quo[q]=7
quo['a b']=9
(( r = quo[q] )); printf 'bare %s\n' "$r"
(( r = quo['q'] )); printf 'single-quoted %s\n' "$r"
(( r = quo["q"] )); printf 'double-quoted %s\n' "$r"
(( r = quo[\q] )); printf 'backslashed %s\n' "$r"
(( r = quo['a b'] )); printf 'a quoted blank %s\n' "$r"
printf 'through a dollar-arithmetic %s\n' "$(( quo['q'] ))"
(( quo['k'] = 5 ))
printf 'the store takes the same key [%s]\n' "${quo[k]-U}"
(( r = quo[zz] )); printf 'an absent key is still %s\n' "$r"
idx=(9 8 7)
(( r = idx[1+1] )); printf 'an indexed subscript is still an expression %s\n' "$r"

# A quotation inside an arithmetic subscript holds its brackets: what ends the
# subscript is the `]` the script wrote outside the quotes, so a key spelled
# with a bracket in it is reachable from arithmetic exactly as it is from
# `${m[']']}`. ksh93u+ 2012-08-01 answers every row of this the same way; zsh
# 5.9.2 will not store such a key at all (#3302).
declare -A brk
brk[']']=5
brk['x]']=6
(( r = brk[']'] )); printf 'a key that is one bracket %s\n' "$r"
(( r = brk['x]'] )); printf 'a key with a bracket in it %s\n' "$r"
printf 'through a dollar-arithmetic %s\n' "$(( brk[']'] ))"
[[ brk[']'] -eq 5 ]] && printf 'and a condition reads the same element\n'

# The other half of the same rule: a quote a *value* carried is a character of
# the key and opens nothing, so the two spellings reach two different
# elements.
declare -A val
val["'q'"]=21
val[q]=22
val['"q"']=23
sq="'q'"
dq='"q"'
(( r = val[$sq] )); printf 'a value brings its own single quotes %s\n' "$r"
(( r = val[$dq] )); printf 'and its own double quotes %s\n' "$r"
(( r = val['q'] )); printf 'where the script writing them means the bare key %s\n' "$r"

# The `set -u` refusal an expression raises is this shell's own and stops it
# wherever it was written, which is what parts it from an ordinary arithmetic
# failure here. Measured 2026-09-18 against bash 5.3.20 with `b` unset: the
# arithmetic command and `let` both end the shell, where the identical two
# constructs failing to read an expression leave a status and run on (#3574).
( set -u; (( b )); printf 'ran on\n' ) 2>/dev/null
printf 'an arithmetic command: %s\n' "$?"
( set -u; (( b )) || printf 'caught\n'; printf 'ran on\n' ) 2>/dev/null
printf 'and an || does not catch it: %s\n' "$?"
( set -u; let "x = b"; printf 'ran on\n' ) 2>/dev/null
printf 'a let operand: %s\n' "$?"
( set -u; typeset -i n; n=b; printf 'ran on\n' ) 2>/dev/null
printf 'an integer declaration: %s\n' "$?"

# The controls: the same two constructs failing as constructs are a status.
( set -u; (( 1 + )); printf 'ran on: %s\n' "$?" ) 2>/dev/null
( set -u; let "x = 1 +"; printf 'ran on: %s\n' "$?" ) 2>/dev/null

# And the refusal names the subscript a reference was aimed at, not the
# reference — the one name in the line that is perfectly well defined. The
# literal subscript is the control, since it holds no name to be unset.
( set -u; declare -n r=a[b]; : "$r" ) 2>/dev/null
printf 'a reference to an element: %s\n' "$?"
( set -u; declare -n r=a[1]; : "$r" ) 2>/dev/null
printf 'a reference with a literal subscript: %s\n' "$?"
