#
# `.` in bash — #2322, and the one place bash looks that nobody else on the
# panel does.
#
# POSIX XCU says `.` searches PATH for a name with no slash in it, and says
# nothing about what happens when PATH does not have it. bash then tries the
# working directory. zsh, ksh93 and dash all stop at the end of PATH, so the
# same script that works here is a missing file everywhere else — which is
# the shape of most "it works on my machine" reports about a `. lib.sh` that
# was never given a `./`.
#
# The behavior is an option and the option is on by default, so the file
# measures both ends of it: with `sourcepath` set the working directory is
# reached, and with it unset bash stops where the other three stop.

printf 'printf "found in the working directory\\n"\n' > cwdlib.sh
mkdir -p libdir
printf 'printf "found on PATH\\n"\n' > libdir/pathlib.sh
PATH="$PWD/libdir:/usr/bin:/bin"

# On PATH, which every shell here does.
. pathlib.sh; printf 'on PATH -> %s\n' "$?"

# Not on PATH, and found anyway. Every diagnostic is dropped here: what is
# being compared is which shell found the file, and the sentence the ones
# that did not write for it is #2324's question.
. cwdlib.sh 2>/dev/null; printf 'not on PATH -> %s\n' "$?"

# `source` takes the same route.
source cwdlib.sh 2>/dev/null; printf 'source, not on PATH -> %s\n' "$?"

# The option that decides it.
shopt -q sourcepath 2>/dev/null; printf 'sourcepath on by default -> %s\n' "$?"
shopt -u sourcepath 2>/dev/null; printf 'shopt -u -> %s\n' "$?"

# With it off, the name is not found and the status says so — the same 1
# bash gives for any dot file it could not open.
( . cwdlib.sh ) 2>/dev/null; printf 'with sourcepath off -> %s\n' "$?"

# And what it turns off is the whole search: even the name PATH *does* have
# is no longer found, which is the half of the option its name does not say.
. pathlib.sh 2>/dev/null; printf 'on PATH with it off -> %s\n' "$?"

# A name with a slash was never a search at all, so it is unaffected.
. ./cwdlib.sh 2>/dev/null; printf 'with a slash -> %s\n' "$?"

shopt -s sourcepath 2>/dev/null
. cwdlib.sh 2>/dev/null; printf 'back on -> %s\n' "$?"

# The other half of the same mechanism: `. -p list file` is "look along this
# list instead, for this call only", and it is bash's alone — zsh reads the
# `-p` as the name of a file, and ksh93, dash and BusyBox ash each call it an
# option they have not got. **bash 3.2 has not got it either**, answering
# `.: -p: invalid option`, so this is a 5.x row rather than a bash one.
mkdir -p aside
printf 'printf "found by -p\\n"\n' > aside/asidelib.sh

# A directory that is neither the working one nor on PATH.
. -p "$PWD/aside" asidelib.sh
printf 'p option -> %s\n' "$?"

# Several directories, like a PATH, and the first hit wins.
. -p "/nonexistent-zz:$PWD/aside" asidelib.sh; printf 'a list -> %s\n' "$?"

# The list *replaces* the search rather than adding to it: a miss is a miss
# even when the file is in the working directory, where a plain `.` finds it.
. -p /nonexistent-zz cwdlib.sh 2>/dev/null; printf 'a missed list -> %s\n' "$?"

# An empty argument is a list of one empty element, which is the working
# directory — the same rule an empty element inside a longer list follows.
. -p "" cwdlib.sh; printf 'an empty list -> %s\n' "$?"

# It wins over the switch, so the two halves do not cancel.
shopt -u sourcepath
. -p "$PWD/aside" asidelib.sh; printf 'p option with the switch off -> %s\n' "$?"
shopt -s sourcepath

# A name with a slash was never a search, so `-p` does not reach it.
. -p "$PWD/aside" ./asidelib.sh 2>/dev/null; printf 'a slash with -p -> %s\n' "$?"

# `source` is the same builtin and takes it too.
source -p "$PWD/aside" asidelib.sh; printf 'source -p -> %s\n' "$?"

# And the two ways to write it wrong.
( . -p ) 2>/dev/null; printf 'no argument -> %s\n' "$?"
( . -p "$PWD/aside" ) 2>/dev/null; printf 'no file -> %s\n' "$?"

# A definition the parser refused binds nothing — #3194.
#
# `eval` reads its text a line at a time and runs what it has read, so a
# failure on a later line still leaves the lines before it run: the second row
# below prints `A` before it complains. A failure *inside* a construct is the
# other half of the same rule, and is the one that was wrong here: the whole
# logical line goes, so a function definition the parser would not finish
# leaves whatever `f` was before it standing rather than replacing it with the
# part that parsed.
#
# The empty body is the shape that made it silent rather than loud. The
# replacement bound here answered 0 and printed nothing, so a script that
# re-defines a helper wrongly lost the helper with no diagnostic at the point
# of use — and this is a bash row rather than a core one because zsh *accepts*
# an empty body and binds exactly that function on purpose (zsh/evaldot.tests).
f() { printf 'orig\n'; }
eval 'f() {
}' 2>/dev/null
printf 'a refused definition -> %s\n' "$?"
f
printf 'and f is still the old one -> %s\n' "$?"

# The lines before the refusal did run, which is what makes the rule above a
# rule about the line and not about the text.
eval 'printf "A\n"
{ fi; }' 2>/dev/null
printf 'a refusal on the second line -> %s\n' "$?"

# And both sentences name the same line. bash numbers `eval`'s text from the
# line the `eval` word is on, and the quote underneath the complaint is
# indexed into the text while being printed with the caller's number — where
# printing the text's own number in front of it made the second sentence
# contradict the first.
eval 'printf "A\n"
{ fi; }' 2>&1 > /dev/null
