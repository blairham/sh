#
# getopts in dash — #2321.
#
# Two of the three answers here dash shares with zsh and not with bash or
# ksh93, so neither is dash's alone and neither could be a tier of its own.
# What makes the file dash's is the third: the sentence dash writes for an
# option its string does not list is `Illegal option -z`, with no script
# name, no line number and no `--` in front of the letter — the shortest
# diagnostic on the panel and the only one that names neither the file nor
# the utility.
#
# The other two are recorded here because this is where the dash side of a
# two-against-two split is measured at all:
#
#   * OPTARG is set to the empty string after an option that takes no
#     argument, where bash and ksh93 leave it unset. `${OPTARG+set}` is the
#     difference, and it is the test a script writes when it wants to know
#     whether the option it just read carried a value.
#   * a second loop over the same arguments, with OPTIND left where the first
#     loop ended, reads the arguments again rather than seeing nothing. A
#     helper function that parses its own options therefore parses them on
#     every call here, and only on the first call in bash and ksh93.

# Each probe is its own function. Two `getopts` calls at the top level with
# operands of their own is a shape real zsh answers a call behind itself in,
# reporting the *previous* option's letter and argument, and a case built on
# that would be pinning one shell's confusion rather than any shell's answer.

noarg() {
  OPTARG=PRESET
  OPTIND=1
  getopts 'ab:' o -a > /dev/null 2>&1
  printf 'OPTARG after a no-argument option: [%s] set=[%s]\n' "${OPTARG-UNSET}" "${OPTARG+yes}"
}
noarg

# And after one that does take an argument, where every shell agrees.
witharg() {
  OPTARG=PRESET
  OPTIND=1
  getopts 'ab:' o -b val > /dev/null 2>&1
  printf 'OPTARG after an argument-taking option: [%s]\n' "${OPTARG-UNSET}"
}
witharg

# The second loop.
g() {
  while getopts 'ab' o "$@" > /dev/null 2>&1; do printf 'g saw %s\n' "$o"; done
  printf 'g end ind=%s\n' "$OPTIND"
}
OPTIND=1
g -a -b
g -a -b

# The sentence. stdout is dropped and stderr kept, so what is compared is the
# diagnostic and nothing else.
h() { OPTIND=1; getopts 'a' o -z 2>&1 > /dev/null; }
h

# --- OPTIND inside a word of several letters ---

# `-abc` is three options in one word. dash's OPTIND names the word *after*
# it from the first letter on, keeping its place inside the word somewhere a
# script cannot see; bash and ksh93 leave OPTIND naming the word until its
# last letter has been read. zsh is a third answer again and is in zsh/.
#
# It matters for the same reason the rest of this file does: a script that
# reads OPTIND between two calls — to `shift` early, or to report how far it
# got — gets a different number here from the one bash gives it.
trace() {
  OPTIND=1
  while getopts 'ab:c' o "$@" > /dev/null 2>&1; do
    printf 'saw %s ind=%s\n' "$o" "$OPTIND"
  done
  printf 'end ind=%s\n' "$OPTIND"
}
trace -abc rest
trace -ac rest
trace -a -c rest

# --- a freeze on the names getopts fills in ---
#
# The third answer on the panel and dash's own. bash consults a `readonly` on
# OPTARG, reports it and writes everything else anyway; ksh93 and zsh do not
# consult it at all. dash consults it and **stops**: the builtin reports,
# returns 2, and neither the name nor OPTIND is written (#3147).
#
# OPTIND is what says it stopped rather than merely reported. It is still 1
# afterwards, so the word count had not moved by the time the refusal
# happened — and it is the only place the order the two are written in is
# visible from a script.
#
# Each case resets OPTIND, for the reason the probes above are functions.

printf 'frozen OPTARG reports -> '
( OPTIND=1; set -- -a val; readonly OPTARG
  getopts 'a:' o 2>&1 >/dev/null | wc -l | tr -d ' ' )

( OPTIND=1; set -- -a val -b; o=none; readonly OPTARG
  getopts 'a:b' o 2>/dev/null
  printf 'frozen OPTARG: st=%s o=[%s] OPTIND=%s\n' "$?" "$o" "$OPTIND"
  getopts 'a:b' o 2>/dev/null
  printf 'and again:     st=%s o=[%s] OPTIND=%s\n' "$?" "$o" "$OPTIND" )

# A frozen OPTIND stops it one write later: OPTARG is written before the
# refusal happens and keeps the value it was given.
( OPTIND=1; set -- -a val; o=none; readonly OPTIND
  getopts 'a:' o 2>/dev/null
  printf 'frozen OPTIND: st=%s o=[%s] OPTARG=[%s]\n' "$?" "$o" "${OPTARG-unset}" )

# And a frozen name, which is the same 2 — here the two answers meet, because
# a name nothing may write is a letter nothing can report.
( OPTIND=1; set -- -a val; N=kept; readonly N
  getopts 'a:' N 2>/dev/null
  printf 'frozen name: st=%s N=[%s] OPTARG=[%s]\n' "$?" "$N" "${OPTARG-unset}" )

# Including at the end of the options, where bash keeps its own 1.
( OPTIND=1; set -- operand; N=kept; readonly N
  getopts 'a:' N 2>/dev/null
  printf 'frozen name at the end: st=%s N=[%s]\n' "$?" "$N" )

# None of it ends the script, which is what separates a builtin's refused
# write from the plain `x=2` this shell gives a whole file up for.
( OPTIND=1; set -- -a val; readonly OPTARG
  getopts 'a:' o 2>/dev/null; printf 'the rest of the line ran\n' ) 2>/dev/null
