#
# down-line-or-beginning-search — a widget, installed with
#
#   autoload -Uz down-line-or-beginning-search
#   zle -N down-line-or-beginning-search
#
# The partner of up-line-or-beginning-search: down a line inside a line that
# holds several; from the last line, forward through history to the nearest
# entry that begins with what is before the cursor, and past the newest back
# to the line that was being typed.
#
# Written from zshcontrib(1) and from what the installed shell answers, never
# from its function files; docs/spec/functions.md has the table. One thing
# here is not the mirror of the other widget, and it is measured: the cursor
# goes to the end of the line only when something matched. Where nothing did,
# it stays where it was.

emulate -L zsh

if [[ $RBUFFER == *$'\n'* ]]; then
	_zle_beginning_search_from=
	zle .down-line
	return
fi
if [[ $LASTWIDGET == (up|down)-line-or-beginning-search && -n $_zle_beginning_search_from ]]; then
	CURSOR=$_zle_beginning_search_from
else
	typeset -g _zle_beginning_search_from=$CURSOR
fi
if zle .history-beginning-search-forward; then
	local rest=${RBUFFER%%$'\n'*}
	(( CURSOR += $#rest ))
fi
return 0
