#
# eval, `.` and source — #2322. The two ways a shell runs text that was not
# in the script when it started, and both are special builtins.
#
# What the panel splits on is held out and named. There is a lot of it, and
# every line of it is about *failure* rather than about what either builtin
# does when it works:
#
#   `. ./nosuchfile`     bash 1, ksh93 1, dash 2, zsh 127 — and inside a
#                        function bash and zsh carry on where ksh93 and dash
#                        give the function up. Four shells, three statuses,
#                        two answers about whether it is fatal.
#   a dot file or an     bash 2, dash 2, ksh93 3 — and zsh 0, carrying on as
#   `eval` that will     though nothing had happened. zsh/ and ksh/.
#   not parse
#   `. file args`        bash, zsh and ksh93 give the dot script operands of
#                        its own and put the caller's back afterwards; dash
#                        ignores them entirely and the script sees the
#                        caller's. ext/ and dash/.
#   `. name` when PATH   bash falls back to the working directory; the other
#   does not have it     three do not. bash/.
#   `source`             bash, zsh and ksh93 have it — in ksh93 as a preset
#                        alias for `command .` — and dash does not. ext/.
#   `return 300`         bash and ksh93 answer 44, zsh and dash 300. Two
#                        against two, so it is nobody's dialect answer.
#   `. adirectory`       bash and ksh93 fail it, zsh and dash succeed. Two
#                        against two again.
#   `$0` in a dot file   zsh alone renames it to the sourced file. zsh/.

eval 'printf "simple\n"'
eval printf '"%s\\n"' unquoted
eval 'printf "%s\n" "one" "two"'

# The words are joined with a space and then read as shell input, so a
# multi-word eval is one command line rather than several.
eval 'printf' "'%s\n'" 'joined args'

# The text goes through the whole expansion the shell does for anything else,
# and it is expanded twice — once to build the string, once when the string is
# run. That second pass is what eval is for.
v=world
eval 'printf "hello %s\n" "$v"'
eval 'printf "%s\n" $(printf "sub")'
w='printf "from variable\n"'
eval "$w"
x='$v'
eval "printf '%s\n' \"$x\""

# It runs in the current shell, so its assignments and its arithmetic stay.
eval 'a=1'; printf 'assigned %s\n' "$a"
n=1; eval "n=$((n+1))"; printf 'n=%s\n' "$n"

# Any shell input at all, not only a simple command.
eval 'printf "a\n"; printf "b\n"'
eval 'for w in x y; do printf "%s " "$w"; done'; printf '\n'
eval 'if true; then printf "compound\n"; fi'

# The status is the status of what it ran, and nothing to run is a success.
eval ''; printf 'empty eval -> %s\n' "$?"
eval 'false'; printf 'false eval -> %s\n' "$?"

printf -- '--- dot ---\n'

# A dot script runs in the current shell: its assignments and its function
# definitions are still there afterwards.
printf 'printf "sourced\\n"\n' > s1.sh
. ./s1.sh
printf 'sv=set-by-source\n' > s3.sh
. ./s3.sh; printf 'sv=%s\n' "$sv"
printf 'f_from_source() { printf "defined in source\\n"; }\n' > s6.sh
. ./s6.sh; f_from_source

# It sees the caller's positional parameters rather than a set of its own.
printf 'printf "args [%%s][%%s]\\n" "$1" "$2"\n' > s2.sh
. ./s2.sh
set -- outer1 outer2
. ./s2.sh

# `return` in a dot script ends the script and gives it that status; the rest
# of the file does not run.
printf 'return 7\nprintf "not reached\\n"\n' > s4.sh
. ./s4.sh; printf 'return from dot -> %s\n' "$?"

# A dot script may source another.
printf 'printf "nested outer\\n"\n. ./s1.sh\n' > s5.sh
. ./s5.sh

# A name with no slash in it is looked up on PATH, which is what makes `.`
# the way a script loads a library rather than a file.
mkdir -p sub
printf 'printf "found on path\\n"\n' > sub/s7.sh
PATH="$PWD/sub:$PATH"
. s7.sh

printf -- '--- how eval reads its operands ---\n'

# The operands are joined with a single space and the result is read as shell
# input, so the quoting a second read sees is what the first read left.
eval printf '"[%s]\n"' one two
eval 'printf' '"%s-%s\n"' a b
eval printf "'%s\n'" 'has space'

# Nothing to run is a success, and so is text with nothing in it to run.
eval; printf 'no operands -> %s\n' "$?"
eval ' '; printf 'only blanks -> %s\n' "$?"
eval '#comment'; printf 'only a comment -> %s\n' "$?"

# Several commands in one operand, and the status is the last one's.
eval 'true; false'; printf 'last of several -> %s\n' "$?"
eval 'false; true'; printf 'the other order -> %s\n' "$?"

# It runs in the current shell, so the caller's positional parameters are
# what it reads and what it sets.
set -- p1 p2
eval 'printf "args [%s][%s]\n" "$1" "$2"'
eval 'set -- q1 q2'
printf 'after eval set -- [%s][%s]\n' "$1" "$2"

# Nested, because the inner operand is text the outer read produced.
eval 'eval "printf \"nested\n\""'

# --- the control flow that reaches out of an eval ---

# `return`, `break` and `continue` inside an eval act on the function or the
# loop the eval is in, not on the eval.
g() { eval 'return 4'; printf 'not reached\n'; }
g; printf 'return through eval -> %s\n' "$?"

for w in 1 2 3; do eval 'break'; printf 'not reached\n'; done
printf 'break through eval -> %s\n' "$?"

n=0
for w in 1 2 3; do eval 'continue'; n=9; done
printf 'continue through eval, n=%s\n' "$n"

printf -- '--- what a dot script answers ---\n'

# The status of a dot script is the status of the last command in it, and a
# file with no commands is a success.
printf 'true\n' > st.sh; . ./st.sh; printf 'ends true -> %s\n' "$?"
printf 'false\n' > st.sh; . ./st.sh; printf 'ends false -> %s\n' "$?"
printf '' > st.sh; . ./st.sh; printf 'empty file -> %s\n' "$?"
printf '# only a comment\n' > st.sh; . ./st.sh; printf 'only a comment -> %s\n' "$?"

# A bare `return` carries the status that was current when it ran.
printf 'false\nreturn\nprintf "not reached\\n"\n' > r.sh
. ./r.sh; printf 'bare return after false -> %s\n' "$?"
printf 'true\nreturn\n' > r.sh
. ./r.sh; printf 'bare return after true -> %s\n' "$?"

# The file needs to be readable and does not need to be executable.
printf 'printf "no execute bit needed\\n"\n' > noexec.sh; chmod 644 noexec.sh
. ./noexec.sh

# A dot script inside a function sees the function's parameters, because it
# is the function's environment it runs in.
printf 'printf "in fn n=%%s [%%s]\\n" "$#" "$1"\n' > fn.sh
h() { . ./fn.sh; }
h a b c

# A name with no slash is looked up on PATH, which is what makes `.` the way
# a script loads a library. A name with a slash is a path and is not.
mkdir -p libdir
printf 'printf "from libdir\\n"\n' > libdir/lib.sh
printf 'printf "from the working directory\\n"\n' > lib.sh
PATH="$PWD/libdir:/usr/bin:/bin"
. lib.sh
. ./lib.sh
