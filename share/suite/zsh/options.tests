#
# The answers only zsh gives about options, splitting and scope — every one
# of them cut from a core/ file where the panel split, and named there.
#
# These are not obscure corners. Three of the five below are the reasons a
# script written for bash does not run under zsh unchanged, and the first is
# a letter that means something else entirely.

# `set -f` is noglob in bash, ksh93 and dash. In zsh the letter is "read no
# rc files" and globbing is untouched.
( set -f; printf '[%s]\n' /dev/nul* ) 2> /dev/null
printf 'set -f -> %s\n' "$?"

# And `-F` is the letter that does turn globbing off here. The pair is the
# point rather than either line alone: a script written for another shell says
# `set -f` for noglob, gets the rc-file option, and keeps globbing — so the two
# rows have to disagree or neither is measuring the split. `set -o noglob` is
# spelled the same in all four shells and is what a portable script writes.
( set -F; printf '[%s]\n' /dev/nul* ) 2> /dev/null
printf 'set -F -> %s\n' "$?"
( set -o noglob; printf '[%s]\n' /dev/nul* ) 2> /dev/null
printf 'set -o noglob -> %s\n' "$?"

# An unquoted `$@` or `$*` is one word. zsh does not field-split the result
# of an expansion unless SH_WORD_SPLIT is on, which is the single most
# visible difference between writing a script for zsh and for anything else.
set -- 'a b' c
for w in $@; do printf 'unquoted at [%s]\n' "$w"; done
for w in $*; do printf 'unquoted star [%s]\n' "$w"; done
for w in "$@"; do printf 'quoted at [%s]\n' "$w"; done

# The same rule applied to an ordinary variable, which is where a script
# meets it first.
v='x y z'
for w in $v; do printf 'unquoted var [%s]\n' "$w"; done
( setopt shwordsplit; for w in $v; do printf 'with shwordsplit [%s]\n' "$w"; done )

# IFS starts as space, tab, newline and NUL. The other four stop at newline.
printf 'IFS default [%s]\n' "$(printf '%s' "$IFS" | od -An -c | tr -s ' ')"

# Assigning over a readonly ends the shell here. bash, ksh93 and dash
# diagnose it and carry on.
( readonly RO=fixed; RO=changed; printf 'assigned over readonly\n' ) 2> /dev/null
printf 'readonly -> %s\n' "$?"

# `set -o` with a name no shell has is 1 here and 2 in the other three.
( set -o nosuchoption_zz ) 2> /dev/null
printf 'bad option name -> %s\n' "$?"

# `$0` inside a dot script is the sourced file here and the outer script
# everywhere else.
printf 'printf "zero [%%s]\\n" "$0"\n' > s0.sh
. ./s0.sh

# And a dot of a file that is not there is 127 — the status of a command that
# does not exist — where bash says 1 and ksh93 and dash end the script.
( . ./nosuchfile_zz.sh ) 2> /dev/null
printf 'missing dot -> %s\n' "$?"

# The option letters this shell spells its own way.
#
# This shell gives a single letter to most of its options, and the letters are
# its own choices rather than the panel's: `-T` is `cdablevars` here and the
# trap-carriage option in bash, `-F` is `noglob` where bash has no `-F` at
# all. So a letter is not portable and every line below is answered by this
# shell alone, which is what puts the file in this tier.
#
# Three claims, and each was a separate defect before #2578: the letter moves
# the option, the option's *name* moves the same state, and `$-` reports the
# option rather than the spelling that moved it.

# The letter turns the option on, and `+` turns it back off.
set -T
[[ -o cdablevars ]] && printf 'the letter set it\n'
set +T
[[ -o cdablevars ]] || printf 'and unset it\n'

# The name reaches the same state, which is what makes the letter an
# abbreviation rather than a second switch.
set -o cdablevars
[[ -o cdablevars ]] && printf 'the name set it too\n'
set +o cdablevars

# $- carries the letter for the option's state, whichever spelling moved it.
set -Q
printf 'letter: %s\n' "$-"
set -o pathdirs
printf 'still one letter: %s\n' "$-"
set +Q
printf 'gone: %s\n' "$-"

# A startup letter is withdrawn when its option goes off. `X` is `listtypes`,
# which this shell starts with on.
[[ -o listtypes ]] && printf 'listtypes starts on\n'
set +X
[[ -o listtypes ]] || printf 'and +X turns it off\n'
printf 'without X: %s\n' "$-"
set -X

# The letters are sorted into byte order rather than the order they were
# written in.
set -y -T -G -e
printf 'in order: %s\n' "$-"
set +y +T +G +e

# An option this shell will not change after startup refuses, and the refusal
# echoes back the spelling that asked for it.
set -i 2>&1 | sed 's/^[^ ]*: //'
printf 'status: %s\n' "$?"
set -o interactive 2>&1 | sed 's/^[^ ]*: //'

# A letter this shell has not got at all is the other sentence.
set -q 2>&1 | sed 's/^[^ ]*: //'

# An emulation puts every option it resets at that emulation's own default,
# which is a second table the same size as the set of names it resets. The
# three controls are a name whose sh default differs from zsh's, a name where
# sh and ksh part company, and a name all four agree about.
#
# This is last in the file on purpose: an emulation changes how words split
# and how an unmatched pattern is read, so anything after it would be
# measuring the emulation rather than what it says it measures.
report() {
  for n in multios posixbuiltins kshglob cshnullcmd extendedglob; do
    if [[ -o $n ]]; then printf '%s=on ' "$n"; else printf '%s=off ' "$n"; fi
  done
  printf '\n'
}

for m in zsh sh ksh csh; do
  emulate $m
  printf '%-4s ' "$m"
  report
done
emulate zsh

# And from the other side: a name the script moved away from the emulation's
# default comes back to the emulation's, not to zsh's. Both directions,
# because a reset that only ever turned things off would pass one of them on
# its own.
setopt multios
unsetopt posixbuiltins
emulate sh
printf 'after a move: '
report
emulate zsh

# And the *listing* compares against the same defaults the emulation writes,
# which is the half that used to be taken against zsh's own whatever mode the
# shell was in (#4517). A bare `setopt` prints the names still away from the
# current mode's default, so an `emulate -R sh` — which puts every resettable
# name on sh's default — leaves nothing to print, while a bare `emulate sh`
# leaves the eight names it does not reset standing where zsh had them.
#
# `emulate ksh` is the fourth mode and is below on its own, because it is the
# one that changes the listing's *shape* rather than its contents.
for m in zsh sh csh; do
  emulate $m
  printf -- '--- emulate %s\n' "$m"
  setopt
  emulate -R $m
  printf -- '--- emulate -R %s\n' "$m"
  setopt
done
emulate zsh

# `emulate ksh` turns KSH_OPTION_PRINT on by ksh's own default, and while that
# option is on both bare listings stop naming the deviations and write every
# option in the table as `name<pad>on|off` — zsh's `set -o` table, at zsh's
# own width. #4528 left this mode out because this shell recorded the option
# and printed the old shape, so `emulate ksh` answered with 11 names where the
# reference writes 185 rows (#4529).
#
# The baseline is still the mode's: every row below is measured against ksh's
# defaults, which is why exactly the eleven names a bare `emulate ksh` leaves
# away from them are the ones marked `on`.
#
# `hashcmds` is dropped from the long-form rows here and from nothing else.
# Its `def` in this shell's table is this shell's own state rather than zsh's,
# so it is spelled `hashcmds` where the reference writes `nohashcmds` — a
# standing difference on `set -o` as well, named in dialect/zsh/setopt.go and
# filed as #4533. Dropping one known row is not a license to drop a row that
# moves: the other 184 are the reference's own, byte for byte.
nohashcmdsrow() { grep -Ev '^(no)?hashcmds( |$)'; }

emulate ksh
printf -- '--- emulate ksh\n'
setopt | nohashcmdsrow
emulate zsh

# **The option decides the shape; the mode decides the contents.** Both rows
# below hold KSH_OPTION_PRINT fixed and move the mode, and the shape does not
# move with it — a mode that is not ksh prints the long form while the option
# is on, and ksh itself prints the short one while it is off. Keyed on the
# mode instead, a grid would agree on every row nobody touched, because ksh's
# default is the only one that turns this option on.
( emulate sh; setopt kshoptionprint
  printf 'sh + ksh_option_print on:  %s rows, first [%s]\n' \
    "$(setopt | wc -l | tr -d ' ')" "$(setopt | head -1)" )
( emulate ksh; unsetopt kshoptionprint
  printf 'ksh + ksh_option_print off: %s rows\n' "$(setopt | wc -l | tr -d ' ')"
  setopt )

# And the contents still move with the mode while the shape stands still: the
# long form under `emulate sh` marks sh's deviations and spells them sh's way,
# which is the composition of this rule with #4517's rather than either alone.
( emulate sh; setopt kshoptionprint
  printf 'sh + ksh_option_print on, deviating: '
  setopt | grep ' on$' | awk '{print $1}' | tr '\n' ' '
  printf '\n' )

# The two bare listings and `set -o` are one table under this option — the
# direction a bare name means is what tells `setopt` and `unsetopt` apart, and
# this form has no direction. Measured byte-identical in zsh 5.9.2; compared
# rather than printed three times, since the rows are above.
( emulate ksh
  [[ "$(setopt)" == "$(unsetopt)" ]] && printf 'setopt == unsetopt\n' || printf 'setopt != unsetopt\n'
  [[ "$(setopt)" == "$(set -o)" ]] && printf 'setopt == set -o\n' || printf 'setopt != set -o\n' )

# A strict reset puts every resettable name on ksh's default, so the long form
# still writes all 185 rows and marks none of them on. The pair with the row
# above is the control: the shape is the same in both and only the states
# moved, so a listing that had collapsed to "print what deviates" would answer
# nothing here and 185 rows there.
( emulate -R ksh
  printf 'emulate -R ksh: %s rows, %s on\n' \
    "$(setopt | wc -l | tr -d ' ')" "$(setopt | grep -c ' on$')" )

# Naming an option prints nothing in either shape, which is what says the long
# form belongs to the *bare* command.
( emulate ksh; setopt autocd; printf 'setopt autocd -> %s, printed [%s]\n' "$?" "$(setopt autocd)" )

# `set +o` is not one of the surfaces this option reaches: it writes
# re-inputtable `set ±o name` lines in both states, and only the row for the
# option itself moves.
( emulate zsh; set +o | wc -l | tr -d ' ' )
( emulate zsh; setopt kshoptionprint; set +o | wc -l | tr -d ' ' )
( emulate zsh; setopt kshoptionprint; set +o | grep kshoptionprint )

# The two listings are one rule and its complement, so every name is in
# exactly one of them and the total does not move with the mode. Printed as a
# count rather than as 185 lines, because the names themselves are above and
# what this row adds is that nothing fell out of both.
for m in zsh sh; do
  emulate $m
  printf -- 'emulate %s: %s set, %s unset\n' "$m" "$(setopt | wc -l)" "$(unsetopt | wc -l)"
done
emulate zsh

# The state is not the deviation, and the two surfaces part under an
# emulation. `prompt_percent` is on and `prompt_subst` is off in both columns
# below — neither is reset by a bare emulation — while sh's defaults for them
# are the opposite of zsh's, so both cross from one listing to the other and
# both change the spelling they are written in. A shell that keyed the listing
# on the state would print the same row twice.
for m in zsh sh; do
  emulate $m
  printf -- 'emulate %s: ' "$m"
  [[ -o promptpercent ]] && printf 'cond pc=on ' || printf 'cond pc=off '
  [[ -o promptsubst ]] && printf 'cond ps=on ' || printf 'cond ps=off '
  printf 'listed: '
  setopt | grep -E '^(no)?prompt(percent|subst)$' | tr '\n' ' '
  printf '\n'
done
emulate zsh

# `vi` and `emacs` are options *and* keymap selections, and the pair has to be
# read together. `[[ -o vi ]]` alone says nothing about which keymap the line
# editor is reading: `bindkey -v` leaves the option off and still edits the vi
# way, and `setopt vi; bindkey -e` leaves the option on with the editor plainly
# in emacs. So every row below prints both — the option, and the keymap `main`
# is an alias for, which is what the editor actually consults.
#
# This exists because the option once moved nothing but itself: `setopt vi`
# reported `vi on` and left the editor in emacs, so an Escape a person pressed
# went into the line (#3140). A row that read only the option would have passed
# every day of that.
editing() {
  printf '%-24s ' "$1"
  [[ -o vi ]] && printf 'vi=on  ' || printf 'vi=off '
  [[ -o emacs ]] && printf 'emacs=on  ' || printf 'emacs=off '
  bindkey -lL main
}

( editing 'fresh shell' )
( setopt vi; editing 'setopt vi' )
( set -o vi; editing 'set -o vi' )
( bindkey -v; editing 'bindkey -v' )
( setopt emacs; editing 'setopt emacs' )
( bindkey -e; editing 'bindkey -e' )

# Turning one on is a selection; turning one off is not a request to go back.
# Both directions, because a rule that only ever selected would pass the first
# of these on its own.
( setopt vi; unsetopt vi; editing 'setopt vi; unsetopt vi' )
( bindkey -v; set +o vi; editing 'bindkey -v; set +o vi' )
( setopt vi; bindkey -e; editing 'setopt vi; bindkey -e' )
( setopt emacs; unsetopt emacs; editing 'setopt emacs; unsetopt emacs' )

# And `-lL` is the listing that says it. `.safe` is named by `-l` and skipped
# by `-lL`, because no `bindkey` command would make it; a name no keymap has is
# refused with a colon that the same complaint from `-M` does not have.
( setopt vi; bindkey -lL )
( bindkey -l .safe; bindkey -lL .safe; printf '.safe under -lL -> nothing above\n' )
( bindkey -lL emacs main )
( bindkey -lL nosuchkeymap_zz ) 2> /dev/null
printf 'bindkey -lL on a name nobody has -> %s\n' "$?"

# And turning off the name that is *not* selected, which is the row that tells
# "only turning one on selects" from "either direction selects": turning `vi`
# off in a shell that turned `vi` on reselects the same keymap and reads alike
# whichever rule is in force.
( setopt vi; unsetopt emacs; editing 'setopt vi; unsetopt emacs' )
( bindkey -v; unsetopt emacs; editing 'bindkey -v; unsetopt emacs' )
( setopt emacs; unsetopt vi; editing 'setopt emacs; unsetopt vi' )

# ---- `set -n` and a `!` nothing ran ----
#
# `set -n` reads and runs nothing, which is what `sh -n file` is: every CI
# syntax check and every editor's on-save check. A `!` in front of a top-level
# pipeline still inverts the status this shell exits with, so a file whose
# first command is negated comes back 1 — with nothing on either stream, since
# there is nothing wrong with the file to report. bash 5.3, bash as `sh`,
# bash 3.2, ksh93u+, dash and BusyBox ash all leave the status alone and
# answer 0 (#3179).
( set -n; ! true ); printf 'noexec bang -> %s\n' "$?"
( set -n; true; ! true ); printf 'noexec bang after a command -> %s\n' "$?"
( set -n; ! true | cat ); printf 'noexec bang on a pipeline -> %s\n' "$?"

# The three controls are what say this is the `!` and not the reading, and
# they agree in every column: two negations invert back onto 0, a negation
# inside an `if` is the clause's business and `set -n` never walks into the
# compound to reach it, and a command that is not negated at all leaves the
# status alone because none of them ran to report one.
( set -n; ! true; ! true ); printf 'noexec bang twice -> %s\n' "$?"
( set -n; if ! true; then :; fi ); printf 'noexec bang inside if -> %s\n' "$?"
( set -n; false ); printf 'noexec plain command -> %s\n' "$?"
