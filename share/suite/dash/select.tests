#
# `select` in dash, which has none.
#
# `select` is not a reserved word, so the loop is a syntax error at `do` and
# a bare `select` is a command that is not found.
#
# Every refusal is asked through `eval` in a subshell, so a script that
# reaches one goes on to the next row and the file's own parse is not what is
# being graded. The rows that print `ran` or `after` ask whether the refusal
# is made while reading or while running.
#
# Measured 2026-09-16: Apple's dash-16 on macOS and Ubuntu 24.04's dash answer
# every row alike, and bash, zsh and ksh93 each answer the file differently.

try() {
	( eval "$1" ) 2>&1
	printf '  -> %s\n' "$?"
}

printf -- '--- select is not a reserved word ---\n'
try 'select x in a b; do break; done'
try 'select x; do break; done'
try 'printf "ran\n"; select x in a; do break; done'
printf -- '--- so it is looked up as a command ---\n'
try 'select'
try 'select x in a'
