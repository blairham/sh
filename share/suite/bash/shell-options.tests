#
# `shopt` — the second option table, which is bash's alone. No other shell on
# the panel has the builtin at all, and the options in it are not the ones
# `set -o` names: the two tables overlap only through `shopt -o`, which is
# `set -o` reached through this spelling.
#
# The listing is asked whole rather than by row count. Fifty-nine options is
# a fact about this bash, and a case that counted them would pass on a
# different build with a different roster while a case that prints them says
# which ones moved.
#
# Three `set -o` names are deliberately not here: bash takes `privileged` and
# the letters `-b`, `-r` and `-P`, and this shell refuses all of them by
# design — `dialect/bash`'s UnimplementedOptionLetters records the letters
# and the long names are paired to them, so a case here would be asking bash
# a question this shell has already answered "not built".
#
# The list was six. `histexpand` and `history` left it when the expander was
# built (#3093) and `keyword` when the option was (#3095), and the last of
# those has a block of its own at the end of this file — the two tables are
# one table, so a name refused here while the letter is wired would be a case
# asserting the opposite of what the shell does.

shopt | head -6
printf 'and the listing is %s rows\n' "$(shopt | grep -c .)"

# -s and -u turn one on and off, and -p writes the line back in the form that
# would set it again.
shopt -s nullglob extglob
shopt -p nullglob extglob
shopt -u nullglob
shopt -p nullglob

# -q is the quiet form: the status is the answer and nothing is written.
shopt -q extglob
printf 'q on an option that is on -> %s\n' "$?"
shopt -q nullglob
printf 'q on one that is off -> %s\n' "$?"
shopt -u extglob

# And the option does what it says, which is what keeps this from being a
# case about a table.
shopt -s nullglob
printf 'nullglob on [%s]\n' "$(printf '[%s]' nosuchpattern_zz*)"
shopt -u nullglob
printf 'nullglob off [%s]\n' "$(printf '[%s]' nosuchpattern_zz*)"

# A name nobody has, which is a failure rather than a new option.
shopt -s nosuchoption_zz 2> /dev/null
printf 'a name nobody has -> %s\n' "$?"
shopt -q nosuchoption_zz 2> /dev/null
printf 'and -q on it -> %s\n' "$?"

# -o is the other table: the same names `set -o` uses, reached through this
# builtin, and printed in `set`'s form rather than in shopt's.
shopt -o -p errexit
shopt -o -p noglob
shopt -o -s noglob
shopt -o -p noglob
shopt -o -u noglob

# BASHOPTS holds the ones that are on, as a colon-separated list.
shopt -u extglob
printf 'BASHOPTS is %s\n' "${BASHOPTS+set}"
shopt -s extglob
case ":$BASHOPTS:" in *:extglob:*) printf 'and turning one on puts it in\n' ;; *) printf 'and it did not\n' ;; esac
shopt -u extglob
case ":$BASHOPTS:" in *:extglob:*) printf 'still there\n' ;; *) printf 'and turning it off takes it out\n' ;; esac

# ---- `set -k`, the keyword option ----
#
# POSIX's keyword option: with it on, **every** `name=value` word of a simple
# command is a prefix assignment and not only the ones in front of the command
# name. bash and ksh93 have it, zsh spells `interactivecomments` with the same
# letter, and dash and BusyBox ash end the file over it — so it cannot be a
# core or an ext case, and this half of it is graded against bash.
#
# What is bash's alone here is the last block: the option reaches past a
# declaration utility and takes its operand too, leaving the utility with
# nothing to act on. ksh93 leaves a declaration's operand where it stands, and
# ksh/shell-options.tests holds the same rows with that answer.
#
# `set -k` stands on a line of its own throughout. ksh93 decides the option
# while **parsing**, so `set -k; f A=1 x` on one line reaches nothing there
# even though it works here, and a case written that way would be asking the
# two columns different questions.

f() { printf 'f: 1=[%s] KV=[%s] n=%s\n' "${1-.}" "${KV-unset}" "$#"; }
set -k
f KV=2 zz
printf 'the promoted name does not outlive the call [%s]\n' "${KV-unset}"

# Several on one command, and the last of a repeated name wins.
g() { printf 'g: 1=[%s] A=[%s] B=[%s] n=%s\n' "${1-.}" "${A-unset}" "${B-unset}" "$#"; }
g A=1 xx B=2
g A=4 A=5 yy

# A `--` does not stop it: it is not an end-of-options marker for this.
g -- C=3
printf 'C after the double dash [%s]\n' "${C-unset}"

# The **written** word decides and not the expanded one.
w='A=9'
g $w yy
g 'A=10' yy
g 1A=11 yy

# The value may hold what a written assignment's may, and is neither split nor
# matched against the filesystem.
h() { printf 'h: 1=[%s] Q=[%s] n=%s\n' "${1-.}" "${Q-unset}" "$#"; }
V=vv
h Q=$V yy
h Q="$V" yy
h Q=x$V yy
h Q=$(printf cs) yy
h Q=$((1+1)) yy
h Q= yy
h Q=a=b yy

# It reaches a builtin and an external alike, and an external is handed the
# name in its environment — which is what the option is for.
printf 'echo drops it -> [%s]\n' "$(echo A=12 kept)"
env A=13 > k.env
printf 'an external is told -> %s\n' "$(grep -c '^A=13$' k.env)"
printf 'and the shell did not keep it [%s]\n' "${A-unset}"

# The letter shows in `$-`, and the long name is the same state.
case "$-" in *k*) printf 'the letter is in $-\n' ;; *) printf 'the letter is not in $-\n' ;; esac
set +k
case "$-" in *k*) printf 'and set +k left it\n' ;; *) printf 'and set +k took it out\n' ;; esac
g A=14 yy
set -o keyword
printf 'set -o keyword -> %s\n' "$?"
g A=15 yy
set +o keyword
printf 'set +o keyword -> %s\n' "$?"
g A=16 yy

# bash's own answer, and the row ksh93 does not share: the option takes a
# declaration utility's operand too, so the utility is left with none and
# lists instead of declaring.
set -k
export E1=e1 > /dev/null
printf 'export under -k [%s]\n' "${E1-unset}"
readonly R1=r1 > /dev/null
printf 'readonly under -k [%s]\n' "${R1-unset}"
declare -i N1=3*3 > /dev/null
printf 'declare under -k [%s]\n' "${N1-unset}"
set +k

# ---- `set -x` and the assignment written in front of a command ----
#
# An assignment standing in front of a command is part of that command, and
# every shell on the panel traces it. This one is bash's shape: **a line of
# its own for each assignment, ahead of the command's own line**, where ksh93
# writes them behind the command and dash, BusyBox ash and zsh write them on
# the command's line. Three shapes and no majority, so each column's file
# carries its own — see interp/xtraceprefix.go and #3133, where this shell
# wrote nothing for the position at all.
#
# `PS4='+ '` is what makes the block comparable at all: zsh's default prefix
# names the script and the line, so the same rows in zsh/shell-options.tests
# would otherwise be a fact about where the harness put the file. It is this
# shell's own default here, so it changes nothing in this column.
#
# The trace is collected in a file and printed afterwards rather than left on
# stderr, so that the order of the two streams is the file's and not the
# harness's.

xf() { :; }
PS4='+ '
exec 3>&2 2> xt.err
set -x
A=3 xf zz
B=4 true
C=5 :
D=6 E=7 /bin/echo ext
V=$(printf vv) :
Q='a b' :
set +x
exec 2>&3
cat xt.err
