# SPDX-FileCopyrightText: 2026 Blair Hamilton
# SPDX-License-Identifier: Apache-2.0
#
# Command substitution — the other half of #2307. ext/procsub.tests has asked
# `<(…)` since the ext tier landed; `$(…)` and the backtick form, which every
# shell on the panel has and POSIX XCU 2.6.3 requires, were asked nowhere.
#
# Nothing here prints a pid or a path that a temporary file would make up. A
# substitution's whole observable behaviour is the text it yields, the status
# it leaves, and where the result may stand.

# The text, with the trailing newlines removed — however many there were.
printf '[%s]\n' "$(printf 'plain')"
printf '[%s]\n' "$(printf 'trailing\n\n\n')"
printf '[%s]\n' "$(printf 'a\nb\n')"
printf '[%s]\n' "$(printf 'a b   c')"

# The backtick form is the same substitution, and the two nest into each
# other and stand side by side.
printf '[%s]\n' `printf 'backtick'`
printf '[%s]\n' "`printf 'x'`"
printf '[%s]\n' "$(printf '%s' "$(printf 'inner')")"
printf '[%s]\n' `printf 'a'``printf 'b'`
printf '[%s]\n' "$(printf 'a')$(printf 'b')"
printf '[%s]\n' "x$(printf 'y')z"

# The status is the last command's in it, and an assignment from one carries
# that status out — which is how a substitution's failure is seen at all.
printf '[%s]\n' "$(exit 5)"; printf 'status -> %s\n' "$?"
printf '[%s]\n' "$(false)"; printf 'false status -> %s\n' "$?"
u=$(true); printf 'assign true -> %s\n' "$?"
u=$(false); printf 'assign false -> %s\n' "$?"
v=$(printf 'assigned'); printf '[%s]\n' "$v"

# Unquoted, the result is split on IFS and globbed like any other expansion;
# quoted, it is one word whatever is in it.
set -- $(printf 'a b c'); printf '[%s][%s][%s]\n' "$1" "$2" "$3"
printf '[%s]\n' $(printf 'a b c')
printf '[%s]\n' "$(printf '*')"

# Any command goes inside it: a list, a compound, a here-document, a loop.
printf '[%s]\n' "$(printf 'semi'; printf 'colon')"
printf '[%s]\n' "$(if true; then printf 'compound'; fi)"
printf '[%s]\n' "$(for w in a b; do printf '%s' "$w"; done)"
printf '[%s]\n' "$(cat <<'HERE'
heredoc
HERE
)"
printf '[%s]\n' "$( printf 'spaced' )"

# Quoting inside it is read as its own, so a double quote may appear inside a
# double-quoted substitution without ending the outer word.
printf '[%s]\n' "$(printf 'quote"inside')"
printf '[%s]\n' "$(printf "nested\"quote")"
printf '[%s]\n' "$(printf 'back\\slash')"

# It runs in its own environment: a `cd` inside one does not move the shell.
printf '[%s]\n' "$(cd /; printf 'moved')"
cd /
printf '[%s]\n' "$(pwd)"

# `$(( ))` is arithmetic, not a substitution of a subshell named `(`.
printf '[%s]\n' "$(( 2 + 3 ))"

# The cases above left the shell in `/`, which is where the `cd` case put it.
# Everything below writes files, so it moves back to the directory the harness
# made for this run first. `$HOME` is that directory and is never printed: the
# path is the machine's and a case that showed it would not repeat anywhere
# else.
cd "$HOME"

# --- where the status goes ---------------------------------------------------
#
# A substitution's status reaches the shell only through an assignment or by
# being the whole command. Used as an operand it is discarded, because the
# command that took the operand has a status of its own — which is the shape
# every `foo=$(bar) || exit` in the wild depends on, and the shape a case that
# only printed the text could not tell apart from the other one.

out=$(exit 7)
rc=$?
printf 'through an assignment: [%s] status %s\n' "$out" "$rc"
: "$(exit 5)"
rc=$?
printf 'as an operand of a command that succeeded: %s\n' "$rc"
: `exit 6`
rc=$?
printf 'the backtick form, the same: %s\n' "$rc"
v=$(true; false)
rc=$?
printf 'the last command inside it decides: %s\n' "$rc"
v=$(false; true)
rc=$?
printf 'and the other way round: %s\n' "$rc"
v=$(exit 2) w=$(exit 3)
rc=$?
printf 'two assignments, the last one decides: %s\n' "$rc"

# --- what the text is --------------------------------------------------------
#
# Trailing newlines are removed — all of them — and newlines in the middle are
# not. Blanks at either end survive, because it is newlines that are stripped
# and not whitespace.

printf 'trailing newlines go: [%s]\n' "$(printf 'a\nb\n\n\n')"
printf 'only newlines: [%s]\n' "$(printf '\n\n')"
printf 'nothing at all: [%s]\n' "$(printf '')"
printf 'an interior blank line survives: [%s]\n' "$(printf 'x\n\ny\n')"
printf 'blanks survive: [%s]\n' "$(printf '   spaced   ')"
printf 'a tab survives: [%s]\n' "$(printf 'tab\there')"
nl=$(printf 'a\nb')
printf 'the length of a two-line result: %s\n' "${#nl}"

# --- quoting inside the backtick form ---------------------------------------
#
# The backtick is the older spelling and reads its body differently: a
# backslash is significant before `$`, `` ` `` and another backslash, which is
# what makes nesting one inside another possible at all — and what makes the
# `$( )` form worth preferring.

printf 'plain: [%s]\n' "`printf 'plain'`"
printf 'a double quote inside: [%s]\n' "`printf '%s' \"quoted inside\"`"
v=val
printf 'an expansion inside: [%s]\n' "`printf '%s' $v`"
printf 'an escaped dollar stays text: [%s]\n' "`printf '%s' \\$v`"
printf 'a single-quoted dollar too: [%s]\n' "`printf '%s' '\$v'`"
printf 'an escaped backslash: [%s]\n' "`printf 'a\\\\b'`"
printf 'and the same in the modern form: [%s]\n' "$(printf 'a\\b')"
printf 'a backtick nested in a backtick: [%s]\n' "`printf '%s' \"\`printf inner\`\"`"
printf 'the modern form nesting the old: [%s]\n' "$(printf '%s' "`printf inner`")"

# --- where a substitution may stand -----------------------------------------

$(printf 'printf') 'as the whole command\n'
printf 'x\n' > "$(printf 'target')"
printf 'as a redirection target: [%s]\n' "$(cat target)"
printf 'joined on the left: [%s]\n' "pre-$(printf 'a b')"
printf 'joined on the right: [%s]\n' "$(printf 'a b')-tail"
printf 'two of them running together: [%s]\n' "$(printf 'one')$(printf 'two')"
for w in $(printf 'p q'); do printf 'in a for list: %s\n' "$w"; done
case $(printf 'match') in match) printf 'as the word of a case\n' ;; esac
if $(printf 'true'); then printf 'as the condition of an if\n'; fi

# --- what goes inside it -----------------------------------------------------

printf 'a comment inside: [%s]\n' "$( : # a comment to the end of the line
printf 'past the comment' )"
printf 'a close paren from a case: [%s]\n' "$(case x in x) printf 'reached' ;; esac)"
printf 'a close paren in the data: [%s]\n' "$(printf 'a)b')"
printf 'a subshell, which is not the same paren: [%s]\n' "$( (printf 'subshell') )"
printf 'text that looks like a substitution: [%s]\n' "$(printf '%s' '$(not expanded)')"
printf 'a redirection inside: [%s]\n' "$(cat < target)"
