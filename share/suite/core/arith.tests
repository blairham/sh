#
# Arithmetic expansion, POSIX XCU 2.6.4. The operators, their precedence, and
# the places a shell evaluates arithmetic without being asked twice.

printf '%s\n' "add=$((1 + 2)) sub=$((7 - 3)) mul=$((3 * 4))"
printf '%s\n' "div=$((7 / 2)) neg-div=$((-7 / 2)) rem=$((7 % 3)) neg-rem=$((-7 % 3))"
printf '%s\n' "precedence=$((2 + 3 * 4)) parens=$(((2 + 3) * 4))"
printf '%s\n' "unary=$((-3)) plus=$((+3)) not=$((!0)) not1=$((!5))"
printf '%s\n' "bitnot=$((~0)) and=$((12 & 10)) or=$((12 | 10)) xor=$((12 ^ 10))"
printf '%s\n' "shl=$((1 << 4)) shr=$((256 >> 3))"
printf '%s\n' "lt=$((1 < 2)) gt=$((1 > 2)) le=$((2 <= 2)) ge=$((1 >= 2))"
printf '%s\n' "eq=$((2 == 2)) ne=$((2 != 2))"
printf '%s\n' "andand=$((1 && 0)) oror=$((0 || 3)) ternary=$((1 ? 10 : 20))"

# Short-circuit: the right side of && is not evaluated when the left is zero,
# so the assignment inside it does not happen — in five of the six shells
# graded here. BusyBox ash runs the operand anyway and leaves x at 9, then at
# 8, which is the divergence this file found on the day the ash column could
# first run (#2605). Each column is graded against the shell it claims to be,
# so both readings are asserted here rather than one of them being the answer.
x=0
: $((0 && (x = 9)))
printf '%s\n' "shortcircuit-and x=$x"
: $((1 || (x = 8)))
printf '%s\n' "shortcircuit-or x=$x"

# The value is the operator's under either reading — `0 && anything` is 0 and
# `1 || anything` is 1 — which is why it could never have been the thing that
# split the columns, and why a case grading the number alone sat between two
# that agree and said nothing.
printf '%s\n' "shortcircuit-value=$((0 && (x = 7))) $((1 || (x = 6)))"

# The conditional is the other short-circuiting operator and is not on that
# axis: the arm it did not take is dropped in every shell here, BusyBox
# included, and an && written inside that arm never runs either.
w=5
printf '%s\n' "dropped-arm=$((0 ? (w = 1) : 2)) w=$w"
v=0
printf '%s\n' "dropped-arm-holding-and=$((0 ? (0 && (v = 9)) : 4)) v=$v"

# And the control for all of it: an operand the left side did not decide is
# evaluated everywhere, so what parts the shells above is the skip and not
# assignment inside a logical operator.
u=0
: $((1 && (u = 9)))
printf '%s\n' "live-operand u=$u"

# A variable is read without a $, and an unset one is zero.
n=5
unset m
printf '%s\n' "bare=$((n * 2)) unset=$((m + 1))"

# Assignment operators, and the value of the whole expression.
a=1
printf '%s\n' "assign=$((a = 10)) then a=$a"
printf '%s\n' "plus-assign=$((a += 5)) then a=$a"
printf '%s\n' "minus-assign=$((a -= 3)) then a=$a"
printf '%s\n' "times-assign=$((a *= 2)) then a=$a"
printf '%s\n' "div-assign=$((a /= 4)) then a=$a"
printf '%s\n' "mod-assign=$((a %= 4)) then a=$a"

# Hexadecimal literals. A leading zero is *not* here: measured, $((010)) is 8
# in bash, ksh93 and dash and 10 in zsh, which does not read a leading zero as
# octal unless asked. So that is a dialect answer and lives in each dialect's
# own file.
printf '%s\n' "hex=$((0x1f)) hexcaps=$((0XFF))"

# Arithmetic inside a string, and nested expansion.
i=3
printf '%s\n' "nested=$((i + $((i * 2))))"

# Whitespace is insignificant.
printf '%s\n' "spaced=$((  1   +   2  ))"

# The status of a command substitution holding an arithmetic result.
v=$((6 * 7))
printf '%s\n' "captured=$v"

# Comparisons are 1 and 0, so they compose with the rest.
printf '%s\n' "compose=$(((3 > 2) + (4 > 5)))"

# --- the conditional, and what it does not evaluate --------------------------
#
# The arm not taken is dropped, which is the only way to divide by zero in a
# shell and get an answer back.

printf '%s\n' "ternary=$(( 1 ? 2 : 3 )) other=$(( 0 ? 2 : 3 ))"
printf '%s\n' "dropped-division=$(( 0 ? 1 / 0 : 5 ))"
k=0
printf '%s\n' "only-one-arm-assigns=$(( 1 ? (k = 9) : (k = 8) )) k=$k"
printf '%s\n' "parenthesised=$(( (1 ? 2 : 3) + 1 ))"
printf '%s\n' "nested-in-the-arm=$(( 1 == 1 ? 1 == 1 ? 7 : 8 : 9 ))"
printf '%s\n' "nested-in-the-test=$(( (0 ? 1 : 1) ? 4 : 5 ))"

# --- what a name means inside an expression ---------------------------------
#
# A bare name is read as a number, an unset one is zero, and an empty one is
# zero as well. The `$` is optional and changes nothing, which is worth
# asking on one line rather than believing: the two spellings reach the value
# by different routes.

n=7
printf '%s\n' "three spellings: $(( $n )) $(( n )) $(( ${n} ))"
v=
printf '%s\n' "empty=$(( v )) empty-plus-one=$(( v + 1 ))"
unset u
printf '%s\n' "unset=$(( u )) unset-plus-one=$(( u + 1 ))"
neg=-4
printf '%s\n' "negative=$(( neg )) negated=$(( -neg ))"

# A *value* that is itself an expression is deliberately absent: bash, zsh and
# ksh93 evaluate it again and dash refuses it as an illegal number. It is
# share/suite/ext/arith.tests.

# --- division, remainder and their signs ------------------------------------
#
# Division truncates toward zero and the remainder takes the sign of the left
# operand, so the pair is asked together rather than either alone.

printf '%s\n' "truncation=$(( 7 / 2 * 2 )) negative-quotient=$(( -7 / 2 ))"
printf '%s\n' "negative-remainder=$(( -7 % 2 ))"

# `7 / -2` is not here. ksh93 93u+ on this machine calls it a division by
# zero and ends the script; the other three answer -3. That is
# share/suite/ksh/arith.tests.

# --- the ends of the range --------------------------------------------------
#
# The arithmetic is 64-bit and signed in every column. The overflowing side of
# that is not asked here — bash and zsh wrap and ksh93 saturates — so what is
# claimed is the range itself.

big=9223372036854775807
printf '%s\n' "largest=$(( big )) smallest=$(( -9223372036854775807 - 1 ))"

# --- where an expansion may stand -------------------------------------------

printf '%s\n' "grouped=$(( (1 + 2) * (3 + 4) ))"
printf '%s\n' "a substitution inside it=$(( 1 + $(printf '2') ))"
q=3
printf '%s\n' "an expansion inside it=$(( $((q + 1)) * 2 ))"
printf '%s\n' "joined to text=$(( 1 + 1 ))s"
printf '%s\n' "a newline inside it=$(( 1 +
2 ))"

# --- a malformed expression -------------------------------------------------
#
# The status is the claim and the wording is not, so the diagnostic is
# discarded and the subshell's number is printed. bash, zsh and ksh93 leave 1
# and dash leaves 2, so only the *fact* that it failed is core; the number is
# share/suite/dash/arith.tests.

( printf '%s\n' "$(( 1 + ))" ) 2>/dev/null
rc=$?
printf 'a dangling operator failed: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi
( printf '%s\n' "$(( 1 2 ))" ) 2>/dev/null
rc=$?
printf 'two numbers with no operator failed: '
if [ "$rc" -ne 0 ]; then printf 'yes\n'; else printf 'no\n'; fi

# --- a shift count past the width of the word -------------------------------
#
# Every shell here hands the count to a C shift on a 64-bit word, and the
# machine takes the count modulo the width rather than answering zero for a
# count too large to mean anything. So `1 << 64` is the word shifted by
# nothing, `1 << 65` by one, and a *negative* count arrives as 63 — the low six
# bits of -1. Unanimous across bash, zsh, ksh93, dash and BusyBox ash, which is
# what puts it here and not in a dialect file.
#
# It is the one place a shell's C heritage shows through a language whose own
# shift is the defined one, and a reimplementation that simply uses that gets
# zero for all four of these.

printf 'shifted by the whole width: %s\n' "$(( 1 << 64 ))"
printf 'and by one more:            %s\n' "$(( 1 << 65 ))"
printf 'right by the whole width:   %s\n' "$(( 8 >> 64 ))"
printf 'by a negative count:        %s\n' "$(( 1 << -1 ))"
