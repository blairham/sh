#
# Field splitting and filename generation, POSIX XCU 2.6.5 and 2.6.6 — the
# two steps that turn one word into several.
#
# Two large questions are deliberately not asked here, because measuring them
# is what put them in the dialect files:
#
#   * an unquoted parameter expansion splits on IFS in bash, ksh93 and dash,
#     and does not split at all in zsh, which quotes the result unless asked
#     otherwise. Command substitution splits in all four.
#   * a pattern matching no file is left alone in bash, ksh93 and dash, and is
#     a fatal error in zsh.
#
# A tier that claims agreement may not contain either.

# Command substitution is split on IFS in every shell.
set -- $(printf 'a b c')
printf 'cmdsub fields=%s [%s] [%s] [%s]\n' "$#" "$1" "$2" "$3"
set -- `printf 'a b c'`
printf 'backtick fields=%s\n' "$#"
set -- "$(printf 'a b c')"
printf 'quoted cmdsub fields=%s [%s]\n' "$#" "$1"

# Runs of whitespace are one separator, and leading and trailing ones produce
# no empty field.
set -- $(printf '  a   b  ')
printf 'whitespace fields=%s [%s] [%s]\n' "$#" "$1" "$2"

# A non-whitespace IFS character is a real separator, so adjacent ones make an
# empty field.
IFS=:
set -- $(printf 'a::b')
printf 'colon fields=%s [%s] [%s] [%s]\n' "$#" "$1" "$2" "$3"
set -- $(printf ':a')
printf 'leading colon fields=%s [%s] [%s]\n' "$#" "$1" "$2"
IFS=' '

# An empty IFS turns splitting off.
IFS=
set -- $(printf 'a b c')
printf 'empty IFS fields=%s [%s]\n' "$#" "$1"
unset IFS
set -- $(printf 'a b c')
printf 'unset IFS fields=%s\n' "$#"
IFS=' '

# Arithmetic expansion produces one field even with spaces in the expression.
set -- $(( 1 + 1 ))
printf 'arith fields=%s [%s]\n' "$#" "$1"

# Filename generation, against files this case makes for itself.
mkdir -p gen
: > gen/alpha.txt
: > gen/beta.txt
: > gen/gamma.log
: > gen/.hidden
set -- gen/*
printf 'star fields=%s [%s] [%s] [%s]\n' "$#" "$1" "$2" "$3"
set -- gen/*.txt
printf 'suffix fields=%s [%s] [%s]\n' "$#" "$1" "$2"
set -- gen/?????.txt
printf 'question fields=%s [%s]\n' "$#" "$1"
set -- gen/[ab]*
printf 'class fields=%s [%s] [%s]\n' "$#" "$1" "$2"
set -- gen/[!ab]*
printf 'negated fields=%s [%s]\n' "$#" "$1"

# The results are sorted, and a leading dot is not matched by * or ?.
set -- gen/*
printf 'sorted: %s\n' "$*"
set -- gen/.*
printf 'dot fields includes the hidden file: '
case " $* " in *' gen/.hidden '*) printf 'yes\n' ;; *) printf 'no\n' ;; esac

# A quoted pattern is not a pattern.
set -- "gen/*"
printf 'quoted pattern fields=%s [%s]\n' "$#" "$1"
set -- gen/\*
printf 'escaped pattern fields=%s [%s]\n' "$#" "$1"

# Whether a field produced by splitting is itself a pattern is a dialect
# answer: measured, bash, ksh93 and dash generate from it and zsh does not,
# which is the same reflex that keeps zsh from splitting a parameter.

# Assignment is not split and not generated, whatever it contains.
a=$(printf 'a b c')
printf 'assignment kept whole: [%s]\n' "$a"
b=gen/*
printf 'assignment not generated: [%s]\n' "$b"

# The word of a `case` and the right side of = in `[ ]` are not split either.
case $(printf 'a b') in
'a b') printf 'case word kept whole\n' ;;
*) printf 'case word was split\n' ;;
esac
