#
# Arithmetic expansion, POSIX XCU 2.6.4. The operators, their precedence, and
# the places a shell evaluates arithmetic without being asked twice.

printf '%s\n' "add=$((1 + 2)) sub=$((7 - 3)) mul=$((3 * 4))"
printf '%s\n' "div=$((7 / 2)) neg-div=$((-7 / 2)) rem=$((7 % 3)) neg-rem=$((-7 % 3))"
printf '%s\n' "precedence=$((2 + 3 * 4)) parens=$(((2 + 3) * 4))"
printf '%s\n' "unary=$((-3)) plus=$((+3)) not=$((!0)) not1=$((!5))"
printf '%s\n' "bitnot=$((~0)) and=$((12 & 10)) or=$((12 | 10)) xor=$((12 ^ 10))"
printf '%s\n' "shl=$((1 << 4)) shr=$((256 >> 3))"
printf '%s\n' "lt=$((1 < 2)) gt=$((1 > 2)) le=$((2 <= 2)) ge=$((1 >= 2))"
printf '%s\n' "eq=$((2 == 2)) ne=$((2 != 2))"
printf '%s\n' "andand=$((1 && 0)) oror=$((0 || 3)) ternary=$((1 ? 10 : 20))"

# Short-circuit: the right side of && is not evaluated when the left is zero,
# so the assignment inside it does not happen.
x=0
: $((0 && (x = 9)))
printf '%s\n' "shortcircuit-and x=$x"
: $((1 || (x = 8)))
printf '%s\n' "shortcircuit-or x=$x"

# A variable is read without a $, and an unset one is zero.
n=5
unset m
printf '%s\n' "bare=$((n * 2)) unset=$((m + 1))"

# Assignment operators, and the value of the whole expression.
a=1
printf '%s\n' "assign=$((a = 10)) then a=$a"
printf '%s\n' "plus-assign=$((a += 5)) then a=$a"
printf '%s\n' "minus-assign=$((a -= 3)) then a=$a"
printf '%s\n' "times-assign=$((a *= 2)) then a=$a"
printf '%s\n' "div-assign=$((a /= 4)) then a=$a"
printf '%s\n' "mod-assign=$((a %= 4)) then a=$a"

# Hexadecimal literals. A leading zero is *not* here: measured, $((010)) is 8
# in bash, ksh93 and dash and 10 in zsh, which does not read a leading zero as
# octal unless asked. So that is a dialect answer and lives in each dialect's
# own file.
printf '%s\n' "hex=$((0x1f)) hexcaps=$((0XFF))"

# Arithmetic inside a string, and nested expansion.
i=3
printf '%s\n' "nested=$((i + $((i * 2))))"

# Whitespace is insignificant.
printf '%s\n' "spaced=$((  1   +   2  ))"

# The status of a command substitution holding an arithmetic result.
v=$((6 * 7))
printf '%s\n' "captured=$v"

# Comparisons are 1 and 0, so they compose with the rest.
printf '%s\n' "compose=$(((3 > 2) + (4 > 5)))"
