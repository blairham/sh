#
# The builtins only zsh has, and the nine of them that no case anywhere in
# this tree mentioned (#2293) — every remaining name on that list but two.
#
# They are not one family. `compctl`, `log` and `zcompile` are zsh's own from
# the start; the `zf_` nine come from the `zsh/files` module and are what a
# script gets when it wants to move a file without a fork.

# `log` reports who has logged in or out since it last looked. With no
# `watch` set there is nobody to report, so it succeeds and says nothing —
# which is the answer a script in a suite can have, and the only one, since
# who is logged in is a property of the machine.
log
printf 'log -> %s\n' "$?"

# `compctl` is the old completion system, still present and still writable
# from a non-interactive shell. -L writes the definitions back as the
# commands that would recreate them, which is what makes it askable at all.
compctl -K handler mycmd
printf 'compctl -> %s\n' "$?"
compctl -L mycmd
compctl -f otherc
compctl -L otherc

# A second definition for the same command replaces the first rather than
# adding to it.
compctl -f mycmd
compctl -L mycmd

# -L with no name writes everything it knows, the built-in defaults included.
compctl -L

# `zcompile` turns a script into a wordcode file beside it. The name is the
# script's with .zwc on the end, and the original is untouched.
printf 'print compiled\n' > unit.zsh
zcompile unit.zsh
printf 'zcompile -> %s\n' "$?"
[[ -f unit.zsh.zwc ]] && printf 'wordcode written\n'
[[ -f unit.zsh ]] && printf 'source kept\n'
[[ -s unit.zsh.zwc ]] && printf 'and it is not empty\n'
. ./unit.zsh

# The `zf_` builtins come from a module, so the file loads it first. That
# `zf_ln` answers before the `zmodload` line here and does not in zsh is
# #1670, which recorded it and decided nothing: a name this shell registers
# is registered from the start, so module membership is not something it can
# consult at lookup time.
zmodload zsh/files
printf 'zmodload -> %s\n' "$?"

# zf_ln makes a link, hard by default and symbolic with -s.
printf 'pointee\n' > target
zf_ln target hard
printf 'zf_ln -> %s\n' "$?"
[[ -f hard ]] && printf 'hard link is there\n'
zf_ln -s target soft
[[ -L soft ]] && printf 'and -s made a symbolic one\n'
printf 'through the link: %s\n' "$(cat soft)"

# A destination that exists is a refusal rather than an overwrite, and the
# diagnostic names the builtin.
zf_ln target hard
printf 'over an existing name -> %s\n' "$?"

# zf_chmod takes the octal bits.
zf_chmod 600 target
printf 'zf_chmod -> %s\n' "$?"
[[ -r target ]] && printf 'still readable\n'
[[ -x target ]] || printf 'and not executable\n'
zf_chmod 700 target
[[ -x target ]] && printf 'now it is\n'

# zf_rmdir removes a directory and only an empty one.
mkdir empty full
: > full/occupant
zf_rmdir empty
printf 'zf_rmdir -> %s\n' "$?"
[[ -d empty ]] || printf 'empty one is gone\n'
zf_rmdir full
printf 'non-empty -> %s\n' "$?"
[[ -d full ]] && printf 'and is still there\n'

# zf_sync flushes what is written and takes no operand.
zf_sync
printf 'zf_sync -> %s\n' "$?"

# zf_chown and zf_chgrp are asked where the answer is the shell's rather than
# the machine's: whether the file is there, and whether enough was said. A
# successful chown needs a uid this run may or may not be allowed to use, and
# a case whose answer moves with who is running it measures the machine.
zf_chown 0 nosuchname
printf 'zf_chown missing -> %s\n' "$?"
zf_chgrp 0 nosuchname
printf 'zf_chgrp missing -> %s\n' "$?"
zf_chown
printf 'zf_chown bare -> %s\n' "$?"
zf_chgrp
printf 'zf_chgrp bare -> %s\n' "$?"
zf_chmod nosuchname
printf 'zf_chmod with no mode -> %s\n' "$?"

# An infinity and a not-a-number are written as the bare word, which is zsh's
# answer alone: no width pads them, no precision touches them, no flag
# prefixes them, and an upper-case conversion does not capitalize them. bash,
# dash and BusyBox ash put the word through the conversion and do all four,
# and ksh93 never reads the operand at all — it goes through the arithmetic
# evaluator there, which answers -0 for an infinity.
#
# Only the readings zsh answers alone are here. The spelling itself — `inf`
# and `nan` rather than Go's `+Inf` and `NaN` — is common ground between four
# of the five and belongs to no tier in this suite, so the corpus row
# printf/non-finite-is-spelled-c-s-way carries it across all seven columns.
printf '[%E][%G]\n' inf nan
printf '[%10f][%-10f][%010f]\n' inf inf inf
printf '[%+f][% f]\n' inf inf
printf '[%20.3e][%4g]\n' nan inf

# `ulimit`'s keyword operands, which zsh has one of. `hard` is the ceiling
# this process is allowed; `soft` is bash's alone and is an unreadable number
# here, which is why the two words are two axes and not one switch.
#
# zsh moves only the soft limit when neither -H nor -S is given, so the first
# line raises the floor to the ceiling and leaves the ceiling where it was.
ulimit -c hard; printf 'ulimit -c hard -> %s\n' "$?"
[ "$(ulimit -Sc)" = "$(ulimit -Hc)" ] && printf 'the floor is now the ceiling\n'
ulimit -c soft 2> /dev/null; printf 'ulimit -c soft -> %s\n' "$?"

# And a limit is a plain number: not a sign, not an expression, not hex.
ulimit -c +1 2> /dev/null; printf 'signed -> %s\n' "$?"
ulimit -c 1+1 2> /dev/null; printf 'expression -> %s\n' "$?"
ulimit -c 0x10 2> /dev/null; printf 'hex -> %s\n' "$?"

# `kill -l` past the one subtraction every shell makes. zsh is the column
# that separates the two halves of the question: one subtraction, like bash
# and dash, and yet a number it cannot name is printed back rather than
# refused, like ksh93 and BusyBox ash. So `kill -l 160` is 160 here and 32
# there, and `kill -l 0` is the number rather than `EXIT`.
kill -l 0
kill -l 32
kill -l 128
kill -l 160
kill -l 257
printf 'status: %s\n' "$?"
# `exec`'s own option letters, where this shell parts from bash on how the
# two compose: `-a` wins over `-l` outright, in either order, so `exec -l -a
# NAME` hands over `NAME` and bash hands over `-NAME`. Each `exec` is in a
# subshell so the file survives it.
( exec -l /bin/sh -c 'printf "[%s]\n" "$0"' )
( exec -a NAME /bin/sh -c 'printf "[%s]\n" "$0"' )
( exec -l -a NAME /bin/sh -c 'printf "[%s]\n" "$0"' )
( exec -a NAME -l /bin/sh -c 'printf "[%s]\n" "$0"' )
( export KEEP=1; exec -c /bin/sh -c 'printf "with -c: [%s]\n" "${KEEP-unset}"' )
# `umask` here reads neither of the two things POSIX's symbolic grammar has
# beyond the plain permission characters: a `u`, `g` or `o` after an operator
# meaning that group's current permissions, and chmod's conditional-execute
# `X`. bash 5.3, ksh93, dash and BusyBox ash read at least one of them.
( umask 022; umask -S g=u ) 2> /dev/null; printf 'a copy -> %s\n' "$?"
( umask 022; umask -S u=X ) 2> /dev/null; printf 'the X letter -> %s\n' "$?"
( umask 022; umask -S a+X ) 2> /dev/null; printf 'X with plus -> %s\n' "$?"

# The ten builtins of the completion system, asked the one way a script can
# ask them — from outside a completion — and the answer is about the *count*
# before it is about the place.
#
# zsh declares a minimum and a maximum for each builtin and refuses on the
# count in the dispatcher, before the builtin's own body runs. So a bare
# `comparguments` is `not enough arguments` and never reaches the sentence
# about completion functions, while a bare `compadd` — which declares no
# minimum — goes straight to it. Eight of the ten are in the first group and
# two in the second, and this shell had the two checks the other way round
# until it was measured: every one of the ten said `can only be called from
# completion function` whatever it was given.
#
# The count is of words and not of operands in nine of the ten, which is what
# a gate ahead of any option parsing means: `compdescribe -i a` is two words
# and refuses for the count, and `compset -p 1 x x` is four and is too many.
# `compquote` is the exception and parses its `-p` off first.
#
# All ten were found by `make coverage` (#2293), which had them as surface no
# case anywhere in this tree mentioned. They are zsh's alone: the other four
# references answer every line below `command not found`.
# Written out one name at a time rather than looped over a variable: a
# command word that is `$c` names no builtin, and the coverage instrument
# reads the text.
compadd 2>&1;       printf 'compadd -> %s\n' "$?"
comparguments 2>&1; printf 'comparguments -> %s\n' "$?"
compdescribe 2>&1;  printf 'compdescribe -> %s\n' "$?"
compfiles 2>&1;     printf 'compfiles -> %s\n' "$?"
compgroups 2>&1;    printf 'compgroups -> %s\n' "$?"
compquote 2>&1;     printf 'compquote -> %s\n' "$?"
compset 2>&1;       printf 'compset -> %s\n' "$?"
comptags 2>&1;      printf 'comptags -> %s\n' "$?"
comptry 2>&1;       printf 'comptry -> %s\n' "$?"
compvalues 2>&1;    printf 'compvalues -> %s\n' "$?"

# The two that declare no minimum, given words, are still about the place.
compadd x 2>&1;  printf 'compadd x -> %s\n' "$?"
comptry x 2>&1;  printf 'comptry x -> %s\n' "$?"

# And the eight that do, once the count is satisfied.
comparguments x 2>&1; printf 'comparguments x -> %s\n' "$?"
compfiles x 2>&1;     printf 'compfiles x -> %s\n' "$?"
compgroups x 2>&1;    printf 'compgroups x -> %s\n' "$?"
comptags x 2>&1;      printf 'comptags x -> %s\n' "$?"
compvalues x 2>&1;    printf 'compvalues x -> %s\n' "$?"

# `compdescribe` declares three where the other seven declare one.
compdescribe -i a 2>&1
printf 'compdescribe two words -> %s\n' "$?"
compdescribe -i a b 2>&1
printf 'compdescribe three words -> %s\n' "$?"

# `compset` is the only one of the ten with a maximum as well as a minimum.
compset -p 1 x 2>&1
printf 'compset three words -> %s\n' "$?"
compset -p 1 x x 2>&1
printf 'compset four words -> %s\n' "$?"

# `compquote` is the exception to "the count is of words": it parses `-p` off
# first, so a lone `-p` is still nothing and a second one changes nothing.
compquote -p 2>&1
printf 'compquote -p alone -> %s\n' "$?"
compquote -p -p 2>&1
printf 'compquote -p twice -> %s\n' "$?"
compquote -p x 2>&1
printf 'compquote -p and a name -> %s\n' "$?"

# And the other nine do count the words: three of them satisfy compdescribe
# whether one is an option or not.
compdescribe a b c 2>&1
printf 'compdescribe three operands -> %s\n' "$?"

# `zpty` runs a program on a pseudo-terminal of its own. It comes from a
# module like the `zf_` builtins above, and it answers before the `zmodload`
# here for the same reason they do — #1670, which recorded that and decided
# nothing — so the module is loaded first and no row below asks that
# question.
#
# What is asked is the bookkeeping rather than a session: the listing with
# nothing to list, and the refusal for a name the table has not got. Starting
# a program on a pty and reading from it is a timing question, and the note
# on determinism in internal/suite/own.go is why a case here may not hold
# one — `internal/smoke` drives the pty surface instead.
#
# It was one of the eight surface elements #3990 found that no case anywhere
# in the tree mentioned, and it arrived with the builtin.
zmodload zsh/zpty
printf 'zmodload zsh/zpty -> %s\n' "$?"
zpty -L
printf 'the listing with nothing to list -> %s\n' "$?"
( zpty -d nosuch_zz ) 2>&1 > /dev/null
printf 'deleting a name it has not got -> %s\n' "$?"
