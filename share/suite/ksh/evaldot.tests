#
# eval and `.` in ksh93 — #2322.
#
# ksh93 answers 3 for text that will not parse, which is a number no other
# shell on the panel uses here: bash and dash answer 2, and zsh answers 1 for
# an `eval` and 126 for a file. It is the same 3 in ksh93 whether the text
# came from a file or from an `eval` operand, which says the number belongs
# to the parse rather than to either builtin.
#
# The other answer here is about how far a *fatal* error travels. In ksh93 an
# unknown option to a builtin ends the shell, and reaching that builtin
# through `eval` or through a dot script does not soften it — the enclosing
# subshell is given up with the same status, and nothing after it in the
# subshell runs. The bare call is kept beside each as the control.
#
# `alias -g` is the fatal call used below because it is short and because
# ksh93's `alias` genuinely has no `-g`: the option is zsh's, and this file
# is one of the places that gets measured.

# --- the status of text that will not parse ---

printf 'for\n' > bad.sh
( . ./bad.sh ) 2>/dev/null; printf 'a dot file that will not parse -> %s\n' "$?"
( eval 'if then fi' ) 2>/dev/null; printf 'an eval that will not parse -> %s\n' "$?"

# A different parse error, to say the number is the parse and not the text.
printf 'case\n' > bad2.sh
( . ./bad2.sh ) 2>/dev/null; printf 'another dot file -> %s\n' "$?"
( eval 'case' ) 2>/dev/null; printf 'another eval -> %s\n' "$?"

# Nothing of the file ran.
printf 'printf "first line\\n"\nfor\nprintf "third line\\n"\n' > bad3.sh
( . ./bad3.sh ) 2>/dev/null; printf 'half a dot file -> %s\n' "$?"

# --- how far a fatal builtin error travels ---

# The bare call: the subshell is given up with 2 and its second command does
# not run.
( alias -g aa=1; printf 'the subshell carried on\n' ) 2>/dev/null
printf 'bare -> %s\n' "$?"

# The same call through `eval`.
( eval 'alias -g bb=1'; printf 'the subshell carried on\n' ) 2>/dev/null
printf 'through eval -> %s\n' "$?"

# And through a dot script, where the rest of the dot script does not run
# either.
printf 'alias -g cc=1\nprintf "the dot script carried on\\n"\n' > u.sh
( . ./u.sh; printf 'after the dot\n' ) 2>/dev/null
printf 'through a dot script -> %s\n' "$?"

# The outer shell is untouched by any of them, because each was in a
# subshell of its own.
printf 'reached the end\n'

# `.` reads a leading dash-word as an option here and has none to read, which
# is a third answer: not bash 5.3's search path and not zsh's filename, but
# an unknown option, its usage line, and the end of the script — `.` being a
# special builtin. The subshell is what the file survives it in.
( . -p /tmp f.sh; printf 'reached\n' ) 2> /dev/null
printf 'a dash-word -> %s\n' "$?"

# `eval`'s own options — #3216, which expected this shell to take none and
# measured it wrong. It reads them, in its own words and with its own
# fatality: `eval: -q: unknown option` and `Usage: eval [ options ] [arg...]`,
# status 2, and the **script ends there** because a usage error in a POSIX
# special builtin is fatal here.
#
# Every refusal is inside a subshell for exactly that reason — the fatality is
# the fact being pinned, so it has to be contained rather than avoided — and
# each stream is taken on its own because the diagnostic is unbuffered and
# the pipe is not.
printf -- '--- an option letter this builtin has not got\n'
( eval -q echo hi ) 2>&1 > /dev/null
( eval -q echo hi ) > /dev/null 2>&1; printf 'status -> %s\n' "$?"

# The text after it does not run, and neither does the command after the
# refusal: the subshell is over.
( eval -q echo hi; printf 'carried on\n' ) 2>/dev/null; printf 'and the subshell ended -> %s\n' "$?"

printf -- '--- the letter alone\n'
( eval -q ) 2>&1 > /dev/null
( eval -q ) > /dev/null 2>&1; printf 'status -> %s\n' "$?"

# The marker ends the options and the rest is the text.
printf -- '--- the end-of-options marker\n'
eval -- echo hi; printf 'status -> %s\n' "$?"
eval --; printf 'the marker alone -> %s\n' "$?"

# Behind the marker a dash-word is a command again, and a command that is not
# there is not fatal — which is the pair that separates "the marker ended the
# options" from "the marker was dropped".
( eval -- -q ) 2>&1 > /dev/null
( eval -- -q; printf 'carried on\n' ) 2>/dev/null

# A lone `-` is the first word of the text rather than a marker or an option.
( eval - echo hi ) 2>&1 > /dev/null
( eval - echo hi ) > /dev/null 2>&1; printf 'a lone dash -> %s\n' "$?"

eval echo plain; printf 'plain -> %s\n' "$?"

# A `set` the dot script runs itself is put back with everything else —
# #4063. The words after the filename give the script parameters of its own,
# and when it returns the caller's are back whatever the script did to them.
# bash is the one column where such a replacement stands.
printf -- '--- a set inside the dot script\n'
printf 'set -- m n o p\n' > setter.sh
set -- a b c; . ./setter.sh p q; printf 'after a set -> [%s]\n' "$*"

# An empty replacement is put back the same way, which says the row above is
# not about the script leaving something behind.
printf 'set --\n' > clearer.sh
set -- a b c; . ./clearer.sh p q; printf 'after set -- -> [%s] n=%s\n' "$*" "$#"

# And `shift` is the control every column agrees on.
printf 'shift\n' > shifter.sh
set -- a b c; . ./shifter.sh p q; printf 'after a shift -> [%s]\n' "$*"
