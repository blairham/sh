#
# <(...) — process substitution. dash has none, and bash 3.2 loses it when it
# is invoked as sh, which is the clearest evidence in the matrix that a
# dialect is a runtime switch rather than a build. It is ext/.
#
# Only the reading form is asked, and only where the result is ordered. >(...)
# is a write into a process this shell does not wait for, so what reaches the
# output and in which order is a scheduling question — the harness's repeat
# check would refuse such a file as unstable, correctly, and an unstable case
# says nothing about either shell.
#
# The name a <(...) expands to is a device path and the number in it is the
# shell's business, so nothing here prints the word itself. What is asked is
# what reading it produces.

cat <(printf 'from the substitution\n')

# It is a word, so it stands where a filename stands: as an operand, after a
# redirection, and more than once in one command.
cat < <(printf 'redirected in\n')
cat <(printf 'first\n') <(printf 'second\n')

# The process runs concurrently with the reader, and its output arrives in
# the order it wrote it.
cat <(printf 'a\nb\nc\n')

# Reading one line at a time from it, which is the use that avoids the
# subshell a pipeline would put the loop in — so what the loop assigns is
# still there afterwards.
n=0
while read -r line; do
  n=$((n + 1))
done < <(printf 'one\ntwo\nthree\n')
printf 'the loop saw %s lines and kept the count\n' "$n"

# Nested inside a command substitution, which is where two different
# mechanisms for the same idea get confused with each other.
printf 'nested: %s\n' "$(cat <(printf 'inner'))"

# It composes with an ordinary pipeline.
cat <(printf 'x\ny\n') | while read -r l; do printf 'piped [%s]\n' "$l"; done

# The substituted process sees the shell's variables, because it is a
# subshell of it rather than an unrelated command.
v=inherited
cat <(printf '%s\n' "$v")

# A function may be the process.
emit() { printf 'from a function\n'; }
cat <(emit)

# What it produces is readable by an ordinary command that reads to the end.
wc -l < <(printf 'l1\nl2\nl3\n')

# An empty producer gives an empty read rather than an error.
printf 'empty produces: ['
cat <(true)
printf ']\n'

# --- the word itself ---------------------------------------------------------
#
# What `<(…)` expands to is a path, and the number in it is the shell's
# business — so the digits are replaced before anything is compared. What
# survives is the shape, which is the part a script can depend on: it is a
# name for a descriptor, not a file in a temporary directory, which is why
# nothing has to clean it up. The directory in front of the number is the
# shell's business too, and the columns disagree about it: zsh names
# /proc/self/fd where that directory is there and every other column here
# names /dev/fd, which is why this file is the one place the two rows below
# can fail in a gated column while the two after them pass.

printf 'the reading form: [%s]\n' "$(printf '%s' <(true) | sed 's/[0-9][0-9]*/N/g')"
printf 'the writing form: [%s]\n' "$(printf '%s' >(true) | sed 's/[0-9][0-9]*/N/g')"

# And the descriptor behind the name is open in the direction the operator
# named, which is the whole of what `>(…)` can be asked without waiting for a
# process this shell does not wait for.
printf 'the reading form is readable: '
if test -r <(true); then printf 'yes\n'; else printf 'no\n'; fi
printf 'the writing form is writable: '
if test -w >(true); then printf 'yes\n'; else printf 'no\n'; fi

# Three of them in one command, in the order they were written rather than in
# the order the three processes happened to finish — which is the reason the
# producers here each write one short string and exit.
printf 'three at once: [%s]\n' "$(cat <(printf 'a') <(printf 'b') <(printf 'c'))"

# One nested inside another: the inner process substitutes into the outer
# one's command, and the outer one's reader never sees the difference.
printf 'nested: [%s]\n' "$(cat <(cat <(printf 'deep')))"

# It stands beside the ordinary redirections on the same command, and a
# here-document may be the other operand — `-` is the standard input the
# here-document is on.
printf 'beside a here-document: [%s]\n' "$(cat <(printf 'a') - <<'HERE'
here
HERE
)"

# A substitution's body is a fork, so the mask it sets is its own — and this
# is the body that made "put the mask back at the end" the wrong mechanism
# (#2949): it runs beside the shell, which has moved on by the time the body
# ends, so a value handed back then is a mask restored over a live one.
umask 077
read maskinside < <(umask 002; umask -S)
printf 'inside a process substitution [%s], and here still [%s]\n' \
	"$maskinside" "$(umask -S)"
umask 022
