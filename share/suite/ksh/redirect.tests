# SPDX-License-Identifier: Apache-2.0
#
# Redirection operators and file descriptors in ksh93 — #2308.
#
# Three operators here belong to this shell alone, and all three are about a
# descriptor's *position* in a file rather than about where its bytes go.
#
#	cmd >; file      run with the output held aside, and replace `file`
#	                 with it only if the command succeeded
#	exec n<#((expr)) move the read position of descriptor n to that offset
#	exec n>#((expr)) the same for a write position
#
# `>;` is the one a script would reach for: `sed … f >; f` is the in-place
# edit every other shell needs a temporary file and a `mv` to write, and its
# whole point is the failure case — a command that ends non-zero leaves the
# target exactly as it was, so a half-written filter cannot destroy the file
# it was reading. bash, zsh and dash all parse `>;` as a redirection to a
# file named `;` or refuse the line, and none of them has `<#` at all.
#
# Each section is a subshell. These operators are fatal where they are not
# understood — a parse error takes the whole input in every shell here — and
# a section that stops should cost its own lines rather than the file's.
#
# The seek operators are written **inline**, and they were behind an `eval`
# until #3990. The argument for the `eval` was that a parse error is the one
# failure a subshell cannot contain, so an inline `<#((0))` would cost every
# section of this file in a shell without the operator — and that argument
# had already been overtaken by line 44 of this same file. `>;` is inline
# there, and bash 5.3.20, zsh 5.9.2 and dash 0.5.12 each refuse *this whole
# file* at that line, so there is nothing left for the `eval` to protect.
#
# What it cost was the other reader. `make coverage` parses every file in
# this tree and asks which elements of the surface no case mentions, and the
# text inside a single-quoted `eval` is a string to a parser: `<#` and `>#`
# read as never mentioned by anything, for as long as they have existed,
# while this file was exercising both. The operator has to be *written* where
# an instrument that reads rather than runs can see it.
#
# share/suite/ksh/status.tests reaches `.sh.pipestatus` through an `eval` for
# the same reason this file used to, and that one still holds: nothing in the
# file it lives in is refused while reading.
#
# Two spellings are deliberately absent. `<>;` is documented for ksh93 and
# this build refuses it (`syntax error … `<>;' unexpected`), so there is no
# behaviour on this machine to record. A coprocess (`cmd |&` with `print -p`
# and `read -p`) is left out for the suite's own rule rather than for a gap:
# whether a reply is readable depends on when the other program flushes, and
# a case whose answer moves with libc buffering is not a case this suite may
# hold. See the note on determinism in internal/suite/own.go.

printf -- '--- >; replaces the file when the command succeeds ---\n'
(
  printf 'one\ntwo\n' > rewritten
  sed 's/one/ONE/' rewritten >; rewritten
  printf 'the edit -> %s, file is [%s]\n' "$?" "$(tr '\n' ',' < rewritten)"
)

printf -- '--- and leaves it alone when the command fails ---\n'
(
  printf 'one\ntwo\n' > kept
  ( cat kept; exit 3 ) >; kept
  printf 'the failed edit -> %s, file is [%s]\n' "$?" "$(tr '\n' ',' < kept)"
)

printf -- '--- >; on a file that did not exist ---\n'
(
  rm -f made
  printf 'fresh\n' >; made
  printf 'the write -> %s, file is [%s]\n' "$?" "$(tr '\n' ',' < made)"
)

printf -- '--- <#((expr)) moves a read position ---\n'
(
  printf 'abcdefghij' > seekable
  exec 3< seekable
  read -n4 v <&3; printf 'the first four: [%s]\n' "$v"
  exec 3<#((0))
  read -n2 v <&3; printf 'after seeking back to 0: [%s]\n' "$v"
  exec 3<#((6))
  read -n2 v <&3; printf 'after seeking to 6: [%s]\n' "$v"
  exec 3<&-
)

printf -- '--- the offset is an arithmetic expression, not a number ---\n'
(
  printf 'abcdefghij' > computed
  exec 3< computed
  n=2
  exec 3<#((n * 3 + 1))
  read -n2 v <&3; printf 'from 2 * 3 + 1: [%s]\n' "$v"
  exec 3<&-
)

printf -- '--- >#((expr)) moves a write position ---\n'
(
  printf '0123456789' > overwritten
  exec 4<> overwritten
  exec 4>#((3))
  printf 'XY' >&4
  exec 4>&-
  printf 'after writing at 3: [%s]\n' "$(cat overwritten)"
)

# --- a target whose expansion failed is a failed redirection ----------------
#
# This shell is the only one of the six that grades a redirection **target**
# it could not expand as a failed *redirection* rather than as a failed
# expansion. The difference is visible three ways at once, so each row below
# prints all three: whether the shell is still running, the status the failure
# left, and whether `||` catches it.
#
# The noun is **a special builtin**, not "a command this shell runs itself" —
# a function, a group and `command :` are all commands it runs itself and all
# three carry on. Those three rows are the ones that pick the noun, and a file
# asking only about `:` and an external could not tell the two readings apart.
#
# Each row is a subshell, because the special-builtin row ends the shell it
# happens in and should cost its own section rather than the file's. The pair
# at the end is the discriminator: a redirection that could not be **opened**
# draws this same grid here, which is what says the grading is the
# redirection's (#4689).

printf -- '--- a special builtin ---\n'
( : > $(( 1/0 )); echo SAME ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- a regular builtin ---\n'
( echo RAN > $(( 1/0 )); echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- a function ---\n'
( f_zz() { echo RAN; }; f_zz > $(( 1/0 )); echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- a group ---\n'
( { echo RAN; } > $(( 1/0 )); echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- command over a special builtin ---\n'
( command : > $(( 1/0 )); echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- || catches the contained one ---\n'
( echo RAN > $(( 1/0 )) || echo CAUGHT ) 2>&1

printf -- '--- and not the fatal one ---\n'
( : > $(( 1/0 )) || echo CAUGHT ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- the failure kind does not move the grid ---\n'
( : > ${qq_zz?bad}; echo SAME ) 2>&1; printf 'after st=%s\n' "$?"
( echo RAN > ${qq_zz?bad}; echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"
( set -u; : > $NOPE_ZZ; echo SAME ) 2>&1; printf 'after st=%s\n' "$?"
( set -u; echo RAN > $NOPE_ZZ; echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- the pair: a target that could not be opened draws it too ---\n'
( : > /nonexistent_zz/f; echo SAME ) 2>&1; printf 'after st=%s\n' "$?"
( echo RAN > /nonexistent_zz/f; echo "st=$?" ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- and a failed expansion in an ordinary word is fatal here ---\n'
( echo $(( 1/0 )); echo SAME ) 2>&1; printf 'after st=%s\n' "$?"

printf -- '--- the control: a target that expands is opened ---\n'
( echo RAN > opened_zz; echo "st=$?"; cat opened_zz ) 2>&1; printf 'after st=%s\n' "$?"

# **Where a `command`-prefixed redirection is applied is a different question
# from what its failure costs**, and this is the column that separates them.
# The builtin is reached here — `CommandReachesABuiltin` is Yes — so the word
# was expanded in this shell and the write comes back, while the row above
# shows the same `command :` carrying this shell on at 1 where a bare `:` ends
# it, because the fatality is keyed on a *special* builtin and the word takes
# the specialness away without taking the process away (#4689, #4701).

printf -- '--- where a command-prefixed target is applied ---\n'
( unset u_zz; : > "${u_zz:=made_zz}"; printf 'a bare builtin:      u=[%s]\n' "${u_zz-unset}" ) 2>/dev/null
( unset u_zz; command : > "${u_zz:=made_zz}"; printf 'command :            u=[%s]\n' "${u_zz-unset}" ) 2>/dev/null
( unset u_zz; command echo RAN > "${u_zz:=made_zz}"; printf 'command echo:        u=[%s]\n' "${u_zz-unset}" ) 2>/dev/null
( unset u_zz; command -v : > "${u_zz:=made_zz}"; printf 'command -v :         u=[%s]\n' "${u_zz-unset}" ) 2>/dev/null
( f_zz() { :; }; unset u_zz; command f_zz > "${u_zz:=made_zz}"; printf 'command <function>:  u=[%s]\n' "${u_zz-unset}" ) 2>/dev/null
( unset u_zz; command /bin/echo RAN > "${u_zz:=made_zz}"; printf 'command /bin/echo:   u=[%s]\n' "${u_zz-unset}" ) 2>/dev/null

printf -- '--- and its here-document body, the other half of the redirection ---\n'
( unset u_zz; command : <<END; printf 'command:  u=[%s]\n' "${u_zz-unset}"
[${u_zz:=made_zz}]
END
) 2>/dev/null

# A `( … )`'s here-document body is expanded **out here**, so what it writes is
# still set afterwards — and this is the only column in the panel that says so.
# The rows below are what say it is the parentheses and not the fork: this
# shell forks for a pipeline element and for a background command, confines the
# body in both, and keeps only what the parentheses carry. Measured 2026-09-26
# on ksh93u+ 2012-08-01, AT&T's build (#4700).

subhd_zz() { printf -- '--- %s\n' "$1"; }

subhd_zz 'a subshell keeps what its here-document body wrote'
n_zz=0
( cat ) <<END
$(( n_zz += 5 ))
END
printf 'n=[%s]\n' "$n_zz"

subhd_zz 'while a command of its own loses it'
n_zz=0
cat <<END
$(( n_zz += 5 ))
END
printf 'n=[%s]\n' "$n_zz"

subhd_zz 'a pipeline element loses it, so a fork is not what decides'
n_zz=0
cat <<END | cat
$(( n_zz += 5 ))
END
printf 'n=[%s]\n' "$n_zz"

subhd_zz 'and a background command loses it'
n_zz=0
cat <<END &
$(( n_zz += 5 ))
END
wait
printf 'n=[%s]\n' "$n_zz"

subhd_zz 'the body escapes and the subshell own assignment still does not'
n_zz=0
unset v_zz
( v_zz=1; cat ) <<END
$(( n_zz += 5 ))
END
printf 'n=[%s] v=[%s]\n' "$n_zz" "${v_zz-unset}"
