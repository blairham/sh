#
# getopts in ksh93 — #2321.
#
# POSIX gives the option string one piece of punctuation: a `:` after a
# letter says that letter takes an argument, and a `:` at the front says be
# quiet about errors. ksh93's string has a second type. A letter followed by
# `#` takes a *numeric* argument, and the digits are read as the argument
# whether they are attached to the letter or in the word after it.
#
# In the other three shells `#` is simply another option letter, so the same
# string means something different in each of them: `-n 5` there leaves the
# 5 as an operand, and `-n5` reports 5 as an unknown option.
#
# This is the one place the panel's `getopts` differ in what they *parse*
# rather than in what they publish afterwards, which is why the rest of this
# area is prose in core/getopts.tests and three per-dialect files of state.

num() {
  OPTIND=1
  while getopts 'n#' o "$@" > /dev/null 2>&1; do
    printf 'saw [%s] arg=[%s]\n' "$o" "${OPTARG-unset}"
  done
  printf 'end ind=%s\n' "$OPTIND"
}

# The argument in the following word, and attached to the letter.
num -n 5
num -n5

# A negative number, and a number in a word with an operand after it.
num -n -3 rest
num -n7 rest

# Nothing numeric there at all.
num -n
num rest
num

# The string may mix the two types, and the `:` type behaves as it does
# everywhere.
both() {
  OPTIND=1
  while getopts 'n#s:' o "$@" > /dev/null 2>&1; do
    printf 'both [%s] arg=[%s]\n' "$o" "${OPTARG-unset}"
  done
  printf 'both end ind=%s\n' "$OPTIND"
}
both -n 5 -s hello rest
both -s hello -n 5
both -n5 -shello

# --- a freeze on the names getopts fills in ---
#
# OPTARG and OPTIND are the builtin's own here rather than a script's: a
# `readonly` on either is not consulted at all, and `getopts` writes through
# it without a word. bash reports the refusal and dash stops the builtin over
# it, so this is the third of three answers and ksh93 shares it only with zsh
# (#3147).
#
# Counted rather than quoted, because the interesting number is zero. Each
# case resets OPTIND, so that none of them reads where the one before it
# stopped.

printf 'sentences for a frozen OPTARG -> '
( OPTIND=1; set -- -a val; readonly OPTARG
  getopts 'a:' o 2>&1 >/dev/null | wc -l | tr -d ' ' )

( OPTIND=1; set -- -a val; readonly OPTARG
  getopts 'a:' o 2>/dev/null
  printf 'frozen OPTARG: st=%s o=[%s] OPTIND=%s OPTARG=[%s]\n' "$?" "$o" "$OPTIND" "${OPTARG-unset}" )

# The same for OPTIND, which the scan writes on every call.
printf 'sentences for a frozen OPTIND -> '
( OPTIND=1; set -- -a val; readonly OPTIND
  getopts 'a:' o 2>&1 >/dev/null | wc -l | tr -d ' ' )

( OPTIND=1; set -- -a val; readonly OPTIND
  getopts 'a:' o 2>/dev/null
  printf 'frozen OPTIND: st=%s o=[%s] OPTARG=[%s]\n' "$?" "$o" "${OPTARG-unset}" )

# The **name** is not one of the two the builtin owns, and it is refused: the
# letter cannot be reported, so the builtin reports 2 instead and the name
# keeps what it had.
( OPTIND=1; set -- -a val; N=kept; readonly N
  getopts 'a:' N 2>/dev/null
  printf 'frozen name: st=%s N=[%s]\n' "$?" "$N" )

# --- OPTARG when the scan runs out of options ---
#
# The call that says "no more options" unsets OPTARG here, so the last
# option's argument is not left standing — the answer bash and BusyBox ash
# give, and not dash's or zsh's. The freeze is a second question and this
# shell keeps it: OPTARG is the builtin's, so the clearing is not refused,
# and nothing removes the attribute (#3146).

( OPTIND=1; set -- -a val x
  getopts 'a:' o; getopts 'a:' o
  printf 'after the scan: st=%s o=[%s] OPTARG=[%s]\n' "$?" "$o" "${OPTARG-unset}" )

( OPTIND=1; OPTARG=PRESET; set -- operand; readonly OPTARG
  getopts 'a:' o 2>/dev/null
  printf 'frozen, at the end: OPTARG=[%s]\n' "${OPTARG-unset}" ) 2>/dev/null
