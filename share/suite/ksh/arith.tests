#
# Arithmetic, the answer only ksh93 gives.
#
# ext/ already proves what the ksh family shares. This file is the rest: the
# arithmetic ksh93 has and the others either lack or answer differently.
# Every line here was measured against AT&T ksh93 93u+ 2012-08-01 on this
# machine, and each is one the other references part company with — bash has
# no floating point in `$(( ))` at all and refuses `2**-1`, dash refuses a
# based literal, and zsh has floats and prints them to a different width.

# A float operand makes the whole expression float, and an all-integer
# expression stays integer. That pair is the rule; neither half is
# interesting without the other.
printf '%s\n' "$(( 3/2 ))"
printf '%s\n' "$(( 3.0/2 ))"
printf '%s\n' "$(( 1.0/2 ))"

# How a float prints is a dialect answer rather than a shared one. ksh93
# writes fifteen significant digits and no trailing point; zsh writes
# seventeen and keeps the point on a whole number. Both are defensible and
# they are not the same bytes, which is what puts this line here.
printf '%s\n' "$(( 1.0/3 ))"
printf '%s\n' "$(( 10.0/4 ))"
printf '%s\n' "$(( 1e3 ))"
printf '%s\n' "$(( 2.5 + 2.5 ))"

# `**` takes a negative exponent because the result is a float. bash refuses
# this outright.
printf '%s\n' "$(( 2**10 ))"
printf '%s\n' "$(( 2**-1 ))"

# Integer division truncates toward zero, and the remainder takes the sign of
# the left operand.
printf '%s\n' "$(( -7/2 ))"
printf '%s\n' "$(( -7%2 ))"

# base#number, including base ten spelled out — which is the way to read a
# digit string with a leading zero as decimal rather than octal.
printf '%s\n' "$(( 10#09 + 1 ))"
printf '%s\n' "$(( 2#1011 ))"
printf '%s\n' "$(( 8#17 ))"
printf '%s\n' "$(( 16#ff ))"

# `integer` is ksh's own spelling of typeset -i, and an integer variable
# evaluates its assignment as arithmetic rather than storing the text.
integer n=7
printf '%s\n' "$(( n/2 ))"
n=n+1
printf '%s\n' "$n"
integer m=3*4
printf '%s\n' "$m"

# typeset -i<base> is an output base: the value is stored as a number and
# written back in that base, with the base still on it. ksh93 writes the hex
# digits in lower case where zsh writes them in upper.
typeset -i8 oct=64
printf '%s\n' "$oct"
typeset -i16 hex=255
printf '%s\n' "$hex"
typeset -i2 bin=5
printf '%s\n' "$bin"

# The base survives further arithmetic on the variable.
oct=oct+1
printf '%s\n' "$oct"

# (( )) is a command whose status is the truth of the value, so a zero value
# is a false command — the one place in the shell where zero is false.
if (( 1 + 1 == 2 )); then printf '%s\n' 'true arithmetic succeeds'; fi
if (( 0 )); then printf '%s\n' 'unreachable'; else printf '%s\n' 'zero is a failure'; fi

# let takes its arguments as arithmetic and reports the last one the same way.
let 'a = 3 + 4'
printf '%s\n' "$a"
let "a == 7" && printf '%s\n' 'let reports the truth of its last expression'

# --- a negative divisor is not asked, and that is the measurement ------------
#
# ksh93 93u+ on this machine refuses *every* integer division whose divisor is
# negative and calls it a division by zero: `7 / -2`, `6 / -2`, `7 / -1`,
# `-7 / -2` and `7 / (0 - 2)` all end the script, and so does a divisor read
# out of a variable. The remainder operator with the same operands answers 1,
# and `7 / -2.0` answers -3.5, so it is integer division with a negative
# divisor specifically. bash, zsh and dash all answer -3.
#
# It is written here rather than run because a case of ours is a thing our
# ksh has to reproduce, and this is a defect in a shell from 2012 rather than
# a dialect's answer. core/arith.tests says the same thing from the other
# side: `-7 / 2` is core and `7 / -2` is nowhere.

# --- the top of the range ----------------------------------------------------
#
# bash and zsh wrap a 64-bit overflow the way C does. ksh93 saturates at the
# largest value instead — and where saturating would lose too much, converts
# to floating point and prints the result in that notation, which no other
# column on the panel can do inside `$(( ))` at all.
big=9223372036854775807
printf 'the largest value: %s\n' "$(( big ))"
printf 'one past it:       %s\n' "$(( big + 1 ))"
printf 'twice it:          %s\n' "$(( big * 2 ))"
printf 'below the smallest: %s\n' "$(( -9223372036854775807 - 2 ))"

# --- a value that is not a number --------------------------------------------
#
# bash and zsh read an unparseable operand as zero and carry on. dash fails
# with status 2 and ksh93 with status 1, so what is ksh93's alone is the pair:
# it refuses, and it refuses with a 1.
( printf 'value [%s]\n' "$(( 0x ))" ) 2>/dev/null
printf 'a hexadecimal prefix with no digits: %s\n' "$?"
notanumber=abc
( printf 'value [%s]\n' "$(( notanumber ))" ) 2>/dev/null
printf 'a name holding letters: %s\n' "$?"
