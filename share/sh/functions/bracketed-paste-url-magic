#
# bracketed-paste-url-magic — replaces bracketed-paste: a paste that starts
# with a URL scheme goes in quoted, so that the shell reads it as one word.
#
#   autoload -Uz bracketed-paste-url-magic
#   zle -N bracketed-paste bracketed-paste-url-magic
#
# Nothing in the manual describes it; this is written from what the
# installed shell answers, never from its function files, and
# docs/spec/functions.md has the measurements:
#
#   * the schemes are http://, https://, ftp://, ftps://, file://, ssh://,
#     sftp:// and magnet:, matched at the very start of the paste and by case;
#     the schema style in :bracketed-paste-url-magic replaces the list;
#   * the quoting is the shell's least, ${(q-)...}, so a URL with nothing
#     in it the shell would read specially goes in as it is;
#   * the paste goes in at the cursor, which ends up after it.

emulate -L zsh

local -a schema
zstyle -a :bracketed-paste-url-magic schema schema ||
	schema=( http:// https:// ftp:// ftps:// file:// ssh:// sftp:// magnet: )
local PASTED scheme
zle .bracketed-paste PASTED || return
for scheme in $schema; do
	if [[ $PASTED == ${(b)scheme}* ]]; then
		PASTED=${(q-)PASTED}
		break
	fi
done
LBUFFER+=$PASTED
