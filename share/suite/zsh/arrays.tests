#
# Arrays, the answer only zsh gives.
#
# ext/arrays.tests carries the half the ksh family shares, and it carries no
# numeric subscript at all — because the base is where the two families part.
# zsh counts from one. This file is the rest: the base, the slices, the
# search subscripts, and the whole-array-as-a-word rule that follows from
# zsh not splitting.
#
# And the length, which is the same difference one step on. zsh has no sparse
# array: an index is a position in a list rather than a key in a map, so a gap
# is filled with empty elements and removing one leaves the slot behind. bash
# and ksh93 keep a set of indices and the count follows what is in it. That is
# at the end of the file, and it is the half a script notices — `${#a[@]}` is
# what a loop bound is written from.

a=(one two three four)

# One-based, and a subscript needs no braces: `$a[1]` is the element where
# every other shell in the panel reads that as `$a` followed by literal text.
printf '%s\n' "$a[1]"
printf '%s\n' "${a[1]}"
printf '%s\n' "$a[4]"

# A negative subscript counts from the end, and -1 is the last element rather
# than an error or an empty word.
printf '%s\n' "$a[-1]"
printf '%s\n' "$a[-2]"

# A comma makes it a slice, and the ends are inclusive. A negative end works
# there too.
printf '%s\n' "${a[2,3]}"
printf '%s\n' "${a[2,-2]}"
printf '%s\n' "${a[1,1]}"

# ${#a} on an array is the element count, not the length of the first
# element — which is the ksh family's answer and the reason a script has to
# know which shell it is in.
printf '%s\n' "${#a}"
printf '%s\n' "${#a[@]}"

# Assigning past the end extends the array to that index.
a[6]=six
printf '%s\n' "${#a}"
printf '%s\n' "$a[6]"
printf '[%s]\n' "$a[5]"

# A bare array in double quotes is the elements joined by a space, because
# zsh has no splitting to undo. Every other shell in the panel needs [*] for
# this.
printf '%s\n' "$a"

# (r) is a subscript that searches by value and yields the element; (i)
# searches and yields its index. A miss from (i) is one past the end.
printf '%s\n' "${a[(r)two]}"
printf '%s\n' "${a[(i)three]}"
printf '%s\n' "${a[(i)nothing]}"

# An empty array is empty rather than one empty element, and += appends.
b=()
printf 'empty count: %s\n' "${#b}"
b+=(x)
b+=(y z)
printf '%s\n' "${#b}"
printf '%s\n' "$b[3]"

# set -A is zsh's other spelling of an array assignment, and it replaces
# rather than appends.
set -A c p q r
printf '%s\n' "$c[2]"
set -A c only
printf '%s\n' "${#c}"

# An associative array is declared, and its subscript is the key.
typeset -A m
m[one]=1
m[two]=2
printf '%s\n' "$m[one]"
printf '%s\n' "${#m}"
printf '%s\n' "${(k)m[(r)2]}"

# ---- a gap, and a hole ----

# Assigning past the end is asked above; what is not is the *count*. zsh has no
# sparse array: the indices in between become elements, so a four-element array
# with something at seven has seven elements and three of them are empty. bash
# and ksh93 keep four and remember which indices they were.
g=(one two three)
g[7]=seven
printf 'count after a gap: %s\n' "${#g[@]}"
printf 'the gap is elements: [%s][%s][%s]\n' "$g[4]" "$g[5]" "$g[6]"
printf 'sorted contents: [%s]\n' "$(printf '%s\n' "${g[@]}" | sort | tr '\n' ' ')"

# The same rule read from the other end: `unset` on an element empties the slot
# and leaves the array the length it was. bash and ksh93 take the element out
# and the count drops.
h=(p q r)
unset 'h[1]'
printf 'count after removing one: %s\n' "${#h[@]}"
printf 'the slot is still there: [%s][%s][%s]\n' "$h[1]" "$h[2]" "$h[3]"

# ---- a table literal's words have to pair off ----

# A flat list assigned to a table is read as key, value, key, value, so an odd
# number of words has one with no partner. zsh refuses it; bash takes the last
# word as a key with nothing under it. The refusal ends the shell, so every row
# here is inside `eval`, whose text is what ends instead — which is also how
# the table can be read afterwards.
typeset -A pairs=(x 9)
eval 'pairs=(a 1 b)' 2>&1
printf 'odd: st=%s n=%s x=%s a=%s\n' "$?" "${#pairs}" "${pairs[x]}" "${pairs[a]-ABSENT}"

# The controls, each of which is taken. The repeated key is the one a check
# written on the key set rather than on the word count would refuse: two pairs
# make one element, and the later value wins.
typeset -A even=(a 1 b 2)
printf 'even: st=%s n=%s\n' "$?" "${#even}"
typeset -A blank=()
printf 'empty: st=%s n=%s\n' "$?" "${#blank}"
typeset -A dup=(a 1 a 2)
printf 'repeated key: st=%s n=%s a=%s\n' "$?" "${#dup}" "${dup[a]}"

# And the count is over what the words came to, not over how many were
# written: one element either way, and only what it expands to moves the
# answer. This is the shape a script hits — a list handed in from somewhere
# else rather than typed out.
w=(a 1 b)
eval 'typeset -A fromlist=($w)' 2>&1
printf 'odd from a list: st=%s\n' "$?"
w=(a 1 b 2)
typeset -A fromlist2=($w)
printf 'even from a list: st=%s n=%s\n' "$?" "${#fromlist2}"

# The same words over a name that is not a table are an ordinary array, so it
# is the target's kind that puts the question and not the words.
plain=(a 1 b)
printf 'not a table: st=%s n=%s\n' "$?" "${#plain}"

# ---- ksharrays moves where a scalar append lands ----

# The option is named for the base and it moves six things, five of which are
# readings. This is the sixth and the only one that is a *write*: `a+=word`
# with no parentheses joins the element at the base instead of growing one
# past the end, which is what the whole ksh family does with nothing set.
setopt ksharrays
a=(first second)
a+=last
printf 'append under the option: [%s]\n' "${a[@]}"
# And a bare name is then that one element, which is how zsh's own tests ask
# it — two axes in one line, so a change moving one and not the other shows.
print -l $a

# The three that do not move, each with the option still on. The parenthesised
# form is the sharpest: same option, same name, same word, and it still adds
# an element — the parentheses are the whole of what tells them apart.
b=(first second)
b+=(last)
printf 'a literal append: [%s]\n' "${b[@]}"
c=(first second)
c[1]+=last
printf 'a subscripted append: [%s]\n' "${c[@]}"
s=abc
s+=last
printf 'a name holding a scalar: [%s]\n' "$s"
unsetopt ksharrays

# The control that pins it to the option: the same line without it adds an
# element, and the same three rows answer exactly as they did above.
d=(first second)
d+=last
printf 'append without the option: [%s]\n' "${d[@]}"
e=(first second)
e+=(last)
printf 'a literal append: [%s]\n' "${e[@]}"
f=(first second)
f[2]+=last
printf 'a subscripted append: [%s]\n' "${f[@]}"
t=abc
t+=last
printf 'a name holding a scalar: [%s]\n' "$t"

# It is answered when the assignment runs and not when the body was read: one
# function, parsed once, called with the option on either side of it.
g() { local -a v=(1 2); v+=x; printf 'in the body: [%s]\n' "${v[@]}" }
g
setopt ksharrays
g
unsetopt ksharrays

# ---- a scalar stored over a table, with and without the option ----

# With `ksharrays` off, a scalar store over a name holding a table replaces the
# name: the table is gone and the value is the whole of it. Both spellings, and
# the append joins nothing — `h=(0 pre); h+=x` is `x` and not `prex`, where a
# bare `$h` reads `pre`.
typeset -A m1=(one 1)
m1=string
printf 'plain, option off: [%s] n=%s\n' "$m1" "${#m1}"
typeset -A m2=(one 1)
m2+=string
printf 'append, option off: [%s] n=%s\n' "$m2" "${#m2}"
typeset -A m3=(0 pre)
m3+=x
printf 'append over the base key: [%s]\n' "$m3"

# Under the option the same stores are refused outright, and the refusal ends
# the shell — so every row here is inside `eval`, whose text is what ends
# instead, which is also how the table can be read afterwards. bash and ksh93
# store the key `0` and keep the table, so this is the option's own answer and
# not the ksh family's.
setopt ksharrays
typeset -A m4=(one 1)
eval 'm4=string' 2>&1
printf 'plain, option on: st=%s n=%s one=%s\n' "$?" "${#m4[@]}" "${m4[one]}"
eval 'm4+=string' 2>&1
printf 'append, option on: st=%s n=%s one=%s\n' "$?" "${#m4[@]}" "${m4[one]}"

# An empty table is still a table, and a subscript still reaches its element.
typeset -A m5
eval 'm5=string' 2>&1
printf 'an empty table: st=%s n=%s\n' "$?" "${#m5[@]}"
typeset -A m6=(one 1)
m6[one]=Q
printf 'a subscript: st=%s one=%s\n' "$?" "${m6[one]}"

# The pair that says it is the name's **kind**: an ordinary array under the
# same option is taken, at its base, and a name no longer holding a table is an
# ordinary scalar store.
arr=(first second)
arr+=last
printf 'an array under the option: st=%s [%s]\n' "$?" "${arr[0]}"
typeset -A m7=(one 1)
unset m7
m7=string
printf 'no longer a table: st=%s [%s]\n' "$?" "$m7"

# And a compound store is not a scalar one, either spelling.
typeset -A m8=(one 1)
m8=()
printf 'an emptying store: st=%s n=%s\n' "$?" "${#m8[@]}"
typeset -A m9=(one 1)
m9+=(two 2)
printf 'a literal append: st=%s n=%s\n' "$?" "${#m9[@]}"
unsetopt ksharrays

# ---- ksharrays moves where a plain scalar store lands, too ----

# The append above is one spelling of the row and `p=word` is the other, and
# the two are written beside each other here deliberately: they are separate
# axes, so a change that moved one and left the other reads as passing to a
# block that only asks the append. Under the option a plain store writes the
# base and the rest of the array stands, where without it the value becomes
# the whole of the name and the array is gone.
setopt ksharrays
p=(first second)
p=word
printf 'a plain store under the option: [%s]\n' "${p[@]}"
printf 'and it is still an array: %s\n' "${(t)p}"
p2=(first second)
p2+=word
printf 'the append beside it: [%s]\n' "${p2[@]}"

# The three that do not move, each with the option still on. The emptying
# store is the sharpest: same option, same name, a bare name on the left, and
# it still replaces the array outright — so it is a *scalar* store the option
# reaches and not any store.
p3=(first second)
p3=()
printf 'an emptying store: n=%s\n' "${#p3[@]}"
p4=(first second)
p4[0]=word
printf 'the base written out: [%s]\n' "${p4[@]}"
p5=abc
p5=word
printf 'a name holding a scalar: [%s]\n' "$p5"
unsetopt ksharrays

# The control that pins it to the option: the same first line without it
# leaves a scalar, and the other three answer exactly as they did above.
q=(first second)
q=word
printf 'a plain store without the option: [%s]\n' "$q"
printf 'and the array is gone: %s\n' "${(t)q}"
q3=(first second)
q3=()
printf 'an emptying store: n=%s\n' "${#q3[@]}"
q4=(first second)
q4[1]=word
printf 'the base written out: [%s]\n' "${q4[@]}"
q5=abc
q5=word
printf 'a name holding a scalar: [%s]\n' "$q5"

# It reaches every scalar store and not only an assignment statement, which is
# what the field is for: a loop variable over a name holding an array sets the
# base under the option and collapses the name without it.
setopt ksharrays
r=(first second)
for r in x y; do :; done
printf 'a loop variable under the option: [%s]\n' "${r[@]}"
unsetopt ksharrays
r2=(first second)
for r2 in x y; do :; done
printf 'a loop variable without it: [%s] %s\n' "$r2" "${(t)r2}"
