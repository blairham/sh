# SPDX-FileCopyrightText: 2026 Blair Hamilton
# SPDX-License-Identifier: Apache-2.0
#
# `times` is not a builtin in ksh93 at all — it is a preset alias for a timed
# empty compound, `{ { time;} 2>&1;}`, and that is this shell's alone.
#
# POSIX lists `times` among the special built-ins, so this is the one name on
# that list ksh93 answers from somewhere else entirely, and both halves of
# the difference follow from the alias rather than from the timing. It is
# what `command -v` reports, and it is why a variable assignment written in
# front of it is a *syntax error*: the word expands to a brace group before
# the grammar sees it, and an assignment prefix has nothing to attach to.
#
# The complaint is asked for as well as the status, which it was not until
# #2888 landed: both shells refuse the line at the same place with the same
# status, and ksh93 quotes the *opening* brace of the expanded alias where
# this one used to quote the closing one. That is about the alias route
# rather than about `times` — a reserved word an alias supplied keeps the
# reading behind an assignment prefix, where one written out loses it — and
# the `times` line is where a stock shell reaches it with nobody having
# written an alias. The status is read from a subshell so the file survives
# it.

printf 'command -v times -> [%s]\n' "$(command -v times 2> /dev/null)"
alias times > /dev/null 2>&1
printf 'and it is an alias -> %s\n' "$?"

( eval 'v=x times > /dev/null' ) 2>&1
printf 'an assignment in front of it -> %s\n' "$?"

# Called as a word of its own it still reports four times, whichever thing it
# is. The numbers are the run's and cannot be printed, so what is asked is
# that it answered at all.
times > /dev/null 2>&1
printf 'times itself -> %s\n' "$?"

# `type` on a special builtin says so, where `type echo` does not (#3273).
#
# The distinction is drawn in four of the seven columns and not in the other
# three, so `echo` is the control on every line: a shell that had merely
# adopted a longer phrase would move it too, and a shell that never says
# `special` fails the first line while passing the control. Ours said the
# short sentence in every dialect until #3273, because there was one wording
# and it took only the name.

type .
type eval
type echo

# `command -V` is the same sentence written by another builtin, and it had
# its own road to it.
command -V .
command -V echo

# And the two letters of this shell's own spelling, which had drifted apart:
# `-v` took the shared sentence and `-a` wrote its own, so one builtin was
# special under one letter and ordinary under the other, one line apart.
whence -v .
whence -a .
whence -a echo

# And *which* names are special is not POSIX's list here: this shell puts
# `alias`, `unalias` and `typeset` on the special side, which no other column
# of the panel does (#3290).
#
# `cd` is the control on every line below — an ordinary builtin in every
# column — so a shell that had put every name it knows on the special side
# fails here rather than passing this file.
type alias
type unalias
type typeset
type cd

# The behaviour that comes with the sentence: an assignment prefixed to a
# special builtin persists here, and one prefixed to `cd` does not.
V1=1 alias > /dev/null
V2=1 unalias -a > /dev/null
V3=1 typeset > /dev/null
V4=1 cd . > /dev/null
printf 'alias=[%s] unalias=[%s] typeset=[%s] cd=[%s]\n' \
	"${V1-UNSET}" "${V2-UNSET}" "${V3-UNSET}" "${V4-UNSET}"

# And `set -x` traces the prefix before the command rather than after it,
# which is this shell's special-builtin order. `cd` keeps the other one.
set -x
W1=1 unalias -a
W2=1 cd .
set +x

# And a prefix this shell refuses costs the script in front of one of them,
# where in front of `cd` it costs nothing. The `readonly` is what makes the
# assignment a refusal; `export` is the POSIX-name control on the fatal side.
#
# No `2>/dev/null` on these: this shell writes the refusal before it opens the
# command's redirections, so a `2>&1` here would be swallowing the diagnostic
# in one column and not the other, over an ordering that is not this file's
# question.
( readonly V=0; V=1 alias; printf 'after alias\n' )
( readonly V=0; V=1 export; printf 'after export\n' )
( readonly W=0; W=1 cd .; printf 'after cd\n' )

# `newgrp` is this shell's fourth special builtin beyond POSIX's fourteen, and
# it is `exec newgrp` under a builtin's name — which is what lets the word be
# special at all: a command that replaces the shell has no status to hand back
# and nothing after it to run.
#
# The machine's own `newgrp` is deliberately never run: it changes a process's
# group, and a file that ran it would be asking the operating system a
# question rather than the shell. What is run instead is a **fixture on a
# PATH of this file's own**, which is the same arrangement dialect/ksh's Go
# tests use — the word is looked up like any other command, so a directory
# made here is where it lands, and the shell is replaced by a program whose
# whole behavior is written three lines above the row that reads it.
#
# That is the row this file was missing. `type newgrp` names it as an
# *operand*, which says nothing about the builtin: `make coverage` counts a
# builtin only where it is the **command word**, and until #3990 nothing in
# the tree had `newgrp` standing there.
type newgrp
command -V newgrp
whence -v newgrp

# Replaced, and not called: `NOT REACHED` never runs, and the status that
# comes back to the parent is the *program's* own rather than a builtin's.
(
  mkdir -p ngbin
  printf '#!/bin/sh\nprintf "the program got [%%s]\n" "$*"\nexit 3\n' > ngbin/newgrp
  chmod +x ngbin/newgrp
  PATH=$PWD/ngbin
  printf 'before\n'
  newgrp -l agroup
  printf 'NOT REACHED\n'
)
printf 'the subshell was replaced -> %s\n' "$?"

# And a redirection that cannot be opened is refused in front of all of that,
# so the word never reaches a lookup at all.
( newgrp < nosuchfile_zz ) 2>&1 > /dev/null
printf 'a redirection it cannot open -> %s\n' "$?"
