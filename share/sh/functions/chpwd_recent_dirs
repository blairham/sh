#
# chpwd_recent_dirs — the chpwd hook that keeps cdr's list:
#
#   autoload -Uz chpwd_recent_dirs cdr add-zsh-hook
#   add-zsh-hook chpwd chpwd_recent_dirs
#
# Written from zshcontrib(1) and from what the installed shell answers, never
# from its function files; docs/spec/functions.md has the measurements.
# Measured beyond the manual: a change is kept only in an interactive shell,
# outside a subshell, and when it was typed — a cd at the prompt, with the
# hook called as a hook or from a chpwd function. One made by a function the
# command line called, by eval, or with cd -q is not kept.

emulate -L zsh
setopt extendedglob

[[ -o interactive ]] || return 0
(( ZSH_SUBSHELL == 0 )) || return 0
# The first call of an autoloaded function runs with loadautofunc in the
# context as well.
case ${ZSH_EVAL_CONTEXT//:loadautofunc} in
(toplevel:shfunc) ;;
(toplevel:shfunc:shfunc) [[ $funcstack[2] == chpwd ]] || return 0 ;;
(*) return 0 ;;
esac

autoload -Uz chpwd_recent_filehandler chpwd_recent_add
local -a reply
chpwd_recent_filehandler
chpwd_recent_add $PWD && chpwd_recent_filehandler $reply
return 0
