#
# `-f` on the command line — #2315's zsh/ half, and the letter a portable
# script is most likely to reach for without checking.
#
# In bash, ksh93 and dash, `-f` is noglob: `sh -f -c 'printf "[%s]\n" *'`
# prints the pattern. In zsh the letter is `NO_RCS` — "read no startup files"
# — and globbing is untouched, so the same command line prints the file names.
# zsh spells noglob `-F`.
#
# zsh/options.tests records the same split for `set -f` *inside* a running
# shell. This file is the other route, and the route is the point: `zsh -f` is
# how a script asks for a shell with no startup files, and it is written into
# shebangs and into `#!/usr/bin/env` lines where the writer usually means one
# of the two things and gets the other.
#
# `-o noglob`, which every column shares, is what core/invocation.tests uses
# and is asked here too — beside the letter, so the file says the option
# exists and the *letter* is what moved.
#
# `$SUITE_SHELL` is the shell of this run; see suite.OurShellVar.

: > aaa.txt
: > bbb.txt

# The letter, three ways of writing it, and the option's long name beside it.
"$SUITE_SHELL" -f -c 'printf "dash f: [%s]\n" *.txt'
"$SUITE_SHELL" -fc 'printf "bundled: [%s]\n" *.txt'
"$SUITE_SHELL" -o noglob -c 'printf "the option name: [%s]\n" *.txt'

# And with no option at all, so the three lines above are read against
# something rather than against an assumption.
"$SUITE_SHELL" -c 'printf "no option: [%s]\n" *.txt'

# `$0` read inside a function of a `-c` command string is the *function's*
# name here and the shell's `$0` in the other three — the same rule
# zsh/functions.tests records for a function called from a script, seen on the
# route where a script is one string on the command line.
"$SUITE_SHELL" -c 'f() { printf "in a function [%s]\n" "$0"; }
f' givenname
"$SUITE_SHELL" -c 'printf "outside a function [%s]\n" "$0"' givenname

# ---- every `setopt` name is a command-line word of its own ----
#
# The second of the two shells that have this facility, and it is not ksh93's.
# The namespace is zsh's own: it holds the `no` forms as names in their own
# right, it folds case and underscores wherever an option name is written, and
# the `--name` spelling folds hyphens on top of that — `--e-x-t-endedglob` is
# `extendedglob` here. A refused word is `no such option: …` at **1** with no
# usage block, where ksh93 writes a usage line and exits 2.
#
# The `-o` rows are what say the hyphen fold belongs to the `--name` spelling
# rather than to the option table: `--no-glob` is `noglob` and `-o no-glob` is
# a refusal, in the same shell in the same run.
#
# `--nonomatch` and `--nonoglob` are the pair that pins what "the `no` forms
# are names" means. `nomatch` is a canonical name, so `nonomatch` is its
# negation and is taken; the canonical name behind `noglob` is `glob`, so
# `noglob` is *already* the negation and `nonoglob` is a second one the
# namespace does not have.

# A refusal here names the shell by the **whole word** it was invoked by,
# where everything zsh says about a line it is running names `zsh` — so the
# harness's own `<shell>` rewrite is what appears in the rows below, and a
# shell that shortened its name to `zsh` would fail them. That is the
# difference from ksh93, which shortens its name for exactly this diagnostic
# and spells it in full everywhere else.

zrow() {
	label=$1
	shift
	printf -- '--- %s\n' "$label"
	out=$( "$SUITE_SHELL" "$@" 2>&1 )
	st=$?
	printf '%s\n' "$out"
	printf 'status %s\n' "$st"
}

zrow 'xtrace'              --xtrace -c 'echo traced'
zrow 'the no form of it'   --noxtrace -c 'echo untraced'
zrow 'errexit'             --errexit -c 'false; echo unreachable'
zrow 'noexec'              --noexec -c 'echo unreachable'
zrow 'shwordsplit'         --shwordsplit -c 'v="a b"; set -- $v; echo $#'
zrow 'and without it'      -c 'v="a b"; set -- $v; echo $#'
zrow 'extendedglob'        --extendedglob -c 'setopt'
zrow 'underscores'         --no_glob -c 'setopt'
zrow 'case as well'        --NO_GLOB -c 'setopt'
zrow 'hyphens too'         --no-glob -c 'setopt'
zrow 'and all of it'       --e-x-t-endedglob -c 'setopt'
zrow 'the same name to -o' -o no-glob -c 'echo unreachable'
zrow 'a no form as a name' --nonomatch -c 'setopt'
zrow 'a second negation'   --nonoglob -c 'echo unreachable'
zrow 'and with a gap in it' --no_no_glob -c 'echo unreachable'
zrow 'a word that is none' --zzznosuch -c 'echo unreachable'
zrow 'a bare no'           --no -c 'echo unreachable'
zrow 'no value is read'    --xtrace=1 -c 'echo unreachable'
zrow 'the refusal stops it' --zzz --xtrace -c 'echo unreachable'
