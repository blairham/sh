#
# dash's printf is the POSIX one and has neither of the two extensions the
# other three share, which makes it alone on both.
#
# `%q` is not a conversion here: the format is written up to it and the run
# fails. And `\xHH` in the *format* is not an escape — bash, zsh and ksh93 all
# write the byte, dash writes the backslash, the x and the digits. A script
# reaching for either is writing for three shells out of four.

( printf '[%q]\n' 'a b' ) 2> /dev/null
printf 'percent q -> %s\n' "$( [ $? -ne 0 ] && printf nonzero || printf zero )"

printf 'hex in the format [\x41\x42]\n'
printf 'hex in a %%b operand [%b]\n' '\x41\x42'

# The escapes dash does have, for the same reason the core file asks the ones
# every shell shares: this file is about the two it lacks rather than about
# printf being different here.
printf 'octal in the format [\101\102]\n'
printf 'octal in a %%b operand [%b]\n' '\0101\0102'
printf 'a tab [\t] and a backslash [\\]\n'

# A numeric operand with a trailing blank. dash writes the number it read and
# calls the operand "not completely converted", which is its own sentence for
# a tail and not the one it gives an operand with no number in it at all --
# that is "expected numeric value", which the blank-only operand earns. bash
# has one sentence for both; zsh and ksh93 take the trailing blank silently.
# A leading blank is accepted everywhere and is the control.
printf '[%d]\n' ' 7'
printf 'a leading blank -> %s\n' "$?"
printf '[%d]\n' '7 '
printf 'a trailing blank -> %s\n' "$?"
printf '[%d]\n' ' '
printf 'a blank on its own -> %s\n' "$?"
