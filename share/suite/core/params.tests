#
# Positional parameters and the parameter expansions POSIX XCU 2.6.2 defines.
# Written from that section and from measuring the reference shells; no case
# here was taken from anyone else's suite, and nothing is expected of a shell
# that the shell on this machine does not actually do.

set -- one two three
printf '%s\n' "count=$# first=$1 last=$3"
printf '%s\n' "star=$*"
printf '%s\n' "at=$@"
shift
printf '%s\n' "after shift: count=$# first=$1"
shift 2
printf '%s\n' "emptied: count=$# first=[$1]"

set -- a 'b c' d
printf '[%s]' "$@"; printf '\n'
printf '[%s]' "$*"; printf '\n'
IFS=:
printf '[%s]' "$*"; printf '\n'
IFS=' '

# ${parameter:-word} and ${parameter-word}: the colon is whether an empty
# value counts as unset.
unset u
e=''
s=set
printf '%s\n' "colon-dash: [${u:-d}] [${e:-d}] [${s:-d}]"
printf '%s\n' "dash:       [${u-d}] [${e-d}] [${s-d}]"
printf '%s\n' "colon-plus: [${u:+p}] [${e:+p}] [${s:+p}]"
printf '%s\n' "plus:       [${u+p}] [${e+p}] [${s+p}]"

# ${parameter:=word} assigns, and the assignment is visible afterwards.
unset u
printf '%s\n' "colon-equals: [${u:=assigned}] then [$u]"

# ${parameter:?word} is deliberately not here. Every reference exits the
# subshell, and the status it exits with is 1 in bash, zsh and ksh93 and 2 in
# dash — measured, not assumed — so it is a dialect answer and lives in each
# dialect's own file rather than in a tier that claims agreement.

# String length.
v=abcdef
printf '%s\n' "len=${#v} empty=${#e}"
set -- p q
printf '%s\n' "argc=${#}"

# Prefix and suffix removal. The doubled form is greedy.
path=/usr/local/share/doc/readme.tar.gz
printf '%s\n' "base=${path##*/}"
printf '%s\n' "dir=${path%/*}"
printf '%s\n' "shortest-suffix=${path%.*}"
printf '%s\n' "longest-suffix=${path%%.*}"
printf '%s\n' "shortest-prefix=${path#*/}"
printf '%s\n' "longest-prefix=${path##*/}"
printf '%s\n' "no-match=${path#zzz}"

# A pattern that is itself an expansion.
suffix=.gz
printf '%s\n' "nested=${path%"$suffix"}"

# $? and $$ are deliberately absent: a pid is not reproducible, and a case
# the reference will not repeat says nothing about either shell.
