#
# compinit [ -D ] [ -d dumpfile ] [ -u | -i ] [ -C ] [ -w ]
#
# Initialize the completion system's tables: read the first line of every
# `_name` file on $fpath, autoload the functions those lines mark, record
# which command each completes, and define `compdef` for a startup file to
# add its own.  zshcompsys(1), "Initialization", is the specification.
#
# Written from that manual and from what the installed shell answers, never
# from its function files.  docs/spec/functions.md records the run.
#
# Measured on zsh 5.9.2 under `-f -c`, with a directory of fixture files:
#
#   * `#compdef foo bar=baz -p "x*"` makes `_comps[foo]` and `_comps[bar]`
#     the file's name, `_services[bar]` `baz`, and `_patcomps["x*"]` — the
#     words of the line split on blanks, quotes and all;
#   * `#compdef -P pat ...` goes to `_postpatcomps`;
#   * `#autoload` autoloads the file and records nothing;
#   * a file with neither line is left alone, not even autoloaded;
#   * the first file of a name on $fpath is the one that counts;
#   * `_comps` and its fellows are hidden-value associations;
#   * `compdef`, `compaudit` and `compdump` are functions afterwards;
#   * with an insecure directory on $fpath and neither `-u` nor `-i`, a
#     shell with no terminal writes `not interactive and can't open
#     terminal`, a blank line and `compinit: initialization aborted` to
#     standard error, is 1, and leaves no compinit defined; `-i` leaves the
#     insecure directories out and `-u` reads them anyway;
#   * a run that finished leaves compinit autoloadable again, so a second
#     call reads $fpath afresh.
#
# Where this differs from zsh, on purpose:
#
#   * **the dump is this shell's own** (#6307).  zsh writes
#     ${ZDOTDIR:-$HOME}/.zcompdump, or the `-d` file, and reads it back on the
#     next start; a dump this shell wrote there would be read by the other
#     shell too, and the two must not trade one another's files.  So what the
#     scan found is kept under ${XDG_CACHE_HOME:-~/.cache}/sh/, in a format of
#     this shell's, and read back only when this build, the directories
#     scanned and the `_name` files in them are as they were when it was
#     written — a file by its stat, or where that moved by its first line,
#     which is all the scan reads — see dialect/zsh/compdump.go.  `-d`
#     still names zsh's file, for `$_comp_dumpfile`, and nothing here reads
#     or writes it.  `-D` is zsh's "no dump": nothing is read or written.
#     `-C` skips compaudit, as in zsh, but not the check that the dump is
#     current, which here costs a stat per file rather than a rescan;
#   * this shell ships no `_main_complete`: the completion widgets are put
#     on one only where the scan finds it — an installed zsh's library is
#     on $fpath by default since #6128 — and otherwise Tab keeps this
#     shell's own completion.

emulate -L zsh -o extendedglob

local opt
local -a dumpfile
integer audit=1 ignoreinsecure=0 usedump=1
while getopts "d:DiuCw" opt; do
	case $opt in
	(d) dumpfile=( $OPTARG ) ;;
	(D) dumpfile=() usedump=0 ;;
	(i) ignoreinsecure=1 ;;
	(u) audit=0 ;;
	(C) audit=0 ;;
	(w) ;;
	(*) return 1 ;;
	esac
done

typeset -gHA _comps _services _patcomps _postpatcomps _compautos
autoload -Uz compaudit compdump

# The state a `_main_complete` reads, which zsh's compinit leaves behind and
# this one did not until #6210 — so Tab after a plain `compinit` printed
# `_main_complete:412: _lastcomp: assignment to invalid subscript range` and
# `no matches found: *:globbed-files` and completed nothing.  The names and
# their types are measured (`typeset +` before and after `compinit -D`, and
# `${(t)…}`): `_lastcomp` a hidden association, `compprefuncs` and
# `comppostfuncs` empty arrays, `_comp_dumpfile` the dump's path, and
# `_comp_options` and `_comp_setup` a hidden array and a hidden scalar, the
# second evaluated by `_main_complete` before it does anything else.
#
# **What the two hold is this file's own**, written from what a completion
# function sees in zsh 5.9.2 and not from zsh's values: a completer of our
# own printing `set -o`, `trap` and `$IFS`, with options flipped at the
# prompt in groups of twenty and bisected (2026-10-05).  Every option below
# came back to the value given here whatever the prompt had; the rest kept
# the prompt's (`autocd`, `globdots`, `promptsubst`, `verbose`,
# `magicequalsubst`, `pipefail` and the history options among them).
# `shglob` could not be measured — zsh's own completion stops parsing with it
# set — and is left alone.  Inside, `IFS` is space, tab, carriage return,
# newline and NUL; a `ZERR` trap is gone and `DEBUG` stays; and `INT` and
# `QUIT` are `TRAPINT` and `TRAPQUIT`, which put `Killed by signal in <the
# function> after <n>s` under the line — what zsh draws when ^C interrupts a
# completion.
typeset -gHA _lastcomp
typeset -ga compprefuncs comppostfuncs
typeset -g _comp_dumpfile=${dumpfile[1]:-${ZDOTDIR:-$HOME}/.zcompdump}
typeset -gHa _comp_options
_comp_options=(
	bareglobqual extendedglob glob multibyte multifuncdef nullglob
	rcexpandparam unset
	noallexport noaliases noautonamedirs nocshjunkiequotes nocshnullglob
	noerrexit noerrreturn noglobassign noglobsubst nohistsubstpattern
	noignorebraces noignoreclosebraces noksharrays nokshglob nokshtypeset
	nomarkdirs nooctalzeroes noposixbuiltins noposixidentifiers
	noshwordsplit notypesettounset nowarncreateglobal noxtrace
)
typeset -gH _comp_setup=$'local IFS=$\' \\t\\r\\n\\0\'
setopt localoptions localtraps localpatterns ${_comp_options[@]}
trap - ZERR
TRAPINT() { zle -M "Killed by signal in ${funcstack[2]} after ${SECONDS}s"; zle -R; return 130 }
TRAPQUIT() { zle -M "Killed by signal in ${funcstack[2]} after ${SECONDS}s"; zle -R; return 131 }'

local -a scan
scan=( $fpath )
if (( audit )); then
	local -a insecure
	insecure=( ${(f)"$(compaudit 2>/dev/null)"} )
	if (( $#insecure )); then
		if (( ignoreinsecure )); then
			scan=( ${scan:|insecure} )
		else
			if [[ -t 0 ]]; then
				print -u2 -r -- "zsh compinit: insecure directories, run compaudit for list."
				if ! read -q "?Ignore insecure directories and continue [y] or abort compinit [n]? "; then
					print -u2
					print -u2 -r -- "compinit: initialization aborted"
					unfunction compinit compdef 2>/dev/null
					return 1
				fi
				print -u2
				scan=( ${scan:|insecure} )
			else
				print -u2 -r -- "not interactive and can't open terminal"
				print -u2
				print -u2 -r -- "compinit: initialization aborted"
				unfunction compinit compdef 2>/dev/null
				return 1
			fi
		fi
	fi
fi

compdef() {
	emulate -L zsh -o extendedglob
	local opt fn name style key
	integer autoload=0 noreplace=0 expression=0 delete=0 keyed=0 keyedmany=0
	while [[ $1 == -[anedkK]## ]]; do
		opt=$1
		shift
		[[ $opt == *a* ]] && autoload=1
		[[ $opt == *n* ]] && noreplace=1
		[[ $opt == *e* ]] && expression=1
		[[ $opt == *d* ]] && delete=1
		[[ $opt == *k* ]] && keyed=1
		[[ $opt == *K* ]] && keyedmany=1
	done
	if (( delete )); then
		for name; do
			unset "_comps[$name]" "_services[$name]"
		done
		return 0
	fi
	(( $# )) || return 0
	fn=$1
	shift
	(( autoload )) && autoload -Uz -- ${fn%% *}
	if (( keyed )); then
		style=$1
		shift
		zle -C $fn $style $fn
		for key; do
			bindkey -- $key $fn
		done
		return 0
	fi
	if (( keyedmany )); then
		while (( $# >= 3 )); do
			zle -C $1 $2 $fn
			bindkey -- $3 $1
			shift 3
		done
		return 0
	fi
	local table=_comps
	for name; do
		case $name in
		(-p) table=_patcomps; continue ;;
		(-P) table=_postpatcomps; continue ;;
		(-N) table=_comps; continue ;;
		esac
		if [[ $table == _comps && $name == *=* ]]; then
			(( noreplace )) && (( ${+_comps[${name%%=*}]} )) && continue
			_comps[${name%%=*}]=$fn
			_services[${name%%=*}]=${name#*=}
			continue
		fi
		# One branch per table rather than an `eval` naming it: this runs for
		# every name of every `#compdef` line that is not a plain list of
		# commands, and for every call a plugin makes (#5873).
		case $table in
		(_patcomps)
			(( noreplace && ${+_patcomps[$name]} )) && continue
			_patcomps[$name]=$fn
			;;
		(_postpatcomps)
			(( noreplace && ${+_postpatcomps[$name]} )) && continue
			_postpatcomps[$name]=$fn
			;;
		(*)
			(( noreplace && ${+_comps[$name]} )) && continue
			_comps[$name]=$fn
			;;
		esac
	done
	return 0
}

local dir file line name word dumpkey
local -a words options
local -A seen
# The first line is split into words the way an unset IFS splits them, so a
# tab separates `#compdef` from its names as a space does and leading blanks
# are dropped; and it is this IFS whatever the caller's is.  Measured on zsh
# 5.9.2: `#compdef<TAB>t1<TAB>t2`, `<TAB>#compdef l2` and `#compdef<TAB><TAB>m1
# <TAB> m2` all register, under `IFS=:` too, while `#compdefx`,
# `#compdef<VT>v1` and `#compdef<CR>r1` register nothing (#6289).
local IFS=$' \t\n\0'

# What the scan leaves is kept apart from what the tables held before it, so
# that it is the same whatever they held and can be written to the dump and
# read back: the files to autoload (`autoloads`, and `autoloadx` as pairs of
# an `#autoload` line's own words and the file), the four tables as they are
# after a scan into empty ones, and whether `_main_complete` was found.
local -a autoloads autoloadx comps services patcomps postpatcomps mainc
local -a held_comps held_services held_patcomps held_postpatcomps
held_comps=( "${(@kv)_comps}" ) held_services=( "${(@kv)_services}" )
held_patcomps=( "${(@kv)_patcomps}" ) held_postpatcomps=( "${(@kv)_postpatcomps}" )
_comps=() _services=() _patcomps=() _postpatcomps=()

# The dump, where it still holds: dialect/zsh/compdump.go checks it against
# this build, the directories about to be scanned, and every `_name` file in
# them — by its stat, or where that moved by its first line — so a file
# added, removed or given another first line, or $fpath reordered, means a
# scan.  The `1` is this file's own format: change it with what the arrays
# hold.
integer loaded=0
if (( usedump )) && __compinit_dump load 1 \
	autoloads autoloadx comps services patcomps postpatcomps mainc -- $scan 2>/dev/null; then
	loaded=1
elif (( usedump )); then
	# Taken before the scan, so a file that moves while it runs is never
	# recorded as what the scan read.
	__compinit_dump key dumpkey 1 $scan 2>/dev/null
fi

if (( loaded )); then
	_comps=( "${comps[@]}" ) _services=( "${services[@]}" )
	_patcomps=( "${patcomps[@]}" ) _postpatcomps=( "${postpatcomps[@]}" )
else
	for dir in $scan; do
		# `-.`, a plain file or a link to one: every file of a Homebrew zsh's
		# library is a link into its Cellar, and zsh registers them (#6183).
		for file in $dir/_*(N-.); do
			name=${file:t}
			[[ $name == *~ ]] && continue
			(( ${+seen[$name]} )) && continue
			seen[$name]=1
			IFS= read -r line < $file || [[ -n $line ]] || continue
			words=( ${=line} )
			case $words[1] in
			('#compdef')
				autoloads+=( $file )
				words=( ${words[2,-1]} )
				# A line that is only command names, which is nearly every
				# line, is what `compdef -n` does with one: each name that has
				# no function yet gets this file's. Written here rather than
				# through the call, which was most of what this scan cost —
				# about 130ms of a start over an installed zsh's library
				# (#5873). Anything with an option or a service still goes
				# through compdef.
				options=( ${(M)words:#(-*|*=*)} )
				if (( $#options )); then
					compdef -n $name $words
				else
					for word in $words; do
						(( ${+_comps[$word]} )) || _comps[$word]=$name
					done
				fi
				;;
			('#autoload')
				if (( $#words > 1 )); then
					autoloadx+=( "${words[2,-1]}" $file )
				else
					autoloads+=( $file )
				fi
				;;
			esac
		done
	done
	comps=( "${(@kv)_comps}" ) services=( "${(@kv)_services}" )
	patcomps=( "${(@kv)_patcomps}" ) postpatcomps=( "${(@kv)_postpatcomps}" )
	mainc=( ${+seen[_main_complete]} )
	if [[ -n $dumpkey ]]; then
		__compinit_dump save $dumpkey 1 \
			autoloads autoloadx comps services patcomps postpatcomps mainc -- $scan 2>/dev/null
	fi
fi

# By the file's own path, so the stub records where it will be read from:
# measured, zsh's compinit leaves `_git is an autoload shell function from
# …/site-functions/_git` and lists the stub as `builtin autoload -XUz
# …/site-functions` (#6155).  One call for the files whose line has no words
# of its own, which is every `#compdef` file and nearly every `#autoload`.
(( $#autoloads )) && autoload -Uz -- $autoloads
for word file in "${autoloadx[@]}"; do
	autoload -Uz ${=word} -- $file
done

# What the tables held before is put back over the scan, which is what a scan
# with `compdef -n` into them would have left: a name they had keeps its
# function, and its service, and a name only the scan has gets both of its.
if (( $#held_comps + $#held_services + $#held_patcomps + $#held_postpatcomps )); then
	local -A had
	had=( "${held_comps[@]}" )
	services=()
	for word line in "${(@kv)_services}"; do
		(( ${+had[$word]} )) || services+=( "$word" "$line" )
	done
	_services=( "${held_services[@]}" "${services[@]}" )
	_comps=( "${(@kv)_comps}" "${held_comps[@]}" )
	_patcomps=( "${(@kv)_patcomps}" "${held_patcomps[@]}" )
	_postpatcomps=( "${(@kv)_postpatcomps}" "${held_postpatcomps[@]}" )
fi

# The completion widgets go to `_main_complete` where the scan found one,
# which is what zsh's compinit leaves — measured, `zle -lL` afterwards lists
# these eight on `_main_complete` (#6184).  Where none was found, Tab keeps
# this shell's own completion.
if (( ${mainc[1]:-0} )); then
	local widget
	for widget in complete-word delete-char-or-list expand-or-complete \
		expand-or-complete-prefix list-choices menu-complete \
		menu-expand-or-complete reverse-menu-complete; do
		zle -C $widget .$widget _main_complete
	done
	# And `menu-select` beside them, where zsh/complist has made it.
	(( $+widgets[menu-select] )) && zle -C menu-select .menu-select _main_complete
	# The rebind zshcompsys(1) promises "if completion styles are set up to
	# perform expansion as well as completion by default" (#6216).  Measured
	# on zsh 5.9.2: the `completer` style is looked up at `:completion:`
	# exactly — `:completion:*` and `*` reach it, `:completion:*:*:*` and
	# `:completion:::::` do not — the word must be `_expand` itself, and only
	# Tab in the main keymap moves, and only from `expand-or-complete`.
	local -a completers
	if zstyle -a ':completion:' completer completers &&
		(( ${completers[(Ie)_expand]} )) &&
		[[ $(bindkey '^I') == *' expand-or-complete' ]]; then
		bindkey '^I' complete-word
	fi
fi

# Waiting to be read again rather than gone: measured, `whence -w compinit`
# afterwards is a function whose body is still to be loaded, and a second
# call rescans.  An aborted run leaves no compinit at all.
unfunction compinit
autoload -Uz compinit
return 0
