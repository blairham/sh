#
# Quoting and quote removal, POSIX XCU 2.2. The question every case here asks
# is which characters keep their meaning inside which quotes, and what is left
# on the word after the shell has finished with it.

printf '%s\n' 'single: $novar `date` \n * ? [ ] ~ ! # & | ; < >'
printf '%s\n' "double: \$literal \`literal\` \\ still"

v=value
printf '%s\n' "double expands: $v ${v} $((1+1))"
printf '%s\n' 'single does not: $v ${v} $((1+1))'

# A backslash outside quotes removes the meaning of the next character.
printf '%s\n' \$v \* \? \\ \' \" \  x
printf '%s\n' "inside double, backslash is literal before an ordinary char: \d \q"

# Adjacent quoted and unquoted runs are one word.
printf '[%s]\n' a'b c'd
printf '[%s]\n' "a"'b'c
set -- one"two three"four
printf '%s\n' "adjacent made $# word(s): [$1]"

# An empty quoted string is a word; an empty unquoted expansion is not.
unset u
set -- "" x
printf '%s\n' "empty quoted is a word: $#"
set -- $u x
printf '%s\n' "unquoted unset vanished: $#"

# Quote removal happens after expansion, so a value that looks like a quote
# is data.
q="'not a quote'"
printf '%s\n' "$q"
b='back\slash'
printf '%s\n' "$b"

# A line continuation outside quotes joins the lines and produces nothing.
printf '%s\n' contin\
uation

# Inside double quotes a backslash-newline is also removed.
printf '%s\n' "join\
ed"

# But inside single quotes a newline is data.
printf '%s\n' 'two
lines'

# A # only begins a comment where a word begins.
printf '%s\n' a#b
printf '%s\n' '#not a comment'

# Command substitution in both spellings, and the trailing newlines it strips.
printf '%s\n' "modern=$(printf 'x\n\n\n')|"
printf '%s\n' "backtick=`printf 'y\n\n'`|"
printf '%s\n' "nested=$(printf '%s' "$(printf inner)")"

# A literal dollar that is not an expansion.
printf '%s\n' "$ alone" "money \$5"

# Tildes are not expanded inside quotes; an unquoted bare tilde is HOME and
# the harness gives every run its own, so only the quoted halves are asked.
printf '%s\n' "quoted: ~ ~root" '~'
