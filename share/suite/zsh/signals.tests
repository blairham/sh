#
# Two things zsh does with a trap that no other shell on the panel does —
# #2314's zsh/ half. Both are the kind of difference a script carries across
# from bash without noticing, because neither changes what is printed until
# the day it does.
#
# The first is scope. `trap … EXIT` written inside a function is that
# *function's* trap in zsh: it runs when the function returns, and it is gone
# afterwards. In bash, ksh93 and dash the same line sets the shell's EXIT trap
# and nothing happens until the shell ends. So a function that sets a cleanup
# trap and returns has already cleaned up here and has not there — and a
# script that sets one in a function and relies on it at the end gets nothing
# at all, because the disposition went away with the call.
#
# The second is `$?`. Read at the top of a signal handler, zsh gives the
# status from before the command that delivered the signal; the other three
# give the status of that command, which is the `kill` itself and is zero.
#
# Neither needs `setopt`: this is what zsh does out of the box. POSIX_TRAPS
# is what turns the first of them off, and the last section of this file is
# that option — added with #4547, where it was found recorded and inert, so
# that both of its states are graded and not only the default one. Everything
# above that section is still what a script meets when nobody set an option.

# An EXIT trap set in a function, and a line after the call. In zsh the trap
# has already run by the time that line is reached.
f() { trap 'printf "trap in f\n"' EXIT; printf 'in f\n'; }
f
printf 'after f\n'

# Including when the function ends with `return`, and the status the call
# reports is the function's rather than the trap's.
g() { trap 'printf "trap in g\n"' EXIT; return 2; }
g
printf 'after g -> %s\n' "$?"

# And it does not run a second time when the shell ends: the trap belonged to
# the call. `end` is the last thing this file prints here, and is the line the
# other three print *before* their copy of the traps above.
printf 'end of the function section\n'

# `$?` inside a signal handler. The command that delivers the signal is
# `kill`, which succeeds, so a shell reporting the interrupted command's
# status reports 0 — and zsh reports what the command before it left.
trap 'printf "handler sees %s\n" "$?"' USR1
( exit 4 )
kill -s USR1 $$
printf 'status after the handler -> %s\n' "$?"
true
kill -s USR1 $$
( exit 6 )
kill -s USR1 $$
trap - USR1

# A `return` written inside a function-local EXIT trap. The frame whose trap
# it is has already been left when the handler runs, so the `return` acts on
# the frame the shell is returning *into* — one frame out and not "the
# shell". Every row runs in a subshell so the file survives the one that has
# no frame to return from.
p() { trap 'return 9' EXIT; return 3; }
q() { p; printf 'in q\n'; }
r() { q; printf 'in r\n'; }
( p; printf 'NOT REACHED\n' ) ; printf 'no caller -> %s\n' "$?"
( q; printf 'after q -> %s\n' "$?" )
( r; printf 'after r -> %s\n' "$?" )

# `exit` in the same body is the shell's last word wherever it is written,
# and a body that runs to its end hands the call's own status back.
e() { trap 'exit 4' EXIT; return 3; }
( e; printf 'NOT REACHED\n' ); printf 'exit in the body -> %s\n' "$?"
g() { trap ':' EXIT; return 2; }
g; printf 'a quiet handler -> %s\n' "$?"

# And what an error the shell *reported* does to the EXIT trap when `set -e`
# is on: nothing runs. A stop the script asked for keeps the handler, and so
# does the same error with the option off — the pair is the discriminator and
# neither half is.
( trap 'printf "TRAP_RAN\n"' EXIT; set -e; readonly ro=1; readonly ro=2
	printf 'NOT REACHED\n' ) 2> /dev/null
printf 'a reported error under set -e ran no handler\n'
( trap 'printf "TRAP_RAN\n"' EXIT; set -e; false; printf 'NOT REACHED\n' )
( trap 'printf "TRAP_RAN\n"' EXIT; set -e; exit 3 )
printf 'and a request to stop kept it\n'

# The subshell boundary has a second answer of its own, and it is wider than
# the one above: there the handler goes for a reported error with **no option
# at all**, and `${x?word}` goes with the errors although it keeps its handler
# at the top level, being a request to stop rather than an error. A special
# builtin's complaint about how it was *called* goes too, which is where this
# shell parts company with the other column that skips anything. Measured
# 2026-09-18 over nine rows, each written plain and under `set -e` — identical
# both ways (#3612).
( trap 'printf "TRAP_RAN\n"' EXIT; readonly rs=1; readonly rs=2
	printf 'NOT REACHED\n' ) 2> /dev/null
( trap 'printf "TRAP_RAN\n"' EXIT; printf '[%s]' "${nosuch?word}"
	printf 'NOT REACHED\n' ) 2> /dev/null
( trap 'printf "TRAP_RAN\n"' EXIT; set -Z; printf 'NOT REACHED\n' ) 2> /dev/null
printf 'a subshell given up on ran no handler, with no option\n'

# And the controls on the same boundary: a stop the subshell asked for keeps
# it, and so does a builtin complaining about its own operands.
( trap 'printf "TRAP_RAN\n"' EXIT; exit 3 )
( trap 'printf "TRAP_RAN\n"' EXIT; cd /nosuchdir_zz; printf 'ran on\n' ) 2> /dev/null
printf 'and a request to stop, or an ordinary failure, kept it\n'

# POSIX_TRAPS, both ways. With it on, an EXIT trap set in a function is the
# shell's: it waits for the shell to end, which is what every other shell on
# the panel does without being asked. Each row is run in a subshell so that
# the option does not leak into the next, and so that "the shell's exit" is
# reached before the file has finished.
( setopt posixtraps
  ft() { trap 'printf "trap in ft\n"' EXIT; printf 'in ft\n'; }
  ft
  printf 'after ft\n' )

# And with it off again, which is the control: the same body, the same order
# of lines in the file, and the trap back at the return.
( unsetopt posixtraps
  fu() { trap 'printf "trap in fu\n"' EXIT; printf 'in fu\n'; }
  fu
  printf 'after fu\n' )

# The option is read when the `trap` runs and not when the function returns,
# so a body that turns it off after setting the trap still defers.
( setopt posixtraps
  fs() { trap 'printf "trap in fs\n"' EXIT; printf 'in fs\n'; unsetopt posixtraps; }
  fs
  printf 'after fs\n' )

# And the other way round: set with the option off and returned with it on,
# the trap still fires at the return.
( unsetopt posixtraps
  fr() { trap 'printf "trap in fr\n"' EXIT; printf 'in fr\n'; setopt posixtraps; }
  fr
  printf 'after fr\n' )

# `emulate sh` turns it on without anyone typing `setopt`, which is how a
# function library meets this.
( emulate sh
  fe() { trap 'printf "trap in fe\n"' EXIT; printf 'in fe\n'; }
  fe
  printf 'after fe\n' )

# Only EXIT moves. A signal trap set inside a function is the shell's to keep
# in both states, so the handler a later signal finds is the inner one.
( setopt posixtraps
  trap 'printf "outer usr1\n"' USR1
  fk() { trap 'printf "inner usr1\n"' USR1; printf 'in fk\n'; }
  fk
  kill -s USR1 $$
  printf 'after fk\n' )
