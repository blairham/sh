#
# Aliases in ksh93 — #2319.
#
# ksh93 ships nineteen aliases before a script has run a line, and several of
# them are how the shell's own vocabulary is spelled: `integer`, `float` and
# `nameref` are aliases for `typeset` with a flag, `history` and `r` are
# aliases onto `fc`, and `source` is one onto `.`. None of the other three
# shells on the panel defines a single alias at startup, so a name that is
# already an alias here is a name a script must not assume is free — an
# earlier draft of core/test.tests defined a function called `r` and nothing
# could call it.
#
# The other two answers are about the builtin rather than the table. ksh93
# has `alias -t` for tracked aliases and `alias -x` for exported ones,
# neither of which the panel's other shells accept; and a name ksh93 has
# removed can be removed *again* successfully, where the other three report
# failure the second time as they do for a name nobody ever defined.
#
# That second one is wider than the rows below reach, and it is written here
# rather than asked because the file is a per-dialect claim and not a place
# to grow a second subject. Naming a name is enough: a *failed* `alias z` —
# `z: alias not found`, status 1 — leaves the name behind, and so does a
# lookup inside `eval`, inside a function or behind `command`. `unalias -a`
# clears the remembered names along with the table. The name is not an alias
# afterwards: no listing has it and `alias z` still fails. See #2926 and
# #3429, the second of which is what the subshell rows at the end are.
#
# The option cases are written inside a subshell. An option `alias` does not
# have is a fatal usage error in ksh93 and would leave the rest of the file
# unrun in the columns that lack these flags.

# Removing a name twice. The first removal succeeds everywhere; the second is
# where ksh93 parts from the panel, and the third case is the control — a
# name that was never defined fails here too, so this is about a name the
# shell has seen rather than about `unalias` being lenient.
alias h=1
unalias h; printf 'first removal -> %s\n' "$?"
unalias h 2>/dev/null; printf 'second removal -> %s\n' "$?"
unalias nevernamed_zz 2>/dev/null; printf 'never named -> %s\n' "$?"

# The two flags. `-t` lists or creates tracked aliases — the shell's cache of
# where a command was found on PATH — and `-x` marks an alias for export.
( alias -t ) > /dev/null 2>&1; printf 'alias -t -> %s\n' "$?"
( alias -x xx=1 ) 2>/dev/null; printf 'alias -x -> %s\n' "$?"
( alias -p ) > /dev/null 2>&1; printf 'alias -p -> %s\n' "$?"

# The preset table. Queried by name rather than listed, because the list
# itself is a version's and the point being made is that these names are
# taken.
for n in integer float nameref history r hash source autoload stop times; do
  if alias "$n" > /dev/null 2>&1; then
    printf 'preset %s yes\n' "$n"
  else
    printf 'preset %s no\n' "$n"
  fi
done

# And a preset is an ordinary alias: it can be removed, after which the name
# is free.
unalias float 2>/dev/null; printf 'unalias a preset -> %s\n' "$?"
alias float > /dev/null 2>&1; printf 'preset after removal -> %s\n' "$?"

# What a subshell's `alias` named outlives the subshell, and what it defined
# does not: a `( … )` and a `$( … )` both leave the name behind in the shell
# that made them, where a pipeline element does not. The removals are
# silenced because the columns without the memory report them (#3429).
( alias z1 2>/dev/null ) ; unalias z1 2>/dev/null; printf 'named in parens -> %s\n' "$?"
q=$(alias z2 2>/dev/null) ; unalias z2 2>/dev/null; printf 'named in a substitution -> %s\n' "$?"
( alias z3=1 ) ; alias z3 > /dev/null 2>&1; printf 'the value it defined -> %s\n' "$?"
( alias z3=1 ) ; unalias z3 2>/dev/null; printf 'but the name it named -> %s\n' "$?"
alias z4 2>/dev/null | cat > /dev/null; unalias z4 2>/dev/null; printf 'a pipeline element -> %s\n' "$?"

# `--` ends the lookup here and not only the options: a bare name behind it is
# named and nothing is printed for it, whether the table holds it or not. The
# control is the same two lookups written without the separator (#3063).
alias -- r > /dev/null 2>&1; printf 'a preset behind the separator -> %s\n' "$?"
alias -- nosuch_zz > /dev/null 2>&1; printf 'and a name that is not one -> %s\n' "$?"
alias nosuch_zz > /dev/null 2>&1; printf 'the same name without it -> %s\n' "$?"
