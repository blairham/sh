#
# Parameter expansion, the answer only bash gives.
#
# The operators here arrived in bash 4.0 and 4.4 and have no spelling in the
# ksh93 on this machine, none in dash, and a different one in zsh — where
# case conversion is an expansion flag and a transformation is a modifier.
# That is what puts the family in a dialect directory rather than in ext/.

v=hello

# Case modification. One caret or comma converts the first character that the
# pattern matches, two convert every one, and a tilde inverts.
printf '%s\n' "${v^}"
printf '%s\n' "${v^^}"
printf '%s\n' "${v~}"
printf '%s\n' "${v~~}"
u=HELLO
printf '%s\n' "${u,}"
printf '%s\n' "${u,,}"

# A pattern after the operator says which characters are converted.
printf '%s\n' "${v^^[aeiou]}"
printf '%s\n' "${v^^l}"

# The @ transformations. Q quotes the value so it can be read back, U and L
# and u are the case operators again by another name, and E processes the
# escapes a $'…' literal would.
printf '%s\n' "${v@Q}"
printf '%s\n' "${v@U}"
printf '%s\n' "${v@u}"
printf '%s\n' "${u@L}"
esc='a\tb'
printf '%s\n' "${esc@E}"

# @a is the attribute letters of a name, and @A is a declaration that would
# recreate it.
declare -ir n=7
printf '%s\n' "${n@a}"
printf '%s\n' "${n@A}"

# printf -v assigns instead of writing, which is bash's way to format into a
# variable without a command substitution.
printf -v out 'formatted %s and %s' one two
printf '%s\n' "$out"
printf -v pad '%05d' 42
printf '%s\n' "$pad"

# A positional slice takes a count rather than an end, and $0 is only
# included when the offset starts at zero.
set -- p q r s
printf '%s\n' "${@:2:2}"
printf '%s\n' "${@: -1}"
printf 'count: %s\n' "$#"

# An array slice is the same operator on a name, and ${!name[@]} is the
# subscripts.
a=(zero one two three)
printf '%s\n' "${a[@]:1:2}"
printf '%s\n' "${!a[@]}"

# An associative array declared with -A, and the subscripts read back.
declare -A m=([k]=v [j]=w)
printf '%s\n' "${m[k]}"
printf '%s\n' "${m[j]}"
printf 'keys: %s\n' "${#m[@]}"

# ${!name} is an indirection in bash — it reads the variable the value names —
# where ksh93 gives back the name itself.
target=found
ref=target
printf '%s\n' "${!ref}"

# A single quote inside the word of an expansion, inside double quotes. bash
# reads the brace group with its own quoting rules and the quotes stay in the
# word as characters, so `${u-'}'}` has the word `'}'` and the `}` between the
# quotes does not end the expansion. zsh, ksh93 and dash end it at that first
# `}` and read the rest of the line as text.
#
# The escaped and the double-quoted spellings agree across the whole panel
# and are in core/params.tests; this is the one that does not.
unset u
printf '[%s]\n' "${u-'}'}"
printf '[%s]\n' "${u-'x'}"

# And the same question put to a *subscript*: which quoting holds a `]` back
# from ending it. bash takes both quotes as well as the backslash, so a key
# with a bracket in it can be read back the way it was written. zsh takes only
# the backslash — it stops at the bracket inside the quotes and reports a math
# error — which is what puts the quoted spellings here rather than in
# ext/arrays.tests, where the backslash form is asked for all three.
declare -A b
b['x]y']=plain
printf 'single=[%s] double=[%s]\n' "${b['x]y']}" "${b["x]y"]}"
printf 'count=%s\n' "${#b[@]}"

# The same protection in a length and in a default, so it is the scan that
# learned to quote rather than one operator's reading of it.
printf 'length=%s\n' "${#b['x]y']}"
printf 'absent default=[%s]\n' "${b['no]such']-fallback}"

# ---- `$_` across a function call ----
#
# `$_` is the previous command's last argument, and `mkdir -p "$d" && cd "$_"`
# is the idiom it exists for. A *function call* is a command like any other, so
# what the caller reads once it returns is the **call's** own last argument and
# not whatever the body last ran — which this shell answered with the body's,
# so `make_dir /tmp/x` then `cd "$_"` went to a directory named `:` (#3134).
#
# That row is unanimous across bash, ksh93 and zsh, and it is the last line of
# each pair below. The *first* line of each pair is where they part: this shell
# opens a body with what the **caller** had, ksh93 does too, and zsh opens it
# with the call's own last argument. So the three files hold the same rows and
# three different answers.

suiteinner() { :; }
suitepeek() { printf 'body [%s]\n' "$_"; suiteinner zz; printf 'body-after [%s]\n' "$_"; }
: outer
suitepeek one two
printf 'after-call [%s]\n' "$_"
suitepeek
printf 'after-argless [%s]\n' "$_"
A=2 suitepeek three
printf 'after-prefixed [%s]\n' "$_"
suitewrap() { suitepeek aa bb; }
: before
suitewrap xx yy
printf 'after-nested [%s]\n' "$_"
suiteset() { _=SET_IN_BODY; }
suiteset qq
printf 'after-explicit [%s]\n' "$_"

# ---- `${!v}` reads the resolved text as a parameter *reference* ----
#
# bash reads what `v` came to as the expansion it spells and not as a plain
# variable name, so a positional parameter, a special parameter and a
# subscripted element all resolve; only an ordinary unset name comes back
# empty. This shell handed the text to the plain-name store, so every row but
# the last two was the empty string at status 0 — a wrong value and not a
# missing diagnostic (#3213).
#
# ksh93 gives back the name it was written on for every one of these, and zsh
# and dash have no such expansion at all, which is what keeps the section in
# this directory.
set -- p q r
arr=(A B C)
for spec in '@' '*' '#' '1' '2' '9' '?' 'arr[1]' 'arr[@]' 'arr[*]' 'arr' 'nosuch'; do
	printf '%s=' "$spec"
	printf '<%s>' "${!spec}"
	printf '\n'
done

# The field count is the half a joined read cannot carry, so it is printed on
# its own: `@` and `[@]` keep one field per parameter and per element where
# `*` and `[*]` are one joined field, exactly as the written spellings do.
ifs_at='@'; ifs_arr='arr[@]'; ifs_star='*'; ifs_astar='arr[*]'
printf 'fields at=%s arr=%s star=%s astar=%s\n' \
	$(set -- "${!ifs_at}"; echo $#) \
	$(set -- "${!ifs_arr}"; echo $#) \
	$(set -- "${!ifs_star}"; echo $#) \
	$(set -- "${!ifs_astar}"; echo $#)

# The subscript in a resolved text is live and is evaluated **once**: the
# counter moves one place per expansion and not one per reader, which is the
# guarantee #3104 wrote down for a written subscript and this road now shares.
counted=(x y z); idx=0; moving='counted[idx++]'
printf 'once=[%s] idx=%s\n' "${!moving}" "$idx"
printf 'twice=[%s][%s] idx=%s\n' "${!moving}" "${!moving}" "$idx"

# ---- `set -u` reaches the *target* of an indirection ----
#
# The refusal is about the second read and names the parameter with its `!` on
# it, subscript and all. A set `v` naming an unset parameter expanded to empty
# at status 0 here where bash ends the script (#3214). Each row is a subshell
# so the file carries on past a fatal one, and the status is printed beside it.
unbound_v=nope
unbound_w='arr[9]'
unbound_q=1
(set -u; printf 'u1=[%s]\n' "${!unbound_v}"); printf 'u1rc=%s\n' "$?"
(set -u; printf 'u2=[%s]\n' "${!arr[9]}"); printf 'u2rc=%s\n' "$?"
(set -u; printf 'u3=[%s]\n' "${!unbound_w}"); printf 'u3rc=%s\n' "$?"
(set -u; set --; printf 'u4=[%s]\n' "${!unbound_q}"); printf 'u4rc=%s\n' "$?"

# The operator guard is the one every other expansion gets: a form that
# supplies a value is no error, and `${!v}` through a name holding `@` is the
# positional list rather than an unset parameter.
unbound_at='@'
(set -u; printf 'u5=[%s]\n' "${!unbound_v-D}"); printf 'u5rc=%s\n' "$?"
(set -u; printf 'u6=[%s]\n' "${!unbound_v:-D}"); printf 'u6rc=%s\n' "$?"
(set -u; printf 'u7=[%s]\n' "${!unbound_v+S}"); printf 'u7rc=%s\n' "$?"
(set -u; printf 'u8=[%s]\n' "${!unbound_at}"); printf 'u8rc=%s\n' "$?"

# `${!v?word}` names the same subject, which is what says the `!` belongs to
# the parameter and not to the `set -u` sentence.
(printf 'q1=[%s]\n' "${!unbound_v?missing}"); printf 'q1rc=%s\n' "$?"
(printf 'q2=[%s]\n' "${!arr[9]?missing}"); printf 'q2rc=%s\n' "$?"

# A positional parameter standing as the *outer* name, where the subject is
# the whole `!1` and not the `$1` a bare positional wears.
(set -- nope; set -u; printf 'u9=[%s]\n' "${!1}"); printf 'u9rc=%s\n' "$?"
(set --; set -u; printf 'u10=[%s]\n' "${!1}"); printf 'u10rc=%s\n' "$?"
