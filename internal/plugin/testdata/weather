#!/bin/sh
# The segment role on its own: this plugin declares no commands, does not
# watch, and draws one element of the prompt.
#
# It is the shape the role exists for. Nothing here answers a question the
# shell waits on: the host *tells* it what the prompt is being drawn for, and
# it publishes when it has something. A prompt drawn before it has published
# draws nothing for the element, which costs no space, and the prompt is
# redrawn in place when the answer turns up.
#
# The two messages are both notifications and neither carries a call id, for
# the reason an event carries none: a prompt segment belongs to no command.
#
# What it draws is the directory's last component, spelled differently from
# anything the shell would draw itself, so a test can tell "the plugin's
# segment is on the screen" from "the shell drew something".
exec 3>&1
send() { printf '%s\n' "$1" >&3; }

while IFS= read -r line; do
	case $line in
	*'"method":"prompt/context"'*)
		dir=$(printf '%s' "$line" | sed -n 's/.*"dir":"\([^"]*\)".*/\1/p')
		# Its own standard error, which the host relays prefixed. It is how a
		# test can tell "the plugin published again" from "the plugin was
		# never told again" — the answer itself is identical either way,
		# which is the whole thing the deduplication is about.
		printf 'told %s\n' "$dir" >&2
		send "{\"jsonrpc\":\"2.0\",\"method\":\"prompt/segment\",\"params\":{\"name\":\"weather\",\"content\":\"sunny-in-${dir##*/}\",\"icon\":\"VCS\",\"state\":\"fine\",\"fields\":{\"WHERE\":\"${dir##*/}\"}}}"
		continue
		;;
	esac
	id=$(printf '%s' "$line" | sed -n 's/.*"id":\([0-9]*\).*/\1/p')
	case $line in
	*'"method":"initialize"'*)
		send "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"protocolVersion\":1,\"name\":\"weather\",\"commands\":[],\"segments\":[\"weather\"]}}"
		;;
	esac
done
